<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- .NET / CoreCLR 在 macOS 上必须允许 JIT：没有它进程无法启动。
	     Hardened Runtime 打开后这一项是硬性要求。 -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- .NET 会加载自带的原生库（libcoreclr.dylib 等），Hardened Runtime 下需要豁免库签名校验。 -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- CoreCLR 的 JIT 之外的动态代码路径（AOT 之外的备用编译路径）需要。 -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- 应用会写本地设置 / 读用户选中的文件；仅此一项沙箱权限，不申请网络与全盘访问。 -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
