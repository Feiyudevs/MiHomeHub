<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MiHomeHub.ViewModels"
             xmlns:m="clr-namespace:MiHomeHub.Models"
             xmlns:conv="clr-namespace:MiHomeHub.Converters"
             xmlns:ctl="clr-namespace:MiHomeHub.Controls"
             xmlns:views="clr-namespace:MiHomeHub.Views"
             xmlns:svc="clr-namespace:MiHomeHub.Services"
             x:Class="MiHomeHub.Views.DeviceDetailView"
             x:DataType="vm:MainViewModel">
    <!-- 色温量程的手输框已并入 ctl:NumberStepper（数值、输入框、单位单标那一套都在控件里），
         这里不再留一份 RangeNum 样式；少一份样式也就少一处会走样的地方。 -->
    <!-- 色温量程的手输框已并入 ctl:NumberStepper（数值、输入框、单位单标那一套都在控件里），
         这里不再留一份 RangeNum 样式；少一份样式也就少一处会走样的地方。 -->
    <!-- 设备详情正文：右侧抽屉与桌面分区的控制弹窗共用这一份，
         两处永远是同一套卡片、同一套命令，不复制不漂移。
         外边距由宿主（抽屉 ScrollViewer / DialogPopup 正文区）决定。 -->
    <UserControl.Styles>
        <!-- 离线设备：控制卡整块压暗。能不能点由各卡自己的 IsEnabled 决定，
             这里只负责「看得出动不了」的视觉，设备重新连上后淡回原样 -->
        <Style Selector="Border.ctl-off">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.ctl-off">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <!-- 控制卡外的操作说明（如「拖动滑杆，松手后生效」）跟着一起淡，免得卡片灰了、提示还亮着 -->
        <Style Selector="TextBlock.ctl-off">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <!-- 音箱播放键：中间一颗 44 圆的品牌紫渐变主键，是这块卡唯一的高对比色块；
             两侧的上一曲 / 下一曲只留一枚 34 圆的透明热区，悬停才浮出浅紫，
             不再三键同底同权重地并排（一眼分不出哪个是主操作） -->
        <Style Selector="Button.DrPlay">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- 紫晕只垫在键下方：深色卡上像一颗灯，浅色主题下也只是一圈柔影 -->
                    <Border Name="Bd" CornerRadius="22" Background="{TemplateBinding Background}"
                            BoxShadow="0 5 14 0 #3D7C5CFC">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.DrPlay:pointerover">
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.DrPlay:pressed">
            <Setter Property="Opacity" Value="0.78" />
        </Style>
        <Style Selector="Button.DrPlay:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <!-- 两侧副键：静息透明（用同色零透明的 From 档，淡入时不会先闪灰），只留圆形热区 -->
        <Style Selector="Button.DrIconBtn">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource AccentSoft2FromBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="17" Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.DrIconBtn:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentSoft2Brush}" />
        </Style>
        <Style Selector="Button.DrIconBtn:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}" />
        </Style>
        <Style Selector="Button.DrIconBtn:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="16">
        <!-- 离线提示：控制卡整体停用后，这里补一句为什么点不动 -->
        <Border CornerRadius="12" Padding="12,9"
                Background="{DynamicResource AmberSoftBrush}"
                IsVisible="{Binding !DrawerDevice.IsOnline}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Classes="StatusDot" Classes.is-warn="True" VerticalAlignment="Center" />
                <TextBlock Text="设备离线，控制暂不可用" FontSize="12.5" FontWeight="Normal"
                           Foreground="{DynamicResource AmberBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <!-- 详情顶部实时读数：设备规格里有的指标各一枚小卡（功率/电压/电流/温度/湿度/PM2.5/照度等）。
             卡片自己就是「卡片外显」的开关：点亮右上角小房子即为显示在主页设备卡上，不再单独占一块配置区 -->
        <StackPanel Spacing="8" IsVisible="{Binding HasDrawerMetricTiles}">
            <ItemsControl ItemsSource="{Binding DrawerMetricTiles}"
                          ItemTemplate="{StaticResource MetricTileTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 读数卡按抽屉宽度自动分列，最多 3 列：温度 / 湿度 / PM2.5 这类常见三项一行排完，
                             不再折到第二行留半张空的。窗口收窄时退到 2 列、1 列，卡片跟着等宽拉伸 -->
                        <ctl:AdaptiveGridPanel MinItemWidth="96" MaxColumns="3" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Grid ColumnDefinitions="*,Auto" Margin="2,2,2,0">
                <TextBlock Classes="Hint" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Text="{Binding MetricTilesHint}"
                           ToolTip.Tip="{Binding MetricTilesHintTip}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="BtnGhost" Height="24" Padding="8,0"
                        FontSize="11.5" Content="恢复默认" Margin="8,0,0,0" VerticalAlignment="Center"
                        Command="{Binding ResetCardMetricsCommand}" />
            </Grid>
        </StackPanel>
        <Border Classes="DrCard" Classes.ctl-off="{Binding !DrawerDevice.IsOnline}"
                IsVisible="{Binding DrawerDevice.IsPower}"
                IsEnabled="{Binding DrawerDevice.IsOnline}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="电源" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}" />
                <ToggleButton Grid.Column="1" Classes="Switch" VerticalAlignment="Center"
                              IsChecked="{Binding DrawerDevice.IsOn, Mode=TwoWay}"
                              IsEnabled="{Binding !DrawerDevice.IsBusy}"
                              Command="{Binding ToggleDeviceCommand}"
                              CommandParameter="{Binding DrawerDevice}" />
            </Grid>
        </Border>
        <!-- 多路开关：每一路独立一行；单路开关也用这张卡（此时没有整机电源卡） -->
        <Border Classes="DrCard" Classes.ctl-off="{Binding !DrawerDevice.IsOnline}"
                IsVisible="{Binding DrawerDevice.HasChannels}"
                IsEnabled="{Binding DrawerDevice.IsOnline}">
            <StackPanel Spacing="8">
                <TextBlock Text="开关" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
                <ItemsControl ItemsSource="{Binding DrawerDevice.Channels}"
                              ItemTemplate="{StaticResource ChannelRowTemplate}" />
            </StackPanel>
        </Border>
        <!-- 小爱音箱：音量 + 播放 / 暂停 -->
        <Border Classes="DrCard" Classes.ctl-off="{Binding !DrawerDevice.IsOnline}"
                IsVisible="{Binding DrawerDevice.IsSpeaker}"
                IsEnabled="{Binding DrawerDevice.IsOnline}">
            <StackPanel Spacing="9">
                <!-- 播放控制：主键居中、两侧副键让位。
                     图标一律 Stretch=Fill 铺满自己的框，再由对齐居中——
                     Uniform 会在框里留空，落点跟着几何边界走，看着就偏了；
                     三角形再右挪半像素，它的重心偏左，按外框居中仍会觉得没居中 -->
                <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,1,0,3"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Classes="DrIconBtn" ToolTip.Tip="上一曲"
                            Command="{Binding PreviousTrackCommand}"
                            IsEnabled="{Binding !DrawerDevice.IsBusy}">
                        <Path Width="13.5" Height="14" Stretch="Fill"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{DynamicResource Text2Brush}"
                              Data="{StaticResource GeoPrevTrack}" />
                    </Button>
                    <Button Classes="DrPlay" ToolTip.Tip="播放 / 暂停"
                            Command="{Binding ToggleSpeakerPlayCommand}"
                            IsEnabled="{Binding !DrawerDevice.IsBusy}">
                        <Panel>
                            <Path Width="10.5" Height="15" Stretch="Fill"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="#FFFFFF"
                                  IsVisible="{Binding !DrawerDevice.IsPlaying}"
                                  Data="{StaticResource GeoPlay}">
                                <Path.RenderTransform>
                                    <TranslateTransform X="0.5" />
                                </Path.RenderTransform>
                            </Path>
                            <Path Width="7.5" Height="14" Stretch="Fill"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="#FFFFFF"
                                  IsVisible="{Binding DrawerDevice.IsPlaying}"
                                  Data="{StaticResource GeoPauseIc}" />
                        </Panel>
                    </Button>
                    <Button Classes="DrIconBtn" ToolTip.Tip="下一曲"
                            Command="{Binding NextTrackCommand}"
                            IsEnabled="{Binding !DrawerDevice.IsBusy}">
                        <Path Width="13.5" Height="14" Stretch="Fill"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{DynamicResource Text2Brush}"
                              Data="{StaticResource GeoNextTrack}" />
                    </Button>
                </StackPanel>
                <!-- 音量挪到播放键下面：先看见主操作，再调大小 -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="音量" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Grid.Column="1" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent2Brush}"
                               Text="{Binding DrawerDevice.SpeakerVolume, StringFormat='{}{0}%'}" />
                </Grid>
                <Slider Classes="DrSlider" Minimum="0" Maximum="100" TickFrequency="1"
                        Value="{Binding DrawerDevice.SpeakerVolume, Mode=TwoWay}"
                        IsEnabled="{Binding DrawerDevice.IsOnline}" />
            </StackPanel>
        </Border>
        <!-- 耗材：滤芯 / 刷头 / 电量，低于 20% 标琥珀色 -->
        <Border Classes="DrCard" IsVisible="{Binding DrawerDevice.HasConsumables}">
            <StackPanel Spacing="8">
                <TextBlock Text="耗材" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
                <ItemsControl ItemsSource="{Binding DrawerDevice.Consumables}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:ConsumableState">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Desc}" FontSize="12.5"
                                           Foreground="{DynamicResource Text2Brush}" />
                                <TextBlock Grid.Column="1" Text="{Binding ValueText}"
                                           Classes="ConsumeVal" Classes.is-low="{Binding IsLow}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <!-- 窗帘：开合度 + 电机控制 -->
        <StackPanel Spacing="12" IsVisible="{Binding DrawerDevice.IsCurtain}"
                    Classes.ctl-off="{Binding !DrawerDevice.IsOnline}"
                    IsEnabled="{Binding DrawerDevice.IsOnline}">
            <Border Classes="DrCard">
                <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="开合度" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" />
                        <TextBlock Grid.Column="1" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent2Brush}"
                                   Text="{Binding DrawerDevice.CurtainPosition, StringFormat='{}{0}%'}" />
                    </Grid>
                    <Slider Classes="DrSlider" Minimum="0" Maximum="100"
                            Value="{Binding DrawerDevice.CurtainPosition, Mode=OneWay}"
                            IsEnabled="False" />
                </StackPanel>
            </Border>
            <Border Classes="DrCard">
                <StackPanel Spacing="7" IsEnabled="{Binding DrawerDevice.IsOnline}">
                    <TextBlock Text="控制" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" />
                    <Border Classes="SegTrack">
                        <UniformGrid Columns="3">
                            <Button Classes="SegBtn" Content="打开" VerticalAlignment="Center"
                                    Command="{Binding CurtainOpenCommand}"
                                    IsEnabled="{Binding !DrawerDevice.IsBusy}" />
                            <Button Classes="SegBtn" Content="暂停" VerticalAlignment="Center"
                                    Command="{Binding CurtainPauseCommand}"
                                    IsEnabled="{Binding !DrawerDevice.IsBusy}" />
                            <Button Classes="SegBtn" Content="关闭" VerticalAlignment="Center"
                                    Command="{Binding CurtainCloseCommand}"
                                    IsEnabled="{Binding !DrawerDevice.IsBusy}" />
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>
            <TextBlock Classes="Hint" Text="打开 / 暂停 / 关闭 电机指令即时下发" />
        </StackPanel>
        <!-- 灯光：亮度 + 色温（拖动松手后生效） -->
        <StackPanel Spacing="12" IsVisible="{Binding DrawerDevice.IsLight}">
            <Border Classes="DrCard" Classes.ctl-off="{Binding !DrawerDevice.IsOnline}"
                    IsEnabled="{Binding DrawerDevice.IsOnline}">
                <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="亮度" FontSize="12.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text2Brush}" />
                        <TextBlock Grid.Column="1" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding DrawerDevice.Brightness, StringFormat='{}{0}%'}" />
                    </Grid>
                    <!-- 与色温同一套胶囊滑杆，只是轨道去掉渐变、用纯色已填段表达档位；
                         量程取设备规格（多数灯 1–100，个别型号不同） -->
                    <Slider Classes="PillSlider"
                            Minimum="{Binding DrawerDevice.BrightnessMin}"
                            Maximum="{Binding DrawerDevice.BrightnessMax}"
                            Value="{Binding DrawerDevice.Brightness, Mode=TwoWay}"
                            IsEnabled="{Binding DrawerDevice.IsOnline}" />
                </StackPanel>
            </Border>
            <!-- 量程按型号走：2700–6500、3000–6500、灯组 1700–7000 各不相同；
                 只有彩光、没有色温属性的灯（追光灯之类）不出这张卡 -->
            <Border Classes="DrCard" IsVisible="{Binding DrawerDevice.HasColorTemp}">
                <StackPanel Spacing="9">
                    <!-- 离线只停用「读数 + 滑杆」这一段；下面的量程设定是本机配置，不连设备也能改 -->
                    <StackPanel Spacing="9"
                                Classes.ctl-off="{Binding !DrawerDevice.IsOnline}"
                                IsEnabled="{Binding DrawerDevice.IsOnline}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="色温" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text2Brush}" />
                            <TextBlock Grid.Column="1" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Text="{Binding DrawerDevice.ColorTemp, StringFormat='{}{0}K'}" />
                        </Grid>
                        <!-- 整根轨道就是色温光谱；Foreground 透明把已填段藏掉，滑块只落在渐变上 -->
                        <Slider Classes="PillSlider"
                                Minimum="{Binding DrawerDevice.ColorTempMin}"
                                Maximum="{Binding DrawerDevice.ColorTempMax}"
                                TickFrequency="{Binding DrawerDevice.ColorTempStep}"
                                Background="{DynamicResource ColorTempTrackBrush}"
                                Foreground="Transparent"
                                Value="{Binding DrawerDevice.ColorTemp, Mode=TwoWay}"
                                IsEnabled="{Binding DrawerDevice.IsOnline}" />
                    </StackPanel>
                    <!-- 色温量程：默认跟着设备规格走，可以按这盏灯自己放宽或收窄；自定义存在 app.json（只认 did） -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text3Brush}"
                                   Text="{Binding DrawerDevice.ColorTempRangeText}" />
                        <Button Grid.Column="1" Classes="BtnGhost" Height="24" Padding="8,0"
                                FontSize="11" Margin="8,0,0,0"
                                Content="{Binding DrawerDevice.LightRangeToggleText}"
                                Command="{Binding ToggleLightRangeCommand}" />
                    </Grid>
                    <StackPanel Spacing="8" IsVisible="{Binding DrawerDevice.IsEditingLightRange}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="最小" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text2Brush}" />
                            <!-- 与场景编辑、添加动作同一个步进器控件：双击数值就能手输 -->
                            <ctl:NumberStepper Grid.Column="1" VerticalAlignment="Center"
                                               Value="{Binding DrawerDevice.LightRangeEditMin, Mode=TwoWay}"
                                               Minimum="1000"
                                               Maximum="{Binding DrawerDevice.LightRangeMinUpper}"
                                               Step="100" Unit="K"
                                               ValueWidth="44" ValueFontSize="13.5"
                                               ValueFontWeight="Bold" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="最大" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text2Brush}" />
                            <ctl:NumberStepper Grid.Column="1" VerticalAlignment="Center"
                                               Value="{Binding DrawerDevice.LightRangeEditMax, Mode=TwoWay}"
                                               Minimum="{Binding DrawerDevice.LightRangeMaxLower}"
                                               Maximum="10000"
                                               Step="100" Unit="K"
                                               ValueWidth="44" ValueFontSize="13.5"
                                               ValueFontWeight="Bold" />
                        </Grid>
                        <TextBlock Classes="Hint" Text="{Binding DrawerDevice.SpecColorTempRangeText}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Classes="BtnGhost" Height="26" Padding="10,0" FontSize="11.5"
                                    Content="恢复默认" Command="{Binding ResetLightRangeCommand}" />
                            <Button Classes="BtnPrimary" Height="26" Padding="12,0" FontSize="11.5"
                                    Content="保存" Command="{Binding SaveLightRangeCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Classes="Hint" Classes.ctl-off="{Binding !DrawerDevice.IsOnline}"
                       Text="拖动滑杆，松手后生效" />
        </StackPanel>
        <!-- 空调：模式 + 目标温度 + 风速（按钮按设备规格生成） -->
        <StackPanel Spacing="12" IsVisible="{Binding DrawerDevice.IsAc}">
            <StackPanel Spacing="12"
                        Classes.ctl-off="{Binding !DrawerDevice.IsOnline}"
                        IsEnabled="{Binding DrawerDevice.IsOnline}"
                        IsVisible="{Binding DrawerDevice.AcSchema, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Classes="DrCard">
                    <!-- 标题与档位条同一行：模式、风速这种一行放得下的，就和「目标温度」一样左标题右控件 -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" IsEnabled="{Binding DrawerDevice.IsOnline}">
                        <TextBlock Text="模式" FontSize="12.5" Foreground="{DynamicResource Text2Brush}"
                                   VerticalAlignment="Center" />
                        <Border Classes="SegTrack" Grid.Column="1">
                            <ItemsControl ItemsSource="{Binding DrawerDevice.AcSchema.Modes}"
                                          ItemTemplate="{StaticResource AcModeOptionTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- 列数 = 模式数：4 个模式就 4 列，右侧不留空格 -->
                                        <UniformGrid Columns="{Binding DrawerDevice.AcSchema.Modes.Count}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </Grid>
                </Border>
                <Border Classes="DrCard">
                    <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding DrawerDevice.IsOnline}">
                        <TextBlock Text="目标温度" FontSize="12.5" Foreground="{DynamicResource Text2Brush}"
                                   VerticalAlignment="Center" />
                        <!-- 温度步进器：和色温量程、场景数值同一个控件，双击数字即可手输 -->
                        <ctl:NumberStepper Grid.Column="1" VerticalAlignment="Center"
                                           Value="{Binding DrawerDevice.AcTargetTempInput, Mode=TwoWay}"
                                           Minimum="{Binding DrawerDevice.AcSchema.TempMin}"
                                           Maximum="{Binding DrawerDevice.AcSchema.TempMax}"
                                           Step="{Binding DrawerDevice.AcSchema.TempStep}"
                                           Unit="℃"
                                           ValueWidth="56" ValueFontSize="15.5"
                                           ValueFontWeight="Bold" />
                    </Grid>
                </Border>
                <Border Classes="DrCard">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" IsEnabled="{Binding DrawerDevice.IsOnline}">
                        <TextBlock Text="风速" FontSize="12.5" Foreground="{DynamicResource Text2Brush}"
                                   VerticalAlignment="Center" />
                        <Border Classes="SegTrack" Grid.Column="1">
                            <!-- 风速档位条：和桌面空调卡同一个控件，九档也只是一排柱子，不再折成两行 -->
                            <ctl:FanSpeedGauge Options="{Binding DrawerDevice.AcSchema.Fans}"
                                               Value="{Binding DrawerDevice.AcFanLevel}"
                                               SelectCommand="{Binding SetAcFanCommand}"
                                               BarBrush="{DynamicResource Surface5Brush}"
                                               BarActiveBrush="{DynamicResource Accent2Brush}" />
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Classes="Hint" Foreground="{DynamicResource Accent2Brush}"
                           Text="空调未开机：温度/风速/模式需开机后调节"
                           IsVisible="{Binding !DrawerDevice.IsOn}" />
            </StackPanel>
            <TextBlock Classes="Hint" Text="未获取到该空调的控制参数，暂无法调节"
                       IsVisible="{Binding DrawerDevice.AcSchema, Converter={x:Static ObjectConverters.IsNull}}" />
        </StackPanel>
        <!-- 风扇：风速档 + 摆风 + 模式（全部按设备规格生成，不同型号服务/piid 都不同） -->
        <StackPanel Spacing="12" IsVisible="{Binding DrawerDevice.IsFan}">
            <StackPanel Spacing="12"
                        Classes.ctl-off="{Binding !DrawerDevice.IsOnline}"
                        IsEnabled="{Binding DrawerDevice.IsOnline}"
                        IsVisible="{Binding DrawerDevice.FanSchema, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Classes="DrCard" IsVisible="{Binding DrawerDevice.FanSchema.HasLevels}">
                    <StackPanel Spacing="7" IsEnabled="{Binding DrawerDevice.IsOnline}">
                        <TextBlock Text="风速" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" />
                        <ItemsControl ItemsSource="{Binding DrawerDevice.FanSchema.Levels}"
                                      ItemTemplate="{StaticResource FanLevelOptionTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Classes="DrCard" IsVisible="{Binding DrawerDevice.FanSchema.HasLevelRange}">
                    <StackPanel Spacing="9">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="风速" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text2Brush}" />
                            <TextBlock Grid.Column="1" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Text="{Binding DrawerDevice.FanLevel}" />
                        </Grid>
                        <Slider Classes="DrSlider"
                                Minimum="{Binding DrawerDevice.FanSchema.LevelMin}"
                                Maximum="{Binding DrawerDevice.FanSchema.LevelMax}"
                                TickFrequency="{Binding DrawerDevice.FanSchema.LevelStep}"
                                Value="{Binding DrawerDevice.FanLevel, Mode=TwoWay}"
                                IsEnabled="{Binding DrawerDevice.IsOnline}" />
                    </StackPanel>
                </Border>
                <Border Classes="DrCard" IsVisible="{Binding DrawerDevice.FanSchema.HasSpeed}">
                    <StackPanel Spacing="9">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="无级调速" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text2Brush}" />
                            <TextBlock Grid.Column="1" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Text="{Binding DrawerDevice.FanSpeed}" />
                        </Grid>
                        <Slider Classes="DrSlider"
                                Minimum="{Binding DrawerDevice.FanSchema.SpeedMin}"
                                Maximum="{Binding DrawerDevice.FanSchema.SpeedMax}"
                                TickFrequency="{Binding DrawerDevice.FanSchema.SpeedStep}"
                                Value="{Binding DrawerDevice.FanSpeed, Mode=TwoWay}"
                                IsEnabled="{Binding DrawerDevice.IsOnline}" />
                    </StackPanel>
                </Border>
                <Border Classes="DrCard"
                        IsVisible="{Binding DrawerDevice.FanSchema.HasSwingH}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="左右摆风" FontSize="12.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text2Brush}" />
                        <ToggleButton Grid.Column="1" Classes="Switch" VerticalAlignment="Center"
                                      IsChecked="{Binding DrawerDevice.SwingHOn, Mode=TwoWay}"
                                      IsEnabled="{Binding DrawerDevice.IsOnline}"
                                      Command="{Binding ToggleFanSwingCommand}"
                                      CommandParameter="h" />
                    </Grid>
                </Border>
                <Border Classes="DrCard"
                        IsVisible="{Binding DrawerDevice.FanSchema.HasSwingV}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="上下摆风" FontSize="12.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text2Brush}" />
                        <ToggleButton Grid.Column="1" Classes="Switch" VerticalAlignment="Center"
                                      IsChecked="{Binding DrawerDevice.SwingVOn, Mode=TwoWay}"
                                      IsEnabled="{Binding DrawerDevice.IsOnline}"
                                      Command="{Binding ToggleFanSwingCommand}"
                                      CommandParameter="v" />
                    </Grid>
                </Border>
                <Border Classes="DrCard" IsVisible="{Binding DrawerDevice.FanSchema.HasModes}">
                    <StackPanel Spacing="7" IsEnabled="{Binding DrawerDevice.IsOnline}">
                        <TextBlock Text="模式" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" />
                        <ItemsControl ItemsSource="{Binding DrawerDevice.FanSchema.Modes}"
                                      ItemTemplate="{StaticResource FanModeOptionTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <TextBlock Classes="Hint" Foreground="{DynamicResource Accent2Brush}"
                           Text="风扇未开机：档位/摆风需开机后调节"
                           IsVisible="{Binding !DrawerDevice.IsOn}" />
            </StackPanel>
            <TextBlock Classes="Hint" Text="未获取到该风扇的控制参数，暂无法调节"
                       IsVisible="{Binding DrawerDevice.FanSchema, Converter={x:Static ObjectConverters.IsNull}}" />
        </StackPanel>
        <!-- 摄像头：米家只开放状态、不开放画面；画面由本地画面源（go2rtc）转一道，普通用户只看「打开画面」 -->
        <StackPanel Spacing="12" IsVisible="{Binding DrawerDevice.IsCamera}">
            <Border Classes="DrCard">
                <StackPanel Spacing="10">
                    <TextBlock Text="实时画面" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Classes="Hint" TextWrapping="Wrap"
                               Text="米家只把摄像头的状态开放出来，画面本身不出家门。所以要在这里看画面，需要在你家里接一道本地画面源；准备一次，之后不用再动。" />
                    <Border Classes="SegTrack">
                        <UniformGrid Columns="3">
                            <Button Classes="SegBtn" Content="打开画面" VerticalAlignment="Center"
                                    Command="{Binding OpenCameraLiveCommand}" />
                            <Button Classes="SegBtn" Content="播放器打开" VerticalAlignment="Center"
                                    ToolTip.Tip="H.265 摄像头在浏览器里可能黑屏，改用本机 mpv / VLC 打开"
                                    Command="{Binding OpenCameraWithPlayerCommand}" />
                            <Button Classes="SegBtn" Content="怎么设置" VerticalAlignment="Center"
                                    Command="{Binding ToggleCameraSetupCommand}" />
                        </UniformGrid>
                    </Border>
                    <TextBlock Classes="Hint" TextWrapping="Wrap"
                               Text="{Binding CameraBridgeHint}" />
                    <TextBlock Classes="Hint" TextWrapping="Wrap" Foreground="{DynamicResource Accent2Brush}"
                               Text="{Binding CameraSecurityHint}"
                               IsVisible="{Binding CameraSecurityHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Spacing="9" IsVisible="{Binding IsCameraSetupExpanded}">
                        <TextBlock Text="一次准备，三步" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Classes="Hint" TextWrapping="Wrap"
                                   Text="1. 在这台电脑上放一个小工具 go2rtc（单个 exe，免安装，随便找个目录）。同一个网络里有一台常开的设备也能放那儿。" />
                        <TextBlock Classes="Hint" TextWrapping="Wrap"
                                   Text="2. 启动它，打开它的页面，用小米账号登录，把摄像头接进来（它的页面会列出来，点一下就行）。" />
                        <TextBlock Classes="Hint" TextWrapping="Wrap"
                                   Text="3. 回到这里点「打开画面」。以后每次都是这一步。" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBlock Text="画面源地址" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text2Brush}" />
                            <Button Grid.Column="1" Classes="SegMini" Content="重新检测"
                                    Command="{Binding RefreshCameraBridgeCommand}" />
                        </Grid>
                        <TextBox Text="{Binding Go2rtcBase, Mode=TwoWay}"
                                 Watermark="http://127.0.0.1:1984" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="SegMini" Content="复制安全配置"
                                    Command="{Binding CopyCameraConfigCommand}" />
                            <Button Classes="SegMini" Content="复制诊断"
                                    Command="{Binding CopyCameraDiagnosticCommand}" />
                            <Button Classes="SegMini" Content="打开画面源页面"
                                    Command="{Binding OpenGo2rtcConsoleCommand}" />
                        </StackPanel>
                        <TextBlock Classes="Hint" TextWrapping="Wrap" Opacity="0.75"
                                   Text="地址默认 127.0.0.1:1984；画面源装在别的机器上时，改成那台机器的 IP 即可。控制台对整个局域网可见时，点「复制安全配置」把 api / rtsp 收回本机。" />
                        <TextBlock Classes="Hint" TextWrapping="Wrap" Opacity="0.75"
                                   Text="2K 摄像头多为 H.265，浏览器 WebRTC 可能一直黑屏；这种情况用「播放器打开」（本机装了 mpv / VLC / PotPlayer 即可）。" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        <!-- 中枢网关：网关自带的网页版自动化编辑器（米家自动化极客版）。
             端口固定 80（实时通道 8082），所以只需要网关 IP：云端带 localip 就用它，否则自动扫描 / 手填 -->
        <StackPanel Spacing="12" IsVisible="{Binding DrawerDevice.IsHub}">
            <Border Classes="DrCard">
                <StackPanel Spacing="10">
                    <TextBlock Text="自动化极客版" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Classes="Hint" TextWrapping="Wrap"
                               Text="这台网关自带一个网页版编辑器，端口是固定的 80（实时通道 8082），不用额外装东西。登录码是一次性的，只能在米家 App 里现取。" />
                    <TextBlock Classes="Hint" TextWrapping="Wrap" Text="{Binding HubGeekHint}"
                               IsVisible="{Binding HubGeekHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding HubGeekIp, Mode=TwoWay}"
                                 Watermark="网关 IP，如 192.168.31.25" />
                        <Button Grid.Column="1" Classes="SegMini" Content="自动查找"
                                Margin="8,0,0,0" Command="{Binding FindHubGatewayCommand}" />
                    </Grid>
                    <Border Classes="SegTrack">
                        <UniformGrid Columns="2">
                            <Button Classes="SegBtn" Content="打开极客版"
                                    Command="{Binding OpenHubGeekCommand}" />
                            <Button Classes="SegBtn" Content="登录码在哪看"
                                    Command="{Binding ToggleHubGeekHelpCommand}" />
                        </UniformGrid>
                    </Border>
                    <StackPanel Spacing="6" IsVisible="{Binding IsHubGeekHelpExpanded}">
                        <TextBlock Classes="Hint" TextWrapping="Wrap"
                                   Text="1. 手机打开米家 App，进这台网关的设备页 → 右上角「…」 → 中枢功能。" />
                        <TextBlock Classes="Hint" TextWrapping="Wrap"
                                   Text="2. 「自动化极客版」一栏会显示 IP 和 6 位登录码；过期了点「重新获取登录码」。这里一般已经自动填好 IP。" />
                        <TextBlock Classes="Hint" TextWrapping="Wrap"
                                   Text="3. 点「打开极客版」进浏览器，输入那 6 位码即可。同一个浏览器登录过，之后不用再输。" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        <!-- 智能场景：本设备参与的全部手动场景与自动化，默认折叠（标题行与高级设置同一套开合样式），
             展开后按类型分组，点一行进已有的场景详情弹窗 -->
        <Border Classes="DrCard">
            <StackPanel Spacing="10">
                <!-- 负边距 + 内边距：把可点区域从卡片内衬里撑出去，整张卡片（含四周留白）都能点 -->
                <Button Classes="SectionHeader" Margin="-16,-15,-16,0" Padding="16,15,16,0"
                        Command="{Binding ToggleSmartScenesCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="智能场景" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource Text3Brush}"
                                       IsVisible="{Binding HasDrawerScenes}"
                                       Text="{Binding DrawerSceneSummary}" />
                            <Path Width="9" Height="9" Stretch="Uniform"
                                  Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.6"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding !IsSmartSceneExpanded}"
                                  Data="M4,3 L8,7 L4,11" />
                            <Path Width="9" Height="9" Stretch="Uniform"
                                  Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.6"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding IsSmartSceneExpanded}"
                                  Data="M3,4 L7,8 L11,4" />
                        </StackPanel>
                    </Grid>
                </Button>
                <StackPanel Spacing="10" IsVisible="{Binding IsSmartSceneExpanded}">
                    <!-- 手动场景 -->
                    <StackPanel Spacing="6" IsVisible="{Binding HasDrawerSceneGroup}">
                        <TextBlock Text="场景" FontSize="12" FontWeight="Normal"
                                   Foreground="{DynamicResource Text3Brush}" />
                        <ItemsControl ItemsSource="{Binding DrawerScenes}"
                                      ItemTemplate="{StaticResource SceneDeviceRowTemplate}" />
                    </StackPanel>
                    <!-- 自动化 -->
                    <StackPanel Spacing="6" IsVisible="{Binding HasDrawerAutomationGroup}">
                        <TextBlock Text="自动化" FontSize="12" FontWeight="Normal"
                                   Foreground="{DynamicResource Text3Brush}" />
                        <ItemsControl ItemsSource="{Binding DrawerAutomations}"
                                      ItemTemplate="{StaticResource SceneDeviceRowTemplate}" />
                    </StackPanel>
                    <TextBlock Classes="Hint" IsVisible="{Binding !HasDrawerScenes}"
                               Text="此设备还没有关联的场景或自动化" />
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- 高级设置：常用控制卡之外的规格属性与低频动作，默认折叠，点击展开 -->
        <Border Classes="DrCard" IsVisible="{Binding HasAdvanced}">
            <StackPanel Spacing="8">
                <Button Classes="SectionHeader" Margin="-16,-15,-16,0" Padding="16,15,16,0"
                        Command="{Binding ToggleAdvancedCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="高级设置" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        <Path Grid.Column="2" Width="9" Height="9" Stretch="Uniform" Margin="8,0,0,0"
                              Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.6"
                              VerticalAlignment="Center"
                              IsVisible="{Binding !IsAdvancedExpanded}"
                              Data="M4,3 L8,7 L4,11" />
                        <Path Grid.Column="2" Width="9" Height="9" Stretch="Uniform" Margin="8,0,0,0"
                              Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.6"
                              VerticalAlignment="Center"
                              IsVisible="{Binding IsAdvancedExpanded}"
                              Data="M3,4 L7,8 L11,4" />
                    </Grid>
                </Button>
                <StackPanel Spacing="16" IsVisible="{Binding IsAdvancedExpanded}"
                            Classes.ctl-off="{Binding !DrawerDevice.IsOnline}"
                            IsEnabled="{Binding DrawerDevice.IsOnline}">
                    <!-- 分组卡之间留 12 的间隔：卡本身不描边，边界只靠色阶 + 留白 -->
                    <ItemsControl ItemsSource="{Binding DrawerSpecAdvancedGroups}"
                                  ItemTemplate="{StaticResource SpecGroupTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <!-- 属性区与动作区之间只画一条淡分割线；只有两段都有内容时才出现 -->
                    <Border Height="1" Background="{DynamicResource LineBrush}" Opacity="0.5"
                            Margin="2,0" IsVisible="{Binding HasAdvancedDivider}" />
                    <ItemsControl ItemsSource="{Binding DrawerSpecAdvancedActions}"
                                  ItemTemplate="{StaticResource SpecActionTemplate}"
                                  IsVisible="{Binding HasAdvancedActions}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock Classes="Hint" Text="这类设备没有开关指令，仅列出状态"
                   IsVisible="{Binding DrawerDevice, Converter={x:Static conv:DeviceReadOnlyConverter.Instance}}" />
        <!-- 设备信息 -->
        <Border Classes="DrCard">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="房间" Foreground="{DynamicResource Text2Brush}" FontSize="13" />
                    <TextBlock Grid.Column="1" Text="{Binding DrawerDevice.RoomName}" FontSize="13"
                               FontWeight="Normal" Foreground="{DynamicResource Text2Brush}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="连接" Foreground="{DynamicResource Text2Brush}" FontSize="13" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="StatusDot"
                                 Classes.is-on="{Binding DrawerDevice.IsOnline}"
                                 Classes.is-warn="{Binding !DrawerDevice.IsOnline}" />
                        <TextBlock FontSize="13" FontWeight="Normal"
                                   Foreground="{DynamicResource Text2Brush}"
                                   VerticalAlignment="Center"
                                   Text="{Binding DrawerDevice.IsOnline, Converter={x:Static conv:BoolTextConverter.Instance}, ConverterParameter='在线|离线'}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="型号" Foreground="{DynamicResource Text2Brush}" FontSize="13" />
                    <TextBlock Grid.Column="1" Text="{Binding DrawerDevice.Model}" FontSize="13"
                               FontWeight="Normal" MaxWidth="180" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding DrawerDevice.Model}"
                               Foreground="{DynamicResource Text2Brush}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="设备 ID" Foreground="{DynamicResource Text2Brush}" FontSize="13" />
                    <TextBlock Grid.Column="1" Text="{Binding DrawerDevice.Did}" FontSize="11.5"
                               MaxWidth="180" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding DrawerDevice.Did}"
                               Foreground="{DynamicResource Text3Brush}" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
