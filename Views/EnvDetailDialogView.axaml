<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:MiHomeHub.Models"
             xmlns:vm="clr-namespace:MiHomeHub.ViewModels"
             xmlns:ctl="clr-namespace:MiHomeHub.Controls"
             x:Class="MiHomeHub.Views.EnvDetailDialogView"
             x:DataType="vm:MainViewModel">
    <ctl:DialogPopup CardWidth="470" CardMaxHeight="660"
                     Title="环境概览" Subtitle="{Binding EnvSourceText}"
                     IsOpen="{Binding IsEnvDetailOpen}"
                     CloseCommand="{Binding CloseEnvDetailCommand}">
        <StackPanel Spacing="14">
            <!-- 温湿度大读数：一眼看到全屋聚合值，数值大、单位小 -->
            <Grid ColumnDefinitions="*,*">
                <Border Classes="EnvTile warm">
                    <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                     Fill="{DynamicResource AmberBrush}" />
                            <TextBlock Classes="EnvTileLab warm" Text="室内温度" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                            <TextBlock Classes="EnvTileVal warm" Text="{Binding EnvTemperatureValue}" />
                            <TextBlock Classes="EnvTileUnit" Text="{Binding EnvTemperatureUnit}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="EnvTile cool" Margin="10,0,0,0">
                    <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                     Fill="{DynamicResource BlueBrush}" />
                            <TextBlock Classes="EnvTileLab cool" Text="室内湿度" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                            <TextBlock Classes="EnvTileVal cool" Text="{Binding EnvHumidityValue}" />
                            <TextBlock Classes="EnvTileUnit" Text="{Binding EnvHumidityUnit}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- 逐设备读数：设备名 + 房间小标签，右侧温度为主、湿度为辅 -->
            <Border Classes="DrCard">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="各设备读数" FontSize="13" FontWeight="Normal"
                                   Foreground="{DynamicResource Text2Brush}" />
                        <TextBlock Grid.Column="1" Classes="Hint" VerticalAlignment="Center"
                                   Text="{Binding EnvReadingsCountText}"
                                   IsVisible="{Binding HasEnvironment}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding EnvReadings}" IsVisible="{Binding HasEnvironment}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:EnvReadingItem">
                                <Grid ColumnDefinitions="*,Auto" MinHeight="34" Margin="0,0,0,5">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                   Foreground="{DynamicResource Text2Brush}" />
                                        <Border Classes="RoomTag">
                                            <TextBlock Classes="RoomTagTx" Text="{Binding Subtitle}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Value}" FontSize="13.5" FontWeight="Normal"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{Binding Extra}" FontSize="11.5"
                                                   Foreground="{DynamicResource Text3Brush}"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                   IsVisible="{Binding Extra, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="Hint" Text="暂无温湿度数据，设备上报后会自动出现在这里"
                               IsVisible="{Binding !HasEnvironment}" />
                </StackPanel>
            </Border>
            <!-- 耗材余量：带进度条，低于 20% 转琥珀色 -->
            <Border Classes="DrCard" IsVisible="{Binding HasConsumables}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="耗材余量" FontSize="13" FontWeight="Normal"
                                   Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Classes="EnvStatusTag"
                                Classes.is-warn="{Binding HasConsumableWarning}">
                            <TextBlock Classes="EnvStatusTx"
                                       Classes.is-warn="{Binding HasConsumableWarning}"
                                       Text="{Binding ConsumableStatusText}" />
                        </Border>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ConsumableItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:ConsumableItem">
                                <Grid ColumnDefinitions="*,Auto,46" MinHeight="36" Margin="0,0,0,3">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                                ClipToBounds="True">
                                        <TextBlock Text="{Binding DeviceName}" FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text2Brush}" />
                                        <Border Classes="RoomTag" VerticalAlignment="Center">
                                            <TextBlock Classes="RoomTagTx" Text="{Binding Desc}" />
                                        </Border>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="92" Height="6" Margin="10,0,12,0"
                                            VerticalAlignment="Center" CornerRadius="3"
                                            Background="{DynamicResource SurfaceBrush}">
                                        <Border Classes="EnvBarFill" Classes.is-low="{Binding IsLow}"
                                                Width="{Binding BarWidth}" Height="6" CornerRadius="3"
                                                HorizontalAlignment="Left" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Classes="ConsumeValSoft"
                                               Classes.is-low="{Binding IsLow}"
                                               Text="{Binding ValueText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ctl:DialogPopup>
</UserControl>
