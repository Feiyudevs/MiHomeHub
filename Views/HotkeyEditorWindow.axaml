<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MiHomeHub.ViewModels"
        x:Class="MiHomeHub.Views.HotkeyEditorWindow"
        x:DataType="vm:MainViewModel"
        Title="快捷键"
        Width="780" Height="648"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        RenderOptions.TextRenderingMode="Antialias">

    <Window.Styles>
        <!-- 分区卡：把「执行步骤」和「组合键」各自收进一块，内容铺满弹窗宽度 -->
        <Style Selector="Border.Section">
            <Setter Property="Background" Value="{DynamicResource CardSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,13"/>
        </Style>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 控制卡片：一行一张，顺序即执行顺序；拖左侧手柄调整顺序 -->
        <Style Selector="Border.StepCard">
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="Border.StepCard.dragging">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Border.StepCard Border.DropTip">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Height" Value="2.5"/>
            <Setter Property="CornerRadius" Value="1.25"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource Accent2Brush}"/>
            <Setter Property="ZIndex" Value="20"/>
        </Style>
        <Style Selector="Border.StepCard Border.DropTip.top">
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="Border.StepCard Border.DropTip.bottom">
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style Selector="Border.StepCard.dropbefore Border.DropTip.top">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="Border.StepCard.dropafter Border.DropTip.bottom">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="Border.StepIcBox">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Path.StepIc">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Path.StepIc.device">
            <Setter Property="Data" Value="{StaticResource GeoPower}"/>
        </Style>
        <Style Selector="Path.StepIc.scene">
            <Setter Property="Data" Value="{StaticResource GeoScene}"/>
        </Style>
        <Style Selector="Path.StepIc.automation">
            <Setter Property="Data" Value="{StaticResource GeoGear}"/>
        </Style>

        <!-- 动作切换组：沿用设置页顶部 Tab 的「底槽 + 选中滑块」外观，做成紧凑版分段切换 -->
        <Style Selector="Border.SegGroup">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.SegTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}">
                        <Panel>
                            <Border Name="Hov" CornerRadius="7" Opacity="0"
                                    Background="{DynamicResource HoverBrush}"/>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.SegTab:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <!-- 选中段整块换成主色底：底色与悬停覆盖层都走淡变，切换时不硬切 -->
        <Style Selector="Button.SegTab /template/ Border#Bd">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.SegTab /template/ Border#Hov">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.SegTab:pointerover /template/ Border#Hov">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.SegTab.on">
            <Setter Property="Background" Value="{DynamicResource PrimaryBtnBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.SegTab.on:pointerover /template/ Border#Hov">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Button.SegTab.on:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- 卡片右侧小方形按钮：上移 / 下移 / 删除 -->
        <Style Selector="Button.StepBtn">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource PlayHoverFromBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.StepBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.StepBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>

        <!-- 空态框 -->
        <Style Selector="Border.StepEmpty">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,11"/>
        </Style>

        <!-- 组合键显示框：只显示当前键，不再拉成整行按钮 -->
        <Style Selector="Border.KeyBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
        <Style Selector="Border.KeyBox.rec">
            <Setter Property="Background" Value="{DynamicResource GreenSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GreenBrush}"/>
        </Style>
        <Style Selector="TextBlock.KeyText">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.KeyBox.rec TextBlock.KeyText">
            <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
        </Style>
        <Style Selector="Path.KeyIc">
            <Setter Property="StrokeThickness" Value="2.2"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{DynamicResource Text3Brush}"/>
        </Style>
        <Style Selector="Border.KeyBox.rec Path.KeyIc">
            <Setter Property="Stroke" Value="{DynamicResource GreenBrush}"/>
        </Style>

        <!-- 录制按钮：紧凑尺寸，录制中整块转绿 -->
        <Style Selector="Button.RecBtn">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.RecBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Button.RecBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
        </Style>
        <Style Selector="Button.RecBtn.rec">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.RecBtn.rec /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource GreenBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GreenBrush}"/>
        </Style>
        <Style Selector="Button.RecBtn.rec:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource GreenBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GreenBrush}"/>
        </Style>

        <Style Selector="TextBlock.Muted">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.Danger">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>
    </Window.Styles>

    <Panel>
        <!-- 遮罩：压暗背后的页面，点一下等于取消 -->
        <Border Name="Mask" Background="#33000000" PointerPressed="OnMaskPressed"/>

        <Border Classes="DialogCard" Width="664" Height="532"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid RowDefinitions="Auto,*,Auto" ClipToBounds="True">

                <!-- ===== 标题 ===== -->
                <Panel Grid.Row="0" Background="Transparent" Margin="28,20,22,0">
                    <StackPanel>
                        <TextBlock Text="{Binding HotkeyEditorTitle}" FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Margin="0,5,0,0"
                                   Text="控制卡片按列表从上到下依次执行"
                                   FontSize="12" Foreground="{DynamicResource Text2Brush}"/>
                    </StackPanel>
                    <Button Classes="ThemeBtn" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Command="{Binding CancelHotkeyEditorCommand}" ToolTip.Tip="关闭">
                        <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="0.8"
                              StrokeLineCap="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="{StaticResource GeoClose}"/>
                    </Button>
                </Panel>

                <!-- ===== 正文 ===== -->
                <ScrollViewer Grid.Row="1" Margin="28,14,6,8"
                              ClipToBounds="True"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,16,4" Spacing="12">

                        <!-- 标题输入：放在标题栏下方、分区卡上方 -->
                        <StackPanel Spacing="5">
                            <TextBlock Text="标题" FontSize="12" FontWeight="Normal"
                                       Foreground="{DynamicResource Text2Brush}"/>
                            <TextBox Text="{Binding HotkeyDraftTitle, Mode=TwoWay}"
                                     Height="38" MaxLength="40"
                                     Watermark="给这组快捷键起个名字"
                                     ToolTip.Tip="默认用第一个加入的设备名；可改成更易认的称呼"/>
                        </StackPanel>

                        <!-- 分区一：执行步骤 -->
                        <Border Classes="Section">
                            <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="SectionTitle" Text="执行步骤"/>
                                        <Border Classes="MiniTag" VerticalAlignment="Center"
                                                IsVisible="{Binding HasHotkeyDraftSteps}">
                                            <TextBlock Text="{Binding HotkeyDraftStepCountText}" FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Accent2Brush}"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Classes="BtnGhost" Height="30" Padding="11,0"
                                                Click="OnPickTargetsClick"
                                                ToolTip.Tip="打开设备 / 场景选择弹窗，可多选，按勾选顺序加入">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Width="11" Height="11" Stretch="Uniform"
                                                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                                                      Stroke="{DynamicResource Accent2Brush}"
                                                      Data="{StaticResource GeoPlus}"/>
                                                <TextBlock Text="选择目标" FontSize="12" FontWeight="Normal"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="IconBtn" Width="28" Height="28"
                                                IsVisible="{Binding HasHotkeyDraftSteps}"
                                                Command="{Binding ClearHotkeyDraftStepsCommand}"
                                                ToolTip.Tip="清空全部卡片">
                                            <Path Width="9" Height="9" Stretch="Uniform" StrokeThickness="1.2"
                                                  StrokeLineCap="Round"
                                                  Stroke="{DynamicResource Text2Brush}"
                                                  Data="{StaticResource GeoClose}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="设备、场景可混着加，逐张选动作"
                                           Classes="Muted"/>

                                <ItemsControl ItemsSource="{Binding HotkeyDraftSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HotkeyDraftStepVm">
                                            <Border Classes="StepCard" Classes.dragging="{Binding IsDragging}"
                                                    DragDrop.AllowDrop="True"
                                                    DragDrop.DragOver="OnStepDragOver"
                                                    DragDrop.DragLeave="OnStepDragLeave"
                                                    DragDrop.Drop="OnStepDrop"
                                                    PointerMoved="OnStepPointerMoved">
                                                <Panel>
                                                    <Border Classes="DropTip top"/>
                                                    <Border Classes="DropTip bottom"/>
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="12,8,10,8">
                                                        <!-- 拖拽手柄：2×3 点阵，与创建自动化弹窗一致 -->
                                                        <Border Width="18" Background="Transparent" Cursor="SizeAll"
                                                                PointerPressed="OnStepGripPressed"
                                                                ToolTip.Tip="按住拖动，调整执行顺序">
                                                            <StackPanel Orientation="Horizontal" Spacing="3"
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <StackPanel Spacing="3">
                                                                    <Ellipse Width="2.4" Height="2.4" Fill="{DynamicResource Text3Brush}" Opacity="0.55"/>
                                                                    <Ellipse Width="2.4" Height="2.4" Fill="{DynamicResource Text3Brush}" Opacity="0.55"/>
                                                                    <Ellipse Width="2.4" Height="2.4" Fill="{DynamicResource Text3Brush}" Opacity="0.55"/>
                                                                </StackPanel>
                                                                <StackPanel Spacing="3">
                                                                    <Ellipse Width="2.4" Height="2.4" Fill="{DynamicResource Text3Brush}" Opacity="0.55"/>
                                                                    <Ellipse Width="2.4" Height="2.4" Fill="{DynamicResource Text3Brush}" Opacity="0.55"/>
                                                                    <Ellipse Width="2.4" Height="2.4" Fill="{DynamicResource Text3Brush}" Opacity="0.55"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- 真机产品图紧贴名称左侧；取不到时退回类型线性图标 -->
                                                        <Border Grid.Column="1" Classes="StepIcBox" Margin="6,0,0,0"
                                                                Padding="0">
                                                            <Panel>
                                                                <Path Classes="StepIc"
                                                                      Width="20" Height="20"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      IsVisible="{Binding !HasDeviceIcon}"
                                                                      Classes.device="{Binding IsDevice}"
                                                                      Classes.scene="{Binding IsScene}"
                                                                      Classes.automation="{Binding IsAutomation}"/>
                                                                <Image Width="34" Height="34" Stretch="Uniform"
                                                                       Source="{Binding DeviceIcon}"
                                                                       IsVisible="{Binding HasDeviceIcon}"
                                                                       RenderOptions.BitmapInterpolationMode="MediumQuality"/>
                                                            </Panel>
                                                        </Border>

                                                        <StackPanel Grid.Column="2" Margin="10,0" Spacing="2"
                                                                    VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                           FontWeight="Normal" MaxWidth="180"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextBrush}"/>
                                                                <Border Classes="MiniTag" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding TypeText}" FontSize="9.5"
                                                                               FontWeight="Normal"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource Text3Brush}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource Text3Brush}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                                                    VerticalAlignment="Center">
                                                            <Border Classes="SegGroup" Margin="0,0,4,0">
                                                                <ItemsControl ItemsSource="{Binding Actions}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:HotkeyActionOptionVm">
                                                                            <Button Classes="SegTab"
                                                                                    Classes.on="{Binding IsSelected}"
                                                                                    Content="{Binding Label}"
                                                                                    Command="{Binding Owner.ChooseCommand}"
                                                                                    CommandParameter="{Binding}"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>

                                                            <Button Classes="StepBtn" Command="{Binding RemoveCommand}"
                                                                    ToolTip.Tip="移除这张卡片">
                                                                <Path Width="8" Height="8" Stretch="Uniform"
                                                                      StrokeThickness="1.3" StrokeLineCap="Round"
                                                                      Stroke="{DynamicResource Text3Brush}"
                                                                      Data="{StaticResource GeoClose}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Panel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Classes="StepEmpty" IsVisible="{Binding !HasHotkeyDraftSteps}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="还没有控制卡片" FontSize="12.5" FontWeight="Normal"
                                                   Foreground="{DynamicResource Text2Brush}"/>
                                        <TextBlock Text="点「选择目标」勾选设备 / 场景 / 自动化，再逐张选动作"
                                                   Classes="Muted"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding HotkeyDraftStepMeta}"
                                           IsVisible="{Binding HasHotkeyDraftSteps}"
                                           Classes="Muted"/>
                            </StackPanel>
                        </Border>

                        <!-- 分区二：组合键（左标题说明 / 右录制区，录制区贴右） -->
                        <Border Classes="Section">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Classes="KeyBox" Width="206" Classes.rec="{Binding IsRecordingHotkey}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <!-- 与页头徽章共用 GeoKeyboard，按 24 网格缩到 14px 由 Viewbox 居中 -->
                                            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                                <Panel Width="24" Height="24">
                                                    <Path Classes="KeyIc" Data="{StaticResource GeoKeyboard}"/>
                                                </Panel>
                                            </Viewbox>
                                            <TextBlock Grid.Column="1" Margin="9,0,0,0" Classes="KeyText"
                                                       Text="{Binding HotkeyDraftKeyText}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>

                                    <Panel Width="92" Height="42">
                                        <Button Classes="RecBtn" Content="录制"
                                                Command="{Binding BeginRecordHotkeyCommand}"
                                                IsVisible="{Binding !IsRecordingHotkey}"
                                                ToolTip.Tip="点一下后直接按组合键；修饰键 + 任意键，或单按 F1–F24"/>
                                        <Button Classes="RecBtn rec" Content="取消录制"
                                                Command="{Binding CancelRecordHotkeyCommand}"
                                                IsVisible="{Binding IsRecordingHotkey}"
                                                ToolTip.Tip="按 Esc 也能取消录制"/>
                                    </Panel>
                                </StackPanel>

                                <StackPanel Spacing="5" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Classes="SectionTitle" Text="组合键"/>
                                    <TextBlock Text="点录制后按下组合键，Esc 取消"
                                               Classes="Muted"/>
                                    <TextBlock Text="{Binding HotkeyModifierHintText}"
                                               Classes="Muted"/>
                                    <TextBlock Text="当前没有可绑定的目标：先确认当前家庭有可控设备，或在「智能」页新建场景"
                                               IsVisible="{Binding HasNoHotkeyTarget}"
                                               Classes="Muted"/>
                                    <TextBlock Text="{Binding HotkeyHint}" IsVisible="{Binding HasHotkeyHint}"
                                               Classes="Muted"
                                               Classes.Danger="{Binding HotkeyHintIsError}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== 底部 ===== -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                        Padding="0,12,16,0" Margin="28,0,22,18">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="保存后立即生效，窗口收进托盘也仍然可用"
                                   FontSize="11.5" Foreground="{DynamicResource Text3Brush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Classes="BtnGhost" Content="取消" Margin="0,0,8,0"
                                Command="{Binding CancelHotkeyEditorCommand}"/>
                        <Button Grid.Column="2" Classes="BtnPrimary" Content="保存绑定"
                                Command="{Binding SaveHotkeyCommand}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Panel>
</Window>
