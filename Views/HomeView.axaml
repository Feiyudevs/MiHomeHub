<UserControl 
    xmlns="https://github.com/avaloniaui"
             
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             
    xmlns:m="clr-namespace:MiHomeHub.Models"
             
    xmlns:vm="clr-namespace:MiHomeHub.ViewModels"
             
    xmlns:ctl="clr-namespace:MiHomeHub.Controls"
             
    xmlns:views="clr-namespace:MiHomeHub.Views"
             x:Class="MiHomeHub.Views.HomeView">
    <UserControl.Styles>
        <!-- 趋势卡右上角的数据来源下拉平时不露面：卡片悬停才淡进来，静止时那一角是空的，
             不跟「较昨日」抢位置。透明度不参与布局，浮出/退场不会让标题行重排 -->
        <Style Selector="Border.TrendCard ctl|OptionPicker.TrendPick">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.TrendCard:pointerover ctl|OptionPicker.TrendPick, ctl|OptionPicker.TrendPick.open">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <!-- 三张趋势卡抽成模板：常规状态排进宫格，只剩一张时同一份模板也能挪到与快捷场景并排的位置 -->
        <DataTemplate x:Key="TrendTempCardTemplate" x:DataType="vm:MainViewModel">
            <Border Classes="TrendCard">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                            <Panel Width="24" Height="24">
                                <Path Classes="StatIc" Stroke="{DynamicResource TrendTempBrush}"
                                      Data="{StaticResource GeoThermo}" />
                            </Panel>
                        </Viewbox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                    Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Classes="TrendLab" Text="温度" />
                            <Border Classes="TrendChip" IsVisible="{Binding HasTempDelta}">
                                <TextBlock Text="{Binding TempTrendDelta}" FontSize="10"
                                           Foreground="{DynamicResource Text3Brush}" />
                            </Border>
                        </StackPanel>
                        <!-- 卡片右上角的数据来源：悬停才浮出来，点一下展开（共用项目里的 OptionPicker） -->
                        <ctl:OptionPicker Grid.Column="2" Classes="TrendPick" Compact="True" Pill="True"
                                          MaxWidth="104" VerticalAlignment="Center"
                                          IsVisible="{Binding CanPickTempSource}"
                                          Options="{Binding TempSources}"
                                          SelectedValue="{Binding SelectedTempSource, Mode=TwoWay}"
                                          ToolTip.Tip="选择这张卡读哪台设备的数据" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" Margin="0,6,0,0">
                        <TextBlock Classes="TrendValue" Text="{Binding TempTrendValue}"
                                   Foreground="{DynamicResource TrendTempBrush}" />
                        <TextBlock Grid.Column="1" Classes="TrendUnit" Text="℃" />
                        <!-- 右侧两行小字：上一句舒适度，下一句全天高低；卡片最底下整块留给曲线 -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Spacing="2" Margin="0,0,0,5">
                            <TextBlock Classes="TrendNote" Text="{Binding TempTrendNote}" Margin="0" />
                            <TextBlock Classes="TrendFoot" Text="{Binding TempTrendRange}"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                    <Panel Grid.Row="2" Height="56" Margin="0,8,0,0">
                        <ctl:TrendChart Values="{Binding TempTrendSeries}"
                                        Stroke="{DynamicResource TrendTempBrush}"
                                        Fill="{DynamicResource TrendTempFill}"
                                        GridBrush="{DynamicResource LineBrush}"
                                        UnitText="℃"
                                        TipBackground="{DynamicResource CardBrush}"
                                        TipForeground="{DynamicResource TextBrush}"
                                        IsVisible="{Binding ShowTempChart}" />
                        <TextBlock Classes="TrendStub" Text="{Binding TempTrendPlaceholder}"
                                   IsVisible="{Binding !ShowTempChart}" />
                    </Panel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TrendHumCardTemplate" x:DataType="vm:MainViewModel">
            <Border Classes="TrendCard">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                            <Panel Width="24" Height="24">
                                <Path Classes="StatIc" Stroke="{DynamicResource TrendHumBrush}"
                                      Data="{StaticResource GeoDrop}" />
                            </Panel>
                        </Viewbox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                    Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Classes="TrendLab" Text="湿度" />
                            <Border Classes="TrendChip" IsVisible="{Binding HasHumDelta}">
                                <TextBlock Text="{Binding HumTrendDelta}" FontSize="10"
                                           Foreground="{DynamicResource Text3Brush}" />
                            </Border>
                        </StackPanel>
                        <ctl:OptionPicker Grid.Column="2" Classes="TrendPick" Compact="True" Pill="True"
                                          MaxWidth="104" VerticalAlignment="Center"
                                          IsVisible="{Binding CanPickHumSource}"
                                          Options="{Binding HumSources}"
                                          SelectedValue="{Binding SelectedHumSource, Mode=TwoWay}"
                                          ToolTip.Tip="选择这张卡读哪台设备的数据" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" Margin="0,6,0,0">
                        <TextBlock Classes="TrendValue" Text="{Binding HumTrendValue}"
                                   Foreground="{DynamicResource TrendHumBrush}" />
                        <TextBlock Grid.Column="1" Classes="TrendUnit" Text="%" />
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Spacing="2" Margin="0,0,0,5">
                            <TextBlock Classes="TrendNote" Text="{Binding HumTrendNote}" Margin="0" />
                            <TextBlock Classes="TrendFoot" Text="{Binding HumTrendRange}"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                    <Panel Grid.Row="2" Height="56" Margin="0,8,0,0">
                        <ctl:TrendChart Values="{Binding HumTrendSeries}"
                                        Stroke="{DynamicResource TrendHumBrush}"
                                        Fill="{DynamicResource TrendHumFill}"
                                        GridBrush="{DynamicResource LineBrush}"
                                        UnitText="%"
                                        TipBackground="{DynamicResource CardBrush}"
                                        TipForeground="{DynamicResource TextBrush}"
                                        IsVisible="{Binding ShowHumChart}" />
                        <TextBlock Classes="TrendStub" Text="{Binding HumTrendPlaceholder}"
                                   IsVisible="{Binding !ShowHumChart}" />
                    </Panel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TrendPowerCardTemplate" x:DataType="vm:MainViewModel">
            <Border Classes="TrendCard">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                            <Panel Width="24" Height="24">
                                <Path Classes="StatIc" Stroke="{DynamicResource TrendPowerBrush}"
                                      Data="{StaticResource GeoBolt}" />
                            </Panel>
                        </Viewbox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                    Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Classes="TrendLab" Text="{Binding PowerTitle}" />
                            <Border Classes="TrendChip" IsVisible="{Binding HasPowerDelta}">
                                <TextBlock Text="{Binding PowerTrendDelta}" FontSize="10"
                                           Foreground="{DynamicResource Text3Brush}" />
                            </Border>
                        </StackPanel>
                        <!-- 先选看几天，再选看哪台：范围放在来源下拉左边 -->
                        <ctl:OptionPicker Grid.Column="2" Classes="TrendPick" Compact="True" Pill="True"
                                          MaxWidth="72" Margin="0,0,6,0" VerticalAlignment="Center"
                                          IsVisible="{Binding HasMetering}"
                                          Options="{Binding PowerRangeOptions}"
                                          SelectedValue="{Binding SelectedPowerRange, Mode=TwoWay}"
                                          ToolTip.Tip="看今天的逐小时，或最近几天每天用了几度" />
                        <!-- 用电与众不同的一项：列表末尾的「全部设备（叠加）」把全屋各表加在一起 -->
                        <ctl:OptionPicker Grid.Column="3" Classes="TrendPick" Compact="True" Pill="True"
                                          MaxWidth="104" VerticalAlignment="Center"
                                          IsVisible="{Binding CanPickPowerSource}"
                                          Options="{Binding PowerSources}"
                                          SelectedValue="{Binding SelectedPowerSource, Mode=TwoWay}"
                                          ToolTip.Tip="选哪台计量设备，或看全部设备的叠加" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" Margin="0,6,0,0">
                        <TextBlock Classes="TrendValue" Text="{Binding PowerTrendValue}"
                                   Foreground="{DynamicResource TrendPowerBrush}" />
                        <TextBlock Grid.Column="1" Classes="TrendUnit" Text="kWh（度）" />
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Spacing="2" Margin="0,0,0,5">
                            <TextBlock Classes="TrendNote" Text="{Binding PowerTrendNow}" Margin="0" />
                            <TextBlock Classes="TrendFoot" Text="{Binding PowerTrendRange}"
                                       HorizontalAlignment="Right"
                                       IsVisible="{Binding ShowPowerChart}" />
                        </StackPanel>
                    </Grid>
                    <Panel Grid.Row="2" Height="56" Margin="0,8,0,0">
                        <ctl:TrendChart Values="{Binding PowerTrendSeries}" IsBars="True"
                                        IsDailyBars="{Binding PowerIsDailyBars}"
                                        HighlightIndex="{Binding PowerTrendFocus}"
                                        Stroke="{DynamicResource TrendPowerBrush}"
                                        Fill="{DynamicResource TrendPowerFill}"
                                        GridBrush="{DynamicResource LineBrush}"
                                        UnitText="{Binding PowerChartUnit}"
                                        TipBackground="{DynamicResource CardBrush}"
                                        TipForeground="{DynamicResource TextBrush}"
                                        IsVisible="{Binding ShowPowerChart}" />
                        <TextBlock Classes="TrendStub" Text="{Binding PowerTrendPlaceholder}"
                                   IsVisible="{Binding !ShowPowerChart}" />
                    </Panel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <!-- 右 16 内距 + 底 20 内距：右侧是给页面滚动条让出的空白（Carousel 右外距 6 + 16 = 原 22，正文宽度不变），
         底部留白只在滚到末尾时露出来，静止时不占版面 -->
    <StackPanel x:DataType="vm:MainViewModel" Margin="0,0,16,20">
        <!-- Hero：透明底；左侧问候+概览按钮，右侧统计卡+环境概览。
             左列 Auto、右列 *：统计卡整行占宽更大，反过来写会把问候语挤到裁字，右侧也就没有换行的余量。
             底边只留 16：下面紧接「环境与能耗」，两段之间的空白不再叠两次 -->
        <Grid ColumnDefinitions="Auto,*" Margin="28,26,28,16">
            <StackPanel VerticalAlignment="Top" Spacing="0">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <TextBlock Text="{Binding Greet}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="，" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="欢迎回家" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource WarmTextBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                    <TextBlock Text="{Binding ClockText}" FontSize="13"
                                   Foreground="{DynamicResource Text2Brush}" />
                    <Border Width="1" Height="12" Background="{DynamicResource LineBrush}"
                                VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DateText}" FontSize="13"
                                   Foreground="{DynamicResource Text2Brush}" />
                    <Border Width="1" Height="12" Background="{DynamicResource LineBrush}"
                                VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" FontSize="13"
                                   Foreground="{DynamicResource Text3Brush}" />
                </StackPanel>
                <!-- 概览按钮区：全部场景 / 全部设备 / 刷新，移到时间日期行下方，左对齐 -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <Button Classes="BtnGhost" Content="全部场景" Click="OnGotoScenes" />
                    <Button Classes="BtnGhost" Content="全部设备" Click="OnGotoRooms" />
                    <Button Classes="BtnGhost" Width="36" Padding="0"
                        Command="{Binding LoadDevicesCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        ToolTip.Tip="拉取最新状态">
                        <Panel>
                            <Path Classes="RefreshIc" Width="13" Height="13" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.4"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Data="{StaticResource GeoRefresh}"
                              IsVisible="{Binding !IsLoading}" />
                            <Path Classes="Spinner" Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.6"
                              StrokeLineCap="Round"
                              Data="{StaticResource GeoSpinner}"
                              Classes.run="{Binding IsLoading}"
                              IsVisible="{Binding IsLoading}" />
                        </Panel>
                    </Button>
                </StackPanel>
            </StackPanel>
            <!-- 统计：卡片色底 + 轻投影；与左侧问候顶部对齐；按钮区已移至左侧时间行下方 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="16,0,0,0" Spacing="12">
                <!-- 环境读数未到货且仍在首拉：先铺同尺寸胶囊占位，读数到了整行换真胶囊 -->
                <ItemsControl ItemsSource="{Binding EnvSkeletonSlots}"
                          ItemTemplate="{StaticResource EnvPillSkeletonTemplate}"
                          IsVisible="{Binding ShowEnvSkeleton}" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <!-- 环境概览：温湿度聚合 + 耗材提醒，三枚胶囊都可点开明细；统计卡下方，底部右对齐 -->
                <WrapPanel Margin="0,0,0,0" IsVisible="{Binding ShowEnvOverview}" HorizontalAlignment="Right">
                    <Button Classes="EnvPill PillTemp" Margin="0,0,8,6" ToolTip.Tip="点击查看明细"
                        Command="{Binding OpenEnvDetailCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="EnvLab LabTemp" Text="温度" />
                            <TextBlock Classes="EnvVal ValTemp" Text="{Binding EnvTemperatureText}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="EnvPill PillHum" Margin="0,0,8,6" ToolTip.Tip="点击查看明细"
                        Command="{Binding OpenEnvDetailCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="EnvLab LabHum" Text="湿度" />
                            <TextBlock Classes="EnvVal ValHum" Text="{Binding EnvHumidityText}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="EnvPill PillCons" Margin="0,0,0,6" ToolTip.Tip="点击查看明细"
                        Classes.is-warn="{Binding HasConsumableWarning}"
                        Command="{Binding OpenEnvDetailCommand}">
                        <TextBlock Classes="EnvVal ValCons" Classes.is-warn="{Binding HasConsumableWarning}"
                               Text="{Binding ConsumablePillText}" />
                    </Button>
                </WrapPanel>
                <!-- 首拉期间统计数字还是 0，先铺四张同尺寸骨架卡，设备一到整行换真卡 -->
                <ItemsControl ItemsSource="{Binding StatSkeletonSlots}"
                          ItemTemplate="{StaticResource StatSkeletonTemplate}"
                          IsVisible="{Binding ShowSkeleton}" HorizontalAlignment="Right"
                          Margin="0,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <WrapPanel HorizontalAlignment="Right" Margin="0,0,0,0"
                           IsVisible="{Binding !ShowSkeleton}">
                    <!-- 五张统计卡都可点：在线→离线设备弹窗、总设备→设备页、灯光/窗帘/空调→对应全屋弹窗。
                         卡片图标套 Viewbox 按 24 网格缩放：Path 单用 Stretch 会贴框左上角，还把描边一起放大。
                         用 WrapPanel + 负外边距：窗口窄时整行折成两排，右边缘仍对齐（-10 抵掉末项的 10 右边距）。 -->
                    <Button Classes="StatCard" Margin="0,0,10,10" Command="{Binding OpenOfflineListCommand}"
                            ToolTip.Tip="点击查看离线设备">
                        <Panel>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="StatIc">
                                        <Panel Width="24" Height="24">
                                            <Path Classes="StatIc" Stroke="{DynamicResource StatGreenBrush}"
                                                  Data="{StaticResource GeoWifi}" />
                                        </Panel>
                                    </Viewbox>
                                    <TextBlock Text="在线设备" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text3Brush}" />
                                </StackPanel>
                                <Grid ColumnDefinitions="Auto,*">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding OnlineCount}" FontSize="21" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource StatGreenBrush}" />
                                        <TextBlock Text="{Binding TotalText}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Bottom"
                                                   Margin="0,0,0,3" />
                                    </StackPanel>
                                    <!-- 离线数量写全称摆在数字同一行；0 台走中性灰，真有掉线才转琥珀提醒。左留 8 与「/74」分开 -->
                                    <TextBlock Grid.Column="1" Classes="OfflineTag" Classes.is-warn="{Binding HasOffline}"
                                               Text="{Binding OfflineText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom" Margin="8,0,0,3" />
                                </Grid>
                            </StackPanel>
                            <Viewbox Classes="StatGo">
                                <Panel Width="24" Height="24">
                                    <Path Classes="StatGoIc" Stroke="{DynamicResource StatGreenBrush}"
                                          Data="{StaticResource GeoArrow}" />
                                </Panel>
                            </Viewbox>
                        </Panel>
                    </Button>
                    <!-- 总设备：在线卡的斜杠总数把灯组算一台，这张按真实设备数统计（灯组内单灯逐台计） -->
                    <Button Classes="StatCard" Margin="0,0,10,10" Click="OnGotoRooms"
                            ToolTip.Tip="真实设备数：灯组按组内单灯逐台计数 · 点击查看全部设备">
                        <Panel>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="StatIc">
                                        <Panel Width="24" Height="24">
                                            <Path Classes="StatIc" Stroke="{DynamicResource StatBlueBrush}"
                                                  Data="{StaticResource GeoGrid}" />
                                        </Panel>
                                    </Viewbox>
                                    <TextBlock Text="总设备" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text3Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding TotalDeviceCount}" FontSize="21" FontWeight="SemiBold"
                                               Foreground="{DynamicResource StatBlueBrush}" />
                                    <TextBlock Text="台" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Bottom"
                                               Margin="0,0,0,3" />
                                </StackPanel>
                            </StackPanel>
                            <Viewbox Classes="StatGo">
                                <Panel Width="24" Height="24">
                                    <Path Classes="StatGoIc" Stroke="{DynamicResource StatBlueBrush}"
                                          Data="{StaticResource GeoArrow}" />
                                </Panel>
                            </Viewbox>
                        </Panel>
                    </Button>
                    <Button Classes="StatCard" Margin="0,0,10,10" Command="{Binding OpenLightListCommand}"
                            ToolTip.Tip="点击查看全屋灯光">
                        <Panel>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="StatIc">
                                        <Panel Width="24" Height="24">
                                            <Path Classes="StatIc" Stroke="{DynamicResource StatPurpleBrush}"
                                                  Data="{StaticResource GeoLight}" />
                                        </Panel>
                                    </Viewbox>
                                    <TextBlock Text="灯光" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text3Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding LightOnCount}" FontSize="21" FontWeight="SemiBold"
                                               Foreground="{DynamicResource StatPurpleBrush}" />
                                    <TextBlock Text="{Binding LightTotalText}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Bottom"
                                               Margin="0,0,0,3" />
                                </StackPanel>
                            </StackPanel>
                            <Viewbox Classes="StatGo">
                                <Panel Width="24" Height="24">
                                    <Path Classes="StatGoIc" Stroke="{DynamicResource StatPurpleBrush}"
                                          Data="{StaticResource GeoArrow}" />
                                </Panel>
                            </Viewbox>
                        </Panel>
                    </Button>
                    <Button Classes="StatCard" Margin="0,0,10,10" Command="{Binding OpenCurtainListCommand}"
                            ToolTip.Tip="点击查看全屋窗帘">
                        <Panel>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="StatIc">
                                        <Panel Width="24" Height="24">
                                            <Path Classes="StatIc" Stroke="{DynamicResource StatTealBrush}"
                                                  Data="{StaticResource GeoCurtain}" />
                                        </Panel>
                                    </Viewbox>
                                    <TextBlock Text="窗帘" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text3Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding CurtainOnCount}" FontSize="21" FontWeight="SemiBold"
                                               Foreground="{DynamicResource StatTealBrush}" />
                                    <TextBlock Text="{Binding CurtainTotalText}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Bottom"
                                               Margin="0,0,0,3" />
                                </StackPanel>
                            </StackPanel>
                            <Viewbox Classes="StatGo">
                                <Panel Width="24" Height="24">
                                    <Path Classes="StatGoIc" Stroke="{DynamicResource StatTealBrush}"
                                          Data="{StaticResource GeoArrow}" />
                                </Panel>
                            </Viewbox>
                        </Panel>
                    </Button>
                    <Button Classes="StatCard" Margin="0,0,10,10" Command="{Binding OpenAcListCommand}"
                            ToolTip.Tip="点击查看全屋空调">
                        <Panel>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="StatIc">
                                        <Panel Width="24" Height="24">
                                            <Path Classes="StatIc" Stroke="{DynamicResource StatCyanBrush}"
                                                  Data="{StaticResource GeoAirCon}" />
                                        </Panel>
                                    </Viewbox>
                                    <TextBlock Text="空调" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text3Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding AcOnCount}" FontSize="21" FontWeight="SemiBold"
                                               Foreground="{DynamicResource StatCyanBrush}" />
                                    <TextBlock Text="{Binding AcTotalText}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Bottom"
                                               Margin="0,0,0,3" />
                                </StackPanel>
                            </StackPanel>
                            <Viewbox Classes="StatGo">
                                <Panel Width="24" Height="24">
                                    <Path Classes="StatGoIc" Stroke="{DynamicResource StatCyanBrush}"
                                          Data="{StaticResource GeoArrow}" />
                                </Panel>
                            </Viewbox>
                        </Panel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Grid>
        <!-- 环境与能耗：还剩两张以上趋势卡时独占一行。
             只剩一张时改走下面的合并行，和快捷场景并排；三条数据都没有时整块不出现。
             在这行标题上双击会切到一份演示数据（供预览样式），再双击回到真实；这层操作不写成可见文案。 -->
        <StackPanel IsVisible="{Binding ShowTrendSolo}">
            <Grid ColumnDefinitions="*,Auto" Margin="2,4,0,12" Background="Transparent"
                  PointerPressed="OnTrendHeaderPressed">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="SecTitle" Margin="0" Text="环境与能耗" />
                    <Border Classes="TrendBadge" IsVisible="{Binding IsTrendPreview}">
                        <TextBlock Text="预览 · 演示数据" FontSize="10"
                                   Foreground="{DynamicResource AmberTextBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding EnvTrendCaption}"
                           FontSize="11" Foreground="{DynamicResource Text3Brush}"
                           VerticalAlignment="Center" />
            </Grid>
            <ctl:AdaptiveGridPanel MinItemWidth="300" Spacing="14" MaxColumns="3" SkipInvisible="True">
                <!-- 温度：家里没有能报温度的传感器就不铺这张卡 -->
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TrendTempCardTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                IsVisible="{Binding HasTempReading}" />
                <!-- 湿度：只有能报湿度的设备才出现 -->
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TrendHumCardTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                IsVisible="{Binding HasHumReading}" />
                <!-- 用电：逐小时平均功率柱状；没有能回读用电的设备就不铺这张卡 -->
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TrendPowerCardTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                IsVisible="{Binding HasMetering}" />
                </ctl:AdaptiveGridPanel>
        </StackPanel>
        <!-- 只剩一张趋势卡时，把它和快捷场景并到同一行：左边一张卡，右边场景铺两行 -->
        <DockPanel IsVisible="{Binding ShowTrendQuickRow}" Margin="0,4,0,0">
            <StackPanel DockPanel.Dock="Left" Width="300" VerticalAlignment="Top">
                <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,12" Background="Transparent"
                      PointerPressed="OnTrendHeaderPressed">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="SecTitle" Margin="0" Text="环境与能耗" />
                        <Border Classes="TrendBadge" IsVisible="{Binding IsTrendPreview}">
                            <TextBlock Text="预览 · 演示数据" FontSize="10"
                                       Foreground="{DynamicResource AmberTextBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding EnvTrendCaption}"
                               FontSize="11" Foreground="{DynamicResource Text3Brush}"
                               VerticalAlignment="Center" />
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TrendTempCardTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                IsVisible="{Binding HasTempReading}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TrendHumCardTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                IsVisible="{Binding HasHumReading}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TrendPowerCardTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                IsVisible="{Binding HasMetering}" />
            </StackPanel>
            <StackPanel Margin="14,0,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="SecTitle" Text="快捷场景" Margin="2,0,0,12" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="BtnGhost" Content="更多"
                        Height="28" Padding="12,0" FontSize="12" VerticalAlignment="Center"
                        IsVisible="{Binding HasScenes}" ToolTip.Tip="查看全部场景"
                        Click="OnGotoScenes" />
                </Grid>
                <ItemsControl ItemsSource="{Binding SceneItems}" ItemTemplate="{StaticResource SceneMiniTemplate}"
                          IsVisible="{Binding HasScenes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctl:AdaptiveGridPanel MinItemWidth="220" Spacing="0" MaxRows="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding SkeletonSlots}"
                          ItemTemplate="{StaticResource SceneSkeletonTemplate}"
                          IsVisible="{Binding ShowSceneSkeleton}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctl:AdaptiveGridPanel MinItemWidth="220" Spacing="0" MaxRows="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DockPanel>
        <!-- 趋势首拉骨架：环境读数到货前先铺三张图表骨架卡，到货后整块换成上面的真趋势卡 -->
        <StackPanel IsVisible="{Binding ShowTrendSkeleton}">
            <Grid ColumnDefinitions="*,Auto" Margin="2,4,0,12" Background="Transparent">
                <TextBlock Classes="SecTitle" Margin="0" Text="环境与能耗" />
            </Grid>
            <ItemsControl ItemsSource="{Binding TrendSkeletonSlots}"
                      ItemTemplate="{StaticResource TrendSkeletonTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctl:AdaptiveGridPanel MinItemWidth="300" Spacing="14" MaxColumns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
        <!-- 快捷场景：正常铺在趋势区下方，一行放不下的进场景页；只剩一张趋势卡时这一块并到上面同一行去 -->
        <StackPanel IsVisible="{Binding ShowQuickScenesSolo}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="SecTitle" Text="快捷场景" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="BtnGhost" Content="更多"
                    Height="28" Padding="12,0" FontSize="12" VerticalAlignment="Center"
                    IsVisible="{Binding HasScenes}" ToolTip.Tip="查看全部场景"
                    Click="OnGotoScenes" />
            </Grid>
            <!-- 默认只显示一行，其余场景进场景页查看 -->
            <ItemsControl ItemsSource="{Binding SceneItems}" ItemTemplate="{StaticResource SceneMiniTemplate}"
                      IsVisible="{Binding HasScenes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctl:AdaptiveGridPanel MinItemWidth="220" Spacing="0" MaxRows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <!-- 场景首次拉取：先铺一行骨架，到货后整块换成真卡片 -->
            <ItemsControl ItemsSource="{Binding SkeletonSlots}"
                      ItemTemplate="{StaticResource SceneSkeletonTemplate}"
                      IsVisible="{Binding ShowSceneSkeleton}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctl:AdaptiveGridPanel MinItemWidth="220" Spacing="0" MaxRows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
        <!-- 首次拉取：先铺骨架宫格，设备一到就整块换成真卡片 -->
        <StackPanel IsVisible="{Binding ShowSkeleton}">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,26,0,12">
                <Path Classes="Spinner" Width="15" Height="15" Stretch="Uniform"
                  Stroke="{DynamicResource Accent2Brush}" StrokeThickness="2.4"
                  StrokeLineCap="Round" Data="{StaticResource GeoSpinner}"
                  Classes.run="{Binding ShowSkeleton}" />
                <TextBlock Classes="SecTitle" Margin="0" Text="正在从米家云端获取设备…" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding SkeletonSlots}"
                      ItemTemplate="{StaticResource SkeletonCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctl:AdaptiveGridPanel MinItemWidth="240" Spacing="0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
        <!-- 空家：设备与场景都没有时，用空提示替代空分组 -->
        <views:EmptyState IsVisible="{Binding ShowHomeEmpty}"
                      Icon="{StaticResource GeoHome}"
                      Title="家里还是空的"
                      Description="在米家 App 添加设备或场景，这里会自动同步" />
        <!-- 按房间分组 -->
        <ItemsControl ItemsSource="{Binding HomeGroups}" IsVisible="{Binding !ShowSkeleton}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:DeviceGroup">
                    <StackPanel>
                        <!-- 房间标题行整行可点：收起后只留这一行，卡片区整块让位。
                             上下间距按"标题跟着自己的卡片"来分：上面留 20 与上一段分开，下面只留 4，
                             加上卡片自带的 8 外距，标题与卡片挨得近，段与段之间才看得出层次 -->
                        <Button Classes="RoomHead" Margin="2,20,0,4"
                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ToggleRoomCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="展开 / 收起该房间的设备">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <!-- 房间图标与侧栏同款：玻璃 SVG / 细线两套画法按设置二选一 -->
                                <Image Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"
                                       IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IconGlass}"
                                       Source="{Binding IconKey, Converter={StaticResource NavSvg}}" />
                                <Path Classes="RoomIc" Width="15" Height="15" Stretch="Uniform"
                                      VerticalAlignment="Center" StrokeThickness="1.4"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      IsVisible="{Binding !$parent[UserControl].((vm:MainViewModel)DataContext).IconGlass}"
                                      Data="{Binding IconKey, Converter={StaticResource NavLine}}" />
                                <TextBlock Classes="RoomName" Text="{Binding TitleText}" />
                                <Viewbox Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                                         RenderTransformOrigin="50%,50%">
                                    <Viewbox.RenderTransform>
                                        <RotateTransform Angle="{Binding ChevronAngle}">
                                            <RotateTransform.Transitions>
                                                <Transitions>
                                                    <DoubleTransition Property="Angle" Duration="0:0:0.09" />
                                                </Transitions>
                                            </RotateTransform.Transitions>
                                        </RotateTransform>
                                    </Viewbox.RenderTransform>
                                    <Panel Width="24" Height="24">
                                        <Path Classes="RoomChev" StrokeThickness="1.92"
                                              StrokeLineCap="Round" StrokeJoin="Round"
                                              Data="{StaticResource GeoChevron}" />
                                    </Panel>
                                </Viewbox>
                            </StackPanel>
                        </Button>
                        <!-- 虚拟化：每组卡片仅生成视口内的可视树 -->
                        <!-- 虚拟化自适应网格：每组仅生成视口内可见的卡片容器 -->
                        <ctl:RecyclingItemsControl x:Name="DeviceItemsControl" ItemsSource="{Binding Items}"
                                      ItemTemplate="{StaticResource DeviceCardTemplate}"
                                      IsVisible="{Binding ItemsVisible}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ctl:VirtualizingAdaptiveGridPanel MinItemWidth="240" Spacing="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ctl:RecyclingItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- 已隐藏：必需设备仍沉在列表末尾的折叠区里，默认收起；展开后是同一张设备卡，
             右键「取消隐藏」即可放回原房间宫格 -->
        <StackPanel IsVisible="{Binding !ShowSkeleton}">
            <StackPanel IsVisible="{Binding HasHiddenDevices}">
                <Button Classes="BtnGhost" HorizontalAlignment="Left" Height="30" Padding="12,0"
                        Margin="2,22,0,10" Command="{Binding ToggleHiddenSectionCommand}"
                        ToolTip.Tip="展开 / 收起已隐藏的设备">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding HiddenSectionText}" FontSize="12.5"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}" />
                        <Viewbox Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                                 RenderTransformOrigin="50%,50%">
                            <Viewbox.RenderTransform>
                                <RotateTransform Angle="{Binding HiddenSectionAngle}">
                                    <RotateTransform.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Angle" Duration="0:0:0.09" />
                                        </Transitions>
                                    </RotateTransform.Transitions>
                                </RotateTransform>
                            </Viewbox.RenderTransform>
                            <Panel Width="24" Height="24">
                                <Path StrokeThickness="1.92" StrokeLineCap="Round" StrokeJoin="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="{StaticResource GeoChevron}" />
                            </Panel>
                        </Viewbox>
                    </StackPanel>
                </Button>
                <ctl:RecyclingItemsControl ItemsSource="{Binding HiddenDevices}"
                                           ItemTemplate="{StaticResource DeviceCardTemplate}"
                                           IsVisible="{Binding HiddenSectionExpanded}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctl:VirtualizingAdaptiveGridPanel MinItemWidth="240" Spacing="0" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ctl:RecyclingItemsControl>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
