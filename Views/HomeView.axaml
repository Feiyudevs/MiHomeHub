<UserControl 
    xmlns="https://github.com/avaloniaui"
             
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             
    xmlns:m="clr-namespace:MiHome.Models"
             
    xmlns:vm="clr-namespace:MiHome.ViewModels"
             
    xmlns:ctl="clr-namespace:MiHome.Controls"
             
    xmlns:views="clr-namespace:MiHome.Views"
             x:Class="MiHome.Views.HomeView">
    <StackPanel x:DataType="vm:MainViewModel">
        <!-- Hero：透明底；左侧问候+概览按钮，右侧统计卡+环境概览。
             左列 Auto、右列 *：统计卡整行占宽更大，反过来写会把问候语挤到裁字，右侧也就没有换行的余量 -->
        <Grid ColumnDefinitions="Auto,*" Margin="28,26">
            <StackPanel VerticalAlignment="Top" Spacing="0">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <TextBlock Text="{Binding Greet}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="，" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="欢迎回家" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource PinkBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                    <TextBlock Text="{Binding ClockText}" FontSize="13"
                                   Foreground="{DynamicResource Text2Brush}" />
                    <Border Width="1" Height="12" Background="{DynamicResource LineBrush}"
                                VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DateText}" FontSize="13"
                                   Foreground="{DynamicResource Text2Brush}" />
                    <Border Width="1" Height="12" Background="{DynamicResource LineBrush}"
                                VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" FontSize="13"
                                   Foreground="{DynamicResource Text3Brush}" />
                </StackPanel>
                <!-- 概览按钮区：全部场景 / 全部设备 / 刷新，移到时间日期行下方，左对齐 -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <Button Classes="BtnGhost" Content="全部场景" Click="OnGotoScenes" />
                    <Button Classes="BtnGhost" Content="全部设备" Click="OnGotoRooms" />
                    <Button Classes="BtnGhost" Width="36" Padding="0"
                        Command="{Binding LoadDevicesCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        ToolTip.Tip="拉取最新状态">
                        <Panel>
                            <Path Classes="RefreshIc" Width="13" Height="13" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.4"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Data="{StaticResource GeoRefresh}"
                              IsVisible="{Binding !IsLoading}" />
                            <Path Classes="Spinner" Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.6"
                              StrokeLineCap="Round"
                              Data="{StaticResource GeoSpinner}"
                              Classes.run="{Binding IsLoading}"
                              IsVisible="{Binding IsLoading}" />
                        </Panel>
                    </Button>
                </StackPanel>
            </StackPanel>
            <!-- 统计：卡片色底 + 轻投影；与左侧问候顶部对齐；按钮区已移至左侧时间行下方 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="16,0,0,0" Spacing="12">
                <!-- 环境读数未到货且仍在首拉：先铺同尺寸胶囊占位，读数到了整行换真胶囊 -->
                <ItemsControl ItemsSource="{Binding EnvSkeletonSlots}"
                          ItemTemplate="{StaticResource EnvPillSkeletonTemplate}"
                          IsVisible="{Binding ShowEnvSkeleton}" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <!-- 环境概览：温湿度聚合 + 耗材提醒，三枚胶囊都可点开明细；统计卡下方，底部右对齐 -->
                <WrapPanel Margin="0,0,0,0" IsVisible="{Binding ShowEnvOverview}" HorizontalAlignment="Right">
                    <Button Classes="EnvPill" Margin="0,0,8,6" ToolTip.Tip="点击查看明细"
                        Command="{Binding OpenEnvDetailCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="EnvLab" Text="温度" />
                            <TextBlock Classes="EnvVal" Text="{Binding EnvTemperatureText}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="EnvPill" Margin="0,0,8,6" ToolTip.Tip="点击查看明细"
                        Command="{Binding OpenEnvDetailCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="EnvLab" Text="湿度" />
                            <TextBlock Classes="EnvVal" Text="{Binding EnvHumidityText}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="EnvPill" Margin="0,0,0,6" ToolTip.Tip="点击查看明细"
                        Classes.is-warn="{Binding HasConsumableWarning}"
                        Command="{Binding OpenEnvDetailCommand}">
                        <TextBlock Classes="EnvVal" Classes.is-warn="{Binding HasConsumableWarning}"
                               Text="{Binding ConsumablePillText}" />
                    </Button>
                </WrapPanel>
                <!-- 首拉期间统计数字还是 0，先铺四张同尺寸骨架卡，设备一到整行换真卡 -->
                <ItemsControl ItemsSource="{Binding StatSkeletonSlots}"
                          ItemTemplate="{StaticResource StatSkeletonTemplate}"
                          IsVisible="{Binding ShowSkeleton}" HorizontalAlignment="Right"
                          Margin="0,0,-10,-10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <WrapPanel HorizontalAlignment="Right" Margin="0,0,-10,-10"
                           IsVisible="{Binding !ShowSkeleton}">
                    <!-- 四张统计卡都可点：在线→离线设备弹窗、灯光/窗帘/空调→对应全屋弹窗。
                         卡片图标套 Viewbox 按 24 网格缩放：Path 单用 Stretch 会贴框左上角，还把描边一起放大。
                         用 WrapPanel + 负外边距：窗口窄时整行折成两排，右边缘仍对齐（-10 抵掉末项的 10 右边距）。 -->
                    <Button Classes="StatCard" Margin="0,0,10,10" Command="{Binding OpenOfflineListCommand}"
                            ToolTip.Tip="点击查看离线设备">
                        <Panel>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="StatIc">
                                        <Panel Width="24" Height="24">
                                            <Path Classes="StatIc" Stroke="{DynamicResource StatGreenBrush}"
                                                  Data="{StaticResource GeoWifi}" />
                                        </Panel>
                                    </Viewbox>
                                    <TextBlock Text="在线设备" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text3Brush}" />
                                </StackPanel>
                                <Grid ColumnDefinitions="Auto,*">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding OnlineCount}" FontSize="21" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource StatGreenBrush}" />
                                        <TextBlock Text="{Binding TotalText}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Bottom"
                                                   Margin="0,0,0,3" />
                                    </StackPanel>
                                    <!-- 离线数量写全称摆在数字同一行；0 台走中性灰，真有掉线才转琥珀提醒 -->
                                    <TextBlock Grid.Column="1" Classes="OfflineTag" Classes.is-warn="{Binding HasOffline}"
                                               Text="{Binding OfflineText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                </Grid>
                            </StackPanel>
                            <Viewbox Classes="StatGo">
                                <Panel Width="24" Height="24">
                                    <Path Classes="StatGoIc" Stroke="{DynamicResource StatGreenBrush}"
                                          Data="{StaticResource GeoArrow}" />
                                </Panel>
                            </Viewbox>
                        </Panel>
                    </Button>
                    <Button Classes="StatCard" Margin="0,0,10,10" Command="{Binding OpenLightListCommand}"
                            ToolTip.Tip="点击查看全屋灯光">
                        <Panel>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="StatIc">
                                        <Panel Width="24" Height="24">
                                            <Path Classes="StatIc" Stroke="{DynamicResource StatPurpleBrush}"
                                                  Data="{StaticResource GeoLight}" />
                                        </Panel>
                                    </Viewbox>
                                    <TextBlock Text="灯光" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text3Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding LightOnCount}" FontSize="21" FontWeight="SemiBold"
                                               Foreground="{DynamicResource StatPurpleBrush}" />
                                    <TextBlock Text="{Binding LightTotalText}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Bottom"
                                               Margin="0,0,0,3" />
                                </StackPanel>
                            </StackPanel>
                            <Viewbox Classes="StatGo">
                                <Panel Width="24" Height="24">
                                    <Path Classes="StatGoIc" Stroke="{DynamicResource StatPurpleBrush}"
                                          Data="{StaticResource GeoArrow}" />
                                </Panel>
                            </Viewbox>
                        </Panel>
                    </Button>
                    <Button Classes="StatCard" Margin="0,0,10,10" Command="{Binding OpenCurtainListCommand}"
                            ToolTip.Tip="点击查看全屋窗帘">
                        <Panel>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="StatIc">
                                        <Panel Width="24" Height="24">
                                            <Path Classes="StatIc" Stroke="{DynamicResource StatTealBrush}"
                                                  Data="{StaticResource GeoCurtain}" />
                                        </Panel>
                                    </Viewbox>
                                    <TextBlock Text="窗帘" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text3Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding CurtainOnCount}" FontSize="21" FontWeight="SemiBold"
                                               Foreground="{DynamicResource StatTealBrush}" />
                                    <TextBlock Text="{Binding CurtainTotalText}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Bottom"
                                               Margin="0,0,0,3" />
                                </StackPanel>
                            </StackPanel>
                            <Viewbox Classes="StatGo">
                                <Panel Width="24" Height="24">
                                    <Path Classes="StatGoIc" Stroke="{DynamicResource StatTealBrush}"
                                          Data="{StaticResource GeoArrow}" />
                                </Panel>
                            </Viewbox>
                        </Panel>
                    </Button>
                    <Button Classes="StatCard" Margin="0,0,10,10" Command="{Binding OpenAcListCommand}"
                            ToolTip.Tip="点击查看全屋空调">
                        <Panel>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Classes="StatIc">
                                        <Panel Width="24" Height="24">
                                            <Path Classes="StatIc" Stroke="{DynamicResource StatCyanBrush}"
                                                  Data="{StaticResource GeoAirCon}" />
                                        </Panel>
                                    </Viewbox>
                                    <TextBlock Text="空调" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text3Brush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding AcOnCount}" FontSize="21" FontWeight="SemiBold"
                                               Foreground="{DynamicResource StatCyanBrush}" />
                                    <TextBlock Text="{Binding AcTotalText}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Bottom"
                                               Margin="0,0,0,3" />
                                </StackPanel>
                            </StackPanel>
                            <Viewbox Classes="StatGo">
                                <Panel Width="24" Height="24">
                                    <Path Classes="StatGoIc" Stroke="{DynamicResource StatCyanBrush}"
                                          Data="{StaticResource GeoArrow}" />
                                </Panel>
                            </Viewbox>
                        </Panel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Grid>
        <!-- 快捷场景：标题行右侧「更多」进场景页；没有场景时整条不出现 -->
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowQuickScenes}">
            <TextBlock Classes="SecTitle" Text="快捷场景" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="BtnGhost" Content="更多"
                Height="28" Padding="12,0" FontSize="12" VerticalAlignment="Center"
                IsVisible="{Binding HasScenes}" ToolTip.Tip="查看全部场景"
                Click="OnGotoScenes" />
        </Grid>
        <!-- 默认只显示一行，其余场景进场景页查看 -->
        <ItemsControl ItemsSource="{Binding SceneItems}" ItemTemplate="{StaticResource SceneMiniTemplate}"
                  IsVisible="{Binding HasScenes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <ctl:AdaptiveGridPanel MinItemWidth="180" Spacing="0" MaxRows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <!-- 场景首次拉取：先铺一行骨架，到货后整块换成真卡片 -->
        <ItemsControl ItemsSource="{Binding SkeletonSlots}"
                  ItemTemplate="{StaticResource SceneSkeletonTemplate}"
                  IsVisible="{Binding ShowSceneSkeleton}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <ctl:AdaptiveGridPanel MinItemWidth="180" Spacing="0" MaxRows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <!-- 首次拉取：先铺骨架宫格，设备一到就整块换成真卡片 -->
        <StackPanel IsVisible="{Binding ShowSkeleton}">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,26,0,12">
                <Path Classes="Spinner" Width="15" Height="15" Stretch="Uniform"
                  Stroke="{DynamicResource Accent2Brush}" StrokeThickness="2.4"
                  StrokeLineCap="Round" Data="{StaticResource GeoSpinner}"
                  Classes.run="{Binding ShowSkeleton}" />
                <TextBlock Classes="SecTitle" Margin="0" Text="正在从米家云端获取设备…" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding SkeletonSlots}"
                      ItemTemplate="{StaticResource SkeletonCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctl:AdaptiveGridPanel MinItemWidth="240" Spacing="0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
        <!-- 空家：设备与场景都没有时，用空提示替代空分组 -->
        <views:EmptyState IsVisible="{Binding ShowHomeEmpty}"
                      Icon="{StaticResource GeoHome}"
                      Title="家里还是空的"
                      Description="在米家 App 添加设备或场景，这里会自动同步" />
        <!-- 按房间分组 -->
        <ItemsControl ItemsSource="{Binding HomeGroups}" IsVisible="{Binding !ShowSkeleton}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:DeviceGroup">
                    <StackPanel>
                        <TextBlock Classes="SecTitle" Text="{Binding TitleText}" />
                        <!-- 虚拟化：每组卡片仅生成视口内的可视树 -->
                        <!-- 虚拟化自适应网格：每组仅生成视口内可见的卡片容器 -->
                        <ctl:RecyclingItemsControl x:Name="DeviceItemsControl" ItemsSource="{Binding Items}"
                                      ItemTemplate="{StaticResource DeviceCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ctl:VirtualizingAdaptiveGridPanel MinItemWidth="240" Spacing="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ctl:RecyclingItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
