<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:MiHome.Controls"
        xmlns:vm="clr-namespace:MiHome.ViewModels"
        x:Class="MiHome.Views.TrayMenuWindow"
        x:DataType="vm:MainViewModel"
        Title="米家 · 控制中心"
        Width="272" Height="259"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        RenderOptions.TextRenderingMode="Antialias">

    <Window.Resources>
        <PathGeometry x:Key="GeoEye">M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z</PathGeometry>
        <PathGeometry x:Key="GeoPower">M18.36 6.64a9 9 0 1 1-12.73 0 M12 2v10</PathGeometry>
        <PathGeometry x:Key="GeoRestart">M3 12a9 9 0 1 0 3-6.7L3 8 M3 3v5h5</PathGeometry>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.TrayItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.TrayItem:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SelBgHoverBrush}" />
        </Style>
        <Style Selector="Button.TrayItem:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SelBgPressBrush}" />
        </Style>
        <Style Selector="Button.Danger:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="#FEE2E2" />
        </Style>
        <Style Selector="Button.Danger:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="#FECACA" />
        </Style>
        <Style Selector="Button.TrayItem Path">
            <Setter Property="Stroke" Value="{DynamicResource Text2Brush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.TrayItem TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 悬停底是实心紫：图标和文字一起翻白。危险项自己的红色规则写在后面，同优先级按顺序取后者。 -->
        <Style Selector="Button.TrayItem:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource SelTextBrush}" />
        </Style>
        <Style Selector="Button.TrayItem:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SelTextBrush}" />
        </Style>
        <Style Selector="Button.TrayItem.Danger:pointerover Path">
            <Setter Property="Stroke" Value="#EF4444" />
        </Style>
        <Style Selector="Button.TrayItem.Danger:pointerover TextBlock">
            <Setter Property="Foreground" Value="#EF4444" />
        </Style>
        <!-- 媒体三键：两侧键中性无色底、悬停同菜单项翻白；主键是实心主色圆钮 -->
        <Style Selector="Button.TrayMedia, Button.TrayPlay">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.TrayMedia">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="11" />
        </Style>
        <Style Selector="Button.TrayPlay">
            <Setter Property="Background" Value="{DynamicResource PrimaryBtnBrush}" />
            <Setter Property="CornerRadius" Value="17" />
        </Style>
        <Style Selector="Button.TrayMedia Path">
            <Setter Property="Fill" Value="{DynamicResource Text2Brush}" />
        </Style>
        <Style Selector="Button.TrayMedia:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SelBgHoverBrush}" />
        </Style>
        <Style Selector="Button.TrayMedia:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SelBgPressBrush}" />
        </Style>
        <Style Selector="Button.TrayMedia:pointerover Path">
            <Setter Property="Fill" Value="{DynamicResource SelTextBrush}" />
        </Style>
        <Style Selector="Button.TrayPlay:pointerover">
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.TrayPlay:pressed">
            <Setter Property="Opacity" Value="0.78" />
        </Style>
        <!-- 媒体骨架的扫光：托盘卡只有 ~216px 宽，全局 SkelShineSm 的 190px 扫程会扫不满 -->
        <Style Selector="Border.TrayShine">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="110" />
            <Setter Property="Canvas.Top" Value="-20" />
            <Setter Property="Canvas.Left" Value="-70" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Background" Value="{DynamicResource SkelShineBrush}" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="0" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Border.TrayShine.run">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="240" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <!-- 外边距留给阴影，改动前先确认阴影扩散不会顶到窗口边缘 -->
    <Grid Margin="20">
        <Border x:Name="Card" CornerRadius="16"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                BoxShadow="0 8 20 0 #59000000">
            <StackPanel Margin="7" Spacing="1">
                <TextBlock x:Name="MenuTitle" Text="米家控制中心" Height="26" Margin="10,4,10,0"
                           FontSize="12.5" LetterSpacing="0.4"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Stretch" TextAlignment="Center"
                           VerticalAlignment="Center" />

                <!-- 媒体控制：上一曲/播放暂停/下一曲，下面是当前音箱下拉；家里没有音箱时整块连同分隔线一起收掉 -->
                <Panel ClipToBounds="True" IsVisible="{Binding TraySpeakerPending}">
                    <StackPanel Spacing="6" Margin="1,2,1,6">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="17"
                                    Background="{DynamicResource SkelBarBrush}" Opacity="0.45" />
                            <Border Width="34" Height="34" CornerRadius="17"
                                    Background="{DynamicResource SkelBarBrush}" />
                            <Border Width="34" Height="34" CornerRadius="17"
                                    Background="{DynamicResource SkelBarBrush}" Opacity="0.45" />
                        </StackPanel>
                        <Border Height="32" CornerRadius="8" Background="{DynamicResource SkelBarBrush}" />
                    </StackPanel>
                    <Canvas IsHitTestVisible="False">
                        <!-- 扫光只在骨架真的显示时跑，收起后动画不能跟着常驻（无限动画会让合成器满帧空转） -->
                        <Border Classes="TrayShine" Classes.run="{Binding TraySpeakerPending}" />
                    </Canvas>
                </Panel>

                <StackPanel Spacing="6" Margin="1,2,1,6" IsVisible="{Binding HasSpeaker}">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button Classes="TrayMedia" ToolTip.Tip="上一曲"
                                Command="{Binding MediaPreviousCommand}">
                            <Viewbox Width="15" Height="15">
                                <Panel Width="24" Height="24">
                                    <Path Data="{StaticResource GeoPrevTrack}" />
                                </Panel>
                            </Viewbox>
                        </Button>
                        <Button Classes="TrayPlay" ToolTip.Tip="播放 / 暂停"
                                Command="{Binding MediaTogglePlayCommand}">
                            <Viewbox Width="17" Height="17">
                                <Panel Width="24" Height="24">
                                    <Path Fill="White" IsVisible="{Binding !MediaSpeaker.IsPlaying}"
                                          Data="{StaticResource GeoPlay}" />
                                    <Path Fill="White" IsVisible="{Binding MediaSpeaker.IsPlaying}"
                                          Data="{StaticResource GeoPauseIc}" />
                                </Panel>
                            </Viewbox>
                        </Button>
                        <Button Classes="TrayMedia" ToolTip.Tip="下一曲"
                                Command="{Binding MediaNextCommand}">
                            <Viewbox Width="15" Height="15">
                                <Panel Width="24" Height="24">
                                    <Path Data="{StaticResource GeoNextTrack}" />
                                </Panel>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                    <ctl:OptionPicker x:Name="SpeakerPicker" Classes="wide muted"
                                      ToolTip.Tip="切换要控制的音箱"
                                      Options="{Binding SpeakerOptions}"
                                      SelectedValue="{Binding SelectedSpeakerValue, Mode=TwoWay}" />
                </StackPanel>

                <Rectangle Height="1" Margin="10,5" Fill="{DynamicResource LineBrush}"
                           IsVisible="{Binding TrayMediaSlot}" />

                <Button Classes="TrayItem" Click="OnShowMainClick">
                    <Grid ColumnDefinitions="20,*">
                        <Border Width="20" Height="40" Grid.Column="0">
                            <!-- eye 几何包围盒是 20x14 的扁盒，Uniform 拉伸后渲染中心比文字中心高 ~1.5px，用位移补偿 -->
                            <Path Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="{StaticResource GeoEye}">
                                <Path.RenderTransform>
                                    <TranslateTransform Y="1.5" />
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <TextBlock Grid.Column="1" Text="显示主界面" Margin="6,0,0,0" />
                    </Grid>
                </Button>

                <Button Classes="TrayItem" Click="OnToggleThemeClick">
                    <Grid ColumnDefinitions="20,*">
                        <Border Width="20" Height="40" Grid.Column="0">
                            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="SunIcon" Width="14" Height="14" Stretch="Uniform"
                                      Data="{StaticResource GeoSun}" />
                                <Path x:Name="MoonIcon" Width="12" Height="12" Stretch="Uniform"
                                      Data="{StaticResource GeoMoon}" />
                            </Panel>
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="ThemeText" Text="切换浅色主题" Margin="6,0,0,0" />
                    </Grid>
                </Button>

                <Button Classes="TrayItem" Click="OnRestartClick">
                    <Grid ColumnDefinitions="20,*">
                        <Border Width="20" Height="40" Grid.Column="0">
                            <Path Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="{StaticResource GeoRestart}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="重新启动" Margin="6,0,0,0" />
                    </Grid>
                </Button>

                <Rectangle Height="1" Margin="10,5" Fill="{DynamicResource LineBrush}" />

                <Button Classes="TrayItem Danger" Click="OnExitClick">
                    <Grid ColumnDefinitions="20,*">
                        <Border Width="20" Height="40" Grid.Column="0">
                            <Path Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="{StaticResource GeoPower}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="退出 米家控制中心" Margin="6,0,0,0" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
