<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MiHome.ViewModels"
        x:Class="MiHome.Views.DesktopMenuWindow"
        x:DataType="vm:DesktopZoneVm"
        Title="分区菜单"
        SizeToContent="WidthAndHeight" MinWidth="128"
        SystemDecorations="None" CanResize="False"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        RequestedThemeVariant="Light">

    <Window.Styles>
        <!-- 菜单项：整行可点，左侧图标固定 12，文字左对齐 -->
        <Style Selector="Button.MItem">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.MItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}" />
        </Style>
        <Style Selector="Button.MItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}" />
        </Style>
        <Style Selector="Button.MItem.danger">
            <Setter Property="Foreground" Value="#D92D20" />
        </Style>
        <Style Selector="Button.MItem.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1FD92D20" />
        </Style>
        <Style Selector="Button.MItem.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2AD92D20" />
        </Style>
        <Style Selector="Button.MItem Path.MIc">
            <Setter Property="Stroke" Value="{DynamicResource Text2Brush}" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="Button.MItem.danger Path.MIc">
            <Setter Property="Stroke" Value="#D92D20" />
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource DrawerBgBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="6"
            BoxShadow="0 2 6 0 #140F172A, 0 12 28 0 #1F0F172A">
        <StackPanel>
            <!-- 添加设备只对设备分区有意义；媒体分区的音箱在卡里点那一行换 -->
            <Button Classes="MItem" Tag="add" Click="OnItemClick" IsVisible="{Binding !IsMedia}">
                <Grid ColumnDefinitions="12,*">
                    <Path Classes="MIc" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                          Data="M12,5 V19 M5,12 H19" />
                    <TextBlock Grid.Column="1" Text="添加设备" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <!-- 媒体分区没有标题栏、不显示名字，改名没有落点 -->
            <Button Classes="MItem" Tag="rename" Click="OnItemClick" IsVisible="{Binding !IsMedia}">
                <Grid ColumnDefinitions="12,*">
                    <Path Classes="MIc" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                          Data="M13 3 H4 a2 2 0 0 0 -2 2 V19 a2 2 0 0 0 2 2 H20 a2 2 0 0 0 2 -2 V10 M18 3 a2.12 2.12 0 0 1 3 3 L12 15 l-4 1 1 -4 Z" />
                    <TextBlock Grid.Column="1" Text="重命名" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <!-- 在这块分区附近再放一块空白分区 -->
            <Button Classes="MItem" Tag="addzone" Click="OnItemClick">
                <Grid ColumnDefinitions="12,*">
                    <Path Classes="MIc" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                          Data="M6,3 H18 Q21,3 21,6 V18 Q21,21 18,21 H6 Q3,21 3,18 V6 Q3,3 6,3 Z M12,8 V16 M8,12 H16" />
                    <TextBlock Grid.Column="1" Text="添加分区" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <Button Classes="MItem" Tag="appearance" Click="OnItemClick">
                <Grid ColumnDefinitions="12,*">
                    <Path Classes="MIc" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                          Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 Z M12,2.5 V5 M12,19 V21.5 M2.5,12 H5 M19,12 H21.5" />
                    <TextBlock Grid.Column="1" Text="外观设置" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="8,4" />
            <Button Classes="MItem danger" Tag="dissolve" Click="OnItemClick">
                <Grid ColumnDefinitions="12,*">
                    <Path Classes="MIc" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                          Data="M5,6 H19 M8,6 V4 H16 V6 M6,6 L7,19 Q7.2,20.5 8.5,20.5 H15.5 Q16.8,20.5 17,19 L18,6 M10,9.5 V16.5 M14,9.5 V16.5" />
                    <TextBlock Grid.Column="1" Text="{Binding DissolveLabel}" Margin="8,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Window>
