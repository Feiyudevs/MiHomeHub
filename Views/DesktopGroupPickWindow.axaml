<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MiHome.ViewModels"
        xmlns:ctl="clr-namespace:MiHome.Controls"
        x:Class="MiHome.Views.DesktopGroupPickWindow"
        x:DataType="vm:DesktopGroupPickVm"
        Title="添加到桌面组件"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        RenderOptions.TextRenderingMode="Antialias">

    <Window.Styles>
        <!-- 分区行：整行可点的卡。与添加设备弹窗的 PickCard 同一套视觉（底色画在 ContentPresenter 上，
             Fluent 悬停态也是改这里，画在 Button.Background 上会被压掉） -->
        <Style Selector="Button.GrpRow">
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.GrpRow /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PickCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
        </Style>
        <Style Selector="Button.GrpRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PickCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        </Style>
        <!-- 已勾选：淡主色底 + 主色描边，和右侧的勾选圈呼应 -->
        <Style Selector="Button.GrpRow.is-on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.GrpRow.is-on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
    </Window.Styles>

    <!-- 窗体铺满主窗口客户区（尺寸由 FitTo 设置），遮罩才能压暗整个软件界面 -->
    <ctl:DialogPopup x:Name="Card"
                     CardWidth="460" CardMaxHeight="500"
                     CanDrag="False"
                     Title="添加到桌面组件"
                     Subtitle="{Binding Subtitle}"
                     IsOpen="True" CloseCommand="{Binding CloseCommand}">

        <StackPanel Spacing="12">

            <!-- ===== 已有分区：多选，点一行切换勾选 ===== -->
            <TextBlock Text="选择分区（可多选）" FontSize="12" FontWeight="SemiBold"
                       Margin="2,0,0,2"
                       Foreground="{DynamicResource Text2Brush}"
                       IsVisible="{Binding !IsEmpty}" />

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupPickItem">
                        <Button Classes="GrpRow" Classes.is-on="{Binding IsSelected}"
                                Tag="{Binding}" Click="OnGroupClick">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Width="36" Height="36" CornerRadius="10"
                                        Background="{DynamicResource HoverBrush}">
                                    <Path Width="18" Height="18" Stretch="Uniform"
                                          StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          Stroke="{DynamicResource Text2Brush}"
                                          Data="{StaticResource GeoGrid}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                            VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CountText}" FontSize="11"
                                               Foreground="{DynamicResource Text2Brush}" />
                                </StackPanel>
                                <Panel Grid.Column="2" VerticalAlignment="Center">
                                    <!-- 已在里面的分区：只提示，不可再选 -->
                                    <Border CornerRadius="8" Padding="8,3"
                                            Background="{DynamicResource GreenSoftBrush}"
                                            IsVisible="{Binding Contains}">
                                        <TextBlock Text="已添加" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource GreenBrush}" />
                                    </Border>
                                    <!-- 勾选圈：未选空心，选中填主色 + 白勾 -->
                                    <Panel IsVisible="{Binding !Contains}">
                                        <Border Width="20" Height="20" CornerRadius="10"
                                                BorderThickness="1.5"
                                                BorderBrush="{DynamicResource LineStrongBrush}"
                                                IsVisible="{Binding !IsSelected}" />
                                        <Border Width="20" Height="20" CornerRadius="10"
                                                Background="{DynamicResource AccentBrush}"
                                                IsVisible="{Binding IsSelected}">
                                            <!-- 勾的宽高按几何比例给足（16:11），Uniform 缩放后没有纵向留白，
                                                 才不会出现勾整体偏上的错觉 -->
                                            <Path Width="12" Height="8.25" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stroke="White" StrokeThickness="2"
                                                  StrokeLineCap="Round" StrokeJoin="Round"
                                                  Data="M4 12 L9 17 L20 6" />
                                        </Border>
                                    </Panel>
                                </Panel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="还没有分区，点下方「新建分区」开始"
                       FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                       Foreground="{DynamicResource Text2Brush}"
                       IsVisible="{Binding IsEmpty}" />

            <!-- ===== 新建分区：默认只露一个入口按钮，点了才展开输入框 ===== -->
            <Button Classes="AddChip" Height="30" Padding="12,0" Margin="0,2,0,0"
                    HorizontalAlignment="Left" Cursor="Hand"
                    Content="＋ 新建分区"
                    Click="OnShowCreateClick"
                    IsVisible="{Binding !IsCreating}" />
            <StackPanel Spacing="7" IsVisible="{Binding IsCreating}">
                <TextBlock Text="新分区名称" FontSize="12"
                           Foreground="{DynamicResource Text2Brush}" />
                <TextBox Name="NameBox" Height="38" FontSize="13.5" Padding="12,0"
                         Background="{DynamicResource SearchBgBrush}"
                         BorderBrush="{DynamicResource SearchLineBrush}"
                         CornerRadius="10"
                         Watermark="分区名称"
                         Text="{Binding NewName, Mode=TwoWay}" />
                <TextBlock Classes="Hint" Text="回车等同于点「确定」" />
            </StackPanel>
        </StackPanel>

        <ctl:DialogPopup.Footer>
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                    Padding="0,14,0,0" Margin="28,0,22,20">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="勾选的分区会一起加入" FontSize="10.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text3Brush}" />
                    <Button Grid.Column="1" Classes="BtnGhost" Content="取消" Margin="0,0,8,0"
                            Click="OnCancelClick" />
                    <Button Grid.Column="2" Classes="BtnPrimary" Content="确定"
                            Command="{Binding ConfirmCommand}" />
                </Grid>
            </Border>
        </ctl:DialogPopup.Footer>
    </ctl:DialogPopup>
</Window>
