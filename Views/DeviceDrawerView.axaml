<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:MiHomeHub.ViewModels"
    xmlns:m="clr-namespace:MiHomeHub.Models"
    xmlns:conv="clr-namespace:MiHomeHub.Converters"
    xmlns:ctl="clr-namespace:MiHomeHub.Controls"
    xmlns:views="clr-namespace:MiHomeHub.Views"
    xmlns:svc="clr-namespace:MiHomeHub.Services"
    x:Class="MiHomeHub.Views.DeviceDrawerView"
    x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <!-- 详情头部设备图标入口：透明按钮壳，外观全交给里面那块圆角图标 -->
        <Style Selector="Button.DeviceIconButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>
        <!-- 边距对齐主内容面板（设备列表卡片）外沿：父级主体网格左右下各留 10、上留 0，
             抽屉右/上/下三边因此贴着面板边框铺开，不再四周悬空 5px、右下探出面板。 -->
        <Border x:Name="DeviceDrawer" Width="380" HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="{DynamicResource DrawerBgBrush}"
                CornerRadius="20" Margin="0,0,10,10"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ClipToBounds="True"
                BoxShadow="0 16 36 0 #2A0F172A" IsVisible="False">
            <Border.RenderTransform>
                <TranslateTransform X="0"/>
            </Border.RenderTransform>
            <!-- DockPanel：头 Dock=Top，ScrollViewer 占满剩余高度，内容超出即可滚 -->
            <DockPanel LastChildFill="True">
                <Panel DockPanel.Dock="Top" Margin="22,20,20,0">
                    <StackPanel Spacing="0">
                        <!-- 图标在左、名称在右：图标放大到与「名称 + 房间」两行同高，两者上沿对齐，
                             整套标题收成一行，不再先压一块空图标行、再在下面出名字 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <!-- 图标列：72 的方框，真机图按原比例装进去，线条占位图同比放大到 36；
                                 点一下换自定义图，右键恢复默认 -->
                            <Button Grid.Column="0" Classes="DeviceIconButton" Width="72" Height="72"
                                    Margin="0,0,16,0" VerticalAlignment="Top"
                                    Command="{Binding EditDrawerDeviceIconCommand}"
                                    ToolTip.Tip="点击自定义设备图标；右键可恢复默认">
                                <Button.ContextMenu>
                                    <ContextMenu Padding="4" MinWidth="0" FontSize="11.5">
                                        <MenuItem Theme="{StaticResource CardMenuItem}"
                                                  Header="自定义图标…"
                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditDrawerDeviceIconCommand}" />
                                        <MenuItem Theme="{StaticResource CardMenuItem}"
                                                  Header="恢复默认图标"
                                                  IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).DrawerDevice.HasCustomIcon}"
                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ResetDrawerDeviceIconCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Panel Width="72" Height="72">
                                    <Panel IsVisible="{Binding !DrawerDevice.HasCustomIcon}">
                                        <Border CornerRadius="21"
                                                IsVisible="{Binding DrawerDevice.Icon, Converter={x:Static ObjectConverters.IsNull}}">
                                            <Path Width="36" Height="36" Stretch="Uniform" StrokeThickness="1.7"
                                                  StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource Accent2Brush}"
                                                  Data="{Binding DrawerDevice, Converter={StaticResource DeviceIcon}}" />
                                        </Border>
                                        <Border Classes="DevPhoto" Width="72" Height="72"
                                                IsVisible="{Binding DrawerDevice.Icon, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <Image Source="{Binding DrawerDevice.Icon}" Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="MediumQuality" />
                                        </Border>
                                    </Panel>
                                    <!-- 自定义设备图铺满 72 圆角框，盖住真机图 / 矢量图标 -->
                                    <ctl:RoundedImage Width="72" Height="72" CornerRadius="21"
                                                      IsHitTestVisible="False"
                                                      IsVisible="{Binding DrawerDevice.HasCustomIcon}"
                                                      Source="{Binding DrawerDevice.CustomIcon.Image}" />
                                </Panel>
                            </Button>
                            <!-- 标题区：名称、房间、两颗操作胶囊上下三行，统一靠左起排。
                                 名称和房间右侧留 38，避开右上角的关闭钮；
                                 胶囊单独放宽到下面那排卡片的右沿（卡片内边距 24，本行 20+4），两者右端对齐 -->
                            <Grid Grid.Column="1" ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto"
                                  VerticalAlignment="Top" Margin="0">
                                <TextBlock Grid.Row="0" Margin="0,0,38,0" Text="{Binding DrawerDevice.Name}"
                                           FontSize="19" FontWeight="Bold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}" />
                                <!-- 房间名留在第二行左端，与名称同一左沿 -->
                                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto"
                                      Margin="0,6,38,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding DrawerDevice.RoomName}" Foreground="{DynamicResource Text3Brush}"
                                               FontSize="12.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <!-- 仅离线时提示；开/关状态不在此处展示，避免“已关闭”叠在标题区 -->
                                    <TextBlock Grid.Column="1" Classes="DevStatus" Margin="8,0,0,0"
                                               Classes.is-warn="{Binding !DrawerDevice.IsOnline}"
                                               IsVisible="{Binding !DrawerDevice.IsOnline}"
                                               Text="离线" />
                                </Grid>
                                <!-- 两颗胶囊另起一行、靠右排，右端和下面那排设备卡片的右沿对齐：「桌面」把设备放上桌面，
                                     「隐藏 / 恢复」把它从房间宫格收进列表末尾的「已隐藏」区
                                     （与卡片右键同一套动作、同一个命令） -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                            Margin="0,10,4,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <!-- 胶囊钮：加号 + 「桌面」两个字，告诉用户这颗钮是把设备放到桌面上 -->
                                    <Button Classes="IconPill"
                                            Command="{Binding AddToDesktopCommand}"
                                            CommandParameter="{Binding DrawerDevice}"
                                            ToolTip.Tip="添加到桌面组件">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Viewbox Width="13" Height="13" Stretch="Uniform"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Panel Width="24" Height="24">
                                                    <Path StrokeThickness="2" StrokeLineCap="Round"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="{StaticResource GeoPlus}" />
                                                </Panel>
                                            </Viewbox>
                                            <TextBlock Text="桌面" FontSize="12.5" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </StackPanel>
                                    </Button>
                                    <!-- 隐藏 / 恢复：未隐藏时是划掉的眼睛 + 「隐藏」，隐藏后同一颗钮变回眼睛 + 「恢复」，
                                         就地可撤销，不用再去列表末尾找 -->
                                    <Button Classes="IconPill"
                                            Command="{Binding HideDeviceCommand}"
                                            CommandParameter="{Binding DrawerDevice}"
                                            ToolTip.Tip="{Binding DrawerDevice.IsHidden, Converter={x:Static conv:BoolTextConverter.Instance}, ConverterParameter='取消隐藏，放回原房间宫格|隐藏后从房间宫格收起，可在列表末尾「已隐藏」里找回'}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Viewbox Width="13" Height="13" Stretch="Uniform"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Panel Width="24" Height="24">
                                                    <Path StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          IsVisible="{Binding !DrawerDevice.IsHidden}"
                                                          Data="M2,12 C5,7 8.5,5 12,5 C15.5,5 19,7 22,12 C19,17 15.5,19 12,19 C8.5,19 5,17 2,12 Z M12,8.6 A3.4,3.4 0 1,1 11.99,8.6 M4,4 L20,20" />
                                                    <Path StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          IsVisible="{Binding DrawerDevice.IsHidden}"
                                                          Data="M2,12 C5,7 8.5,5 12,5 C15.5,5 19,7 22,12 C19,17 15.5,19 12,19 C8.5,19 5,17 2,12 Z M12,8.6 A3.4,3.4 0 1,1 11.99,8.6" />
                                                </Panel>
                                            </Viewbox>
                                            <TextBlock FontSize="12.5" VerticalAlignment="Center"
                                                       Text="{Binding DrawerDevice.IsHidden, Converter={x:Static conv:BoolTextConverter.Instance}, ConverterParameter='恢复|隐藏'}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                    <Button Classes="ThemeBtn" Width="32" Height="32" Padding="8"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Command="{Binding CloseOverlaysCommand}" ToolTip.Tip="关闭">
                        <Path Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"
                              StrokeLineCap="Round" Data="{StaticResource GeoClose}" />
                    </Button>
                </Panel>
                <!-- 内边距挂在内容 Margin，不能写在 ScrollViewer.Padding：
                     Avalonia 11.3.9 的 Extent 不含 Padding，会算短一截导致底部滚不到 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <views:DeviceDetailView Margin="22,18,24,24" />
                </ScrollViewer>
            </DockPanel>
        </Border>
</UserControl>
