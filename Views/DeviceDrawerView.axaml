<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:MiHome.ViewModels"
    xmlns:m="clr-namespace:MiHome.Models"
    xmlns:conv="clr-namespace:MiHome.Converters"
    xmlns:ctl="clr-namespace:MiHome.Controls"
    xmlns:views="clr-namespace:MiHome.Views"
    xmlns:svc="clr-namespace:MiHome.Services"
    x:Class="MiHome.Views.DeviceDrawerView"
    x:DataType="vm:MainViewModel">
        <Border x:Name="DeviceDrawer" Width="380" HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="{DynamicResource DrawerBgBrush}"
                CornerRadius="20" Margin="0,5,5,5"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ClipToBounds="True"
                BoxShadow="0 16 36 0 #2A0F172A" IsVisible="False">
            <Border.RenderTransform>
                <TranslateTransform X="0"/>
            </Border.RenderTransform>
            <!-- DockPanel：头 Dock=Top，ScrollViewer 占满剩余高度，内容超出即可滚 -->
            <DockPanel LastChildFill="True">
                <Panel DockPanel.Dock="Top" Margin="22,20,20,0">
                    <StackPanel Spacing="0">
                        <Panel Width="56" Height="56" Margin="0,0,0,14" HorizontalAlignment="Left">
                            <Border CornerRadius="17"
                                    IsVisible="{Binding DrawerDevice.Icon, Converter={x:Static ObjectConverters.IsNull}}">
                                <Path Width="28" Height="28" Stretch="Uniform" StrokeThickness="1.7"
                                      StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource Accent2Brush}"
                                      Data="{Binding DrawerDevice, Converter={StaticResource DeviceIcon}}" />
                            </Border>
                            <Border Classes="DevPhoto" Width="56" Height="56"
                                    IsVisible="{Binding DrawerDevice.Icon, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Image Source="{Binding DrawerDevice.Icon}" Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="MediumQuality" />
                            </Border>
                        </Panel>
                        <!-- 名称/房间与「添加到桌面组件」圆钮同处一行：钮靠右并垂直居中对齐这两行文字 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="0">
                                <TextBlock Text="{Binding DrawerDevice.Name}" FontSize="19" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding DrawerDevice.RoomName}" Foreground="{DynamicResource Text3Brush}"
                                               FontSize="12.5" />
                                    <!-- 仅离线时提示；开/关状态不在此处展示，避免“已关闭”叠在标题区 -->
                                    <TextBlock Classes="DevStatus"
                                               Classes.is-warn="{Binding !DrawerDevice.IsOnline}"
                                               IsVisible="{Binding !DrawerDevice.IsOnline}"
                                               Text="离线" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="IconDisc" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding AddToDesktopCommand}"
                                    CommandParameter="{Binding DrawerDevice}"
                                    ToolTip.Tip="添加到桌面组件">
                                <Viewbox Width="14" Height="14" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Panel Width="24" Height="24">
                                        <Path StrokeThickness="2" StrokeLineCap="Round"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource GeoPlus}" />
                                    </Panel>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <Button Classes="ThemeBtn" Width="32" Height="32" Padding="8"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Command="{Binding CloseOverlaysCommand}" ToolTip.Tip="关闭">
                        <Path Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"
                              StrokeLineCap="Round" Data="{StaticResource GeoClose}" />
                    </Button>
                </Panel>
                <!-- 内边距挂在内容 Margin，不能写在 ScrollViewer.Padding：
                     Avalonia 11.3.9 的 Extent 不含 Padding，会算短一截导致底部滚不到 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <views:DeviceDetailView Margin="22,18,24,24" />
                </ScrollViewer>
            </DockPanel>
        </Border>
</UserControl>