<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MiHomeHub.ViewModels"
        xmlns:ctl="clr-namespace:MiHomeHub.Controls"
        x:Class="MiHomeHub.Views.ColorPickerWindow"
        Title="自定义调色盘"
        Width="476" Height="654"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        RenderOptions.TextRenderingMode="Antialias">

    <Window.Styles>
        <StyleInclude Source="avares://MiHomeHub/Themes/MainWindowStyles.axaml" />

        <!-- 调色盘里的常用色块：和桌面外观的色点同一套观感 -->
        <Style Selector="Button.PickerSwatch">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.PickerSwatch /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.PickerSwatch:pointerover">
            <Setter Property="Opacity" Value="0.9" />
        </Style>
    </Window.Styles>

    <ctl:DialogPopup x:Name="Dialog"
                     CardWidth="380" CardMaxHeight="540"
                     CanDrag="True"
                     Title="自定义调色盘"
                     Subtitle="色相 / 饱和度 / 明度 · 常用色"
                     IsOpen="True">
        <ctl:DialogPopup.Resources>
            <SolidColorBrush x:Key="MaskBrush" Color="Transparent" />
        </ctl:DialogPopup.Resources>

        <ctl:DialogPopup.Footer>
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                    Padding="0,14,0,0" Margin="28,0,22,20">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                               FontSize="11.5" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="BtnGhost" Content="取消"
                            Margin="8,0,8,0" Click="OnCancelClick" />
                    <Button Grid.Column="2" Classes="BtnPrimary" Content="用这个颜色"
                            Click="OnApplyClick" />
                </Grid>
            </Border>
        </ctl:DialogPopup.Footer>

        <StackPanel Spacing="12">
            <!-- 新色 / 原色预览 + 当前 HEX、RGB -->
            <Grid ColumnDefinitions="*,94" Height="56">
                <Border x:Name="PreviewNew" CornerRadius="10"
                        BorderThickness="1" BorderBrush="#33FFFFFF"
                        Background="#FF7043ED" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0"
                            Spacing="4" VerticalAlignment="Center">
                    <Border x:Name="PreviewOld" Height="18" CornerRadius="5"
                            BorderThickness="1" BorderBrush="#33FFFFFF"
                            Background="#FF101018" ToolTip.Tip="原色" />
                    <TextBlock x:Name="HexLabel" Text="#7043ED" FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="Consolas,Courier New,monospace" />
                    <TextBlock x:Name="RgbLabel" Text="112, 67, 237" FontSize="10.5"
                               Foreground="{DynamicResource Text3Brush}"
                               FontFamily="Consolas,Courier New,monospace" />
                </StackPanel>
            </Grid>

            <!-- 色相条：静态彩虹底，旋钮只改 Transform，不参与布局 -->
            <Border x:Name="HueTrack" Height="16" CornerRadius="4"
                    ClipToBounds="True" Cursor="Hand"
                    PointerPressed="OnHuePointer"
                    PointerMoved="OnHuePointer"
                    PointerReleased="OnHuePointer">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#FF0000" Offset="0" />
                        <GradientStop Color="#FFFF00" Offset="0.17" />
                        <GradientStop Color="#00FF00" Offset="0.33" />
                        <GradientStop Color="#00FFFF" Offset="0.5" />
                        <GradientStop Color="#0000FF" Offset="0.67" />
                        <GradientStop Color="#FF00FF" Offset="0.83" />
                        <GradientStop Color="#FF0000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Panel>
                    <Ellipse x:Name="HueKnob" Width="14" Height="14"
                             Stroke="White" StrokeThickness="2" Fill="#FF0000"
                             HorizontalAlignment="Left" VerticalAlignment="Center"
                             Margin="-7,0,0,0" IsHitTestVisible="False" />
                </Panel>
            </Border>

            <!-- 饱和度 × 明度：三层始终铺满，代码只改底色和准星位置 -->
            <Border x:Name="SvArea" Height="150" CornerRadius="8"
                    ClipToBounds="True" BorderThickness="1"
                    BorderBrush="#33FFFFFF" Background="#FF0000"
                    Cursor="Cross"
                    PointerPressed="OnSvPointer"
                    PointerMoved="OnSvPointer"
                    PointerReleased="OnSvPointer">
                <Panel>
                    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#FF000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="SvCursor" Width="14" Height="14" CornerRadius="7"
                            BorderThickness="2" BorderBrush="#FFFFFF"
                            Background="Transparent" IsHitTestVisible="False"
                            HorizontalAlignment="Left" VerticalAlignment="Top" />
                </Panel>
            </Border>

            <Grid ColumnDefinitions="Auto,110,*,Auto">
                <TextBlock Text="HEX" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                <TextBox x:Name="HexBox" Grid.Column="1" Height="28" Margin="8,0,0,0"
                         Padding="8,0" FontSize="11.5" MaxLength="7"
                         VerticalContentAlignment="Center"
                         Watermark="#RRGGBB"
                         TextChanged="OnHexTextChanged"
                         KeyDown="OnHexKeyDown" />
                <TextBlock Grid.Column="3" Text="支持 #RGB / #RRGGBB"
                           FontSize="10.5" Foreground="{DynamicResource Text3Brush}"
                           VerticalAlignment="Center" />
            </Grid>

            <StackPanel Spacing="8">
                <TextBlock Text="常用颜色" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}" />
                <ItemsControl x:Name="PresetList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ColorSwatch">
                            <Button Classes="PickerSwatch"
                                    Tag="{Binding Hex}" Click="OnPresetClick"
                                    ToolTip.Tip="{Binding Hex}">
                                <Panel>
                                    <Border Width="20" Height="20" CornerRadius="10"
                                            Background="{Binding Brush}"
                                            BorderThickness="1" BorderBrush="#33FFFFFF" />
                                    <Border Width="26" Height="26" CornerRadius="13"
                                            BorderThickness="2"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            IsVisible="{Binding IsSelected}" />
                                </Panel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ctl:DialogPopup>
</Window>
