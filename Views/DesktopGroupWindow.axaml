<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MiHome.ViewModels"
        xmlns:views="clr-namespace:MiHome.Views"
        x:Class="MiHome.Views.DesktopGroupWindow"
        x:DataType="vm:DesktopGroupVm"
        Title="{Binding Name}"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        Topmost="False"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        RequestedThemeVariant="Dark"
        RenderOptions.TextRenderingMode="Antialias">

    <!-- 提示条统一走全局组件 Themes/ToolTipStyles.axaml（纯白胶囊），
         本窗口不再单独定义 ToolTip 样式/资源；要换色只在本地覆盖 ToolTipBackground 等三个键。 -->

    <views:DesktopGroupView x:Name="Root" />

</Window>
