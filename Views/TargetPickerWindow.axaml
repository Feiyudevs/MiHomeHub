<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MiHomeHub.ViewModels"
        xmlns:ctl="clr-namespace:MiHomeHub.Controls"
        x:Class="MiHomeHub.Views.TargetPickerWindow"
        x:DataType="vm:TargetPickerVm"
        Title="选择设备"
        Width="956" Height="736"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        RenderOptions.TextRenderingMode="Antialias">

    <Window.Styles>
        <!-- 设备卡片：一整块有底色的卡；选中态「极淡紫底 + 1px 淡紫描边 + 主色名称」。
             底色一律画在 ContentPresenter 上（Fluent 的悬停态也是改这里，画在 Button.Background 上会被压掉） -->
        <Style Selector="Button.PickCard">
            <Setter Property="Width" Value="244" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.PickCard /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PickCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
        </Style>
        <Style Selector="Button.PickCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PickCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        </Style>
        <Style Selector="Button.PickCard.in /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PickCardOnFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PickCardOnLineBrush}" />
        </Style>
        <Style Selector="Button.PickCard.in:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PickCardOnFillHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PickCardOnLineBrush}" />
        </Style>

        <Style Selector="TextBlock.PickName">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="TextBlock.PickRoom">
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        </Style>
        <Style Selector="Button.PickCard.in TextBlock.PickName">
            <Setter Property="Foreground" Value="{DynamicResource PickCardOnTextBrush}" />
        </Style>
        <Style Selector="Path.PickIc">
            <Setter Property="Stroke" Value="{DynamicResource Text2Brush}" />
        </Style>
        <Style Selector="Button.PickCard.in Path.PickIc">
            <Setter Property="Stroke" Value="{DynamicResource PickCardOnTextBrush}" />
        </Style>
        <Style Selector="Image.PickPhoto">
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.PickCard.in Image.PickPhoto">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- 分组标题右侧的数量胶囊 -->
        <Style Selector="Border.GrpChip">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>

        <!-- 搜索输入框：外层 Border 画底色与描边，内层 TextBox 模板的边框（含聚焦高亮）全部压掉 -->
        <Style Selector="TextBox.Flat">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.Flat /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.Flat:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.Flat:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.SearchBox:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <!-- 聚焦时描边转主色：从淡线淡过去，不硬跳 -->
        <Style Selector="Border.SearchBox">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>

        <!-- 分类胶囊：单选，选中铺实心主色 -->
        <Style Selector="Button.RoomTab">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource PlayHoverFromBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.RoomTab /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="13,0" />
        </Style>
        <Style Selector="Button.RoomTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.RoomTab.on">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>
        <Style Selector="Button.RoomTab.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PickCardOnBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PickCardOnBrush}" />
        </Style>
        <Style Selector="Button.RoomTab.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PickCardOnBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PickCardOnBrush}" />
        </Style>

        <Style Selector="Button.TopIcon">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource PlayHoverFromBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        </Style>
        <Style Selector="Button.TopIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
    </Window.Styles>

    <Panel>
        <!-- 遮罩：窗口透明，只负责「点外面关掉」；窗体比卡片四周各多 58，那圈透明带留给卡片投影 -->
        <Border Name="Mask" Background="Transparent" PointerPressed="OnMaskPressed" />

        <!-- 尺寸固定：切分类只换内容，卡片不能跟着内容多少忽高忽低；
             小屏 / 高分屏下由 FitToWorkArea / FitTo 按工作区收 -->
        <Border x:Name="PickerCard" Classes="DialogCard" Width="840" Height="620"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" ClipToBounds="True">

                <!-- ===== 标题栏（可拖动）+ 关闭 ===== -->
                <Panel Name="Header" Grid.Row="0" Background="Transparent"
                       Margin="28,20,22,0" PointerPressed="OnHeaderPressed">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Margin="0,5,0,0" Text="{Binding Subtitle}" FontSize="12"
                                   Foreground="{DynamicResource Text2Brush}" />
                    </StackPanel>
                    <Button Classes="ThemeBtn" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Command="{Binding CloseCommand}" ToolTip.Tip="关闭">
                        <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="0.8"
                              StrokeLineCap="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="{StaticResource GeoClose}" />
                    </Button>
                </Panel>

                <!-- ===== 分类筛选条 ===== -->
                <ScrollViewer Grid.Row="1" Margin="28,14,22,0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PickerTab">
                                <Button Classes="RoomTab" Classes.on="{Binding IsActive}"
                                        Content="{Binding Title}" Tag="{Binding}"
                                        Click="OnRoomTabClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- ===== 工具条：搜索框 + 全部移出（仅即时提交模式） ===== -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="28,14,22,0">
                    <Border Name="SearchBoxHost" Classes="SearchBox" Height="40" CornerRadius="12"
                            Background="{DynamicResource SearchBgBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource SearchLineBrush}">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,6,0">
                            <Path Grid.Column="0" Width="15" Height="15" Stretch="Uniform"
                                  StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                  VerticalAlignment="Center"
                                  Stroke="{DynamicResource Text2Brush}"
                                  Data="{StaticResource GeoSearch}" />
                            <Grid Grid.Column="1">
                                <TextBox Name="SearchBox" Classes="Flat"
                                         Foreground="{DynamicResource TextBrush}"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         Text="{Binding SearchText, Mode=TwoWay}" />
                                <TextBlock Text="搜索设备、场景或房间…" FontSize="13" FontWeight="Normal"
                                           Margin="9,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text3Brush}"
                                           Opacity="0.72"
                                           IsHitTestVisible="False"
                                           IsVisible="{Binding !HasQuery}" />
                            </Grid>
                            <Button Grid.Column="2" Classes="TopIcon" Width="24" Height="24"
                                    Command="{Binding ClearSearchCommand}"
                                    IsVisible="{Binding HasQuery}" ToolTip.Tip="清除">
                                <Path Width="9" Height="9" Stretch="Uniform" StrokeThickness="1.2"
                                      StrokeLineCap="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="{StaticResource GeoClose}" />
                            </Button>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Classes="BtnGhost" Content="全部移出"
                            Height="36" Padding="14,0" FontSize="12.5" Margin="10,0,0,0"
                            IsVisible="{Binding ShowClearAll}"
                            Command="{Binding ClearAllCommand}" />
                </Grid>

                <!-- ===== 按房间 / 场景 / 自动化分组 + 网格卡片 ===== -->
                <ScrollViewer Name="BodyScroll" Grid.Row="3" Margin="28,14,6,10"
                              ClipToBounds="True"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,16,8">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PickerGroup">
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="2,0,0,9">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <Border Classes="GrpChip">
                                                <TextBlock Text="{Binding CountText}" FontSize="10" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Text2Brush}" />
                                            </Border>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PickerItem">
                                                    <Button Classes="PickCard" Classes.in="{Binding IsIn}"
                                                            Command="{Binding $parent[Window].((vm:TargetPickerVm)DataContext).ToggleCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <Panel Width="32" Height="32" VerticalAlignment="Center">
                                                                <Panel IsVisible="{Binding !HasCustomIcon}">
                                                                    <Border IsVisible="{Binding HasGlyph}">
                                                                        <Path Classes="PickIc" Width="18" Height="18" Stretch="Uniform"
                                                                              StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                                                              VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                              Data="{Binding Device, Converter={StaticResource DeviceIcon}}" />
                                                                    </Border>
                                                                    <Image Classes="PickPhoto" Width="32" Height="32" Source="{Binding Device.Icon}"
                                                                           Stretch="Uniform"
                                                                           RenderOptions.BitmapInterpolationMode="MediumQuality"
                                                                           IsVisible="{Binding HasPhoto}" />
                                                                    <!-- 场景 / 自动化用自带线性图标，和设备同一套描边色 -->
                                                                    <Path Classes="PickIc" Width="18" Height="18" Stretch="Uniform"
                                                                          StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                          Data="{Binding Scene.Icon}" IsVisible="{Binding IsScene}" />
                                                                </Panel>
                                                                <!-- 自定义设备图铺满 32 圆角框 -->
                                                                <ctl:RoundedImage Width="32" Height="32" CornerRadius="8"
                                                                                  IsHitTestVisible="False"
                                                                                  IsVisible="{Binding HasCustomIcon}"
                                                                                  Source="{Binding Device.CustomIcon.Image}" />
                                                            </Panel>
                                                            <StackPanel Grid.Column="1" Margin="10,0,4,0"
                                                                        VerticalAlignment="Center" Spacing="2">
                                                                <TextBlock Classes="PickName" Text="{Binding Name}" FontSize="12.5"
                                                                           FontWeight="Normal"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Classes="PickRoom" Text="{Binding Category}" FontSize="10.5"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding EmptyText}" FontSize="12" Margin="2,24,0,0"
                                   Foreground="{DynamicResource Text2Brush}"
                                   IsVisible="{Binding IsEmptyResult}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 列表底部渐隐，避免滚动时被卡片边缘一刀截断 -->
                <Border Grid.Row="3" Height="20" VerticalAlignment="Bottom"
                        Margin="28,0,6,10"
                        IsHitTestVisible="False"
                        Background="{DynamicResource DrawerBgBrush}">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="#00FFFFFF" />
                            <GradientStop Offset="0.6" Color="#99FFFFFF" />
                            <GradientStop Offset="1" Color="#FFFFFFFF" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>

                <!-- ===== 底部：取消 / 确定（只在单选与多选模式出现） ===== -->
                <Border Grid.Row="4" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                        Padding="0,12,16,0" Margin="28,0,22,18"
                        IsVisible="{Binding ShowConfirm}">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <TextBlock Text="{Binding FooterHint}" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Text3Brush}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectionText}" FontSize="11.5"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Foreground="{DynamicResource Accent2Brush}" />
                        <Button Grid.Column="2" Classes="BtnGhost" Content="取消" Margin="0,0,8,0"
                                Click="OnCancelClick" />
                        <Button Grid.Column="3" Classes="BtnPrimary" Content="{Binding ConfirmText}"
                                Click="OnConfirmClick"
                                IsEnabled="{Binding CanConfirm}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Panel>
</Window>
