<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MiHomeHub.ViewModels"
             xmlns:views="clr-namespace:MiHomeHub.Views"
             x:Class="MiHomeHub.Views.HotkeysView">
    <UserControl.Styles>
        <!-- 快捷键卡片：网格里一格，固定宽度，内容三行（键帽 / 名称 / 说明）；不描边，靠 CardBrush 的浅底分层 -->
        <Style Selector="Border.HkCard">
            <Setter Property="Width" Value="332"/>
            <Setter Property="Height" Value="112"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <!-- 组合键键帽 -->
        <Style Selector="Border.HkKey">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.HkKey">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <!-- 状态圆点：默认危险色，钩子可用时挂 .ok 变绿 -->
        <Style Selector="Ellipse.Dot">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Ellipse.Dot.ok">
            <Setter Property="Fill" Value="{DynamicResource GreenBrush}"/>
        </Style>
        <!-- 删除二次确认胶囊 -->
        <Style Selector="Button.DangerPill">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <StackPanel x:DataType="vm:MainViewModel" Margin="0,0,16,20" Spacing="14"
                MaxWidth="1040" HorizontalAlignment="Stretch">

        <!-- 页头：标题 + 说明；右侧总开关与新建入口 -->
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <!-- 徽章图标：GeoKeyboard 按 24 网格画好交给 Viewbox 等比缩放居中。Path 单独用 Stretch=Uniform 时
                     贴的是盒子左上角而不是正中，键盘包围盒 18×14 非正方形，直接缩会在徽章里偏左上 -->
                <Border Width="42" Height="42" CornerRadius="14" VerticalAlignment="Center"
                        Background="{DynamicResource AccentSoftBrush}">
                    <Viewbox Width="22" Height="22"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Panel Width="24" Height="24">
                            <Path StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round"
                                  Stroke="{DynamicResource Accent2Brush}"
                                  Data="{StaticResource GeoKeyboard}" />
                        </Panel>
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="快捷键" FontSize="19" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="全局组合键按顺序执行控制卡片；窗口收进托盘后依然生效"
                               FontSize="12" Foreground="{DynamicResource Text3Brush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="12,6"
                        ToolTip.Tip="关掉后所有组合键停止响应，绑定关系保留">
                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                        <Path Width="12" Height="12" Stretch="Uniform"
                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                              Stroke="{DynamicResource Text3Brush}" Data="{StaticResource GeoPower}" />
                        <TextBlock Text="全局快捷键" FontSize="12" FontWeight="Normal"
                                   Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                        <Button Classes="Switch" Classes.on="{Binding HotkeysEnabled}"
                                VerticalAlignment="Center" Command="{Binding ToggleHotkeysCommand}" />
                    </StackPanel>
                </Border>

                <Button Classes="BtnGhost" Height="34" Padding="12,0"
                        Click="OnNewHotkeyClick" IsEnabled="{Binding !IsHotkeyEditorOpen}"
                        ToolTip.Tip="在弹窗里加控制卡片、录一组组合键">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Width="11" Height="11" Stretch="Uniform"
                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                              Stroke="{DynamicResource Text2Brush}"
                              Data="{StaticResource GeoPlus}" />
                        <TextBlock Text="新建快捷键" FontSize="12" FontWeight="Normal" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 状态条：钩子状态 / 已绑定数量 / 最近触发，一行读完 -->
        <StackPanel Orientation="Horizontal" Spacing="9" Margin="2,0,0,0">
            <Ellipse Classes="Dot" Classes.ok="{Binding HotkeyHookAvailable}" />
            <TextBlock Text="{Binding HotkeyHookStateText}" FontSize="11.5"
                       Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
            <TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource Text3Brush}" />
            <TextBlock Text="{Binding HotkeyCountText}" FontSize="11.5"
                       Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
            <TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource Text3Brush}"
                       IsVisible="{Binding HasHotkeyLast}" />
            <TextBlock Text="{Binding HotkeyLastText}" FontSize="11.5"
                       Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center"
                       IsVisible="{Binding HasHotkeyLast}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- 列表标题行 -->
        <Grid ColumnDefinitions="*,Auto" Margin="2,2,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="已绑定" FontSize="14.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                <Border Classes="MiniTag" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HotkeyCountText}" FontSize="10.5" FontWeight="Bold"
                               Foreground="{DynamicResource Accent2Brush}" />
                </Border>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="点卡片上的铅笔改组合键与卡片，开关单独停用"
                       Classes="Hint" VerticalAlignment="Center"
                       IsVisible="{Binding HasHotkeys}" />
        </Grid>

        <Panel>
            <ItemsControl ItemsSource="{Binding HotkeyItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HotkeyItemVm">
                        <Border Classes="HkCard">
                            <Grid RowDefinitions="Auto,*,Auto" ClipToBounds="True">
                                <!-- 第一行：键帽 + 右上角操作（编辑 / 删除同色图标） -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
                                    <Border Classes="HkKey" MaxWidth="150">
                                        <TextBlock Text="{Binding ComboText}" Classes="HkKey"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <Button Grid.Column="2" Classes="IconBtn" Width="26" Height="26"
                                            VerticalAlignment="Center" Margin="0,0,2,0"
                                            Click="OnEditHotkeyClick" Tag="{Binding}"
                                            ToolTip.Tip="编辑组合键与控制卡片">
                                        <Path Width="11" Height="11" Stretch="Uniform"
                                              StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                              Stroke="{DynamicResource Text3Brush}"
                                              Data="M4,20 L4,16 L16,4 L20,8 L8,20 Z M14,6 L18,10" />
                                    </Button>

                                    <Button Grid.Column="3" Classes="IconBtn" Width="26" Height="26"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding !IsConfirmingDelete}"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveHotkeyCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="删除这条快捷键">
                                        <Path Width="10" Height="10" Stretch="Uniform"
                                              StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                              Stroke="{DynamicResource Text3Brush}"
                                              Data="{StaticResource GeoClose}" />
                                    </Button>

                                    <Button Grid.Column="3" Classes="DangerPill" Width="58"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsConfirmingDelete}"
                                            Content="确认删除"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveHotkeyCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="再次点击即删除；3 秒后自动取消" />
                                </Grid>

                                <!-- 第二行：目标名称 + 缺失标记 -->
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,9,0,0">
                                    <TextBlock Text="{Binding TargetText}" FontSize="13.5" FontWeight="Normal"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Classes="MiniTag" Margin="6,0,0,0"
                                            IsVisible="{Binding IsMissing}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MissingText}" FontSize="10" FontWeight="Normal"
                                                   Foreground="{DynamicResource DangerBrush}" />
                                    </Border>
                                </Grid>

                                <!-- 第三行：动作说明（左）+ 启用开关（右下角） -->
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding SubText}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text3Brush}" />
                                    <Button Grid.Column="1" Classes="Switch" Classes.on="{Binding IsEnabled}"
                                            VerticalAlignment="Center"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleHotkeyEnabledCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="启用 / 停用这条快捷键" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <views:EmptyState IsVisible="{Binding !HasHotkeys}"
                              Icon="{StaticResource GeoKeyboard}"
                              Title="还没有快捷键"
                              Description="点右上角「新建快捷键」，在弹窗里加控制卡片、录一组组合键，即可全局控制" />
        </Panel>
    </StackPanel>
</UserControl>
