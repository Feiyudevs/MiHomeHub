<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MiHome.ViewModels"
        x:Class="MiHome.Views.DesktopRenameWindow"
        x:DataType="vm:DesktopZoneVm"
        Title="重命名分区"
        Width="180" Height="18" MinHeight="0"
        SystemDecorations="None" CanResize="False"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        RenderOptions.TextRenderingMode="Antialias"
        RequestedThemeVariant="Light">

    <Window.Styles>
        <Style Selector="TextBox.ZoneNameEdit">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- 去掉 Fluent 自己的底与描边，只留光标与选区；但控件级 MinHeight=32 压不掉，
             真正生效的是下面 NameBox 元素上的本地 MinHeight="0"（本地值优先级最高）。 -->
        <Style Selector="TextBox.ZoneNameEdit /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TextBox.ZoneNameEdit:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Styles>

    <Border Name="Card"
            Background="#CCFFFFFF"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="4"
            Height="18" VerticalAlignment="Top" ClipToBounds="True"
            BoxShadow="0 1 3 0 #1A0F172A, 0 6 18 0 #260F172A">
        <TextBox Name="NameBox" Classes="ZoneNameEdit" MaxLength="24" Watermark="分区名称"
                 MinHeight="0" MaxHeight="18" Height="18" VerticalAlignment="Center" />
    </Border>
</Window>
