<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MiHome.ViewModels"
             x:Class="MiHome.Views.DesktopGroupView"
             x:DataType="vm:DesktopZoneVm"
             ClipToBounds="False">

    <UserControl.Styles>
        <!-- 图标按钮（DskIcon）与分区设备卡的玻璃覆盖分别在全局 ControlStyles 与
             DesktopDevicesPanel 里：贴桌面的分区窗、它的菜单/音量浮层都是独立 Window，
             取不到视图内局部样式，公共按钮样式只能放全局。 -->
        <!-- 内容区边距必须写在样式里、不能写在元素上：元素上的 Margin 是本地值，优先级高于
             样式 Setter，会让下面 .media 这条永远不生效（之前「改了没反应」就是这个原因）。
             设备分区有 44 高标题栏，内容顶部只用 8；媒体分区没有标题栏，四边统一 12。 -->
        <Style Selector="StackPanel.ZoneBody">
            <Setter Property="Margin" Value="12,8,12,12" />
        </Style>
        <Style Selector="StackPanel.ZoneBody.media">
            <Setter Property="Margin" Value="12" />
        </Style>
        <!-- 这里刻意不给 TextBlock 加轮廓阴影（试过，已撤）：Avalonia 的 DropShadowEffect
             对 12.5px 小字相当于每笔画外糊一圈 9px 灰雾，在中等亮度的磨砂底上会整片发脏。
             DeskBox 也开了文字阴影，但它的背景是 60~145 的暗底，黑影落在上面本来就看不见；
             它读得清靠的是背景暗，不是阴影。本程序的对比度由 CardBrush 的浓度负责，
             不在文字上加任何第二层。 -->
    </UserControl.Styles>

    <Panel>
        <!-- CornerRadius 必须 = 8：DWM 圆角固定 8 DIP，两层曲线重合才不会在角部露出硬边。
             媒体分区没有标题栏，整张卡就是拖动面（按下落在按钮上时由按钮自己吃掉事件） -->
        <Border Name="Card" CornerRadius="8"
                Background="{Binding CardBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                PointerPressed="OnBodyPressed"
                PointerMoved="OnBodyMoved"
                PointerReleased="OnBodyReleased"
                PointerCaptureLost="OnBodyCaptureLost">
            <Grid RowDefinitions="Auto,*">

                <!-- ===== 标题栏：拖动区（展开的媒体分区隐藏，折叠后保留展开入口） ===== -->
                <Border Grid.Row="0" Name="Header" Height="44" Background="Transparent"
                        IsVisible="False"
                        PointerPressed="OnHeaderPressed"
                        PointerMoved="OnHeaderMoved"
                        PointerReleased="OnHeaderReleased"
                        PointerCaptureLost="OnHeaderCaptureLost">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0,12,0">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Border Width="5" Height="13" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource Accent2Brush}" />
                            <!-- 名称：双击进入改名（浮层是独立窗口，见 DesktopRenameWindow） -->
                            <Grid Name="TitleNameHost" VerticalAlignment="Center" MaxWidth="150">
                                <TextBlock Name="TitleText" Text="{Binding Name}" FontSize="12.5"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Opacity="{Binding TitleOpacity}"
                                           MaxWidth="150" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource DskTextBrush}" />
                            </Grid>
                            <Border CornerRadius="999" Height="16" Padding="6,0" VerticalAlignment="Center"
                                    Background="#1FFFFFFF" IsVisible="{Binding ShowCount}"
                                    Opacity="{Binding TitleOpacity}">
                                <TextBlock Text="{Binding CountText}" FontSize="10" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource DskText2Brush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                            <!-- 置顶图钉：摘掉 Progman 从属、浮到所有窗口之上；再点一次放回桌面层。
                                 选中态只换图标颜色（同一族状态控件的做法），不加底色、不加勾 -->
                            <Button Classes="DskIcon" Classes.pin="{Binding IsTopmost}"
                                    Click="OnPinClick" ToolTip.Tip="置顶 / 放回桌面">
                                <Viewbox Width="15" Height="15" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Panel Width="24" Height="24">
                                        <Path StrokeThickness="1.92" StrokeLineCap="Round" StrokeJoin="Round"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource GeoPin}" />
                                    </Panel>
                                </Viewbox>
                            </Button>
                            <!-- 折叠 / 展开：chevron 旋转 90ms，与内容淡出同步。
                                 图标一律走「Viewbox 缩放的 24 网格 Panel」——Path 单独用 Stretch 时是按几何包围盒
                                 对齐的，非正方几何（chevron 是 12×6）在框里会偏；套一层 24 网格才真正居中。
                                 StrokeThickness 用 1.92（24 网格坐标）= 15px 下 1.2px，与主窗口图标同线宽 -->
                            <Button Name="CollapseBtn" Classes="DskIcon" Click="OnCollapseClick"
                                    ToolTip.Tip="折叠 / 展开">
                                <Viewbox Width="15" Height="15" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         RenderTransformOrigin="50%,50%">
                                    <Viewbox.RenderTransform>
                                        <RotateTransform Angle="{Binding CollapseArrowAngle}">
                                            <RotateTransform.Transitions>
                                                <Transitions>
                                                    <DoubleTransition Property="Angle" Duration="0:0:0.09" />
                                                </Transitions>
                                            </RotateTransform.Transitions>
                                        </RotateTransform>
                                    </Viewbox.RenderTransform>
                                    <Panel Width="24" Height="24">
                                        <Path StrokeThickness="1.92" StrokeLineCap="Round" StrokeJoin="Round"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource GeoChevron}" />
                                    </Panel>
                                </Viewbox>
                            </Button>
                            <!-- 添加设备只在设备分区出现；媒体分区换音箱是点卡里那一行音箱 -->
                            <!-- 加号同时管设备和场景，具体加什么在弹窗顶部分组条里切 -->
                            <Button Classes="DskIcon" Click="OnAddDeviceClick" IsVisible="{Binding !IsMedia}"
                                    ToolTip.Tip="添加设备 / 场景">
                                <Viewbox Width="15" Height="15" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Panel Width="24" Height="24">
                                        <Path StrokeThickness="1.92" StrokeLineCap="Round" StrokeJoin="Round"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource GeoPlus}" />
                                    </Panel>
                                </Viewbox>
                            </Button>
                            <!-- 分区菜单：点开一个贴着按钮的菜单窗口（默认在下方） -->
                            <Button Name="MenuBtn" Classes="DskIcon" Click="OnMenuClick" ToolTip.Tip="分区菜单">
                                <StackPanel Orientation="Horizontal" Spacing="2.4"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="2.4" Height="2.4"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Ellipse Width="2.4" Height="2.4"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Ellipse Width="2.4" Height="2.4"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== 内容区：展开时才创建设备/场景宫格或媒体卡，淡出完成后卸载整棵子树 =====
                     边距由上面 ZoneBody / ZoneBody.media 两条样式控制（媒体分区四边 12，与标题栏留白对齐） -->
                <StackPanel Grid.Row="1" Classes="ZoneBody" Classes.media="{Binding IsMedia}"
                            IsVisible="{Binding ContentVisible}"
                            Opacity="{Binding ContentOpacity}">
                    <StackPanel.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.08" />
                        </Transitions>
                    </StackPanel.Transitions>
                    <!-- 不使用 ContentControl 的模板回收缓存；Child=null 即解除对内容树的引用。 -->
                    <Border Name="ZoneContentHost" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 宽度拖拽条：左右缘各一条，贴在卡片外沿，不抢卡片内容区的命中。
             左缘拉伸时右边缘钉住，宿主窗口同时改 X 与宽度。 -->
        <Border Name="ResizeGripLeft" Width="7" HorizontalAlignment="Left"
                Background="Transparent" Cursor="SizeWestEast"
                PointerPressed="OnResizeLeftPressed"
                PointerMoved="OnResizeLeftMoved"
                PointerReleased="OnResizeLeftReleased"
                PointerCaptureLost="OnResizeLeftCaptureLost" />
        <Border Name="ResizeGrip" Width="7" HorizontalAlignment="Right"
                Background="Transparent" Cursor="SizeWestEast"
                PointerPressed="OnResizePressed"
                PointerMoved="OnResizeMoved"
                PointerReleased="OnResizeReleased"
                PointerCaptureLost="OnResizeCaptureLost" />
    </Panel>
</UserControl>
