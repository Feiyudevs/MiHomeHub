<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MiHome.ViewModels"
        xmlns:ctl="clr-namespace:MiHome.Controls"
        x:Class="MiHome.Views.ActionEditorWindow"
        x:DataType="vm:MainViewModel"
        Title="添加动作"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        RenderOptions.TextRenderingMode="Antialias">
    <!-- 添加动作弹窗：① 设备 → ② 属性 → ③ 值，跟触发条件弹窗同一套做法（独立窗体 + 居中卡片）。
         状态都挂在主视图模型上，「添加 / 取消」直接复用 ConfirmAddAction / CancelAddAction。 -->
    <Window.Styles>
        <StyleInclude Source="avares://MiHome/Themes/MainWindowStyles.axaml" />
    </Window.Styles>

    <ctl:DialogPopup x:Name="EditorPopup" CardWidth="500" CardMaxHeight="640"
                     CanDrag="False"
                     Title="添加动作"
                     Subtitle="选类型 → 按类型填写，添加后追加到执行顺序末尾"
                     IsOpen="{Binding IsActionEditorOpen}"
                     CloseCommand="{Binding CancelAddActionCommand}">

        <ctl:DialogPopup.Footer>
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                    Padding="0,14,0,0" Margin="28,0,22,20">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="保存场景后才会写入米家云端" FontSize="10.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Text3Brush}" />
                    <Button Grid.Column="1" Classes="BtnGhost" Content="取消" Margin="0,0,8,0"
                            Command="{Binding CancelAddActionCommand}" />
                    <Button Grid.Column="2" Classes="BtnPrimary" Content="添加"
                            Command="{Binding ConfirmAddActionCommand}"
                            IsEnabled="{Binding HasActionDraft}" />
                </Grid>
            </Border>
        </ctl:DialogPopup.Footer>

        <StackPanel Spacing="14">
            <StackPanel Spacing="6">
                <TextBlock Classes="SecLabel" Text="① 动作类型" />
                <ctl:OptionPicker Classes="wide"
                                  Options="{Binding ActionKindOptions}"
                                  SelectedValue="{Binding SelectedActionKindValue, Mode=TwoWay}" />
            </StackPanel>

            <!-- 类型 = 设备：选设备 → 选属性 → 设值 -->
            <StackPanel Spacing="6" IsVisible="{Binding IsActionKindDevice}">
                <TextBlock Classes="SecLabel" Text="② 设备" />
                <!-- 点一下弹「选择设备」窗（与触发条件弹窗同一套卡片网格），选完回填并联动加载 ③ 属性 -->
                <Button Classes="DevPick" Click="OnPickDeviceClick"
                        ToolTip.Tip="从设备列表里选一台">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding ActionDeviceLabel}" FontSize="13"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Path Grid.Column="1" Width="12" Height="12" Stretch="Uniform"
                              StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                              VerticalAlignment="Center" Margin="8,0,0,0"
                              Stroke="{DynamicResource Text3Brush}"
                              Data="{StaticResource GeoArrow}" />
                    </Grid>
                </Button>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding IsActionKindDevice}"
                        IsEnabled="{Binding HasActionCapabilities}">
                <TextBlock Classes="SecLabel" Text="③ 属性" />
                <ctl:OptionPicker Classes="wide"
                                  Options="{Binding ActionCapabilityOptions}"
                                  SelectedValue="{Binding SelectedActionCapabilityKey, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding IsActionKindDevice}">
                <TextBlock Classes="SecLabel"
                           IsVisible="{Binding HasActionDraft}" Text="④ 值" />
                <Panel>
                    <ToggleButton Classes="Switch" HorizontalAlignment="Left"
                                  IsVisible="{Binding DraftIsBool}"
                                  IsChecked="{Binding ActionDraftValue.BoolValue, Mode=TwoWay}" />
                    <NumericUpDown IsVisible="{Binding DraftIsNumber}" Width="140"
                                   HorizontalAlignment="Left"
                                   Minimum="{Binding DraftMin}"
                                   Maximum="{Binding DraftMax}"
                                   Increment="{Binding DraftStep}"
                                   FormatString="0.##"
                                   Value="{Binding ActionDraftValue.NumValue, Mode=TwoWay}" />
                    <!-- 枚举值也走自绘 OptionPicker，和面板里的下拉保持同一套外观 / 交互 -->
                    <ctl:OptionPicker IsVisible="{Binding DraftIsOption}" Width="180"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Options="{Binding ActionDraftValue.OptionItems}"
                                      SelectedValue="{Binding ActionDraftValue.OptionValue, Mode=TwoWay}" />
                    <TextBox IsVisible="{Binding DraftIsText}" Height="32"
                             Text="{Binding ActionDraftValue.TextValue, Mode=TwoWay}"
                             Watermark="要写入的文字" />
                </Panel>
            </StackPanel>

            <!-- 类型 = 延时：秒数写进「下一条添加的动作」的 delay_time -->
            <StackPanel Spacing="6" IsVisible="{Binding IsActionKindDelay}">
                <TextBlock Classes="SecLabel" Text="② 等待时长" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumericUpDown Width="140" Minimum="1" Maximum="86400" Increment="10"
                                   FormatString="0"
                                   Value="{Binding ActionDelaySeconds, Mode=TwoWay}" />
                    <TextBlock Text="秒" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text2Brush}" />
                </StackPanel>
            </StackPanel>

            <!-- 类型 = 执行场景：挑一条手动场景 -->
            <StackPanel Spacing="6" IsVisible="{Binding IsActionKindScene}">
                <TextBlock Classes="SecLabel" Text="② 目标场景" />
                <ctl:OptionPicker Classes="wide"
                                  Options="{Binding ActionSceneOptions}"
                                  SelectedValue="{Binding SelectedActionSceneId, Mode=TwoWay}" />
            </StackPanel>

            <TextBlock Text="{Binding ActionEditorHint}" FontSize="11.5" TextWrapping="Wrap"
                       IsVisible="{Binding ActionEditorHint,
                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource Text3Brush}" />

            <TextBlock Text="正在读取设备能力…" FontSize="11.5"
                       IsVisible="{Binding ActionEditorBusy}"
                       Foreground="{DynamicResource Text3Brush}" />
        </StackPanel>
    </ctl:DialogPopup>
</Window>
