<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:MiHome.Models"
             xmlns:vm="clr-namespace:MiHome.ViewModels"
             xmlns:ctl="clr-namespace:MiHome.Controls"
             xmlns:views="clr-namespace:MiHome.Views"
             x:Class="MiHome.Views.RoomsView">
    <!-- 右 16 内距 + 底 20 内距：右侧是给页面滚动条让出的空白（Carousel 右外距 6 + 16 = 原 22，正文宽度不变），
         底部留白只在滚到末尾时露出来，静止时不占版面 -->
    <StackPanel x:DataType="vm:MainViewModel" Margin="0,0,16,20">
    <!-- 房间横幅 -->
    <Border CornerRadius="20" Padding="22,20" Margin="0,0,0,18"
            Background="{DynamicResource BannerBrush}">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding BannerTitle}" FontSize="19" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="{Binding BannerDesc}" FontSize="12.5" Margin="0,6,0,0"
                           Foreground="{DynamicResource Text2Brush}" />
                <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Classes="RbNum" Text="{Binding BannerTotal}" />
                        <TextBlock Classes="RbLab" Text="设备总数" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="RbNum" Text="{Binding BannerOn}"
                                   Foreground="{DynamicResource GreenBrush}" />
                        <TextBlock Classes="RbLab" Text="当前开启" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="RbNum" Text="{Binding BannerOffline}"
                                   Foreground="{DynamicResource AmberBrush}" />
                        <TextBlock Classes="RbLab" Text="离线" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Width="120" Height="120" CornerRadius="30"
                    Background="{DynamicResource Surface4Brush}" VerticalAlignment="Center">
                <Panel>
                    <!-- 与侧栏房间图标共用同一套 key 和两种画法：玻璃模式取多色 SVG，细线模式取线稿 -->
                    <Image Width="76" Height="76" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding IconGlass}"
                           Source="{Binding BannerIconKey, Converter={StaticResource NavSvg}}" />
                    <Viewbox Width="76" Height="76" Stretch="Uniform"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding !IconGlass}">
                        <Panel Width="24" Height="24">
                            <Path Width="24" Height="24" Stretch="None"
                                  Stroke="{DynamicResource NavActiveTextBrush}" StrokeThickness="0.9"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="{Binding BannerIconKey, Converter={StaticResource NavLine}}" />
                        </Panel>
                    </Viewbox>
                </Panel>
            </Border>
        </Grid>
    </Border>
    <ItemsControl ItemsSource="{Binding SkeletonSlots}"
                  ItemTemplate="{StaticResource SkeletonCardTemplate}"
                  IsVisible="{Binding ShowSkeleton}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <ctl:AdaptiveGridPanel MinItemWidth="240" Spacing="0" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
    <ctl:RecyclingItemsControl ItemsSource="{Binding Devices}" IsVisible="{Binding !ShowSkeleton}"
                  ItemTemplate="{StaticResource DeviceCardTemplate}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <!-- 虚拟化自适应网格：仅生成视口内可见的卡片容器 -->
                <ctl:VirtualizingAdaptiveGridPanel MinItemWidth="240" Spacing="0" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ctl:RecyclingItemsControl>
    <TextBlock Classes="Hint" Text="该房间暂无匹配设备" HorizontalAlignment="Center"
               Margin="0,40" IsVisible="{Binding ShowEmptyHint}" />
    </StackPanel>
</UserControl>
