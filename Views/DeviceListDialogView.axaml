<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MiHome.ViewModels"
             xmlns:ctl="clr-namespace:MiHome.Controls"
             x:Class="MiHome.Views.DeviceListDialogView"
             x:DataType="vm:MainViewModel">
    <!-- 统计卡共用的设备清单弹窗（灯光卡 = 全屋灯，在线卡 = 离线设备）。
         正文复用主窗口那张设备卡，动作仍由 MainViewModel(IDeviceCardHost) 接：点卡开抽屉、点电源键下发开关。 -->
    <ctl:DialogPopup CardWidth="620" CardMaxHeight="660"
                     Title="{Binding StatListTitle}" Subtitle="{Binding StatListSubtitle}"
                     IsOpen="{Binding IsStatListOpen}"
                     CloseCommand="{Binding CloseStatListCommand}">
        <!-- 类型卡的全关：挨着关闭钮放，批量下发只打清单里「在线且开」的那几台 -->
        <ctl:DialogPopup.HeaderActions>
            <Button Classes="HeaderAct" Command="{Binding CloseAllStatDevicesCommand}"
                    IsVisible="{Binding CanCloseAllStatDevices}"
                    ToolTip.Tip="{Binding CloseAllStatTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.4"
                          StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="{StaticResource GeoPower}"/>
                    <TextBlock Text="全关" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </StackPanel>
            </Button>
        </ctl:DialogPopup.HeaderActions>
        <Grid>
            <ItemsControl ItemsSource="{Binding StatDevices}" ItemTemplate="{StaticResource DeviceCardTemplate}"
                          IsVisible="{Binding HasStatDevices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctl:AdaptiveGridPanel MinItemWidth="240" Spacing="0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Classes="Hint" Text="{Binding StatListEmptyText}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       IsVisible="{Binding !HasStatDevices}" />
        </Grid>
    </ctl:DialogPopup>
</UserControl>
