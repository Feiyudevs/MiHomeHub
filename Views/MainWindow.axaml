<Window 
    
    
    xmlns="https://github.com/avaloniaui"
    
    
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
    
    xmlns:vm="clr-namespace:MiHome.ViewModels"
    
    
    xmlns:m="clr-namespace:MiHome.Models"
    
    
    xmlns:conv="clr-namespace:MiHome.Converters"
    
    
    xmlns:ctl="clr-namespace:MiHome.Controls"
    
    
    xmlns:views="clr-namespace:MiHome.Views"
    
    
    xmlns:svc="clr-namespace:MiHome.Services"
        x:Class="MiHome.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="米家 · 控制中心"
        Icon="/Assets/logo.ico"
        Width="1280" Height="800"
        MinWidth="980" MinHeight="620"
        Background="{DynamicResource BgBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="60"
        KeyDown="OnKeyDown">
    <Window.Styles>
        <StyleInclude Source="avares://MiHome/Themes/MainWindowStyles.axaml" />
    </Window.Styles>
    <Grid RowDefinitions="60,*">
        <!-- ================= 标题栏 60（§8.1） ================= -->
        <Grid Grid.Row="0" x:Name="TitleBar" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
              Background="{DynamicResource BgBrush}" Margin="16,0,12,0"
              PointerPressed="OnTitleBarPressed">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Width="22" Height="22" Source="{StaticResource LogoImage}"
                       VerticalAlignment="Center" />
                <TextBlock Text="米家 · 控制中心" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                <Border Classes="TbTag">
                    <TextBlock Text="智能家居" />
                </Border>
            </StackPanel>
            <!-- 账户区：家庭名与登录收进一个全圆角胶囊，放在搜索框左侧，规格与搜索框一致（32 高） -->
            <Border Grid.Column="1" Classes="AccountGroup" Margin="18,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Classes="AccountChip" x:Name="HomeChipBtn"
                            ToolTip.Tip="{Binding HomeChipTip}">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft"
                                    ShowMode="TransientWithDismissOnPointerMoveAway">
                                <!-- 不用 BoxShadow：Avalonia 阴影会按直角矩形外扩，盖住圆角 -->
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="14"
                                        Padding="8" MinWidth="188" MaxWidth="260"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="切换家庭" FontSize="11" Margin="10,4,10,6"
                                                   Foreground="{DynamicResource Text3Brush}" />
                                        <ItemsControl ItemsSource="{Binding HomeOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="m:HomeOption">
                                                    <Button Classes="HomeMenuItem" Classes.is-on="{Binding IsSelected}"
                                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SwitchHomeCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{Binding Name}">
                                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- 与侧栏 house 图标同一份细线几何 -->
                            <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.6"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Stroke="{DynamicResource Text2Brush}"
                                  Data="{x:Static svc:NavIcons.HouseLine}"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HomeName}" FontSize="12"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       MaxWidth="120" />
                            <!-- 绿点只在已登录时出现；未登录状态由右侧「登录」表达 -->
                            <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                     Fill="{DynamicResource GreenBrush}"
                                     IsVisible="{Binding IsLoggedIn}" />
                            <!-- 仅多家庭时显示下拉箭头 -->
                            <Path Width="8" Height="8" Stretch="Uniform" Margin="1,0,0,0"
                                  VerticalAlignment="Center" Stroke="{DynamicResource Text3Brush}"
                                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="M6 9 L12 15 L18 9"
                                  IsVisible="{Binding CanSwitchHome}" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="12" Margin="2,0" VerticalAlignment="Center"
                            Background="{DynamicResource LineBrush}"
                            IsVisible="{Binding !IsLoggedIn}" />
                    <Button Classes="AccountLogin" Command="{Binding LoginCommand}"
                            IsVisible="{Binding !IsLoggedIn}"
                            ToolTip.Tip="登录">
                        <TextBlock Text="登录" FontSize="12"
                                   Foreground="{DynamicResource Accent2Brush}" />
                    </Button>
                </StackPanel>
            </Border>
            <!-- 标题栏左侧两个音箱入口：弱化主色胶囊，紧贴「我的家庭」右侧，与家庭胶囊同高；仅检测到音箱时出现 -->
            <!-- 浮层左沿与本胶囊左沿对齐（打开时由 MainWindow 计算并传入） -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0"
                        VerticalAlignment="Center">
                <Button x:Name="XiaoAiBtn" Classes="XiaoAiCapsule"
                        Classes.open="{Binding IsVoiceOpen}"
                        IsVisible="{Binding HasSpeaker}"
                        Command="{Binding ToggleVoiceCommand}" ToolTip.Tip="小爱语音指令">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="11,0" HorizontalAlignment="Center">
                        <ctl:VoiceBars Width="14" Height="14" VerticalAlignment="Center"
                                       BarBrush="{Binding $parent[Button].Foreground}"
                                       IsActive="{Binding HasSpeaker}"
                                       IsBusy="{Binding IsVoiceSending}" />
                        <TextBlock Text="小爱同学" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- 音乐：未播放时只是一个入口；正在播放时把名称就地换成上一曲/暂停/下一曲，就地可操作 -->
                <Button x:Name="MusicBtn" Classes="MusicCapsule"
                        Classes.open="{Binding IsMusicOpen}"
                        IsVisible="{Binding HasSpeaker}"
                        Command="{Binding ToggleMusicCommand}" ToolTip.Tip="音箱播放控制">
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="9,0" HorizontalAlignment="Center">
                        <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                            <Panel Width="24" Height="24">
                                <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      Data="{StaticResource GeoMusic}" />
                            </Panel>
                        </Viewbox>
                        <TextBlock Text="音乐" VerticalAlignment="Center" Margin="2,0"
                                   IsVisible="{Binding !MediaSpeaker.IsPlaying}" />
                        <StackPanel Orientation="Horizontal" Spacing="1"
                                    IsVisible="{Binding MediaSpeaker.IsPlaying}">
                            <Button Classes="CapBtn" ToolTip.Tip="上一曲"
                                    Command="{Binding MediaPreviousCommand}">
                                <Viewbox Width="15" Height="15">
                                    <Panel Width="24" Height="24">
                                        <Path Fill="{Binding $parent[Button].Foreground}"
                                              Data="{StaticResource GeoPrevTrack}" />
                                    </Panel>
                                </Viewbox>
                            </Button>
                            <Button Classes="CapBtn" ToolTip.Tip="暂停"
                                    Command="{Binding MediaTogglePlayCommand}">
                                <Viewbox Width="15" Height="15">
                                    <Panel Width="24" Height="24">
                                        <Path Fill="{Binding $parent[Button].Foreground}"
                                              Data="{StaticResource GeoPauseIc}" />
                                    </Panel>
                                </Viewbox>
                            </Button>
                            <Button Classes="CapBtn" ToolTip.Tip="下一曲"
                                    Command="{Binding MediaNextCommand}">
                                <Viewbox Width="15" Height="15">
                                    <Panel Width="24" Height="24">
                                        <Path Fill="{Binding $parent[Button].Foreground}"
                                              Data="{StaticResource GeoNextTrack}" />
                                    </Panel>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>
            <!-- 搜索：圆形按钮本身就地展开成输入框，点击时宽度从 32 长到 252 -->
            <Border Grid.Column="3" x:Name="SearchBox" Classes="SearchBox" Margin="12,0,0,0"
                    Focusable="True" IsTabStop="False"
                    PointerPressed="OnSearchBoxPressed">
                <Grid ColumnDefinitions="30,*">
                    <!-- 放大镜固定在左端 30px 内圈正中：24 栅格原坐标 + Viewbox 等比缩放，
                         不能让 Path 自己 Stretch，否则几何原点不归零会整体偏移 -->
                    <Viewbox Width="20" Height="20"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Panel Width="24" Height="24">
                            <Path StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="{StaticResource GeoSearch}" />
                        </Panel>
                    </Viewbox>
                    <TextBox Grid.Column="1" x:Name="SearchInput" Classes="SearchInline"
                             MinWidth="0" Height="30" VerticalAlignment="Center"
                             IsTabStop="False"
                             Watermark="搜索设备、房间…" Text="{Binding SearchText}"
                             KeyDown="OnSearchKeyDown" LostFocus="OnSearchLostFocus" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 特效测试开关：定位内存占用用（关闭所有阴影/光晕 + 强制 GC） -->
                <Button x:Name="FxBadge" Classes="ThemeBtn" Margin="0,0,6,0" Click="OnToggleFxClick"
                        ToolTip.Tip="测试：关闭所有阴影/光晕并强制回收内存（再点恢复）">
                    <TextBlock Text="特效" FontSize="11" FontWeight="SemiBold" />
                </Button>
                <Button Classes="ThemeBtn" Margin="0,0,6,0" Command="{Binding OpenLogCommand}" ToolTip.Tip="操作日志">
                    <Path Width="15" Height="15" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round"
                          Data="{StaticResource GeoLog}" />
                </Button>
                <Button Classes="ThemeBtn" Margin="0,0,6,0" Command="{Binding ToggleThemeCommand}"
                        ToolTip.Tip="切换浅色/深色 (T)">
                    <Panel>
                        <Path Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"
                              StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource GeoMoon}"
                              IsVisible="{Binding IsDark}" />
                        <Path Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"
                              StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource GeoSun}"
                              IsVisible="{Binding !IsDark}" />
                    </Panel>
                </Button>
                <Button Classes="ThemeBtn" Margin="0,0,6,0" Click="OnGotoSettings" ToolTip.Tip="设置">
                    <Path Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"
                          StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource GeoCog}" />
                </Button>
                <Button Classes="WinBtn" Click="OnMinClick" ToolTip.Tip="最小化">
                    <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Panel Width="24" Height="24">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.06"
                                  StrokeLineCap="Round" Data="{StaticResource GeoMin}" />
                        </Panel>
                    </Viewbox>
                </Button>
                <Button Classes="WinBtn" Click="OnMaxClick" ToolTip.Tip="最大化 / 还原">
                    <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Panel Width="24" Height="24">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.06"
                                  StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource GeoMax}" />
                        </Panel>
                    </Viewbox>
                </Button>
                <Button Classes="WinBtn close" Click="OnCloseClick" ToolTip.Tip="关闭">
                    <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Panel Width="24" Height="24">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.06"
                                  StrokeLineCap="Round" Data="{StaticResource GeoClose}" />
                        </Panel>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>
        <!-- ================= 主体：侧栏 + 内容面板 ================= -->
        <Grid Grid.Row="1" ColumnDefinitions="180,*" Margin="10,0,10,10">
            <!-- 侧栏 -->
            <DockPanel Grid.Column="0" Margin="10,10,10,0">
                <StackPanel DockPanel.Dock="Top">
                    <Button Classes="NavRow" Classes.on="{Binding SelectedNavIndex, Converter={StaticResource IntEq}, ConverterParameter=0}" Tag="home"
                            Content="首页" Click="OnGotoHome" />
                    <Button Classes="NavRow" Classes.on="{Binding SelectedNavIndex, Converter={StaticResource IntEq}, ConverterParameter=2}" Tag="scene"
                            Content="场景" Click="OnGotoScenes" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Classes="NavCaption" Text="{Binding RoomCount, StringFormat='房间 · {0}'}" />
                <!-- 所有房间 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                    <ItemsControl ItemsSource="{Binding Rooms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:RoomChip">
                                <Button Classes="NavRow room" Classes.on="{Binding IsSelected}"
                                        Tag="{Binding IconKey}"
                                        Content="{Binding Name}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PickRoomCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
            <!-- 内容面板：只左上圆角；左侧与侧栏齐平，右/下用 -10 抵掉主体网格的边距，贴住窗口边缘 -->
            <Border Grid.Column="1" CornerRadius="40,0,0,0" Background="{DynamicResource PanelBrush}"
                    BoxShadow="0 3 10 0 #170F172A" ClipToBounds="True" Margin="0,0,-10,-10">
                <Grid>
                    <!-- 环境光晕：面板底层两团超大半径的径向光斑（特效测试时可整体隐藏） -->
                    <Panel x:Name="AmbientGlow" IsHitTestVisible="False">
                        <Border Width="560" Height="520" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="-190,-210,0,0">
                            <Border.Background>
                                <RadialGradientBrush Center="50%,50%">
                                    <GradientStop Color="{DynamicResource Ambient1}" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Width="640" Height="580" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,-210,-230">
                            <Border.Background>
                                <RadialGradientBrush Center="50%,50%">
                                    <GradientStop Color="{DynamicResource Ambient2}" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                    </Panel>
                    <Carousel SelectedIndex="{Binding SelectedNavIndex}"
                              Margin="22,20,22,28">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <views:HomeView />
                        </ScrollViewer>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <views:RoomsView />
                        </ScrollViewer>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <views:ScenesView />
                        </ScrollViewer>
                    </Carousel>
                    <!-- ================= 设备遮罩（只盖圆角内容面板，不盖侧栏/标题栏；由外层 Border 裁出圆角） ================= -->
                    <Border x:Name="DeviceMask" ZIndex="90" Classes="Mask" Background="{DynamicResource DrawerMaskBrush}"
                            Opacity="0" IsVisible="False" PointerReleased="OnMaskClick" />
                    <!-- 浅色遮罩层：叠在主遮罩之上，颜色更淡，随抽屉开关淡入淡出 -->
                    <Border x:Name="DeviceMaskLight" ZIndex="91" Classes="Mask" Background="{DynamicResource MaskLightBrush}"
                            Opacity="0" IsVisible="False" PointerReleased="OnMaskClick" />
                </Grid>
            </Border>
        </Grid>
        <!-- ================= 设备详情抽屉（右→左滑入动画） =================
             遮罩已移入圆角内容面板内部（只盖内容区、随面板裁圆角，不盖侧栏/标题栏）；
             抽屉保留在根层，Grid.Row=1 + HorizontalAlignment=Right，滑入主体右侧。 -->
        <views:DeviceDrawerView x:Name="DeviceDrawerView" Grid.Row="1" ZIndex="100" />
        <!-- ================= 小爱语音：标题栏右侧胶囊唤出的指令浮层（仅检测到音箱时出现） ================= -->
        <!-- 浮层右缘对齐标题栏胶囊右缘（右侧栏钮宽度固定，所以用右对齐 + 固定右边距） -->
        <views:VoicePanelView x:Name="VoicePanelView" Grid.Row="1" ZIndex="120" />
        <!-- ================= 音乐：标题栏音乐胶囊唤出的播放控制浮层（仅检测到音箱时出现） ================= -->
        <views:MusicPanelView x:Name="MusicPanelView" Grid.Row="1" ZIndex="120" />
        <!-- ================= 环境概览明细弹窗 ================= -->
        <views:EnvDetailDialogView Grid.Row="0" Grid.RowSpan="2" />
        <!-- ================= 登录弹窗（遮罩 + 居中卡片，跨满整个窗口与「设置」一致） ================= -->
        <views:LoginDialogView Grid.Row="0" Grid.RowSpan="2" />
        <!-- ================= 设置弹窗（走 DialogPopup 基类：遮罩 + 居中卡片 + 标题栏 + 滚动正文） ================= -->
        <!-- 基类外壳跨满整个窗口（含 48px 标题栏），卡片以全窗口为基准居中 -->
        <views:SettingsDialogView Grid.Row="0" Grid.RowSpan="2" />
        <!-- ================= 操作日志弹窗（走 DialogPopup 基类：遮罩 + 居中卡片，跨满整个窗口） ================= -->
        <views:LogDialogView Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</Window>
