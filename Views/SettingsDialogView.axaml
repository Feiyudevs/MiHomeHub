<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:MiHomeHub.Models"
             xmlns:vm="clr-namespace:MiHomeHub.ViewModels"
             xmlns:ctl="clr-namespace:MiHomeHub.Controls"
             x:Class="MiHomeHub.Views.SettingsDialogView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <!-- 分区卡：设置页里的次级卡片。底色比外层 Card 再亮/暗一档，靠 1px 淡描边分层；
             不叠投影，避免一屏里出现十几个各自带阴影的小块 -->
        <Style Selector="Border.CompTile">
            <Setter Property="Background" Value="{DynamicResource PickCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,13" />
        </Style>
    </UserControl.Styles>
    <ctl:DialogPopup
                     Title="设置"
                     IsOpen="{Binding IsSettingsOpen}"
                     CloseCommand="{Binding CloseOverlaysCommand}"
                     CardWidth="900"
                     CardHeight="640"
                     CardMaxHeight="640"
                     ContentMargin="28,18,6,0">
        <StackPanel Classes="SetArea">
            <!-- 顶部 Tab 导航 -->
            <Border Classes="TabBar" Margin="0,0,0,18">
                <ctl:SlidingTabPanel Classes="SlidingTab" SelectedIndex="{Binding SettingsTab}" Spacing="4">
                    <Button Classes="Tab" Classes.on="{Binding SettingsTab, Converter={StaticResource IntEq}, ConverterParameter=0}"
                            Tag="0" Click="OnTabClick" Content="通用" />
                    <Button Classes="Tab" Classes.on="{Binding SettingsTab, Converter={StaticResource IntEq}, ConverterParameter=1}"
                            Tag="1" Click="OnTabClick" Content="桌面组件" />
                    <Button Classes="Tab" Classes.on="{Binding SettingsTab, Converter={StaticResource IntEq}, ConverterParameter=2}"
                            Tag="2" Click="OnTabClick" Content="账户" />
                    <Button Classes="Tab" Classes.on="{Binding SettingsTab, Converter={StaticResource IntEq}, ConverterParameter=3}"
                            Tag="3" Click="OnTabClick" Content="关于" />
                </ctl:SlidingTabPanel>
            </Border>

            <!-- 通用 -->
            <StackPanel Spacing="14" IsVisible="{Binding SettingsTab, Converter={StaticResource IntEq}, ConverterParameter=0}">
                <Border Classes="Card">
                    <StackPanel Spacing="20">
                        <TextBlock Text="外观" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource PurpleSoftBrush}">
                                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Panel Width="24" Height="24">
                                        <Path Stroke="{DynamicResource PurpleBrush}" Data="{StaticResource GeoGear}" />
                                    </Panel>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="主题" FontSize="13.5" FontWeight="Normal"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="界面明暗配色" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                            <ctl:OptionPicker Grid.Column="2" VerticalAlignment="Center"
                                              Options="{Binding ThemeOptions}"
                                              SelectedValue="{Binding IsDark}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource PurpleSoftBrush}">
                                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Panel Width="24" Height="24">
                                        <Path Stroke="{DynamicResource PurpleBrush}" Data="{StaticResource GeoGrid}" />
                                    </Panel>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="侧栏图标" FontSize="13.5" FontWeight="Normal"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="导航区图标的画法" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                            <ctl:OptionPicker Grid.Column="2" VerticalAlignment="Center"
                                              Options="{Binding IconOptions}"
                                              SelectedValue="{Binding IconGlass}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource BlueSoftBrush}">
                                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Panel Width="24" Height="24">
                                        <Path Stroke="{DynamicResource BlueBrush}" Data="{StaticResource GeoShadow}" />
                                    </Panel>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="卡片阴影" FontSize="13.5" FontWeight="Normal"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="关闭后卡片改为扁平贴合，界面更清爽" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                          IsChecked="{Binding CardShadow}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource AmberSoftBrush}">
                                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Panel Width="24" Height="24">
                                        <Path Stroke="{DynamicResource AmberBrush}" Data="{StaticResource GeoBolt}" />
                                    </Panel>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="硬件加速" FontSize="13.5" FontWeight="Normal"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="开启后界面改由显卡绘制，需重启应用"
                                           Classes="Hint Sub" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                          IsChecked="{Binding UseGpu}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Classes="Card">
                    <StackPanel Spacing="20">
                        <TextBlock Text="启动与窗口" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource GreenSoftBrush}">
                                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Panel Width="24" Height="24">
                                        <Path Stroke="{DynamicResource GreenBrush}" Data="{StaticResource GeoPower}" />
                                    </Panel>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="开机启动" FontSize="13.5" FontWeight="Normal"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="登录系统后自动启动应用" Classes="Hint Sub" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding AutoStartErrorText}"
                                           Classes="Hint Sub" Margin="0,2,0,0"
                                           Foreground="{DynamicResource DangerBrush}"
                                           IsVisible="{Binding AutoStartErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                          IsChecked="{Binding AutoStart}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource BlueSoftBrush}">
                                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Panel Width="24" Height="24">
                                        <Path Stroke="{DynamicResource BlueBrush}" Data="{StaticResource GeoMax}" />
                                    </Panel>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="启动后显示主界面" FontSize="13.5" FontWeight="Normal"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="关掉后启动直接收进托盘，需要时点托盘图标打开" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                          IsChecked="{Binding ShowMainWindowOnStartup}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource PurpleSoftBrush}">
                                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Panel Width="24" Height="24">
                                        <Path Stroke="{DynamicResource PurpleBrush}" Data="{StaticResource GeoTray}" />
                                    </Panel>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="关闭后进托盘" FontSize="13.5" FontWeight="Normal"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="关掉这项后点关闭直接退出应用" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                          IsChecked="{Binding CloseToTray}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="Card">
                    <StackPanel Spacing="20">
                        <TextBlock Text="首页" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource BlueSoftBrush}">
                                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Panel Width="24" Height="24">
                                        <Path Stroke="{DynamicResource BlueBrush}" Data="{StaticResource GeoGrid}" />
                                    </Panel>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="数据看板" FontSize="13.5" FontWeight="Normal"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="关掉后首页整块隐藏；重新打开会把卡片恢复显示"
                                           Classes="Hint Sub" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                          IsChecked="{Binding DataBoardVisible, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
                            </StackPanel>

            <!-- 桌面组件 -->
            <StackPanel Spacing="14" IsVisible="{Binding SettingsTab, Converter={StaticResource IntEq}, ConverterParameter=1}">
                <!-- 总开关：一块窗全开全关，分区自己的开关留在下面 -->
                <Border Classes="Card">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="SetIc" Background="{DynamicResource BlueSoftBrush}">
                            <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Panel Width="24" Height="24">
                                    <Path Stroke="{DynamicResource BlueBrush}" Data="{StaticResource GeoGrid}" />
                                </Panel>
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="在桌面显示设备分区" FontSize="13.5" FontWeight="Normal"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="总开关：关掉后所有分区一起收起，分区与外观设置都保留"
                                       Classes="Hint Sub" Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                      IsChecked="{Binding DesktopWidgetsEnabled}" />
                    </Grid>
                </Border>

                <!-- 分区：逐块方卡，开关就压在各自卡上，不用在一长条列表里找 -->
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="SecTitle" Margin="2,4,0,0" Text="分区" />
                        <TextBlock Grid.Column="1" Classes="Hint" Margin="0,0,14,0" VerticalAlignment="Center"
                                   Text="设备卡悬停点「＋」即可添加入口" />
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,12,Auto">
                        <!-- 媒体分区 -->
                        <Border Classes="CompTile" Grid.Row="0" Grid.Column="0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Classes="SetIc" Background="{DynamicResource PurpleSoftBrush}">
                                    <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Panel Width="24" Height="24">
                                            <Path Stroke="{DynamicResource PurpleBrush}" Data="{StaticResource GeoSpeaker}" />
                                        </Panel>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="媒体分区" FontSize="13.5" FontWeight="Normal"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="与首页「音响播放」是同一台音箱" Classes="Hint Sub" />
                                </StackPanel>
                                <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                              IsChecked="{Binding DesktopMediaZone}" />
                            </Grid>
                        </Border>

                        <!-- 空调分区 -->
                        <Border Classes="CompTile" Grid.Row="0" Grid.Column="2">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Classes="SetIc" Background="{DynamicResource BlueSoftBrush}">
                                    <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Panel Width="24" Height="24">
                                            <Path Stroke="{DynamicResource BlueBrush}" Data="{StaticResource GeoAirCon}" />
                                        </Panel>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="空调分区" FontSize="13.5" FontWeight="Normal"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="桌面直接调温度、模式、风速" Classes="Hint Sub" />
                                </StackPanel>
                                <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                              IsChecked="{Binding DesktopAcZone}" />
                            </Grid>
                        </Border>

                        <!-- 监控分区：摄像头多于一台时，选哪一台就收在卡里 -->
                        <Border Classes="CompTile" Grid.Row="2" Grid.Column="0"
                                IsVisible="{Binding SupportsWindowsOnlyDesktopFeatures}">
                            <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="SetIc" Background="{DynamicResource BlueSoftBrush}">
                                        <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Panel Width="24" Height="24">
                                                <Path Stroke="{DynamicResource BlueBrush}" Data="{StaticResource GeoCamera}" />
                                            </Panel>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="监控分区" FontSize="13.5" FontWeight="Normal"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="桌面直接看实时画面，关窗即停流" Classes="Hint Sub" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                                  IsChecked="{Binding DesktopCameraZone}" />
                                </Grid>
                                <!-- 摄像头多于一台才给下拉：只有一台时没什么好选的，这一行不占位置 -->
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowCameraPicker}">
                                    <TextBlock Text="显示画面" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text2Brush}" />
                                    <ctl:OptionPicker Grid.Column="1" VerticalAlignment="Center" MaxWidth="150"
                                                      Options="{Binding CameraOptions}"
                                                      SelectedValue="{Binding SelectedCameraValue, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 桌面数据卡：逐张开关收在首页「数据看板」的编辑弹窗里，这里只留已投数量和入口 -->
                        <Border Classes="CompTile" Grid.Row="2" Grid.Column="2"
                                IsVisible="{Binding SupportsWindowsOnlyDesktopFeatures}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="SetIc" Background="{DynamicResource PurpleSoftBrush}">
                                        <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Panel Width="24" Height="24">
                                                <Path Stroke="{DynamicResource PurpleBrush}" Data="{StaticResource GeoDashboard}" />
                                            </Panel>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="桌面数据卡" FontSize="13.5" FontWeight="Normal"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{Binding DesktopDataCards.SummaryText}" Classes="Hint Sub" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="BtnGhost" Height="28" Padding="12,0" FontSize="12"
                                            Content="管理" VerticalAlignment="Center"
                                            Command="{Binding ManageDesktopDataCardsCommand}"
                                            ToolTip.Tip="打开首页「数据看板」的编辑弹窗，和首页显隐一起逐张勾选" />
                                </Grid>
                                <TextBlock Text="逐张开关在首页「数据看板」的编辑里，和首页显隐放在同一行"
                                           Classes="Hint" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- 桌面交互：管的是鼠标怎么用桌面组件，和上面的分区显隐分开成一节 -->
                <StackPanel Spacing="10">
                    <TextBlock Classes="SecTitle" Margin="2,4,0,0" Text="桌面交互" />
                    <Grid ColumnDefinitions="*,12,*">
                        <Border Classes="CompTile" Grid.Column="0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Classes="SetIc" Background="{DynamicResource GreenSoftBrush}">
                                    <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Panel Width="24" Height="24">
                                            <Path Stroke="{DynamicResource GreenBrush}" Data="{StaticResource GeoMax}" />
                                        </Panel>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="双击桌面隐藏组件" FontSize="13.5" FontWeight="Normal"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="双击桌面空白处收起 / 恢复所有卡片" Classes="Hint Sub" />
                                </StackPanel>
                                <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                              IsChecked="{Binding DoubleClickDesktopToggles}" />
                            </Grid>
                        </Border>

                        <Border Classes="CompTile" Grid.Column="2">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Classes="SetIc" Background="{DynamicResource PurpleSoftBrush}">
                                    <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Panel Width="24" Height="24">
                                            <Path Stroke="{DynamicResource PurpleBrush}" Data="{StaticResource GeoGrid}" />
                                        </Panel>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="移入自动展开" FontSize="13.5" FontWeight="Normal"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="移入折叠的分区自动展开" Classes="Hint Sub" />
                                </StackPanel>
                                <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                              IsChecked="{Binding HoverExpand}" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- 分区外观：直接内联，不再弹独立窗口 -->
                <Border Classes="Card">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="分区外观" FontSize="14.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="BtnGhost" Height="26" Padding="10,0" FontSize="11.5"
                                    Content="恢复默认" Command="{Binding DesktopAppearance.RestoreDefaultCommand}" />
                        </Grid>

                        <!-- 背景色 -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="背景" FontSize="13" FontWeight="Normal"
                                       Foreground="{DynamicResource Text2Brush}" />
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <ItemsControl ItemsSource="{Binding DesktopAppearance.Presets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ColorSwatch">
                                            <Button Classes="Swatch" Tag="{Binding Hex}" Click="OnSwatchClick"
                                                    ToolTip.Tip="{Binding Hex}">
                                                <Panel>
                                                    <Border Width="20" Height="20" CornerRadius="10"
                                                            Background="{Binding Brush}"
                                                            BorderThickness="1" BorderBrush="#33FFFFFF" />
                                                    <Border Width="26" Height="26" CornerRadius="13"
                                                            BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"
                                                            IsVisible="{Binding IsSelected}" />
                                                </Panel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="ColorOrb"
                                        Classes.on="{Binding DesktopAppearance.IsCustomColorSelected}"
                                        Background="{Binding DesktopAppearance.CustomColorBrush}"
                                        Click="OnCustomColorClick"
                                        ToolTip.Tip="自定义颜色（打开调色盘）" />
                            </StackPanel>
                            <TextBlock Classes="Hint" Text="未选背景色时，底色随深/浅色主题自动切换"
                                       IsVisible="{Binding DesktopAppearance.FollowTheme}" />
                        </StackPanel>

                        <!-- 背景浓度 -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="背景浓度" FontSize="13" FontWeight="Normal"
                                           Foreground="{DynamicResource Text2Brush}" />
                                <TextBlock Grid.Column="1" Text="{Binding DesktopAppearance.OpacityText}"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent2Brush}" VerticalAlignment="Center" />
                            </Grid>
                            <Slider Classes="DrSlider"
                                    Minimum="{x:Static vm:DesktopAppearanceVm.MinOpacityPercent}"
                                    Maximum="{x:Static vm:DesktopAppearanceVm.MaxOpacityPercent}"
                                    TickFrequency="1"
                                    Value="{Binding DesktopAppearance.OpacityPercent, Mode=TwoWay}" />
                            <TextBlock Classes="Hint"
                                       Text="数值是底色自身的不透明度，磨砂染色随之联动：0% 纯磨砂无底色、100% 最沉。" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 账户 -->
            <StackPanel Spacing="14" IsVisible="{Binding SettingsTab, Converter={StaticResource IntEq}, ConverterParameter=2}">
                <Border Classes="Card">
                    <StackPanel Spacing="20">
                        <TextBlock Text="账户" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource AccentSoftBrush}">
                                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Panel Width="24" Height="24">
                                        <Path Stroke="{DynamicResource Accent2Brush}" Data="{StaticResource GeoLock}" />
                                    </Panel>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" FontSize="13.5" FontWeight="Normal"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="凭证仅保存在本机 · 不上传第三方" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                            <!-- 已登录：一键退出；未登录：一键登录或扫码 -->
                            <Button Grid.Column="2" Classes="BtnGhost" Content="退出登录" VerticalAlignment="Center"
                                    Command="{Binding LogoutCommand}"
                                    IsVisible="{Binding IsLoggedIn}" />
                            <Button Grid.Column="2" Classes="BtnGhost" Content="一键登录" VerticalAlignment="Center"
                                    Command="{Binding QuickLoginCommand}"
                                    IsVisible="{Binding ShowQuickLoginAction}" />
                            <Button Grid.Column="2" Classes="BtnGhost" Content="扫码登录" VerticalAlignment="Center"
                                    Command="{Binding QrLoginCommand}"
                                    IsVisible="{Binding ShowQrLoginAction}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Classes="Card">
                    <StackPanel Spacing="20">
                        <TextBlock Text="设备与场景" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource GreenSoftBrush}">
                                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Panel Width="24" Height="24">
                                        <Path Stroke="{DynamicResource GreenBrush}" Data="{StaticResource GeoRefresh}" />
                                    </Panel>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="重新拉取" FontSize="13.5" FontWeight="Normal"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="从米家云端刷新设备列表与开关状态" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Classes="BtnGhost" Content="刷新" VerticalAlignment="Center"
                                    Command="{Binding LoadDevicesCommand}" IsEnabled="{Binding !IsLoading}" />
                        </Grid>
                        <!-- 隐藏开关：打开后墙壁开关 / 场景按键整类不上设备列表 -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource AmberSoftBrush}">
                                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Panel Width="24" Height="24">
                                        <Path Stroke="{DynamicResource AmberBrush}" Data="{StaticResource GeoKeycap}" />
                                    </Panel>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="隐藏开关设备" FontSize="13.5" FontWeight="Normal"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="打开后，设备列表不再出现墙壁开关与场景按键"
                                           Classes="Hint Sub" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                          IsChecked="{Binding HideSwitches}" />
                        </Grid>
                        <!-- 默认音箱：小爱语音指令的落点，只在有音箱时出现 -->
                        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasSpeaker}">
                            <Border Classes="SetIc" Background="{DynamicResource PurpleSoftBrush}">
                                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Panel Width="24" Height="24">
                                        <Path Stroke="{DynamicResource PurpleBrush}"
                                              Data="M12,3 C10,3 8,5 8,7 V12 C8,14 10,16 12,16 C14,16 16,14 16,12 V7 C16,5 14,3 12,3 Z M5,11 C5,15 8,18 12,18 C16,18 19,15 19,11 M12,18 V21 M8,21 H16" />
                                    </Panel>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="默认音箱" FontSize="13.5" FontWeight="Normal"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="语音指令下发到这台小爱音箱" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                            <ctl:OptionPicker Grid.Column="2" VerticalAlignment="Center" MaxWidth="170"
                                              Options="{Binding SpeakerOptions}"
                                              SelectedValue="{Binding SelectedSpeakerValue, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 关于 -->
            <StackPanel Spacing="14" IsVisible="{Binding SettingsTab, Converter={StaticResource IntEq}, ConverterParameter=3}">
                <Border Classes="Card">
                    <StackPanel Spacing="20">
                        <TextBlock Text="关于" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Grid ColumnDefinitions="Auto,*">
                            <Image Width="34" Height="34" Source="{StaticResource LogoImage}"
                                   VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="米家控制中心 MiHomeHub" FontSize="13.5" FontWeight="Normal"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding AppVersionText}" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- 开源仓库：源码即 GPL-3.0 第 6 节的源码提供途径 -->
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <Button Classes="BtnGhost" Height="34" Content="开源仓库"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="{Binding RepoUrl}" />
                            <Button Classes="BtnGhost" Height="34" Content="作者网站"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="{Binding AuthorUrl}" />
                            <Button Classes="BtnGhost" Height="34" Content="哔哩哔哩"
                                    ToolTip.Tip="https://space.bilibili.com/3546951903611444"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="{Binding BilibiliUrl}" />
                            <!-- 赞赏支持：点开只弹收款码，不影响任何功能 -->
                            <Button Classes="BtnGhost" Height="34" Content="赞赏支持"
                                    Command="{Binding OpenSupportCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 更新：GitHub Release 全量包，校验 SHA256 后交安装器静默替换 -->
                <Border Classes="Card">
                    <StackPanel Spacing="16">
                        <TextBlock Text="更新" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource PurpleSoftBrush}">
                                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Panel Width="24" Height="24">
                                        <Path Stroke="{DynamicResource PurpleBrush}" Data="{StaticResource GeoGear}" />
                                    </Panel>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding UpdateStatusText}" FontSize="13.5" FontWeight="Normal"
                                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                <!-- 只有测试通道实例才显示这一行，普通用户看不到 -->
                                <TextBlock Text="{Binding UpdateChannelHint}" FontSize="12"
                                           Foreground="{DynamicResource AmberTextBrush}" TextWrapping="Wrap"
                                           IsVisible="{Binding UpdateChannelHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <!-- 下载中：圆形进度环，替代原来的细横条 -->
                                <ctl:CircularProgress Width="20" Height="20" Thickness="2.5" Margin="0,0,2,0"
                                                      Value="{Binding UpdateProgress}"
                                                      TrackBrush="{DynamicResource LineBrush}"
                                                      FillBrush="{DynamicResource Accent2Brush}"
                                                      IsVisible="{Binding IsUpdateBusy}" />
                                <Button Classes="BtnGhost" Height="34" Content="检查更新"
                                        Command="{Binding CheckUpdateCommand}" />
                                <Button Classes="BtnGhost" Height="34" Content="网盘下载"
                                        Command="{Binding OpenUrlCommand}"
                                        CommandParameter="{Binding UpdateDiskUrl}"
                                        IsVisible="{Binding HasUpdateDiskUrl}" />
                                <Button Classes="BtnPrimary" Height="34" Content="立即更新"
                                        Command="{Binding InstallUpdateCommand}"
                                        IsVisible="{Binding IsUpdateAvailable}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 匿名使用统计：默认关闭，用户自己决定是否上报；只报事件，不报账号与设备名 -->
                <Border Classes="Card">
                    <StackPanel Spacing="16">
                        <TextBlock Text="隐私" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource GreenSoftBrush}">
                                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Panel Width="24" Height="24">
                                        <Path Stroke="{DynamicResource GreenBrush}" Data="{StaticResource GeoPower}" />
                                    </Panel>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="匿名使用统计" FontSize="13.5" FontWeight="Normal"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding TelemetryHint}" Classes="Hint Sub" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                          IsChecked="{Binding TelemetryEnabled}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ctl:DialogPopup>
</UserControl>
