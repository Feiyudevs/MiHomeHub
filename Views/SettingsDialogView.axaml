<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:MiHome.Models"
             xmlns:vm="clr-namespace:MiHome.ViewModels"
             xmlns:ctl="clr-namespace:MiHome.Controls"
             x:Class="MiHome.Views.SettingsDialogView"
             x:DataType="vm:MainViewModel">
    <ctl:DialogPopup
                     Title="设置"
                     IsOpen="{Binding IsSettingsOpen}"
                     CloseCommand="{Binding CloseOverlaysCommand}"
                     CardWidth="900"
                     CardHeight="640"
                     CardMaxHeight="640"
                     ContentMargin="28,18,6,0">
        <StackPanel Classes="SetArea">
            <!-- 顶部 Tab 导航 -->
            <Border Classes="TabBar" Margin="0,0,0,18">
                <ctl:SlidingTabPanel Classes="SlidingTab" SelectedIndex="{Binding SettingsTab}" Spacing="4">
                    <Button Classes="Tab" Classes.on="{Binding SettingsTab, Converter={StaticResource IntEq}, ConverterParameter=0}"
                            Tag="0" Click="OnTabClick" Content="通用" />
                    <Button Classes="Tab" Classes.on="{Binding SettingsTab, Converter={StaticResource IntEq}, ConverterParameter=1}"
                            Tag="1" Click="OnTabClick" Content="桌面组件" />
                    <Button Classes="Tab" Classes.on="{Binding SettingsTab, Converter={StaticResource IntEq}, ConverterParameter=2}"
                            Tag="2" Click="OnTabClick" Content="账户" />
                    <Button Classes="Tab" Classes.on="{Binding SettingsTab, Converter={StaticResource IntEq}, ConverterParameter=3}"
                            Tag="3" Click="OnTabClick" Content="关于" />
                </ctl:SlidingTabPanel>
            </Border>

            <!-- 通用 -->
            <StackPanel Spacing="14" IsVisible="{Binding SettingsTab, Converter={StaticResource IntEq}, ConverterParameter=0}">
                <Border Classes="Card">
                    <StackPanel Spacing="20">
                        <TextBlock Text="外观" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource PurpleSoftBrush}">
                                <Path Stroke="{DynamicResource PurpleBrush}" Data="{StaticResource GeoGear}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="主题" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="界面明暗配色" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                            <ctl:OptionPicker Grid.Column="2" VerticalAlignment="Center"
                                              Options="{Binding ThemeOptions}"
                                              SelectedValue="{Binding IsDark}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource PurpleSoftBrush}">
                                <Path Stroke="{DynamicResource PurpleBrush}" Data="{StaticResource GeoGrid}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="侧栏图标" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="导航区图标的画法" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                            <ctl:OptionPicker Grid.Column="2" VerticalAlignment="Center"
                                              Options="{Binding IconOptions}"
                                              SelectedValue="{Binding IconGlass}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource BlueSoftBrush}">
                                <Path Stroke="{DynamicResource BlueBrush}" Data="{StaticResource GeoShadow}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="卡片阴影" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="关闭后卡片改为扁平贴合，界面更清爽" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                          IsChecked="{Binding CardShadow}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Classes="Card">
                    <StackPanel Spacing="20">
                        <TextBlock Text="启动与窗口" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource GreenSoftBrush}">
                                <Path Stroke="{DynamicResource GreenBrush}" Data="{StaticResource GeoPower}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="开机启动" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="登录 Windows 后自动启动应用" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                          IsChecked="{Binding AutoStart}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource BlueSoftBrush}">
                                <Path Stroke="{DynamicResource BlueBrush}" Data="{StaticResource GeoMax}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="启动后显示主界面" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="关掉后启动直接收进托盘，需要时点托盘图标打开" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                          IsChecked="{Binding ShowMainWindowOnStartup}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource PurpleSoftBrush}">
                                <Path Stroke="{DynamicResource PurpleBrush}" Data="{StaticResource GeoTray}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="关闭后进托盘" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="关掉这项后点关闭直接退出应用" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                          IsChecked="{Binding CloseToTray}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 桌面组件 -->
            <StackPanel Spacing="14" IsVisible="{Binding SettingsTab, Converter={StaticResource IntEq}, ConverterParameter=1}">
                <Border Classes="Card">
                    <StackPanel Spacing="20">
                        <TextBlock Text="桌面组件" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource BlueSoftBrush}">
                                <Path Stroke="{DynamicResource BlueBrush}" Data="{StaticResource GeoGrid}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="在桌面显示设备分区" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="设备卡悬停点「＋」即可添加入口；关掉只是收起，分区配置保留"
                                           Classes="Hint Sub" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                          IsChecked="{Binding DesktopWidgetsEnabled}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource PurpleSoftBrush}">
                                <Path Stroke="{DynamicResource PurpleBrush}" Data="{StaticResource GeoSpeaker}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="在桌面显示媒体分区" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="控制的音箱与首页「音响播放」是同一台；关掉后不会自动放回"
                                           Classes="Hint Sub" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                          IsChecked="{Binding DesktopMediaZone}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource GreenSoftBrush}">
                                <Path Stroke="{DynamicResource GreenBrush}" Data="{StaticResource GeoMax}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="双击桌面隐藏组件" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="双击桌面空白处，快速收起 / 恢复所有桌面卡片"
                                           Classes="Hint Sub" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                          IsChecked="{Binding DoubleClickDesktopToggles}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource PurpleSoftBrush}">
                                <Path Stroke="{DynamicResource PurpleBrush}" Data="{StaticResource GeoGrid}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="移入自动展开" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="鼠标移入折叠的分区时自动展开，移出后自动收起"
                                           Classes="Hint Sub" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" Classes="Switch" VerticalAlignment="Center"
                                          IsChecked="{Binding HoverExpand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 分区外观：直接内联，不再弹独立窗口 -->
                <Border Classes="Card">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="分区外观" FontSize="14.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="BtnGhost" Height="26" Padding="10,0" FontSize="11.5"
                                    Content="恢复默认" Command="{Binding DesktopAppearance.RestoreDefaultCommand}" />
                        </Grid>

                        <!-- 背景色 -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="背景" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}" />
                            <ItemsControl ItemsSource="{Binding DesktopAppearance.Presets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ColorSwatch">
                                        <Button Classes="Swatch" Tag="{Binding Hex}" Click="OnSwatchClick"
                                                ToolTip.Tip="{Binding Hex}">
                                            <Panel>
                                                <Border Width="20" Height="20" CornerRadius="10"
                                                        Background="{Binding Brush}"
                                                        BorderThickness="1" BorderBrush="#33FFFFFF" />
                                                <Border Width="26" Height="26" CornerRadius="13"
                                                        BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"
                                                        IsVisible="{Binding IsSelected}" />
                                            </Panel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="Hint" Text="未选背景色时，底色随深/浅色主题自动切换"
                                       IsVisible="{Binding DesktopAppearance.FollowTheme}" />
                        </StackPanel>

                        <!-- 背景浓度 -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="背景浓度" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}" />
                                <TextBlock Grid.Column="1" Text="{Binding DesktopAppearance.OpacityText}"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent2Brush}" VerticalAlignment="Center" />
                            </Grid>
                            <Slider Classes="DrSlider"
                                    Minimum="{x:Static vm:DesktopAppearanceVm.MinOpacityPercent}"
                                    Maximum="{x:Static vm:DesktopAppearanceVm.MaxOpacityPercent}"
                                    TickFrequency="1"
                                    Value="{Binding DesktopAppearance.OpacityPercent, Mode=TwoWay}" />
                            <TextBlock Classes="Hint"
                                       Text="数值是底色自身的不透明度，磨砂染色随之联动：0% 纯磨砂无底色、72% 最沉。" />
                        </StackPanel>

                        <!-- 毛玻璃 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="毛玻璃" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text2Brush}" />
                                <TextBlock Classes="Hint" Text="用系统亚克力模糊墙纸，与透明度叠加生效" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Classes="Switch" VerticalAlignment="Center"
                                          IsChecked="{Binding DesktopAppearance.Glass, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 账户 -->
            <StackPanel Spacing="14" IsVisible="{Binding SettingsTab, Converter={StaticResource IntEq}, ConverterParameter=2}">
                <Border Classes="Card">
                    <StackPanel Spacing="20">
                        <TextBlock Text="账户" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource AccentSoftBrush}">
                                <Path Stroke="{DynamicResource Accent2Brush}" Data="{StaticResource GeoLock}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="凭证仅保存在本机 · 不上传第三方" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                            <!-- 已登录：一键退出；未登录：一键登录或扫码 -->
                            <Button Grid.Column="2" Classes="BtnGhost" Content="退出登录" VerticalAlignment="Center"
                                    Command="{Binding LogoutCommand}"
                                    IsVisible="{Binding IsLoggedIn}" />
                            <Button Grid.Column="2" Classes="BtnGhost" Content="一键登录" VerticalAlignment="Center"
                                    Command="{Binding QuickLoginCommand}"
                                    IsVisible="{Binding ShowQuickLoginAction}" />
                            <Button Grid.Column="2" Classes="BtnGhost" Content="扫码登录" VerticalAlignment="Center"
                                    Command="{Binding QrLoginCommand}"
                                    IsVisible="{Binding ShowQrLoginAction}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Classes="Card">
                    <StackPanel Spacing="20">
                        <TextBlock Text="设备与场景" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SetIc" Background="{DynamicResource GreenSoftBrush}">
                                <Path Stroke="{DynamicResource GreenBrush}" Data="{StaticResource GeoRefresh}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="重新拉取" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="从米家云端刷新设备列表与开关状态" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Classes="BtnGhost" Content="刷新" VerticalAlignment="Center"
                                    Command="{Binding LoadDevicesCommand}" IsEnabled="{Binding !IsLoading}" />
                        </Grid>
                        <!-- 默认音箱：小爱语音指令的落点，只在有音箱时出现 -->
                        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasSpeaker}">
                            <Border Classes="SetIc" Background="{DynamicResource PurpleSoftBrush}">
                                <Path Stroke="{DynamicResource PurpleBrush}"
                                      Data="M12,3 C10,3 8,5 8,7 V12 C8,14 10,16 12,16 C14,16 16,14 16,12 V7 C16,5 14,3 12,3 Z M5,11 C5,15 8,18 12,18 C16,18 19,15 19,11 M12,18 V21 M8,21 H16" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="默认音箱" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="语音指令下发到这台小爱音箱" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                            <ctl:OptionPicker Grid.Column="2" VerticalAlignment="Center" MaxWidth="170"
                                              Options="{Binding SpeakerOptions}"
                                              SelectedValue="{Binding SelectedSpeakerValue, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 关于 -->
            <StackPanel Spacing="14" IsVisible="{Binding SettingsTab, Converter={StaticResource IntEq}, ConverterParameter=3}">
                <Border Classes="Card">
                    <StackPanel Spacing="20">
                        <TextBlock Text="关于" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Grid ColumnDefinitions="Auto,*">
                            <Image Width="34" Height="34" Source="{StaticResource LogoImage}"
                                   VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="MiHomeHub" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding AppVersionText}" Classes="Hint Sub" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- 开源仓库：源码即 GPL-3.0 第 6 节的源码提供途径 -->
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <Button Classes="BtnGhost" Height="34" Content="开源仓库"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="{Binding RepoUrl}" />
                            <Button Classes="BtnGhost" Height="34" Content="作者网站"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="{Binding AuthorUrl}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ctl:DialogPopup>
</UserControl>
