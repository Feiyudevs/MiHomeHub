<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ani="clr-namespace:Avalonia.Animation.Easings;assembly=Avalonia.Base"
    xmlns:conv="clr-namespace:MiHome.Converters"
    xmlns:ctl="clr-namespace:MiHome.Controls"
    xmlns:vm="clr-namespace:MiHome.ViewModels"
    xmlns:m="clr-namespace:MiHome.Models">
            <!-- ======== 圆角 ======== -->
            <CornerRadius x:Key="RLg">20</CornerRadius>
            <CornerRadius x:Key="R">16</CornerRadius>
            <CornerRadius x:Key="RSm">12</CornerRadius>
            <CornerRadius x:Key="RCtl">10</CornerRadius>
            <!-- ======== 全局 ToolTip：纯白胶囊 ========
                 与滚动条那组一样，直接在应用资源顶层覆盖 Fluent 的同名键（优先级高于
                 FluentTheme 的主题字典）。恒浅色、不随深浅主题漂移：白底 + 深字 + 极细边。
                 外观（圆角 / 内距 / 字号 / 最大宽）在 Themes/ToolTipStyles.axaml 统一给；
                 任何窗口要换色，就地覆盖这三个键即可，不必复制样式。 -->
            <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToolTipForeground" Color="#1A1F2C"/>
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#140F172A"/>
            <!-- ======== 滑动条：轨道从 Fluent 默认 2px 加高到 8px ======== -->
            <x:Double x:Key="SliderTrackThemeHeight">8</x:Double>
            <!-- ======== 滚动条：主题自带的轨道/箭头画刷一律置空，只留胶囊滑块 ======== -->
            <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarButtonBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarButtonBackgroundDisabled" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarButtonBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarButtonBorderBrushPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarButtonBorderBrushPressed" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarButtonBorderBrushDisabled" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundDisabled" Color="Transparent"/>
            <!-- 滑块本体（Thumb）的 Background 不会被我们的模板画出来，置空只为保险；
                 ThumbFillPointerOver/Pressed 反过来要留色，见下面主题字典里的定义 -->
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarThumbBackgroundColor" Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="Transparent"/>
            <!-- 主题靠这两个缩放资源把未展开的滑块压成 3px 细线，换成恒等缩放，
                 拖拽时鼠标离开把手也不会缩到看不见（样式赋值压不过模板里的本地 DynamicResource） -->
            <ScaleTransform x:Key="VerticalSmallScrollThumbScaleTransform" ScaleX="1" ScaleY="1"/>
            <ScaleTransform x:Key="HorizontalSmallScrollThumbScaleTransform" ScaleX="1" ScaleY="1"/>
            <!-- ======== 卡片投影：运行期由「设置 → 通用 → 卡片阴影」整体替换 ======== -->
            <BoxShadows x:Key="CardShadow">0 1 2 0 #050F172A, 0 5 16 0 #080F172A</BoxShadows>
            <BoxShadows x:Key="CardShadowHover">0 3 8 0 #0D0F172A, 0 10 24 0 #140F172A</BoxShadows>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BgBrush" Color="#07090E"/>
                    <SolidColorBrush x:Key="PanelBrush" Color="#0E1118"/>
                    <SolidColorBrush x:Key="CardBrush" Color="#1A1F2C"/>
                    <SolidColorBrush x:Key="Card2Brush" Color="#222838"/>
                    <!-- 设置页内卡片：比全局 CardBrush 再淡一档，降低存在感 -->
                    <SolidColorBrush x:Key="CardSoftBrush" Color="#161A24"/>
                    <!-- 搜索框底：CardBrush 50% 透明，比卡片更轻 -->
                    <SolidColorBrush x:Key="SearchBgBrush" Color="#801A1F2C"/>
                    <!-- 搜索框边框：LineBrush 一半透明度 -->
                    <SolidColorBrush x:Key="SearchLineBrush" Color="#09FFFFFF"/>
                    <!-- 下拉触发器：比搜索框再轻一档，靠浮层投影而不是描边区分层次 -->
                    <SolidColorBrush x:Key="PickFillBrush" Color="#08FFFFFF"/>
                    <SolidColorBrush x:Key="PickLineBrush" Color="#0AFFFFFF"/>
                    <SolidColorBrush x:Key="HoverBrush" Color="#282F42"/>
                    <!-- 淡入起点：必须与 HoverBrush 同色、只把透明位拉满，配色改一处要改两处 -->
                    <SolidColorBrush x:Key="PlayHoverFromBrush" Color="#00282F42"/>
                    <SolidColorBrush x:Key="LineBrush" Color="#12FFFFFF"/>
                    <!-- 主窗口卡片外轮廓：比全局 LineBrush 深一档，窗口贴在桌面上时才立得住 -->
                    <SolidColorBrush x:Key="WindowLineBrush" Color="#26FFFFFF"/>
                    <!-- 桌面分区卡片外轮廓：比全局 LineBrush 重一档、仍轻于主窗口，透出壁纸时轮廓才立得住。
                         分区窗固定 Dark 主题，实际只走深色字典；浅色那份只为资源完整性。 -->
                    <SolidColorBrush x:Key="ZoneLineBrush" Color="#1FFFFFFF"/>
                    <!-- 可点胶囊的悬停描边：比 LineBrush 亮一档，让静止/悬停/展开三态成色阶 -->
                    <SolidColorBrush x:Key="LineStrongBrush" Color="#22FFFFFF"/>
                    <SolidColorBrush x:Key="TextBrush" Color="#EEF1F6"/>
                    <SolidColorBrush x:Key="Text2Brush" Color="#99A1B3"/>
                    <SolidColorBrush x:Key="Text3Brush" Color="#646C7E"/>
                    <!-- 桌面分区卡 / 半透明弹窗专用文字：底色是「透出墙纸的磨砂」，主窗口那套灰压上去读不清，
                         这里统一往上提亮两档（主文字接近纯白，次级仍保持层次） -->
                    <SolidColorBrush x:Key="DskTextBrush" Color="#F8FAFD"/>
                    <SolidColorBrush x:Key="DskText2Brush" Color="#C9D1DF"/>
                    <SolidColorBrush x:Key="DskText3Brush" Color="#A6AFC0"/>
                    <!-- 滚动条胶囊：静止用 ScrollBarThumbFill，悬停/拖动由主题的 /template/ Border 规则取这两个画刷 -->
                    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#646C7E"/>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#99A1B3"/>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#C3CAD6"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#7884ecff"/>
                    <SolidColorBrush x:Key="Accent2Brush" Color="#a69bdfff"/>
                    <Color x:Key="Accent2Color">#9bdfff</Color>
                    <!-- 分区标题栏图钉的开启态：品牌紫提亮一档，压得住卡片底色 -->
                    <SolidColorBrush x:Key="PinBrush" Color="#8B7CFF"/>
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#247C5CFC"/>
                    <!-- 菜单 / 下拉的选中底：全应用统一走品牌主色 #7C5CFC 的实心档（与电源键开启态同色相）。
                         选中 = 提亮一档的实心紫 + 互补白字；悬停是同色相压暗一档的预览，按压再亮一档。 -->
                    <SolidColorBrush x:Key="SelBgBrush" Color="#8B7CFF"/>
                    <SolidColorBrush x:Key="SelBgHoverBrush" Color="#6F60DE"/>
                    <SolidColorBrush x:Key="SelBgPressBrush" Color="#A397FF"/>
                    <!-- 淡入起点：必须与 SelBgHoverBrush 同色、只把透明位拉满，配色改一处要改两处 -->
                    <SolidColorBrush x:Key="SelBgFromBrush" Color="#006F60DE"/>
                    <!-- 选中行文字：实心紫的互补色，深色主题下也是同一支白 -->
                    <SolidColorBrush x:Key="SelTextBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="WarmTextBrush" Color="#C7BCFF"/>
                    <SolidColorBrush x:Key="NavActiveTextBrush" Color="#C7BCFF"/>
                    <!-- 电源键开启态：比导航选中文字色（浅薰衣草）更深的次级主色，实心紫更压得住深色卡 -->
                    <SolidColorBrush x:Key="PowerOnBrush" Color="#7C5CFC"/>
                    <!-- 开关开启态轨道：直接用主色实心档。原来的 AccentBrush 带 alpha 的透明天蓝，
                         叠在深色卡上会偏青，指示灯式开关应统一走品牌紫 -->
                    <SolidColorBrush x:Key="SwitchOnBrush" Color="#8B7CFF"/>
                    <SolidColorBrush x:Key="GreenBrush" Color="#6BE894"/>
                    <SolidColorBrush x:Key="GreenSoftBrush" Color="#242FD573"/>
                    <SolidColorBrush x:Key="BlueBrush" Color="#7FABFF"/>
                    <Color x:Key="BlueColor">#7FABFF</Color>
                    <SolidColorBrush x:Key="PinkBrush" Color="#FF8FAB"/>
                    <Color x:Key="PinkColor">#FF8FAB</Color>
                    <SolidColorBrush x:Key="PinkSoftBrush" Color="#22FF8FAB"/>
                    <!-- 危险动作（删除）：正红，不要用粉色——粉色在深色卡上像装饰色，传达不出"不可逆" -->
                    <SolidColorBrush x:Key="DangerBrush" Color="#FF5A5A"/>
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#2AFF5A5A"/>
                    <SolidColorBrush x:Key="BlueSoftBrush" Color="#244D8DFF"/>
                    <SolidColorBrush x:Key="AmberBrush" Color="#FFD97A"/>
                    <SolidColorBrush x:Key="AmberSoftBrush" Color="#33FFC868"/>
                    <!-- 耗材胶囊悬停档：比 AmberSoftBrush 再深一点，只给可点控件用 -->
                    <SolidColorBrush x:Key="AmberSoft2Brush" Color="#4DFFC868"/>
                    <SolidColorBrush x:Key="AmberTextBrush" Color="#FFE7AE"/>
                    <SolidColorBrush x:Key="PurpleBrush" Color="#C7BFFF"/>
                    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#26A78BFA"/>
                    <!-- 统计卡数字：比主色亮一档、淡一档，避免数字压过卡片 -->
                    <SolidColorBrush x:Key="StatGreenBrush" Color="#8FE9AF"/>
                    <SolidColorBrush x:Key="StatPurpleBrush" Color="#D3CBFF"/>
                    <SolidColorBrush x:Key="StatBlueBrush" Color="#AACFFF"/>
                    <!-- 窗帘走青绿、空调走天蓝：与在线（绿）、灯光（紫）拉开色相，四张卡才不会看成同色 -->
                    <SolidColorBrush x:Key="StatTealBrush" Color="#93E8DC"/>
                    <SolidColorBrush x:Key="StatCyanBrush" Color="#8FD9FF"/>
                    <SolidColorBrush x:Key="CoolBrush" Color="#9FC9FF"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#0DFFFFFF"/>
                    <SolidColorBrush x:Key="Surface4Brush" Color="#0FFFFFFF"/>
                    <SolidColorBrush x:Key="Surface5Brush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="TrackBrush" Color="#2A3040"/>
                    <SolidColorBrush x:Key="ThumbBrush" Color="#8E96A8"/>
                    <!-- 滑动条（深色）：加高轨道、渐变已填充段、白滑块 -->
                    <SolidColorBrush x:Key="SliderTrackFill" Color="#3A4258"/>
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#47506B"/>
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#47506B"/>
                    <LinearGradientBrush x:Key="SliderTrackValueFill" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#7C5CFC" Offset="0"/>
                        <GradientStop Color="#8B7CFF" Offset="1"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#9B8CFF"/>
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#7C5CFC"/>
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#EDEFF6"/>
                    <SolidColorBrush x:Key="MaskBrush" Color="#4A000000"/>
                    <!-- 抽屉托盘遮罩：比登录/设置遮罩更轻，只作层次提示不压暗内容 -->
                    <SolidColorBrush x:Key="DrawerMaskBrush" Color="#38000000"/>
                    <!-- 浅色遮罩层：叠在 DrawerMaskBrush 之上再补一点点深度 -->
                    <SolidColorBrush x:Key="MaskLightBrush" Color="#14000000"/>
                    <!-- 抽屉托盘：与主内容面板同色，卡片在其上浮起 -->
                    <SolidColorBrush x:Key="DrawerBgBrush" Color="#0E1118"/>
                    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#171B24" Offset="0"/>
                        <GradientStop Color="#141822" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BannerBrush" StartPoint="0,0" EndPoint="1,0.6">
                        <GradientStop Color="#1A2238" Offset="0"/>
                        <GradientStop Color="#161B28" Offset="0.7"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="DevOnBrush" StartPoint="0.1,0" EndPoint="0.5,1">
                        <GradientStop Color="#247C5CFC" Offset="0"/>
                        <GradientStop Color="#0D7C5CFC" Offset="0.55"/>
                        <GradientStop Color="#1A1F2C" Offset="1"/>
                    </LinearGradientBrush>
                    <!-- 添加设备（选择器）里的设备卡：只在弹窗底 #0E1118 上淡淡浮起一层，
                         做成「可点的卡」但不抢镜 -->
                    <SolidColorBrush x:Key="PickCardBrush" Color="#12161F"/>
                    <SolidColorBrush x:Key="PickCardHoverBrush" Color="#1B212D"/>
                    <!-- 房间直达条的选中胶囊仍用实心主色（单选、只有一枚，不会铺满屏） -->
                    <SolidColorBrush x:Key="PickCardOnBrush" Color="#6A55D8"/>
                    <!-- 已选中的设备卡：整片铺主色在多选场景下会一屏紫底，压眼。
                         改成淡紫底 + 主色描边 + 主色文字，选中靠描边和字色认 -->
                    <SolidColorBrush x:Key="PickCardOnFillBrush" Color="#171526"/>
                    <SolidColorBrush x:Key="PickCardOnFillHoverBrush" Color="#1D1A30"/>
                    <SolidColorBrush x:Key="PickCardOnLineBrush" Color="#544A8C"/>
                    <SolidColorBrush x:Key="PickCardOnTextBrush" Color="#C7BFFF"/>
                    <!-- 桌面分区里的设备卡：开/关只用这一种半透明底，让窗口磨砂透上来
                         （主窗口列表里的 DevCard 用 CardBrush / DevOnBrush，不受影响）
                         6% 白：卡与卡的差别交给图标和文字，底只作「可点」提示。
                         这层是**加亮**，压在分区底色上会直接吃掉白字对比 —— 10% 时白字从
                         3.4:1 掉到 3.0:1，所以只留 6%，别再往上加 -->
                    <SolidColorBrush x:Key="DskCardBrush" Color="#0FFFFFFF"/>
                    <!-- 分区里的电源键：底也是半透明白，不能压住磨砂 -->
                    <SolidColorBrush x:Key="DskSwitchBrush" Color="#33FFFFFF"/>
                    <SolidColorBrush x:Key="DskSwitchOnBrush" Color="#9984ECFF"/>
                    <!-- 设备卡「更多」：铺满设备图标位置的圆角方底（近不透明的卡面色，压住背后的图标）；
                         自身悬停再亮一档，确认「点到它了」 -->
                    <SolidColorBrush x:Key="MoreBtnBgBrush" Color="#E61A1F2C"/>
                    <SolidColorBrush x:Key="MoreBtnBgHoverBrush" Color="#F22A3145"/>
                    <LinearGradientBrush x:Key="PrimaryBtnBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7C5CFC" Offset="0"/>
                        <GradientStop Color="#8B7CFF" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7C5CFC" Offset="0"/>
                        <GradientStop Color="#9B8CFF" Offset="1"/>
                    </LinearGradientBrush>
                    <Color x:Key="HeroColor1">#1C2030</Color>
                    <Color x:Key="HeroColor2">#141822</Color>
                    <Color x:Key="HeroColor3">#1A1F35</Color>
                    <Color x:Key="HeroGlowColor">#2AFF8FAB</Color>
                    <Color x:Key="HeroGlow2Color">#18FF8FAB</Color>
                    <Color x:Key="Ambient1">#1F7C5CFC</Color>
                    <Color x:Key="Ambient2">#14FF8FAB</Color>
                    <!-- Hero 统计：统一轻底，弱化彩色背景 -->
                    <SolidColorBrush x:Key="HeroStatGreenBg" Color="#0DFFFFFF"/>
                    <SolidColorBrush x:Key="HeroStatPurpleBg" Color="#0DFFFFFF"/>
                    <SolidColorBrush x:Key="HeroStatBlueBg" Color="#0DFFFFFF"/>
                    <SolidColorBrush x:Key="HeroBorderBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="StatPinkBrush" Color="#FF8FAB"/>
                    <!-- 骨架占位：卡底比真卡略沉，占位块略亮，白色高光带扫过才看得出来。
                         渐变端点必须写百分号，纯数字会被当成绝对像素，整条渐变缩成 1px。 -->
                    <SolidColorBrush x:Key="SkelCardBrush" Color="#161A24"/>
                    <SolidColorBrush x:Key="SkelBarBrush" Color="#242938"/>
                    <LinearGradientBrush x:Key="SkelShineBrush" StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#40FFFFFF" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                    <!-- ======== 右键菜单（设备卡）：Fluent 默认是直角深灰板，这里换成与卡片同族的浮层
                         （外壳与菜单项模板内联在 Templates.axaml，这里只配色） ======== -->
                    <SolidColorBrush x:Key="MenuBgBrush" Color="#1E2431"/>
                    <SolidColorBrush x:Key="MenuLineBrush" Color="#1AFFFFFF"/>
                    <!-- 菜单项文字：单独开键而不复用 TextBrush，桌面分区才能在自己面板的
                         Resources 里就地覆盖成浅色，不波及主窗口列表。图标描边直接绑同一支。 -->
                    <SolidColorBrush x:Key="MenuTextBrush" Color="#EEF1F6"/>
                    <!-- ======== 下拉框（ComboBox）：与输入框同一套半透明底 + 极淡描边，
                         浮层沿用右键菜单的深板；选中项走品牌紫实心 ======== -->
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#0FFFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#08FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#12FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#22FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#22FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#0AFFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="#EEF1F6"/>
                    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#EEF1F6"/>
                    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#EEF1F6"/>
                    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#646C7E"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1E2431"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#1AFFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#EEF1F6"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#282F42"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#282F42"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#8B7CFF"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#9B8CFF"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#6F60DE"/>
                    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#EEF1F6"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgBrush" Color="#E6EAF1"/>
                    <SolidColorBrush x:Key="PanelBrush" Color="#F7F9FC"/>
                    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="Card2Brush" Color="#F0F3F8"/>
                    <!-- 设置页内卡片：比全局 CardBrush 再淡一档，降低存在感 -->
                    <SolidColorBrush x:Key="CardSoftBrush" Color="#F6F8FC"/>
                    <!-- 搜索框底：Card2Brush 50% 透明，比面板更轻 -->
                    <SolidColorBrush x:Key="SearchBgBrush" Color="#80F0F3F8"/>
                    <!-- 搜索框边框：LineBrush 一半透明度 -->
                    <SolidColorBrush x:Key="SearchLineBrush" Color="#0A0F172A"/>
                    <!-- 下拉触发器：底色 3%、边框 5%，比搜索框更轻，层次交给浮层投影 -->
                    <SolidColorBrush x:Key="PickFillBrush" Color="#080F172A"/>
                    <SolidColorBrush x:Key="PickLineBrush" Color="#0C0F172A"/>
                    <SolidColorBrush x:Key="HoverBrush" Color="#E8EDF5"/>
                    <SolidColorBrush x:Key="PlayHoverFromBrush" Color="#00E8EDF5"/>
                    <SolidColorBrush x:Key="LineBrush" Color="#140F172A"/>
                    <!-- 主窗口卡片外轮廓：比全局 LineBrush 深一档，窗口贴在桌面上时才立得住 -->
                    <SolidColorBrush x:Key="WindowLineBrush" Color="#260F172A"/>
                    <SolidColorBrush x:Key="ZoneLineBrush" Color="#1F0F172A"/>
                    <!-- 可点胶囊的悬停描边：比 LineBrush 深一档，让静止/悬停/展开三态成色阶 -->
                    <SolidColorBrush x:Key="LineStrongBrush" Color="#240F172A"/>
                    <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
                    <SolidColorBrush x:Key="Text2Brush" Color="#5A6478"/>
                    <SolidColorBrush x:Key="Text3Brush" Color="#8A93A6"/>
                    <!-- 浅色主题下磨砂偏亮，文字反而要往下压深才清晰（与深色主题相反方向） -->
                    <SolidColorBrush x:Key="DskTextBrush" Color="#0B1220"/>
                    <SolidColorBrush x:Key="DskText2Brush" Color="#3A4457"/>
                    <SolidColorBrush x:Key="DskText3Brush" Color="#5A6478"/>
                    <!-- 浅色主题下滚动条整体压浅：静止更淡，悬停/拖动只略深一档，避免出现一条黑条 -->
                    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#C6CCD8"/>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#AFB8C7"/>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#99A3B5"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#8E83F0"/>
                    <SolidColorBrush x:Key="Accent2Brush" Color="#7E76E0"/>
                    <Color x:Key="Accent2Color">#7E76E0</Color>
                    <SolidColorBrush x:Key="PinBrush" Color="#7C5CFC"/>
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F6D5BE3"/>
                    <!-- 菜单 / 下拉的选中底：浅底上直接用取色到的实心紫 #7C5CFC，悬停亮一档、按压深一档 -->
                    <SolidColorBrush x:Key="SelBgBrush" Color="#7C5CFC"/>
                    <SolidColorBrush x:Key="SelBgHoverBrush" Color="#9C8BFF"/>
                    <SolidColorBrush x:Key="SelBgPressBrush" Color="#6A4BEA"/>
                    <!-- 淡入起点：与 SelBgHoverBrush 同色、透明位为 0 -->
                    <SolidColorBrush x:Key="SelBgFromBrush" Color="#009C8BFF"/>
                    <!-- 选中行文字：实心紫的互补色 -->
                    <SolidColorBrush x:Key="SelTextBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="WarmTextBrush" Color="#5B4BC9"/>
                    <SolidColorBrush x:Key="NavActiveTextBrush" Color="#5B4BC9"/>
                    <!-- 电源键开启态：浅色主题下再提亮一档，更通透 -->
                    <SolidColorBrush x:Key="PowerOnBrush" Color="#9B8CFF"/>
                    <!-- 开关开启态轨道：浅底上用取色到的实心紫 #7C5CFC（与菜单选中底同档） -->
                    <SolidColorBrush x:Key="SwitchOnBrush" Color="#7C5CFC"/>
                    <SolidColorBrush x:Key="GreenBrush" Color="#4ADE80"/>
                    <SolidColorBrush x:Key="GreenSoftBrush" Color="#1F16A34A"/>
                    <SolidColorBrush x:Key="BlueBrush" Color="#60A5FA"/>
                    <Color x:Key="BlueColor">#60A5FA</Color>
                    <SolidColorBrush x:Key="BlueSoftBrush" Color="#1C2563EB"/>
                    <SolidColorBrush x:Key="PinkBrush" Color="#EC4899"/>
                    <Color x:Key="PinkColor">#EC4899</Color>
                    <SolidColorBrush x:Key="PinkSoftBrush" Color="#1AEC4899"/>
                    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1ADC2626"/>
                    <SolidColorBrush x:Key="AmberBrush" Color="#FBBF24"/>
                    <SolidColorBrush x:Key="AmberSoftBrush" Color="#24E9A05C"/>
                    <SolidColorBrush x:Key="AmberSoft2Brush" Color="#38E9A05C"/>
                    <SolidColorBrush x:Key="AmberTextBrush" Color="#C9843C"/>
                    <SolidColorBrush x:Key="PurpleBrush" Color="#A78BFA"/>
                    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#1F7C3AED"/>
                    <!-- 统计卡数字：比主色亮一档、淡一档，避免数字压过卡片 -->
                    <SolidColorBrush x:Key="StatGreenBrush" Color="#6CCB92"/>
                    <SolidColorBrush x:Key="StatPurpleBrush" Color="#A596EA"/>
                    <SolidColorBrush x:Key="StatBlueBrush" Color="#82AAEE"/>
                    <!-- 浅色主题同对：窗帘青绿、空调天蓝，饱和度对齐其余统计色 -->
                    <SolidColorBrush x:Key="StatTealBrush" Color="#3FAE9F"/>
                    <SolidColorBrush x:Key="StatCyanBrush" Color="#2E9FD6"/>
                    <SolidColorBrush x:Key="CoolBrush" Color="#3B82F6"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#0D0F172A"/>
                    <SolidColorBrush x:Key="Surface4Brush" Color="#120F172A"/>
                    <SolidColorBrush x:Key="Surface5Brush" Color="#140F172A"/>
                    <SolidColorBrush x:Key="TrackBrush" Color="#E7EBF3"/>
                    <SolidColorBrush x:Key="ThumbBrush" Color="#FFFFFF"/>
                    <!-- 滑动条（浅色）：加高轨道、渐变已填充段、白滑块 -->
                    <SolidColorBrush x:Key="SliderTrackFill" Color="#C6CCD8"/>
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#B5BDCC"/>
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#B5BDCC"/>
                    <LinearGradientBrush x:Key="SliderTrackValueFill" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#6D5BE3" Offset="0"/>
                        <GradientStop Color="#8B7CFF" Offset="1"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#8B7CFF"/>
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#6D5BE3"/>
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#EDEFF6"/>
                    <SolidColorBrush x:Key="MaskBrush" Color="#340F172A"/>
                    <!-- 抽屉托盘遮罩：比登录/设置遮罩更轻，只作层次提示不压暗内容 -->
                    <SolidColorBrush x:Key="DrawerMaskBrush" Color="#260F172A"/>
                    <!-- 浅色遮罩层：叠在 DrawerMaskBrush 之上再补一点点深度 -->
                    <SolidColorBrush x:Key="MaskLightBrush" Color="#0C0F172A"/>
                    <!-- 抽屉托盘：与主内容面板同色，白卡在其上浮起（卡片式分布） -->
                    <SolidColorBrush x:Key="DrawerBgBrush" Color="#F7F9FC"/>
                    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F7F9FC" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BannerBrush" StartPoint="0,0" EndPoint="1,0.6">
                        <GradientStop Color="#E8EEFF" Offset="0"/>
                        <GradientStop Color="#F3F6FC" Offset="0.7"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="DevOnBrush" StartPoint="0.1,0" EndPoint="0.5,1">
                        <GradientStop Color="#1F6D5BE3" Offset="0"/>
                        <GradientStop Color="#0A6D5BE3" Offset="0.55"/>
                        <GradientStop Color="#FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                    <!-- 添加设备（选择器）里的设备卡：浅色下用纯白卡 + 悬停淡灰 -->
                    <SolidColorBrush x:Key="PickCardBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="PickCardHoverBrush" Color="#EDF1F8"/>
                    <!-- 房间直达条的选中胶囊仍用实心主色（单选、只有一枚，不会铺满屏） -->
                    <SolidColorBrush x:Key="PickCardOnBrush" Color="#6F5AE6"/>
                    <!-- 已选中的设备卡：淡紫底 + 主色描边 + 主色文字，不整片铺主色 -->
                    <SolidColorBrush x:Key="PickCardOnFillBrush" Color="#F7F5FE"/>
                    <SolidColorBrush x:Key="PickCardOnFillHoverBrush" Color="#EFEAFB"/>
                    <SolidColorBrush x:Key="PickCardOnLineBrush" Color="#CFC4F2"/>
                    <SolidColorBrush x:Key="PickCardOnTextBrush" Color="#6D5BE3"/>
                    <!-- 桌面分区里的设备卡：开/关同一种半透明白底 -->
                    <SolidColorBrush x:Key="DskCardBrush" Color="#B8FFFFFF"/>
                    <SolidColorBrush x:Key="DskSwitchBrush" Color="#B3E7EBF3"/>
                    <SolidColorBrush x:Key="DskSwitchOnBrush" Color="#CC8E83F0"/>
                    <!-- 设备卡「更多」：铺满设备图标位置的圆角方底（浅灰蓝、近不透明，白卡上也有边界）；
                         自身悬停再深一档 -->
                    <SolidColorBrush x:Key="MoreBtnBgBrush" Color="#F2DDE4F0"/>
                    <SolidColorBrush x:Key="MoreBtnBgHoverBrush" Color="#FFC9D3E6"/>
                    <LinearGradientBrush x:Key="PrimaryBtnBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6D5BE3" Offset="0"/>
                        <GradientStop Color="#8B7CFF" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6D5BE3" Offset="0"/>
                        <GradientStop Color="#9B8CFF" Offset="1"/>
                    </LinearGradientBrush>
                    <Color x:Key="HeroColor1">#FFFFFF</Color>
                    <Color x:Key="HeroColor2">#EEF2FB</Color>
                    <Color x:Key="HeroColor3">#E8EEFF</Color>
                    <Color x:Key="HeroGlowColor">#2AEC4899</Color>
                    <Color x:Key="HeroGlow2Color">#14EC4899</Color>
                    <Color x:Key="Ambient1">#146D5BE3</Color>
                    <Color x:Key="Ambient2">#0FEC4899</Color>
                    <!-- Hero 统计：统一轻底，弱化彩色背景 -->
                    <SolidColorBrush x:Key="HeroStatGreenBg" Color="#0D0F172A"/>
                    <SolidColorBrush x:Key="HeroStatPurpleBg" Color="#0D0F172A"/>
                    <SolidColorBrush x:Key="HeroStatBlueBg" Color="#0D0F172A"/>
                    <SolidColorBrush x:Key="HeroBorderBrush" Color="#140F172A"/>
                    <SolidColorBrush x:Key="StatPinkBrush" Color="#EC4899"/>
                    <LinearGradientBrush x:Key="SkelShineBrush" StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="SkelCardBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SkelBarBrush" Color="#DDE3EE"/>
                    <!-- ======== 右键菜单（设备卡）：浅色下用纯白浮层 + 极淡描边 ======== -->
                    <SolidColorBrush x:Key="MenuBgBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="MenuLineBrush" Color="#140F172A"/>
                    <SolidColorBrush x:Key="MenuTextBrush" Color="#0F172A"/>
                    <!-- ======== 下拉框（ComboBox）：与输入框同一套淡底 + 极淡描边，浮层用纯白板 ======== -->
                    <SolidColorBrush x:Key="ComboBoxBackground" Color="#0F0F172A"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#160F172A"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#160F172A"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#080F172A"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#140F172A"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#240F172A"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#240F172A"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#0C0F172A"/>
                    <SolidColorBrush x:Key="ComboBoxForeground" Color="#0F172A"/>
                    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#0F172A"/>
                    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#0F172A"/>
                    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#8A93A6"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#140F172A"/>
                    <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#0F172A"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#EDF1F8"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#EDF1F8"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#7C5CFC"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#9C8BFF"/>
                    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#6A4BEA"/>
                    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#0F172A"/>
                    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFFFFF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>