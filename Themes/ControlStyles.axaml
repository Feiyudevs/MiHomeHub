<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ani="clr-namespace:Avalonia.Animation.Easings;assembly=Avalonia.Base"
    xmlns:conv="clr-namespace:MiHomeHub.Converters"
    xmlns:ctl="clr-namespace:MiHomeHub.Controls"
    xmlns:vm="clr-namespace:MiHomeHub.ViewModels"
    xmlns:m="clr-namespace:MiHomeHub.Models">
        <!-- ======== 全局基础 ======== -->
        <!-- 字体族是内存敏感项，不要改成多段链（如 "A, B, C"），也不要换成 Segoe UI：
             多段链会让 Avalonia 每排版一次都去逐个探测候选字族，探测过程会新建 GlyphTypeface；
             而 Segoe 系（含 Segoe UI Variable）的请求名与系统实际返回名不一致，字型缓存永远不命中，
             于是每排版一次就新建一份字型对象 + 整张 Name 表且释放不掉（实测可涨到 1GB 量级）。
             这里只写单一字体，字形自足（中英文都覆盖），命中缓存后不再产生新对象。 -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
        </Style>
        <Style Selector="TextBlock.Hint">
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- 设置行副标题：右侧控件占了列宽，单行会被裁掉，允许折成两行 -->
        <Style Selector="TextBlock.Hint.Sub">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>
        <!-- 设备卡文字：默认按主窗口配色（名称次级亮、房间/路数次级灰）。
             桌面分区卡在 DesktopGroupView 里用更具体的选择器覆盖成 DskText* 提亮一档，
             因此这三处都必须只由样式上色，元素上不能写本地 Foreground -->
        <Style Selector="TextBlock.DevName">
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
        </Style>
        <Style Selector="TextBlock.DevMeta">
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
        </Style>
        <Style Selector="TextBlock.SecTitle">
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,26,0,12"/>
        </Style>
        <Style Selector="TextBlock.SecTitle:first-child">
            <Setter Property="Margin" Value="2,0,0,12"/>
        </Style>
        <!-- 首页房间标题行：整行可点，点一下收起 / 展开该房间的设备卡片。
             不给整行铺底色，只在悬停时把标题与箭头提亮一档，避免一排房间标题变成一排按钮 -->
        <Style Selector="Button.RoomHead">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TextBlock.RoomName">
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.RoomHead:pointerover TextBlock.RoomName">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Path.RoomChev">
            <Setter Property="Stroke" Value="{DynamicResource Text3Brush}"/>
        </Style>
        <Style Selector="Button.RoomHead:pointerover Path.RoomChev">
            <Setter Property="Stroke" Value="{DynamicResource Text2Brush}"/>
        </Style>
        <!-- 房间标题左侧的细线图标（玻璃模式改由 Image 画，这条只管细线那套） -->
        <Style Selector="Path.RoomIc">
            <Setter Property="Stroke" Value="{DynamicResource Text3Brush}"/>
        </Style>
        <Style Selector="Button.RoomHead:pointerover Path.RoomIc">
            <Setter Property="Stroke" Value="{DynamicResource Text2Brush}"/>
        </Style>
        <!-- 房间标题上的「N 盏灯亮着」小胶囊：暖色底 + 琥珀字，和侧栏那枚点亮的小灯泡同一套配色；
             只在房间确实有灯开着时出现，灯全关后连胶囊带「一键全关」一起收起 -->
        <Style Selector="Border.RoomLightPill">
            <Setter Property="Background" Value="{DynamicResource PillWarnBgBrush}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,2,9,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.RoomLightPill TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource AmberTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource R}"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
        </Style>
        <!-- 设置页内卡片：比全局再淡一档，整体更收敛 -->
        <Style Selector="StackPanel.SetArea Border.Card">
            <Setter Property="Background" Value="{DynamicResource CardSoftBrush}"/>
        </Style>
        <!-- 滑动条滑块：白圆点加轻投影，浮在加高的轨道上 -->
        <Style Selector="Slider /template/ Thumb /template/ Border">
            <Setter Property="BoxShadow" Value="0 1 4 #59000000"/>
        </Style>
        <!-- ======== 悬停 / 按下的颜色过渡 ========
             只要鼠标移上去会变色，就必须在一个过渡里淡变过去，不能一帧硬切。
             但只淡背景：文字与图标是「换色」不是「渐变」，移上去直接换到目标色、
             不要把两色之间的中间帧画出来，否则字会糊糊地漂一秒。 -->
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- ======== 按钮 ======== -->
        <Style Selector="Button.BtnPrimary">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="10" Background="{DynamicResource PrimaryBtnBrush}"
                            BoxShadow="0 2 8 #00000040"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.BtnPrimary:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Accent2Brush}"/>
        </Style>
        <Style Selector="Button.BtnPrimary:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.BtnPrimary:disabled /template/ Border#Bd">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Button.BtnGhost">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="10" Background="{DynamicResource Card2Brush}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="Cp" Content="{TemplateBinding Content}"
                                          TextBlock.Foreground="{DynamicResource Text2Brush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.BtnGhost:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <Style Selector="Button.BtnGhost:pointerover /template/ ContentPresenter#Cp">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <!-- 区块内的轻量「添加」小钮：不做实心底，只描一圈淡边。
             实心底在深色卡里像一块砖，压在标题行右侧很抢眼；描边版才是"可点入口"的视觉语言。 -->
        <Style Selector="Button.AddChip">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="7"
                            Background="Transparent"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="Cp" Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.AddChip:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.AddChip:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Accent2Brush}"/>
        </Style>
        <Style Selector="Button.AddChip:disabled /template/ Border#Bd">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <!-- 危险动作钮（删除）：结构与 BtnGhost 一致，正红文字 + 悬停淡红底 -->
        <Style Selector="Button.BtnDanger">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="10" Background="{DynamicResource Surface4Brush}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="Cp" Content="{TemplateBinding Content}"
                                          TextBlock.Foreground="{DynamicResource DangerBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.BtnDanger:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
        </Style>
        <Style Selector="Button.BtnDanger:disabled /template/ Border#Bd">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <!-- 自绘开关：轨道 38x22，滑块居左/居右表示关/开 -->
        <Style Selector="Button.Switch">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- 关闭态同样走 SwitchOffBrush + 细边：原来的 Card2Brush 在浅色卡片上只有 1.04:1，
                         轨道整条看不见，只剩一枚灰滑块浮在半空 -->
                    <Border Name="Track" CornerRadius="11" Background="{DynamicResource SwitchOffBrush}"
                            BorderBrush="{DynamicResource SwitchOffStrokeBrush}" BorderThickness="1">
                        <Ellipse Name="Knob" Width="16" Height="16" Margin="2,0"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Fill="{DynamicResource Text3Brush}"
                                 Stroke="{DynamicResource SwitchKnobStrokeBrush}" StrokeThickness="1"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.Switch.on /template/ Border#Track">
            <Setter Property="Background" Value="{DynamicResource SwitchOnBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.Switch.on /template/ Ellipse#Knob">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Fill" Value="White"/>
        </Style>
        <Style Selector="Button.Switch:pointerover /template/ Border#Track">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.IconBtn">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="10" Background="{DynamicResource CardBrush}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.IconBtn:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <!-- 窗口控制钮 36×36（与 ThemeBtn 同高，图标垂直对齐、圆角悬浮） -->
        <Style Selector="Button.WinBtn">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="8" Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.WinBtn:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        </Style>
        <Style Selector="Button.WinBtn.close:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="#E81123"/>
        </Style>
        <Style Selector="Button.WinBtn.close:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- macOS 红绿灯 12×12 圆点：悬停才显示 ×/−/对角箭头，颜色照搬系统 -->
        <Style Selector="Button.MacLight">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Ellipse Name="Dot" Width="12" Height="12" Fill="#FF5F57"/>
                        <Path Name="Glyph" Width="8" Height="8" Stretch="Uniform"
                              StrokeThickness="1.1" StrokeLineCap="Round" IsVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.MacLight.min /template/ Ellipse#Dot">
            <Setter Property="Fill" Value="#FEBC2E"/>
        </Style>
        <Style Selector="Button.MacLight.zoom /template/ Ellipse#Dot">
            <Setter Property="Fill" Value="#28C840"/>
        </Style>
        <Style Selector="Button.MacLight.close /template/ Path#Glyph">
            <Setter Property="Data" Value="{StaticResource MacGlyphClose}"/>
            <Setter Property="Stroke" Value="#7A0B00"/>
        </Style>
        <Style Selector="Button.MacLight.min /template/ Path#Glyph">
            <Setter Property="Data" Value="{StaticResource MacGlyphMin}"/>
            <Setter Property="Stroke" Value="#7A5200"/>
        </Style>
        <Style Selector="Button.MacLight.zoom /template/ Path#Glyph">
            <Setter Property="Data" Value="{StaticResource MacGlyphZoom}"/>
            <Setter Property="Stroke" Value="#0B5A1E"/>
        </Style>
        <Style Selector="Button.MacLight:pointerover /template/ Path#Glyph">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <!-- 标题栏主题钮 36×36（抽屉关闭钮可覆写 Width/Height/Padding） -->
        <Style Selector="Button.ThemeBtn">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="8" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.ThemeBtn:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        </Style>
        <Style Selector="Button.ThemeBtn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <!-- 圆形图标钮：底色 SurfaceBrush 是分主题的一层轻微抬升（暗底加白、亮底加深），
             悬停改用同色覆盖层淡入 —— 不能直接对 Background 做颜色过渡：
             SurfaceBrush 是 5% 白、HoverBrush 是实心色，逐通道插值会在中途冲出一层浅灰，
             就是悬停那一下「闪一下」。覆盖层色始终是 HoverBrush，只有透明度在动 -->
        <Style Selector="Button.IconDisc">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="17" Background="{DynamicResource SurfaceBrush}">
                        <Panel>
                            <Border Name="Hov" CornerRadius="17" Background="{DynamicResource HoverBrush}"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.IconDisc /template/ Border#Hov">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.IconDisc:pointerover /template/ Border#Hov">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.IconDisc:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <!-- 胶囊图标+文字钮：底与悬停同 IconDisc，横向按内距撑开，圆角取半高成胶囊 -->
        <Style Selector="Button.IconPill">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="16" Background="{DynamicResource SurfaceBrush}">
                        <Panel>
                            <Border Name="Hov" CornerRadius="16" Background="{DynamicResource HoverBrush}"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.IconPill /template/ Border#Hov">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.IconPill:pointerover /template/ Border#Hov">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.IconPill:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <!-- ======== 开关 40×22（§8.4） ======== -->
        <Style Selector="ToggleButton.Switch">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- 轨道带 1px 描边：浅色模式下关闭态只靠底色几乎压不出来，得有一圈细边兜底；
                         描边会占掉 1px 内容区，滑块坐标按外包尺寸 3px 的内缩重算（2 + 1） -->
                    <Border Name="Track" CornerRadius="11" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource SwitchOffStrokeBrush}" BorderThickness="1">
                        <Canvas>
                            <Ellipse Name="Thumb" Width="16" Height="16" Canvas.Left="2" Canvas.Top="2"
                                     Fill="{TemplateBinding Foreground}"
                                     Stroke="{DynamicResource SwitchKnobStrokeBrush}" StrokeThickness="1">
                                <Ellipse.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Canvas.Left" Duration="0:0:0.24">
                                            <DoubleTransition.Easing>
                                                <ani:BackEaseOut/>
                                            </DoubleTransition.Easing>
                                        </DoubleTransition>
                                    </Transitions>
                                </Ellipse.Transitions>
                            </Ellipse>
                        </Canvas>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Background" Value="{DynamicResource SwitchOffBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThumbBrush}"/>
        </Style>
        <Style Selector="ToggleButton.Switch /template/ Border#Track">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.22"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.Switch:checked">
            <Setter Property="Background" Value="{DynamicResource SwitchOnBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- 开启态是实心紫，那圈灰细边会变成一道脏边，单独关掉 -->
        <Style Selector="ToggleButton.Switch:checked /template/ Border#Track">
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.Switch:checked /template/ Ellipse#Thumb">
            <Setter Property="Canvas.Left" Value="20"/>
        </Style>
        <Style Selector="ToggleButton.Switch:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <!-- ======== 卡片电源按钮：圆形底 + 电源图标（关=淡底，开=主色底） ======== -->
        <!-- 关闭态用 TrackBrush：SurfaceBrush 只有 5% 白，深色卡上圆底几乎不可见，会被看成一个小图标 -->
        <Style Selector="ctl|DevicePowerButton.Power">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource TrackBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Disc 不设对齐（默认 Stretch 铺满按钮）；设 Center 会收缩到图标大小 -->
                    <Border Name="Disc" CornerRadius="16" Background="{TemplateBinding Background}">
                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 电源符号：上竖线 + 开口圆弧，描边绘制保证小尺寸不糊 -->
                            <Path Name="PowerIcon" Width="13" Height="13" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="M18.36,6.64 A9,9 0 1 1 6.64,6.64 M12,2 V12"/>
                            <!-- 窗帘：图标直接用布帘的开合状态表达开关 —— 关=两片合拢在中间，
                                 开=收向两侧；按 24 网格画好交给 Viewbox 居中缩放
                                 （Path 单独用 Stretch 会贴左上角，宽扁图形会看起来偏高） -->
                            <Viewbox Name="CurtainIcons" Width="17" Height="17" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Panel Width="24" Height="24">
                                    <!-- 杆单独一条、比布帘粗一档：与布帘同宽时同线宽会被读成「书本」 -->
                                    <Path Name="CurtainRod"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="2.8" StrokeLineCap="Round"
                                          Data="M3.6,4 H20.4"/>
                                    <Path Name="CurtainClosed"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                          Data="M3.6,4 V16 Q3.6,19 6.6,19 H17.4 Q20.4,19 20.4,16 V4 M12,4 V19"/>
                                    <Path Name="CurtainOpen"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                          Data="M3.6,4 V16 Q3.6,19 6.6,19 H9 V4 M20.4,4 V16 Q20.4,19 17.4,19 H15 V4"/>
                                </Panel>
                            </Viewbox>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- 普通设备显示电源符号；窗帘卡片（.curtain）换成布帘图标，
             且布帘形态直接跟随开关状态：关=合拢，开=收向两侧 -->
        <Style Selector="ctl|DevicePowerButton.Power /template/ Path#CurtainClosed">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="ctl|DevicePowerButton.Power /template/ Path#CurtainOpen">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ctl|DevicePowerButton.Power /template/ Viewbox#CurtainIcons">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ctl|DevicePowerButton.Power.curtain /template/ Path#PowerIcon">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ctl|DevicePowerButton.Power.curtain /template/ Viewbox#CurtainIcons">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="ctl|DevicePowerButton.Power.curtain:checked /template/ Path#CurtainClosed">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ctl|DevicePowerButton.Power.curtain:checked /template/ Path#CurtainOpen">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="ctl|DevicePowerButton.Power /template/ Border#Disc">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.22"/>
                    <!-- 悬停只把圆底压暗 15%，同样走过渡，避免按下/移开时闪一下 -->
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ctl|DevicePowerButton.Power">
            <Setter Property="RenderTransform" Value="translate(0px,0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- 卡片悬停不再移动电源键：「更多」已改为浮在左侧设备图标上，右列保持原位，
             开关随手感不变（标签页 / 桌面分区共用这一档） -->
        <Style Selector="ctl|DevicePowerButton.Power:pointerover /template/ Border#Disc">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="ctl|DevicePowerButton.Power:checked">
            <Setter Property="Background" Value="{DynamicResource PowerOnBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ctl|DevicePowerButton.Power:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <!-- ======== 侧栏导航 ======== -->
        <Style Selector="Button.NavRow">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- 外层 Hit 用 Transparent 背景铺满整行，保证空白区域也能命中 hover/点击 -->
                    <Border Name="Hit" Background="Transparent">
                        <Panel>
                            <Border Name="Bar" Width="3" Height="18" CornerRadius="0 2 2 0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="Transparent"/>
                            <Border Name="Bg" CornerRadius="12" Padding="12,9,12,9" Margin="10,3,10,3"
                                    Background="Transparent">
                                <Grid ColumnDefinitions="21,*,Auto">
                                    <!-- 两套画法都备好，靠设置里的图标模式二选一显示 -->
                                    <Image Name="Gx" Grid.Column="0" Width="17" Height="17" Stretch="Uniform"
                                           RenderOptions.BitmapInterpolationMode="MediumQuality"
                                           Opacity="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NavIconOpacity}}"
                                           IsVisible="{Binding ((vm:MainViewModel)DataContext).IconGlass, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NavSvg}}"/>
                                    <Path Name="Ic" Grid.Column="0" Width="15" Height="15" Stretch="Uniform"
                                          Opacity="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NavIconOpacity}}"
                                          IsVisible="{Binding !((vm:MainViewModel)DataContext).IconGlass, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NavLine}}"/>
                                    <!-- 用户自定义的房间图（SVG 或 PNG）：有就盖在默认图标上并把默认画法隐到透明 -->
                                    <Image Name="Cx" Grid.Column="0" Width="17" Height="17" Stretch="Uniform"
                                           RenderOptions.BitmapInterpolationMode="MediumQuality"
                                           IsVisible="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NavCustomVisible}}"
                                           Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NavCustomImage}}"/>
                                    <TextBlock Name="Lb" Grid.Column="1" Text="{TemplateBinding Content}"
                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Foreground="{TemplateBinding Foreground}"/>
                                    <!-- 房间灯还亮着：房间名右侧一枚点着的小灯泡（实心灯身 + 一圈暖黄光晕）。
                                         所有导航行共用一个模板，这里默认隐藏，由 .lighton 类点亮；
                                         纯状态标记，不参与命中，点它等同点整行。
                                         灯身放大到 17（原 13 整个图形只占 24 视框的一半，白底上缩成一粒淡黄点），
                                         灯色与光晕各走主题专属的两支画笔（深色亮黄 / 浅色深琥珀），不再借 AmberBrush。 -->
                                    <Panel Name="Lamp" Grid.Column="2" Width="20" Height="20"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           IsVisible="False" IsHitTestVisible="False">
                                        <!-- 光晕比灯身再大一圈（24 对 20，Panel 不裁子元素，只向外溢 2px，
                                             不影响行高），灯点才有一圈真正散开的光 -->
                                        <Ellipse Width="24" Height="24" Fill="{DynamicResource LampGlowBrush}" />
                                        <Viewbox Width="20" Height="20"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Panel Width="24" Height="24">
                                                <Path Fill="{DynamicResource LampBulbBrush}"
                                                      Data="{StaticResource GeoBulbGlass}" />
                                                <Path Stroke="{DynamicResource LampBulbBaseBrush}" StrokeThickness="2"
                                                      StrokeLineCap="Round" Data="{StaticResource GeoBulbBase}" />
                                            </Panel>
                                        </Viewbox>
                                    </Panel>
                                </Grid>
                            </Border>
                            <!-- 拖拽抓手：六点两列三行，挪到行左缘——和选中竖条共用同一条槽位
                                 （竖条贴 0~3px，六点落在它右侧的留白里，选中时六点自动让位）。
                                 默认透明且不挡鼠标，悬停房间行才淡淡浮现，按住左缘立即进入排序（不用长按） -->
                            <Border Name="Grip" Width="10" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    Background="Transparent" Cursor="SizeAll">
                                <!-- 八宫格 4×4 等分（8×12）：点径与行/列步长都取整数像素，三行两列才会等距；
                                     原来 8×15 的行步长是 5、列是 4，非整数取整后中间那行会偏，看着没有等分 -->
                                <Grid Name="GripDots" Width="8" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                                      ColumnDefinitions="*,*" RowDefinitions="*,*,*">
                                    <Ellipse Grid.Row="0" Grid.Column="0" Width="2" Height="2"
                                             Fill="{DynamicResource Text3Brush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Row="0" Grid.Column="1" Width="2" Height="2"
                                             Fill="{DynamicResource Text3Brush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Row="1" Grid.Column="0" Width="2" Height="2"
                                             Fill="{DynamicResource Text3Brush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2"
                                             Fill="{DynamicResource Text3Brush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Row="2" Grid.Column="0" Width="2" Height="2"
                                             Fill="{DynamicResource Text3Brush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Row="2" Grid.Column="1" Width="2" Height="2"
                                             Fill="{DynamicResource Text3Brush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.NavRow:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        </Style>
        <Style Selector="Button.NavRow:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Button.NavRow.on">
            <Setter Property="Foreground" Value="{DynamicResource NavActiveTextBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <!-- 选中底色交给共享滑块（Border.NavSlider）画：行自身留透明，悬停也不盖住滑块，
             这样滑块才能从上一行「位移」到当前行（位置由 MainWindow 按 .on 行边界同步） -->
        <Style Selector="Button.NavRow.on /template/ Border#Bg">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.NavRow.on:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- 侧栏选中滑块：浅紫底 + 圆角（与外层行底色 12 圆角、10,3 内缩对齐），
             位移/宽高过渡与页签共享滑块同一套 0.28s CubicEaseInOut；首帧无过渡，避免开场滑块从 0 飞入 -->
        <Style Selector="Border.NavSlider">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style Selector="Border.NavSlider.ready">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Canvas.Left" Duration="0:0:0.28" Easing="CubicEaseInOut"/>
                    <DoubleTransition Property="Canvas.Top" Duration="0:0:0.28" Easing="CubicEaseInOut"/>
                    <DoubleTransition Property="Width" Duration="0:0:0.28" Easing="CubicEaseInOut"/>
                    <DoubleTransition Property="Height" Duration="0:0:0.28" Easing="CubicEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.NavRow.on /template/ Border#Bar">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <!-- 房间行图标：比导航图标再细一档，配合圆头圆角更轻盈 -->
        <Style Selector="Button.NavRow.room /template/ Path#Ic">
            <Setter Property="StrokeThickness" Value="1.2"/>
        </Style>
        <!-- 这个房间还有灯开着：点亮行内那枚小灯泡（「全部」永远不会挂这个类） -->
        <Style Selector="Button.NavRow.lighton /template/ Panel#Lamp">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <!-- 拖拽抓手：所有导航行默认透明、不参与命中（上面三行不参与排序，永远看不见）；
             房间行悬停时只淡淡浮现（三级文字色 + 0.6 透明度，弱化一档），按住行左缘即可拖。
             「全部」固定第一行，任何时候都不亮。 -->
        <Style Selector="Button.NavRow /template/ Border#Grip">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.NavRow.room:pointerover /template/ Border#Grip">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
        <!-- 选中行的竖条正占着这条槽位：六点不再叠上去，只留命中区（仍能按住左缘直接拖） -->
        <Style Selector="Button.NavRow.room.on:pointerover /template/ Border#Grip">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Button.NavRow.room.locked /template/ Border#Grip">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Button.NavRow.room.dragging /template/ Border#Grip">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <!-- 正在拖的那一行：原地淡成占位（落点用下面那条横线表达） -->
        <Style Selector="Button.NavRow.room.dragging">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <Style Selector="Button.NavRow.room.dragging /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        </Style>
        <!-- ======== 侧栏房间拖拽浮层（NavDragLayer 里的纯视觉元素） ======== -->
        <!-- 跟着指针走的那张房间卡：比行更高一档的浮起感 -->
        <Style Selector="Border.NavDragGhost">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BoxShadow" Value="0 8 20 0 #3A0F172A"/>
        </Style>
        <Style Selector="Border.NavDragGhost TextBlock.NavDragGhostLabel">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource NavActiveTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- 落点横线：横贯卡片宽度的一条 2px 细线，主色两端渐变收口，卡在插入位置的两行之间 -->
        <Style Selector="Border.NavDropBar">
            <Setter Property="Background" Value="{DynamicResource NavDropLineBrush}"/>
            <Setter Property="CornerRadius" Value="1"/>
        </Style>
        <!-- 侧栏分组小标题 -->
        <Style Selector="TextBlock.NavCaption">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
            <Setter Property="Margin" Value="22,14,10,6"/>
        </Style>
        <!-- ======== 芯片筛选条（§8.12） ======== -->
        <Style Selector="ToggleButton.Chip">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="20" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock Name="Lb" Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
        </Style>
        <Style Selector="ToggleButton.Chip:pointerover">
            <Setter Property="Background" Value="{DynamicResource Card2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="ToggleButton.Chip:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WarmTextBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <!-- ======== 设备卡（§8.6：无边框，开启淡紫渐变） ======== -->
        <Style Selector="ctl|DeviceCardButton.DevCard">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="RenderTransform" Value="translate(0px,0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2">
                        <TransformOperationsTransition.Easing>
                            <ani:CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Margin 由样式提供（默认 8，给投影留绘制空间：投影被控件边界裁切时才会出现硬边缺口）；
                         桌面分区内卡片不投影，局部样式把它收到 4，故此处不能再写本地值（本地值会压过样式 setter） -->
                    <Panel>
                        <!-- 卡面统一 80 高：读数标签换行时卡片不再跟着长高，
                             同一宫格里一张高一张矮、行间空档忽大忽小的问题一起消失。
                             比原来的 74 只高一点，和场景大卡同高；两项读数正好铺满，
                             再多一项也只是挤进内距，卡片本身不撑开 -->
                        <Border Name="Card" Height="80" CornerRadius="16" Padding="15,13"
                                ClipToBounds="True">
                            <Panel>
                                <!-- 底部彩色光晕：贴卡底往上晕开的一层彩色渐变（青 → 蓝 → 紫 → 粉）。
                                     这里刻意不用 BoxShadow：阴影画不到自身轮廓内，光源条必须露在卡内，
                                     一露就留下硬边暗缝；露在卡外又会被当成「卡片外面的光」。
                                     所以改用「横向彩色渐变 + 纵向柔化遮罩」的纯背景层：
                                     整层永远只在卡片本体范围内（圆角由 Border 自己的 CornerRadius 裁出来），
                                     纵向遮罩从 34% 处开始极缓地抬亮度，到卡底最浓，往上自然散开，没有硬边界。
                                     负外边距是 Padding 15,13 的反向值，把它撑到卡片本体边缘；透明度只由样式给。 -->
                                <Border Name="Glow" IsHitTestVisible="False"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="-15,-13,-15,-13"
                                        CornerRadius="16">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                            <GradientStop Color="#005FD8FF" Offset="0"/>
                                            <GradientStop Color="#B45FD8FF" Offset="0.15"/>
                                            <GradientStop Color="#C08FB6FF" Offset="0.42"/>
                                            <GradientStop Color="#C4A78BFA" Offset="0.66"/>
                                            <GradientStop Color="#C0FF9EC4" Offset="0.86"/>
                                            <GradientStop Color="#00FF9EC4" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                                            <GradientStop Color="#08FFFFFF" Offset="0.34"/>
                                            <GradientStop Color="#20FFFFFF" Offset="0.56"/>
                                            <GradientStop Color="#58FFFFFF" Offset="0.76"/>
                                            <GradientStop Color="#A8FFFFFF" Offset="0.9"/>
                                            <GradientStop Color="#FFFFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <!-- 已开启的设备：右侧压一层很淡的渐变彩，不用整块紫底也能一眼认出是开着的 -->
                                <Border Name="OnTint" IsHitTestVisible="False"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="-15,-13,-15,-13"
                                        CornerRadius="16">
                                    <Border.Background>
                                        <!-- 单一紫色、只走透明度渐变：不再从紫过渡到粉，右缘浓度回到原来量级 -->
                                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                            <GradientStop Color="#008B7CFF" Offset="0"/>
                                            <GradientStop Color="#008B7CFF" Offset="0.5"/>
                                            <GradientStop Color="#2A8B7CFF" Offset="0.8"/>
                                            <GradientStop Color="#4A8B7CFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Panel>
                        </Border>
                        <!-- 拖拽排序辅助框：盖在卡面上的覆盖层，不参与布局（悬停点亮时不会推动兄弟卡片）。
                             Opacity 与 Margin 都只由样式给（同上，本地值压不过样式）；默认全暗，只有分区那侧点亮。 -->
                        <Rectangle Name="DragHint" IsHitTestVisible="False"
                                   StrokeThickness="1.4" StrokeDashArray="3.5,2.5"
                                   RadiusX="16" RadiusY="16"
                                   Stroke="{DynamicResource AccentBrush}"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ctl|DeviceCardButton.DevCard /template/ Rectangle#DragHint">
            <!-- 外距与 Border#Card 同档（全局 8 / 分区 4），改那边要同步这边 -->
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- 底部光晕：静止全暗，悬停淡入；卡片抬起（-3px）与光晕同时发生，分区卡只留光晕 -->
        <Style Selector="ctl|DeviceCardButton.DevCard /template/ Border#Glow">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.24">
                        <DoubleTransition.Easing>
                            <ani:CubicEaseOut/>
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ctl|DeviceCardButton.DevCard:pointerover /template/ Border#Glow">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- 开启态右缘渐变：只在「卡面带电源键的开启设备」上出现 ——
             .on 是任意一路通电，.sw 是卡片显示单个开关（IsControllable && 单路），
             双开 / 四键这类多路卡不显示，它们进抽屉操作。开关切换时淡入淡出。 -->
        <Style Selector="ctl|DeviceCardButton.DevCard /template/ Border#OnTint">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22">
                        <DoubleTransition.Easing>
                            <ani:CubicEaseOut/>
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ctl|DeviceCardButton.DevCard.on.sw /template/ Border#OnTint">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ctl|DeviceCardButton.DevCard /template/ Border#Card">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <!-- 用 BoxShadow 而非 Effect：Effect 会离屏渲染成与元素等大的图层，投影外扩部分被裁成硬边 -->
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
        </Style>
        <Style Selector="ctl|DeviceCardButton.DevCard.on /template/ Border#Card">
            <Setter Property="Background" Value="{DynamicResource DevOnBrush}"/>
        </Style>
        <Style Selector="ctl|DeviceCardButton.DevCard:pointerover">
            <Setter Property="RenderTransform" Value="translate(0px,-3px)"/>
        </Style>
        <Style Selector="ctl|DeviceCardButton.DevCard:pressed">
            <Setter Property="RenderTransform" Value="translate(0px,-1px) scale(0.99)"/>
        </Style>
        <!-- 设备图标：只画矢量图标本身，不垫底板 -->
        <Style Selector="Border.DevIc">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
        </Style>
        <Style Selector="Path.DevIcon">
            <Setter Property="Stroke" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Stroke" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Path.DevIcon.on">
            <Setter Property="Stroke" Value="{DynamicResource Accent2Brush}"/>
        </Style>
        <!-- 设备真机图：已裁到实物外框，只展示图本身，不垫底色、不切圆角 -->
        <Style Selector="Border.DevPhoto">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
        </Style>
        <!-- ======== 加载：骨架卡 + 掠过的高光带 + 旋转指示器 ======== -->
        <Style Selector="Border.SkelCard">
            <!-- 与真实设备卡同高：骨架换成真卡时卡片不再跳一下 -->
            <Setter Property="Height" Value="80"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="15,13"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource SkelCardBrush}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
        </Style>
        <Style Selector="Border.SkelIc">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource SkelBarBrush}"/>
        </Style>
        <Style Selector="Border.SkelBar">
            <Setter Property="Height" Value="11"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource SkelBarBrush}"/>
        </Style>
        <Style Selector="Border.SkelSw">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Background" Value="{DynamicResource SkelBarBrush}"/>
        </Style>
        <!-- 高光带：卡片内容框已裁切，带子比卡高一点也不会漏出圆角 -->
        <Style Selector="Border.SkelShine">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="110"/>
            <Setter Property="Canvas.Top" Value="-18"/>
            <Setter Property="Canvas.Left" Value="-86"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource SkelShineBrush}"/>
            <Setter Property="RenderTransform">
                <TranslateTransform X="0"/>
            </Setter>
        </Style>
        <!-- 动画只在骨架真的显示时挂上：Avalonia 的 Style.Animations 不看 IsVisible，
             无限动画一旦常驻，合成器就按刷新率满帧重绘整棵树（空转掉一个核 + 常驻 GPU 占用）。 -->
        <Style Selector="Border.SkelShine.run">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="416"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- 窄版高光带：统计卡这类小卡用。类名单独开一个，不复用 SkelShine，
             否则 .SkelShine.run 的 416 扫程动画会和窄版动画同时命中、互相抢写 X。 -->
        <Style Selector="Border.SkelShineSm">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Canvas.Top" Value="-8"/>
            <Setter Property="Canvas.Left" Value="-64"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource SkelShineBrush}"/>
            <Setter Property="RenderTransform">
                <TranslateTransform X="0"/>
            </Setter>
        </Style>
        <Style Selector="Border.SkelShineSm.run">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="190"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- 旋转指示器：绕自身中心匀速转，尺寸/描边色由使用方给。
             原点必须写百分号：Avalonia 把 "0.5,0.5" 解析成绝对 0.5px，等于绕左上角转，整条弧会被带着甩。 -->
        <Style Selector="Path.Spinner">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform">
                <RotateTransform Angle="0"/>
            </Setter>
        </Style>
        <Style Selector="Path.Spinner.run">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite" Easing="LinearEasing">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- 设备状态文本：默认灰，开启绿，离线琥珀（warn 在后，优先生效） -->
        <Style Selector="TextBlock.DevStatus">
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="TextBlock.DevStatus.is-on">
            <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
        </Style>
        <Style Selector="TextBlock.DevStatus.is-warn">
            <Setter Property="Foreground" Value="{DynamicResource AmberBrush}"/>
        </Style>
        <!-- 状态圆点：文字保持常规色，只用小点表达在线/离线 -->
        <Style Selector="Ellipse.StatusDot">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource Text3Brush}"/>
        </Style>
        <Style Selector="Ellipse.StatusDot.is-on">
            <Setter Property="Fill" Value="{DynamicResource GreenBrush}"/>
        </Style>
        <Style Selector="Ellipse.StatusDot.is-warn">
            <Setter Property="Fill" Value="{DynamicResource AmberBrush}"/>
        </Style>
        <!-- ======== 场景卡（§8.8：彩色渐变 + 光晕，无边框） ======== -->
        <Style Selector="Button.SceneMini">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="RenderTransform" Value="translate(0px,0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2">
                        <TransformOperationsTransition.Easing>
                            <ani:CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Margin 用于给投影留出绘制空间 -->
                    <Border Name="Card" MinHeight="80" CornerRadius="16" Margin="8">
                        <Panel>
                            <!-- 光晕铺满整卡，靠自身圆角贴合卡片，避免硬边色块 -->
                            <!-- Style 模板无 x:DataType：DataContext 类型由运行时内容决定，这里退回反射绑定 -->
                            <Border Name="Glow" CornerRadius="16" Background="{ReflectionBinding GlowBrush}"
                                    IsHitTestVisible="False"/>
                            <Border Padding="12">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.SceneMini /template/ Border#Card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
        </Style>
        <Style Selector="Button.SceneMini:pointerover">
            <Setter Property="RenderTransform" Value="translate(0px,-3px)"/>
        </Style>
        <Style Selector="Button.SceneMini:pressed">
            <Setter Property="RenderTransform" Value="translate(0px,-1px) scale(0.98)"/>
        </Style>
        <Style Selector="Button.SceneBig">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="RenderTransform" Value="translate(0px,0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2">
                        <TransformOperationsTransition.Easing>
                            <ani:CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Margin 用于给投影留出绘制空间 -->
                    <Border Name="Card" MinHeight="152" CornerRadius="16" Margin="8">
                        <Panel>
                            <!-- 光晕铺满整卡，靠自身圆角贴合卡片，避免硬边色块 -->
                            <!-- Style 模板无 x:DataType：DataContext 类型由运行时内容决定，这里退回反射绑定 -->
                            <Border Name="Glow" CornerRadius="16" Background="{ReflectionBinding GlowBrush}"
                                    IsHitTestVisible="False"/>
                            <Border Padding="18">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.SceneBig /template/ Border#Card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
        </Style>
        <Style Selector="Button.SceneBig:pointerover">
            <Setter Property="RenderTransform" Value="translate(0px,-4px)"/>
        </Style>
        <Style Selector="Button.SceneBig:pressed">
            <Setter Property="RenderTransform" Value="translate(0px,-1px) scale(0.98)"/>
        </Style>
        <!-- ======== 场景执行：纯播放图标按钮（默认透明，hover 才出圆角底） ======== -->
        <Style Selector="Button.PlayCircle">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- 静止态不能用 Transparent：BrushTransition 逐通道插值，从 (0,0,0,0) 起步会先冲成一团
                         浅灰再落回目标色，就是 hover 那一下闪白。起点要写 hover 同色、只把透明位拉满 -->
                    <Border Name="Card" CornerRadius="12" Background="{DynamicResource PlayHoverFromBrush}">
                        <!-- 宽高按 GeoPlay 包围盒比例（7.3:10）给：Uniform 不留未居中的横向余量 -->
                        <Path Width="10" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource Text3Brush}" Opacity="0.55"
                              Data="{StaticResource GeoPlay}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.PlayCircle /template/ Border#Card">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.PlayCircle:pointerover /template/ Border#Card">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <!-- ======== 输入框统一外观 ========
             Fluent 深色默认给 TextBox 一块纯黑底 + 亮白边，压在卡片上像个窟窿。
             这里换成「极淡半透明底 + 10 圆角 + 淡描边」：静止一档、悬停亮一档、
             聚焦只把描边换成主色（更深色下用高不透明度那一支），底色只微提一档，
             避免输入时整块跳色。
             带类的输入框（.Search / .Log / .VoiceInput）选择器更具体，各自的外观不受影响。 -->
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FieldLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- 模板里的 Border 才是真正画底和边的元素：Fluent 的 pointerover / focus 会改它，必须逐档压回来。
             **聚焦那档必须补 BorderThickness**：Fluent 主题在 :focus 里把边框换成
             TextControlBorderThemeThicknessFocused（2px），只改颜色会让输入框一点进去就粗一圈；
             模板自带的 :focus 规则只在 ControlTheme 内层，全局样式补上厚度才盖得住。 -->
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource FieldBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FieldLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource FieldBgHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource FieldBgHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FieldLineFocusBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- 占位文字：本项目锁定 Avalonia 11.3.9，Fluent 模板里的占位 TextBlock 叫 PART_Watermark
             （不带浮动水印时只有这一个），直接给它上色即可。
             注意 11 没有 TextBox.PlaceholderForeground 这个属性，也不能写 PART_Placeholder / PART_FloatingPlaceholder
             （那是 Avalonia 12 的模板名与属性），写了会直接编译失败。 -->
        <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{DynamicResource WatermarkBrush}"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style Selector="TextBox /template/ TextBlock#PART_FloatingWatermark">
            <Setter Property="Foreground" Value="{DynamicResource WatermarkBrush}"/>
        </Style>
        <!-- 数字框 / 时间框内部的 TextBox 自带边框，会和外框叠成双层，统一压平 -->
        <Style Selector="NumericUpDown /template/ TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- ======== 下拉框：与输入框同一套底色 / 描边语言 ======== -->
        <Style Selector="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,0,10,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ComboBox /template/ Border#BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}"/>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- ======== 搜索框：胶囊造型，聚焦/悬停均不改色 ======== -->
        <Style Selector="TextBox.Search">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SearchBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SearchLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- 悬停/聚焦都保持同一底色与淡边框，不做颜色变化 -->
        <Style Selector="TextBox.Search /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource SearchBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SearchLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox.Search:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource SearchBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SearchLineBrush}"/>
        </Style>
        <Style Selector="TextBox.Search:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource SearchBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SearchLineBrush}"/>
        </Style>
        <Style Selector="TextBox.Log">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
            <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, Courier New"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <!-- 只读日志区不摆出「可输入」的样子：没有闪烁光标，鼠标也不变 I 形 -->
            <Setter Property="CaretBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <!-- 日志正文是暗淡的 Text3，默认那支半透明青色选区压在上面几乎看不清字：
                 选区换成实心紫底 + 白字，和菜单选中态同一套色 -->
            <Setter Property="SelectionBrush" Value="{DynamicResource SelBgBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource SelTextBrush}"/>
        </Style>
        <!-- 模板内那层 Border 才是画底和边的元素：外面已经有一层容器，
             这里必须连悬停 / 聚焦一起按平，否则鼠标经过或多点一下就又浮出一条内边框 -->
        <Style Selector="TextBox.Log /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="TextBox.Log:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.Log:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- ======== 滚动条：默认隐藏，鼠标进入哪个滚动容器就只浮出它自己的胶囊 ======== -->
        <Style Selector="ScrollBar">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <!-- 不能按整个 Window 判断：下拉浮层是 Popup 独立窗口，鼠标进了浮层后主窗口
             :pointerover 会掉，浮层自己的滚动条反而一直藏着；而鼠标回到主窗口时又会把
             编辑弹窗 / 背后列表 / 浮层的滚动条一次性全点亮（同时冒出 3 条）。
             改成以各自的 ScrollViewer 为准，Popup 里的 ScrollViewer 也能命中。 -->
        <Style Selector="ScrollViewer:pointerover ScrollBar">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- 指针直接落在滑块 / 轨道上（拖动过程中）也要保持可见 -->
        <Style Selector="ScrollBar:pointerover">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- 箭头按钮：PathIcon 自己的主题把 Foreground 写死成 TextControlForeground，
             置空 ScrollBarButtonArrowForeground 管不到它，只能整个隐藏 -->
        <Style Selector="ScrollBar /template/ PathIcon">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton,
                        ScrollBar /template/ RepeatButton#PART_LineDownButton">
            <!-- 箭头已整体隐藏：按钮直接不显示，两端不再各占一行轨道高度，滑块行程占满整条轨道 -->
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <!-- 滑块换成 8px 居中胶囊。模板里只能有这一个 Border：主题的
             `^:pointerover/:pressed /template/ Border` 会命中模板内所有 Border，
             多包一层透明 Border 就会被它刷出一整条 16px 的「把手底色」 -->
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Pill"
                            HorizontalAlignment="Center" VerticalAlignment="Stretch"
                            Width="8" Margin="0,2"
                            CornerRadius="4"
                            Background="{DynamicResource ScrollBarThumbFill}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- 静止色用模板本地值（ScrollBarThumbFill），悬停/拖动色走主题的
             ScrollBarThumbFillPointerOver/Pressed，已在主题字典里按明暗配好 -->
        <!-- ======== 设备卡「更多」按钮 ======== -->
        <!-- 平时完全隐形且不参与命中，整卡悬停才浮现（透明度过渡）；
             点击行为由 Controls/MenuOpener 附加属性接管：打开与右键同一份菜单。
             菜单本体（外壳 + 菜单项主题）直接内联在 Templates.axaml 的设备卡模板里，
             不依赖样式匹配 —— 弹出层的样式应用时机不可控，本地值最稳。 -->
        <!-- 「更多」：48×48 点击热区，与设备图标同尺寸；可见内容是一枚铺满热区的圆角方底 + 三个点。
             默认隐藏 + 上浮 3px，卡片悬停时渐显下滑浮现、移开时渐隐回升。
             Avalonia 的 Transitions 是双向共用一条设置（没有分方向时长），0.22s 是按
             「渐变看得出来、又不拖手」定的档：太短（0.12s 左右）在深色卡上几乎读成瞬现。 -->
        <Style Selector="ctl|DeviceMoreButton.MoreBtn">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <!-- 保留原 Fluent ContentPresenter 的结构及命名，只不加载无关的按钮主题状态。 -->
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True" />
                </ControlTemplate>
            </Setter>
            <Setter Property="RenderTransform" Value="translate(0px,-3px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22">
                        <DoubleTransition.Easing>
                            <ani:CubicEaseOut/>
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24">
                        <TransformOperationsTransition.Easing>
                            <ani:CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ctl|DeviceCardButton.DevCard:pointerover ctl|DeviceMoreButton.MoreBtn">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="RenderTransform" Value="translate(0px,0px)"/>
        </Style>
        <Style Selector="ctl|DeviceMoreButton.MoreBtn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <!-- 容器：48×48 与点击热区同大，只负责把三个点居中；不铺底色、不描边，
             悬停 / 按下都保持透明，画面上只留菜单图标本身；底下的设备图标照常保留显示。 -->
        <Style Selector="ctl|DeviceMoreButton.MoreBtn Border.MoreBtnPill">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ctl|DeviceMoreButton.MoreBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ctl|DeviceMoreButton.MoreBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ======== 弹窗基类 DialogPopup：遮罩 + 居中卡片 + 标题栏 + 可滚动正文 ======== -->
        <!-- 卡片四周 1px DialogLineBrush 浅描边：暗色下是极淡的白、浅色下是极淡的蓝黑，只负责把卡片从背景里分出来 -->
        <Style Selector="Border.DialogCard">
            <Setter Property="Background" Value="{DynamicResource DrawerBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="24"/>
            <!-- 投影这里不能开 ClipToBounds：Avalonia 的 BoxShadow 画在控件自己的绘制上下文里，
                 开了就被自己的边界裁光。裁切下移到卡片内层的 Grid（它铺满卡片内容区，效果等价）。
                 模糊 40 + 下偏 16 → 左右需 40、上 24、下 56 留白，独立弹窗窗体按四周 58 留边 -->
            <Setter Property="BoxShadow" Value="0 16 40 0 #3311182B"/>
        </Style>
        <Style Selector="ctl|DialogPopup">
            <Setter Property="IsVisible" Value="{Binding IsOpen, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <!-- 遮罩：跨满宿主容器，点击即关闭（模板里挂 Mask 类，由控件识别） -->
                        <Border Classes="Mask" Background="{DynamicResource MaskBrush}"/>
                        <Border Name="DialogCard" Classes="DialogCard" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="{TemplateBinding CardWidth}"
                                Height="{TemplateBinding CardHeight}"
                                MaxHeight="{TemplateBinding CardMaxHeight}">
                            <!-- 正文再长也只在卡片内滚：这层裁切接管原 DialogCard 上的 ClipToBounds，
                                 超出一行的内容不会再画到卡片圆角外面，同时不挡卡片的投影 -->
                            <Grid RowDefinitions="Auto,*,Auto" ClipToBounds="True">
                                <Panel Name="DialogHeader" Background="Transparent" Margin="28,20,22,0">
                                    <StackPanel>
                                        <TextBlock Text="{TemplateBinding Title}" FontSize="19" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Classes="Hint" Margin="0,5,0,0" Text="{TemplateBinding Subtitle}"
                                                   IsVisible="{Binding Subtitle, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </StackPanel>
                                    <!-- 动作区 + 关闭钮同一行靠右：整块靠右对齐，所以有没有动作钮，关闭钮都钉在原位 -->
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <ContentControl Content="{TemplateBinding HeaderActions}"
                                                        IsTabStop="False" VerticalAlignment="Top"/>
                                        <Button Classes="ThemeBtn" Cursor="Hand"
                                                Command="{TemplateBinding CloseCommand}" ToolTip.Tip="关闭">
                                            <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="0.8"
                                                  StrokeLineCap="Round"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="{StaticResource GeoClose}"/>
                                        </Button>
                                    </StackPanel>
                                </Panel>
                                <!-- 右外距缩到 6：把滚动条推到卡片内侧边缘，不再压在卡片上；
                                     正文右侧补 16 内距，正文可用宽度与卡片位置都和原来完全一致 -->
                                <ScrollViewer Grid.Row="1" Margin="{TemplateBinding ContentMargin}"
                                              ClipToBounds="True"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ContentPresenter Content="{TemplateBinding Content}" Margin="0,0,16,0"/>
                                </ScrollViewer>
                                <!-- 底部常驻操作区：正文滚到哪都在，Footer 为空时整行高度为 0、不占位 -->
                                <ContentPresenter Grid.Row="2" Content="{TemplateBinding Footer}"
                                                  IsVisible="{Binding Footer, RelativeSource={RelativeSource TemplatedParent},
                                                              Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- 弹窗标题栏动作钮：与右上角关闭钮同宽同悬停底，宽度随文字走 -->
        <Style Selector="Button.HeaderAct">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="8" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.HeaderAct:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        </Style>
        <Style Selector="Button.HeaderAct:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <!-- ======== 触发条件编辑器（弹窗）：取值片 + 可折叠的筛选行 ======== -->
        <!-- 取值片：胶囊按钮，选中态走品牌实心底 + 白字（与下拉选中同族） -->
        <Style Selector="Button.Chip">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.Chip:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        </Style>
        <Style Selector="Button.Chip.on /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SelBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SelBgBrush}" />
        </Style>
        <Style Selector="Button.Chip.on">
            <Setter Property="Foreground" Value="{DynamicResource SelTextBrush}" />
        </Style>

        <!-- 筛选参数的一行：整行可点展开取值片，右侧显示当前值。
             悬停不给整行铺底色（一行横跨整个卡片，铺开太抢眼），只把文字与箭头提亮 -->
        <Style Selector="Button.ArgHead">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="-7,0,-7,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TextBlock.ArgName">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        </Style>
        <Style Selector="Button.ArgHead:pointerover TextBlock.ArgName">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="Path.ArgChev">
            <Setter Property="Stroke" Value="{DynamicResource Text3Brush}" />
        </Style>
        <Style Selector="Button.ArgHead:pointerover Path.ArgChev">
            <Setter Property="Stroke" Value="{DynamicResource Text2Brush}" />
        </Style>
        <!-- 收起行右侧的当前取值：未筛显示「任意」用弱色，筛过用正文色加粗 -->
        <Style Selector="TextBlock.ArgVal">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
        </Style>
        <Style Selector="TextBlock.ArgVal.picked">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- 设备选择行：点一下弹「选择设备」窗，样式与下拉触发器同族（底色 + 描边 + 右箭头） -->
        <Style Selector="Button.DevPick">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="Button.DevPick /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style Selector="Button.DevPick:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!-- ======== 弹窗里的分组卡：把「名称 / 启用 / 触发条件」这类零散字段收成一张淡底卡 ======== -->
        <Style Selector="Border.SecCard">
            <Setter Property="Background" Value="{DynamicResource CardSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,13"/>
        </Style>
        <Style Selector="TextBlock.SecLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
        </Style>
        <!-- 小状态胶囊：「只读」「N 项」这类轻标 -->
        <Style Selector="Border.MiniTag">
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
            <Setter Property="CornerRadius" Value="7"/>
            <!-- 左右只留 5：设备卡中间只有九十来像素，7 的边距会让两枚读数差一两个像素换行 -->
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ======== 智能页：场景 / 自动化卡 ======== -->
        <!-- 智能页的场景卡直接套设备卡的壳（ctl|DeviceCardButton.DevCard），
             外观 / 悬停 / 按下全部共用（页头提示已改为纯文字，原来的 HintChip 胶囊样式删除）。 -->

        <!-- ======== 顶部 Tab 导航：设置页纯文字，智能页可放图标与计数 ======== -->
        <Style Selector="Border.TabBar">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.Tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="9" Background="Transparent">
                        <Panel>
                            <Border Name="Hov" CornerRadius="9" Opacity="0"
                                    Background="{DynamicResource HoverBrush}">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.Tab:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Button.Tab:pointerover /template/ Border#Hov">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.Tab.on">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.Tab.on:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.Tab.on:pointerover /template/ Border#Hov">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border.TabSlider">
            <Setter Property="Background" Value="{DynamicResource PrimaryBtnBrush}"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
        <Style Selector="Border.TabSlider.ready">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Canvas.Left" Duration="0:0:0.28" Easing="CubicEaseInOut"/>
                    <DoubleTransition Property="Canvas.Top" Duration="0:0:0.28" Easing="CubicEaseInOut"/>
                    <DoubleTransition Property="Width" Duration="0:0:0.28" Easing="CubicEaseInOut"/>
                    <DoubleTransition Property="Height" Duration="0:0:0.28" Easing="CubicEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.TabBadge">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Tab.on Border.TabBadge">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>

        <!-- 预设色块：按钮本体透明，色点与选中环都是内层 Border（避开 Fluent 模板的边框冲突） -->
        <Style Selector="Button.Swatch">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Swatch /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.Swatch:pointerover">
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <!-- 自定义取色入口：照抄图标选择窗里那颗「自定义颜色」按钮——
             26px 实心圆、1px 淡描边，悬停描边转淡紫，选中转主紫并加粗。
             背景交给绑定（没取过自定义色时是多色渐变，取过就是那枚颜色）。 -->
        <Style Selector="Button.ColorOrb">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="13"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.ColorOrb:pointerover /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent2Brush}"/>
        </Style>
        <Style Selector="Button.ColorOrb.on /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="2.5"/>
        </Style>

        <!-- ======== 滑杆（抽屉 / 桌面分区浮层共用） ======== -->
        <!-- 抽屉滑杆：底轨 + 左圆角已填段 + 白圆钮。已填段只圆左端，避免与滑块之间出现缺口。
             放在全局而不是主窗口样式里：桌面分区的音量浮层、外观窗都是独立 Window，
             拿不到主窗口的局部样式，之前各写一份会漂出两种滑杆。 -->
        <Style Selector="Slider.DrSlider">
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBtnBrush}" />
            <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent" VerticalAlignment="Center" Height="30">
                        <!-- 未填轨道：两端都圆 -->
                        <Border Height="10" CornerRadius="5" VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                Background="{TemplateBinding Background}" />
                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               IsDirectionReversed="False"
                               Orientation="Horizontal"
                               VerticalAlignment="Center" Height="10">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_DecreaseButton"
                                              Background="Transparent" BorderThickness="0" Focusable="False"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              Padding="0" Margin="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <!-- 只圆左端；右端直角顶到滑块下，消除缺口 -->
                                            <Border Height="10" CornerRadius="5,0,0,5"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                    Background="{Binding $parent[Slider].Foreground}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>
                            <Track.Thumb>
                                <Thumb Name="PART_Thumb" Width="18" Height="18" Focusable="True">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Border Width="18" Height="18" CornerRadius="9"
                                                    Background="{DynamicResource SliderThumbBackground}"
                                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                                    BoxShadow="0 1 4 #28000000" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_IncreaseButton"
                                              Background="Transparent" BorderThickness="0" Focusable="False"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              Padding="0" Margin="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- 再压一遍 Fluent 默认 pressed/hover，防止右侧槽位出现灰底 -->
        <Style Selector="Slider.DrSlider /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Slider.DrSlider /template/ RepeatButton#PART_IncreaseButton:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Slider.DrSlider /template/ RepeatButton#PART_IncreaseButton:pressed">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- ======== 胶囊滑杆（灯光亮度 / 色温） ======== -->
        <!-- 一条 12 高的整根胶囊轨道 + 白圆钮，没有「底轨 + 已填段」两段拼接：
             色温直接把渐变刷在轨道上（Foreground 置 Transparent，已填段不参与绘制），
             亮度则用纯色已填段（Foreground = PillFillBrush），靠长度表达档位。 -->
        <Style Selector="Slider.PillSlider">
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PillFillBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent" VerticalAlignment="Center" Height="34">
                        <!-- 整根胶囊轨道：色温暖轨、亮度底轨都画在这一层 -->
                        <Border Height="12" CornerRadius="6" VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                Background="{TemplateBinding Background}"
                                BoxShadow="0 1 2 #20000000" />
                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               IsDirectionReversed="False"
                               Orientation="Horizontal"
                               VerticalAlignment="Center" Height="12">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_DecreaseButton"
                                              Background="Transparent" BorderThickness="0" Focusable="False"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              ClipToBounds="False"
                                              Padding="0" Margin="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <!-- 已填段：盖在轨道上表达档位；色温把 Foreground 设成透明就露不出这一段。
                                                 右端负边距 = 圆点半径，让进度条穿过圆点圆心而不是停在它左边 -->
                                            <Grid Background="Transparent">
                                                <Border Height="12" CornerRadius="6,0,0,6" Margin="0,0,-10,0"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                        Background="{Binding $parent[Slider].Foreground}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>
                            <Track.Thumb>
                                <Thumb Name="PART_Thumb" Width="20" Height="20" Focusable="True">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Border Width="20" Height="20" CornerRadius="10"
                                                    Background="{DynamicResource SliderThumbBackground}"
                                                    BoxShadow="0 1 5 #33000000" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_IncreaseButton"
                                              Background="Transparent" BorderThickness="0" Focusable="False"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              Padding="0" Margin="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- 同样压掉 Fluent 的 hover/pressed 灰底，轨道上只留我们画的胶囊 -->
        <Style Selector="Slider.PillSlider /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Slider.PillSlider /template/ RepeatButton#PART_IncreaseButton:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Slider.PillSlider /template/ RepeatButton#PART_IncreaseButton:pressed">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- ======== 桌面分区图标按钮 ======== -->
        <!-- 贴桌面的分区窗与它的浮层都是独立 Window，取不到视图内的局部样式，
             所以标题栏/播放键那套 24×24 圆角图标按钮定义在这里 -->
        <Style Selector="Button.DskIcon">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <!-- 悬停底是 #26 白：静息也用同一支白的零透明，淡入时才不会先压一层灰 -->
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="Foreground" Value="{DynamicResource DskTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.DskIcon:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.DskIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#26FFFFFF" />
        </Style>
        <Style Selector="Button.DskIcon:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <!-- 图钉的开启态：图标换成品牌紫（PinBrush），不加底色、不加勾 —— 和分区里其它状态控件同一档表现 -->
        <Style Selector="Button.DskIcon.pin">
            <Setter Property="Foreground" Value="{DynamicResource PinBrush}" />
        </Style>
        <!-- 播放控制那一排：比普通图标大一号，仍然是同一套悬停/按下底色 -->
        <Style Selector="Button.DskMedia">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <!-- ======== 房间标注底板 ========
             下拉触发器、浮层列表、桌面分区共用这一个类：底色走主题感知的 Surface5，
             文字色仍由各处自定（桌面玻璃上要更亮一档的 DskText3） -->
        <Style Selector="Border.RoomTag">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="5,1.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- ======== 右键菜单入场 ========
             与托盘菜单、下拉浮层同一套动效语言（0.94 起、8px 落位、0.22s）。只动缩放与透明度，
             不做位移：ContextMenu 的弹出窗按内容尺寸开，位移会把边缘切掉。
             一次性动画，播完回到基础值（= 末帧），不会常驻渲染循环。
             ⚠ 不能对 RenderTransform 直接写关键帧：Avalonia 11 的动画器注册表没有 ITransform 条目，
             菜单一打开就抛 "No animator registered for the property RenderTransform"（官方 issue #8640），
             且 Animation.Animators 在 11.x 已内化、无法手动补注册。
             正确姿势与 Path.Spinner 同款：RenderTransform 固定挂一个 ScaleTransform，
             关键帧只写 ScaleTransform.ScaleX / ScaleY（double + Transform 归属，走 TransformAnimator 路由）。 -->
        <Style Selector="ContextMenu">
            <Setter Property="RenderTransformOrigin" Value="50%, 0%" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.22" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.94" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.94" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ======== 自绘模板补过渡 ========
             这些按钮的底 / 描边画在自己模板里的具名 Border 上，全局那条只兜到 Fluent 的
             ContentPresenter，所以要在这里逐类补。只补颜色，时长统一 0.16s，
             和全局兜底同一档，悬停与移开两个方向同速。 -->
        <Style Selector="Button.BtnPrimary /template/ Border#Bd,
                        Button.BtnGhost /template/ Border#Bd,
                        Button.BtnDanger /template/ Border#Bd,
                        Button.AddChip /template/ Border#Bd,
                        Button.IconBtn /template/ Border#Bd,
                        Button.WinBtn /template/ Border#Bd,
                        Button.ThemeBtn /template/ Border#Bd,
                        Button.IconDisc /template/ Border#Bd,
                        Button.IconPill /template/ Border#Bd,
                        Button.HeaderAct /template/ Border#Bd,
                        Button.Chip /template/ Border#Bd,
                        Button.NavRow /template/ Border#Bg,
                        ToggleButton.Chip /template/ Border#Bd">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- 靠透明度表达悬停的几处：开关轨、预设色点、滚动条 -->
        <Style Selector="Button.Switch /template/ Border#Track, Button.Swatch, ScrollBar">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>
</Styles>
