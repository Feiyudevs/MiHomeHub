<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ani="clr-namespace:Avalonia.Animation.Easings;assembly=Avalonia.Base"
    xmlns:conv="clr-namespace:MiHome.Converters"
    xmlns:ctl="clr-namespace:MiHome.Controls"
    xmlns:vm="clr-namespace:MiHome.ViewModels"
    xmlns:m="clr-namespace:MiHome.Models">
        <!-- ======== 全局基础 ======== -->
        <!-- 字体族是内存敏感项，不要改成多段链（如 "A, B, C"），也不要换成 Segoe UI：
             多段链会让 Avalonia 每排版一次都去逐个探测候选字族，探测过程会新建 GlyphTypeface；
             而 Segoe 系（含 Segoe UI Variable）的请求名与系统实际返回名不一致，字型缓存永远不命中，
             于是每排版一次就新建一份字型对象 + 整张 Name 表且释放不掉（实测可涨到 1GB 量级）。
             这里只写单一字体，字形自足（中英文都覆盖），命中缓存后不再产生新对象。 -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
        </Style>
        <Style Selector="TextBlock.Hint">
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- 设置行副标题：右侧控件占了列宽，单行会被裁掉，允许折成两行 -->
        <Style Selector="TextBlock.Hint.Sub">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>
        <!-- 设备卡文字：默认按主窗口配色（名称次级亮、房间/路数次级灰）。
             桌面分区卡在 DesktopGroupView 里用更具体的选择器覆盖成 DskText* 提亮一档，
             因此这三处都必须只由样式上色，元素上不能写本地 Foreground -->
        <Style Selector="TextBlock.DevName">
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
        </Style>
        <Style Selector="TextBlock.DevMeta">
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
        </Style>
        <Style Selector="TextBlock.DevBadgeText">
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
        </Style>
        <Style Selector="TextBlock.SecTitle">
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,26,0,12"/>
        </Style>
        <Style Selector="TextBlock.SecTitle:first-child">
            <Setter Property="Margin" Value="2,0,0,12"/>
        </Style>
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource R}"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BoxShadow" Value="0 1 2 0 #050F172A, 0 5 16 0 #080F172A"/>
        </Style>
        <!-- 滑动条滑块：白圆点加轻投影，浮在加高的轨道上 -->
        <Style Selector="Slider /template/ Thumb /template/ Border">
            <Setter Property="BoxShadow" Value="0 1 4 #59000000"/>
        </Style>
        <!-- ======== 按钮 ======== -->
        <Style Selector="Button.BtnPrimary">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="10" Background="{DynamicResource PrimaryBtnBrush}"
                            BoxShadow="0 2 8 #00000040"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.BtnPrimary:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Accent2Brush}"/>
        </Style>
        <Style Selector="Button.BtnPrimary:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.BtnPrimary:disabled /template/ Border#Bd">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Button.BtnGhost">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="10" Background="{DynamicResource Card2Brush}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="Cp" Content="{TemplateBinding Content}"
                                          TextBlock.Foreground="{DynamicResource Text2Brush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.BtnGhost:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <Style Selector="Button.BtnGhost:pointerover /template/ ContentPresenter#Cp">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Button.IconBtn">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="10" Background="{DynamicResource CardBrush}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.IconBtn:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <!-- 窗口控制钮 36×36（与 ThemeBtn 同高，图标垂直对齐、圆角悬浮） -->
        <Style Selector="Button.WinBtn">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="8" Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.WinBtn:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        </Style>
        <Style Selector="Button.WinBtn.close:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="#E81123"/>
        </Style>
        <Style Selector="Button.WinBtn.close:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- 标题栏主题钮 36×36（抽屉关闭钮可覆写 Width/Height/Padding） -->
        <Style Selector="Button.ThemeBtn">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="8" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.ThemeBtn:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        </Style>
        <Style Selector="Button.ThemeBtn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <!-- 圆形图标钮：底色 SurfaceBrush 是分主题的一层轻微抬升（暗底加白、亮底加深），悬停换 HoverBrush -->
        <Style Selector="Button.IconDisc">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="17" Background="{DynamicResource SurfaceBrush}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.IconDisc:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <Style Selector="Button.IconDisc:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <!-- ======== 开关 40×22（§8.4） ======== -->
        <Style Selector="ToggleButton.Switch">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Track" CornerRadius="11" Background="{TemplateBinding Background}">
                        <Canvas>
                            <Ellipse Name="Thumb" Width="16" Height="16" Canvas.Left="3" Canvas.Top="3"
                                     Fill="{TemplateBinding Foreground}">
                                <Ellipse.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Canvas.Left" Duration="0:0:0.24">
                                            <DoubleTransition.Easing>
                                                <ani:BackEaseOut/>
                                            </DoubleTransition.Easing>
                                        </DoubleTransition>
                                    </Transitions>
                                </Ellipse.Transitions>
                            </Ellipse>
                        </Canvas>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Background" Value="{DynamicResource TrackBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThumbBrush}"/>
        </Style>
        <Style Selector="ToggleButton.Switch /template/ Border#Track">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.22"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.Switch:checked">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ToggleButton.Switch:checked /template/ Ellipse#Thumb">
            <Setter Property="Canvas.Left" Value="21"/>
        </Style>
        <Style Selector="ToggleButton.Switch:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <!-- ======== 卡片电源按钮：圆形底 + 电源图标（关=淡底，开=主色底） ======== -->
        <!-- 关闭态用 TrackBrush：SurfaceBrush 只有 5% 白，深色卡上圆底几乎不可见，会被看成一个小图标 -->
        <Style Selector="ToggleButton.Power">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource TrackBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Disc 不设对齐（默认 Stretch 铺满按钮）；设 Center 会收缩到图标大小 -->
                    <Border Name="Disc" CornerRadius="16" Background="{TemplateBinding Background}">
                        <!-- 电源符号：上竖线 + 开口圆弧，描边绘制保证小尺寸不糊 -->
                        <Path Width="13" Height="13" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M18.36,6.64 A9,9 0 1 1 6.64,6.64 M12,2 V12"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.Power /template/ Border#Disc">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.22"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.Power">
            <Setter Property="RenderTransform" Value="translate(0px,0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- 卡片悬停时右列「一分为二」：电源键从垂直居中滑到右下角（16px：32+32 两枚按钮
             在 48px 内容高里排下，上「更多」-9 起、下电源键 24 起，留 1px 不重叠），
             给上方浮现的「更多」让位 -->
        <Style Selector="Button.DevCard:pointerover ToggleButton.Power">
            <Setter Property="RenderTransform" Value="translate(0px,16px)"/>
        </Style>
        <Style Selector="ToggleButton.Power:pointerover /template/ Border#Disc">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="ToggleButton.Power:checked">
            <Setter Property="Background" Value="{DynamicResource PowerOnBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ToggleButton.Power:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <!-- ======== 侧栏导航 ======== -->
        <Style Selector="Button.NavRow">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- 外层 Hit 用 Transparent 背景铺满整行，保证空白区域也能命中 hover/点击 -->
                    <Border Name="Hit" Background="Transparent">
                        <Panel>
                            <Border Name="Bar" Width="3" Height="18" CornerRadius="0 2 2 0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="Transparent"/>
                            <Border Name="Bg" CornerRadius="12" Padding="12,9" Margin="10,3,10,3"
                                    Background="Transparent">
                                <Grid ColumnDefinitions="21,*">
                                    <!-- 两套画法都备好，靠设置里的图标模式二选一显示 -->
                                    <Image Name="Gx" Grid.Column="0" Width="17" Height="17" Stretch="Uniform"
                                           IsVisible="{Binding ((vm:MainViewModel)DataContext).IconGlass, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NavSvg}}"/>
                                    <Path Name="Ic" Grid.Column="0" Width="15" Height="15" Stretch="Uniform"
                                          IsVisible="{Binding !((vm:MainViewModel)DataContext).IconGlass, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NavLine}}"/>
                                    <TextBlock Name="Lb" Grid.Column="1" Text="{TemplateBinding Content}"
                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </Grid>
                            </Border>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.NavRow:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        </Style>
        <Style Selector="Button.NavRow:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Button.NavRow.on">
            <Setter Property="Foreground" Value="{DynamicResource NavActiveTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.NavRow.on /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        </Style>
        <Style Selector="Button.NavRow.on /template/ Border#Bar">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <!-- 房间行图标：比导航图标再细一档，配合圆头圆角更轻盈 -->
        <Style Selector="Button.NavRow.room /template/ Path#Ic">
            <Setter Property="StrokeThickness" Value="1.2"/>
        </Style>
        <!-- 侧栏分组小标题 -->
        <Style Selector="TextBlock.NavCaption">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
            <Setter Property="Margin" Value="22,14,10,6"/>
        </Style>
        <!-- ======== 芯片筛选条（§8.12） ======== -->
        <Style Selector="ToggleButton.Chip">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="20" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock Name="Lb" Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
        </Style>
        <Style Selector="ToggleButton.Chip:pointerover">
            <Setter Property="Background" Value="{DynamicResource Card2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="ToggleButton.Chip:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WarmTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- ======== 设备卡（§8.6：无边框，开启淡紫渐变） ======== -->
        <Style Selector="Button.DevCard">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="RenderTransform" Value="translate(0px,0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2">
                        <TransformOperationsTransition.Easing>
                            <ani:CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Margin 由样式提供（默认 8，给投影留绘制空间：投影被控件边界裁切时才会出现硬边缺口）；
                         桌面分区内卡片不投影，局部样式把它收到 4，故此处不能再写本地值（本地值会压过样式 setter） -->
                    <Panel>
                        <Border Name="Card" MinHeight="74" CornerRadius="16" Padding="15,13">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <!-- 拖拽排序辅助框：盖在卡面上的覆盖层，不参与布局（悬停点亮时不会推动兄弟卡片）。
                             Opacity 与 Margin 都只由样式给（同上，本地值压不过样式）；默认全暗，只有分区那侧点亮。 -->
                        <Rectangle Name="DragHint" IsHitTestVisible="False"
                                   StrokeThickness="1.4" StrokeDashArray="3.5,2.5"
                                   RadiusX="16" RadiusY="16"
                                   Stroke="{DynamicResource AccentBrush}"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.DevCard /template/ Rectangle#DragHint">
            <!-- 外距与 Border#Card 同档（全局 8 / 分区 4），改那边要同步这边 -->
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.DevCard /template/ Border#Card">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <!-- 用 BoxShadow 而非 Effect：Effect 会离屏渲染成与元素等大的图层，投影外扩部分被裁成硬边 -->
            <Setter Property="BoxShadow" Value="0 1 2 0 #050F172A, 0 4 14 0 #060F172A"/>
        </Style>
        <Style Selector="Button.DevCard.on /template/ Border#Card">
            <Setter Property="Background" Value="{DynamicResource DevOnBrush}"/>
        </Style>
        <Style Selector="Button.DevCard:pointerover">
            <Setter Property="RenderTransform" Value="translate(0px,-3px)"/>
        </Style>
        <Style Selector="Button.DevCard:pressed">
            <Setter Property="RenderTransform" Value="translate(0px,-1px) scale(0.99)"/>
        </Style>
        <!-- 设备图标：只画矢量图标本身，不垫底板 -->
        <Style Selector="Border.DevIc">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
        </Style>
        <Style Selector="Path.DevIcon">
            <Setter Property="Stroke" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Stroke" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Path.DevIcon.on">
            <Setter Property="Stroke" Value="{DynamicResource Accent2Brush}"/>
        </Style>
        <!-- 设备真机图：已裁到实物外框，只展示图本身，不垫底色、不切圆角 -->
        <Style Selector="Border.DevPhoto">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
        </Style>
        <!-- ======== 加载：骨架卡 + 掠过的高光带 + 旋转指示器 ======== -->
        <Style Selector="Border.SkelCard">
            <Setter Property="MinHeight" Value="74"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="15,13"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource SkelCardBrush}"/>
            <Setter Property="BoxShadow" Value="0 1 2 0 #050F172A, 0 4 14 0 #060F172A"/>
        </Style>
        <Style Selector="Border.SkelIc">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource SkelBarBrush}"/>
        </Style>
        <Style Selector="Border.SkelBar">
            <Setter Property="Height" Value="11"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource SkelBarBrush}"/>
        </Style>
        <Style Selector="Border.SkelSw">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Background" Value="{DynamicResource SkelBarBrush}"/>
        </Style>
        <!-- 高光带：卡片内容框已裁切，带子比卡高一点也不会漏出圆角 -->
        <Style Selector="Border.SkelShine">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="110"/>
            <Setter Property="Canvas.Top" Value="-18"/>
            <Setter Property="Canvas.Left" Value="-86"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource SkelShineBrush}"/>
            <Setter Property="RenderTransform">
                <TranslateTransform X="0"/>
            </Setter>
        </Style>
        <!-- 动画只在骨架真的显示时挂上：Avalonia 的 Style.Animations 不看 IsVisible，
             无限动画一旦常驻，合成器就按刷新率满帧重绘整棵树（空转掉一个核 + 常驻 GPU 占用）。 -->
        <Style Selector="Border.SkelShine.run">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="416"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- 窄版高光带：统计卡这类小卡用。类名单独开一个，不复用 SkelShine，
             否则 .SkelShine.run 的 416 扫程动画会和窄版动画同时命中、互相抢写 X。 -->
        <Style Selector="Border.SkelShineSm">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Canvas.Top" Value="-8"/>
            <Setter Property="Canvas.Left" Value="-64"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource SkelShineBrush}"/>
            <Setter Property="RenderTransform">
                <TranslateTransform X="0"/>
            </Setter>
        </Style>
        <Style Selector="Border.SkelShineSm.run">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="190"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- 旋转指示器：绕自身中心匀速转，尺寸/描边色由使用方给。
             原点必须写百分号：Avalonia 把 "0.5,0.5" 解析成绝对 0.5px，等于绕左上角转，整条弧会被带着甩。 -->
        <Style Selector="Path.Spinner">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform">
                <RotateTransform Angle="0"/>
            </Setter>
        </Style>
        <Style Selector="Path.Spinner.run">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite" Easing="LinearEasing">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- 设备状态文本：默认灰，开启绿，离线琥珀（warn 在后，优先生效） -->
        <Style Selector="TextBlock.DevStatus">
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.DevStatus.is-on">
            <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
        </Style>
        <Style Selector="TextBlock.DevStatus.is-warn">
            <Setter Property="Foreground" Value="{DynamicResource AmberBrush}"/>
        </Style>
        <!-- 状态圆点：文字保持常规色，只用小点表达在线/离线 -->
        <Style Selector="Ellipse.StatusDot">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource Text3Brush}"/>
        </Style>
        <Style Selector="Ellipse.StatusDot.is-on">
            <Setter Property="Fill" Value="{DynamicResource GreenBrush}"/>
        </Style>
        <Style Selector="Ellipse.StatusDot.is-warn">
            <Setter Property="Fill" Value="{DynamicResource AmberBrush}"/>
        </Style>
        <!-- ======== 场景卡（§8.8：彩色渐变 + 光晕，无边框） ======== -->
        <Style Selector="Button.SceneMini">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="RenderTransform" Value="translate(0px,0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2">
                        <TransformOperationsTransition.Easing>
                            <ani:CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Margin 用于给投影留出绘制空间 -->
                    <Border Name="Card" MinHeight="80" CornerRadius="16" Margin="8">
                        <Panel>
                            <!-- 光晕铺满整卡，靠自身圆角贴合卡片，避免硬边色块 -->
                            <!-- Style 模板无 x:DataType：DataContext 类型由运行时内容决定，这里退回反射绑定 -->
                            <Border Name="Glow" CornerRadius="16" Background="{ReflectionBinding GlowBrush}"
                                    IsHitTestVisible="False"/>
                            <Border Padding="12">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.SceneMini /template/ Border#Card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BoxShadow" Value="0 1 2 0 #050F172A, 0 5 16 0 #080F172A"/>
        </Style>
        <Style Selector="Button.SceneMini:pointerover">
            <Setter Property="RenderTransform" Value="translate(0px,-3px)"/>
        </Style>
        <Style Selector="Button.SceneMini:pressed">
            <Setter Property="RenderTransform" Value="translate(0px,-1px) scale(0.98)"/>
        </Style>
        <Style Selector="Button.SceneBig">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="RenderTransform" Value="translate(0px,0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2">
                        <TransformOperationsTransition.Easing>
                            <ani:CubicEaseOut/>
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Margin 用于给投影留出绘制空间 -->
                    <Border Name="Card" MinHeight="152" CornerRadius="16" Margin="8">
                        <Panel>
                            <!-- 光晕铺满整卡，靠自身圆角贴合卡片，避免硬边色块 -->
                            <!-- Style 模板无 x:DataType：DataContext 类型由运行时内容决定，这里退回反射绑定 -->
                            <Border Name="Glow" CornerRadius="16" Background="{ReflectionBinding GlowBrush}"
                                    IsHitTestVisible="False"/>
                            <Border Padding="18">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.SceneBig /template/ Border#Card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BoxShadow" Value="0 1 2 0 #050F172A, 0 5 16 0 #080F172A"/>
        </Style>
        <Style Selector="Button.SceneBig:pointerover">
            <Setter Property="RenderTransform" Value="translate(0px,-4px)"/>
        </Style>
        <Style Selector="Button.SceneBig:pressed">
            <Setter Property="RenderTransform" Value="translate(0px,-1px) scale(0.98)"/>
        </Style>
        <!-- ======== 场景执行：纯播放图标按钮（默认透明，hover 才出圆角底） ======== -->
        <Style Selector="Button.PlayCircle">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- 静止态不能用 Transparent：BrushTransition 逐通道插值，从 (0,0,0,0) 起步会先冲成一团
                         浅灰再落回目标色，就是 hover 那一下闪白。起点要写 hover 同色、只把透明位拉满 -->
                    <Border Name="Card" CornerRadius="12" Background="{DynamicResource PlayHoverFromBrush}">
                        <!-- 宽高按 GeoPlay 包围盒比例（7.3:10）给：Uniform 不留未居中的横向余量 -->
                        <Path Width="10" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource Text3Brush}" Opacity="0.55"
                              Data="{StaticResource GeoPlay}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.PlayCircle /template/ Border#Card">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.PlayCircle:pointerover /template/ Border#Card">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <!-- ======== 搜索框：胶囊造型，聚焦/悬停均不改色 ======== -->
        <Style Selector="TextBox.Search">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SearchBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SearchLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- 悬停/聚焦都保持同一底色与淡边框，不做颜色变化 -->
        <Style Selector="TextBox.Search /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource SearchBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SearchLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox.Search:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource SearchBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SearchLineBrush}"/>
        </Style>
        <Style Selector="TextBox.Search:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource SearchBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SearchLineBrush}"/>
        </Style>
        <Style Selector="TextBox.Log">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- ======== 滚动条：默认隐藏，悬停浮现圆角胶囊 ======== -->
        <Style Selector="ScrollBar">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25">
                        <DoubleTransition.Easing>
                            <ani:CubicEaseOut/>
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Window:pointerover ScrollBar">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- 箭头按钮：PathIcon 自己的主题把 Foreground 写死成 TextControlForeground，
             置空 ScrollBarButtonArrowForeground 管不到它，只能整个隐藏 -->
        <Style Selector="ScrollBar /template/ PathIcon">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton,
                        ScrollBar /template/ RepeatButton#PART_LineDownButton">
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <!-- 滑块换成 8px 居中胶囊。模板里只能有这一个 Border：主题的
             `^:pointerover/:pressed /template/ Border` 会命中模板内所有 Border，
             多包一层透明 Border 就会被它刷出一整条 16px 的「把手底色」 -->
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Pill"
                            HorizontalAlignment="Center" VerticalAlignment="Stretch"
                            Width="8" Margin="0,2"
                            CornerRadius="4"
                            Background="{DynamicResource ScrollBarThumbFill}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- 静止色用模板本地值（ScrollBarThumbFill），悬停/拖动色走主题的
             ScrollBarThumbFillPointerOver/Pressed，已在主题字典里按明暗配好 -->
        <Style Selector="ScrollBar /template/ Thumb /template/ Border#Pill">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18">
                        <BrushTransition.Easing>
                            <ani:CubicEaseOut/>
                        </BrushTransition.Easing>
                    </BrushTransition>
                </Transitions>
            </Setter>
        </Style>
        <!-- ======== 设备卡「更多」按钮 ======== -->
        <!-- 平时完全隐形且不参与命中，整卡悬停才浮现（透明度过渡）；
             点击行为由 Controls/MenuOpener 附加属性接管：打开与右键同一份菜单。
             菜单本体（外壳 + 菜单项主题）直接内联在 Templates.axaml 的设备卡模板里，
             不依赖样式匹配 —— 弹出层的样式应用时机不可控，本地值最稳。 -->
        <!-- 「更多」：比电源键略小（26×26 正圆）、右列内水平居中同轴；
             无任何底色，只有三个点；默认隐藏 + 上浮 3px，卡片悬停时淡入下滑浮现 -->
        <Style Selector="Button.MoreBtn">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
            <Setter Property="RenderTransform" Value="translate(0px,-3px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.DevCard:pointerover Button.MoreBtn">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="RenderTransform" Value="translate(0px,0px)"/>
        </Style>
        <Style Selector="Button.MoreBtn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <!-- 无背景版：任何状态（卡片悬停 / 自身 hover / 按下）都不铺底色，
             Fluent Button 主题自带的 pointerover/pressed 灰底显式压回透明 -->
        <Style Selector="Button.MoreBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.MoreBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ======== 弹窗基类 DialogPopup：遮罩 + 居中卡片 + 标题栏 + 可滚动正文 ======== -->
        <!-- 卡片四周 1px LineBrush 浅描边：暗色下是极淡的白、浅色下是极淡的蓝黑，只负责把卡片从背景里分出来 -->
        <Style Selector="Border.DialogCard">
            <Setter Property="Background" Value="{DynamicResource DrawerBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="24"/>
            <!-- 正文再长也只在卡片内滚：不裁切时超出一行的内容会画到卡片圆角外面 -->
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="BoxShadow" Value="0 24 48 0 #3311182B"/>
        </Style>
        <Style Selector="ctl|DialogPopup">
            <Setter Property="IsVisible" Value="{Binding IsOpen, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <!-- 遮罩：跨满宿主容器，点击即关闭（模板里挂 Mask 类，由控件识别） -->
                        <Border Classes="Mask" Background="{DynamicResource MaskBrush}"/>
                        <Border Classes="DialogCard" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="{TemplateBinding CardWidth}"
                                MaxHeight="{TemplateBinding CardMaxHeight}">
                            <Grid RowDefinitions="Auto,*">
                                <Panel Name="DialogHeader" Background="Transparent" Margin="28,20,22,0">
                                    <StackPanel>
                                        <TextBlock Text="{TemplateBinding Title}" FontSize="19" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Classes="Hint" Margin="0,5,0,0" Text="{TemplateBinding Subtitle}"
                                                   IsVisible="{Binding Subtitle, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </StackPanel>
                                    <Button Classes="ThemeBtn" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Cursor="Hand"
                                            Command="{TemplateBinding CloseCommand}" ToolTip.Tip="关闭">
                                        <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="0.8"
                                              StrokeLineCap="Round"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="{StaticResource GeoClose}"/>
                                    </Button>
                                </Panel>
                                <!-- 右外距缩到 6：把滚动条推到卡片内侧边缘，不再压在卡片上；
                                     正文右侧补 16 内距，正文可用宽度与卡片位置都和原来完全一致 -->
                                <ScrollViewer Grid.Row="1" Margin="28,18,6,26"
                                              ClipToBounds="True"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ContentPresenter Content="{TemplateBinding Content}" Margin="0,0,16,0"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- ======== 滑杆（抽屉 / 桌面分区浮层共用） ======== -->
        <!-- 抽屉滑杆：底轨 + 左圆角已填段 + 白圆钮。已填段只圆左端，避免与滑块之间出现缺口。
             放在全局而不是主窗口样式里：桌面分区的音量浮层、外观窗都是独立 Window，
             拿不到主窗口的局部样式，之前各写一份会漂出两种滑杆。 -->
        <Style Selector="Slider.DrSlider">
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBtnBrush}" />
            <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent" VerticalAlignment="Center" Height="30">
                        <!-- 未填轨道：两端都圆 -->
                        <Border Height="10" CornerRadius="5" VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                Background="{TemplateBinding Background}" />
                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               IsDirectionReversed="False"
                               Orientation="Horizontal"
                               VerticalAlignment="Center" Height="10">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_DecreaseButton"
                                              Background="Transparent" BorderThickness="0" Focusable="False"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              Padding="0" Margin="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <!-- 只圆左端；右端直角顶到滑块下，消除缺口 -->
                                            <Border Height="10" CornerRadius="5,0,0,5"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                    Background="{Binding $parent[Slider].Foreground}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>
                            <Track.Thumb>
                                <Thumb Name="PART_Thumb" Width="18" Height="18" Focusable="True">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Border Width="18" Height="18" CornerRadius="9"
                                                    Background="{DynamicResource SliderThumbBackground}"
                                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                                    BoxShadow="0 1 4 #28000000" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_IncreaseButton"
                                              Background="Transparent" BorderThickness="0" Focusable="False"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              Padding="0" Margin="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- 再压一遍 Fluent 默认 pressed/hover，防止右侧槽位出现灰底 -->
        <Style Selector="Slider.DrSlider /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Slider.DrSlider /template/ RepeatButton#PART_IncreaseButton:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Slider.DrSlider /template/ RepeatButton#PART_IncreaseButton:pressed">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- ======== 桌面分区图标按钮 ======== -->
        <!-- 贴桌面的分区窗与它的浮层都是独立 Window，取不到视图内的局部样式，
             所以标题栏/播放键那套 24×24 圆角图标按钮定义在这里 -->
        <Style Selector="Button.DskIcon">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="Foreground" Value="{DynamicResource DskTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.DskIcon:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.DskIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#26FFFFFF" />
        </Style>
        <Style Selector="Button.DskIcon:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <!-- 播放控制那一排：比普通图标大一号，仍然是同一套悬停/按下底色 -->
        <Style Selector="Button.DskMedia">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <!-- ======== 房间标注底板 ========
             下拉触发器、浮层列表、桌面分区共用这一个类：底色走主题感知的 Surface5，
             文字色仍由各处自定（桌面玻璃上要更亮一档的 DskText3） -->
        <Style Selector="Border.RoomTag">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="5,1.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- ======== 右键菜单入场 ========
             与托盘菜单、下拉浮层同一套动效语言（0.94 起、8px 落位、0.22s）。只动缩放与透明度，
             不做位移：ContextMenu 的弹出窗按内容尺寸开，位移会把边缘切掉。
             一次性动画，播完回到基础值（= 末帧），不会常驻渲染循环。
             ⚠ 不能对 RenderTransform 直接写关键帧：Avalonia 11 的动画器注册表没有 ITransform 条目，
             菜单一打开就抛 "No animator registered for the property RenderTransform"（官方 issue #8640），
             且 Animation.Animators 在 11.x 已内化、无法手动补注册。
             正确姿势与 Path.Spinner 同款：RenderTransform 固定挂一个 ScaleTransform，
             关键帧只写 ScaleTransform.ScaleX / ScaleY（double + Transform 归属，走 TransformAnimator 路由）。 -->
        <Style Selector="ContextMenu">
            <Setter Property="RenderTransformOrigin" Value="50%, 0%" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.22" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.94" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.94" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
</Styles>