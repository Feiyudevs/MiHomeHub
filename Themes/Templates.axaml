<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ani="clr-namespace:Avalonia.Animation.Easings;assembly=Avalonia.Base"
    xmlns:conv="clr-namespace:MiHomeHub.Converters"
    xmlns:ctl="clr-namespace:MiHomeHub.Controls"
    xmlns:vm="clr-namespace:MiHomeHub.ViewModels"
    xmlns:m="clr-namespace:MiHomeHub.Models">
            <!-- ======== 全局 DataTemplate：设备卡/骨架卡/场景迷你卡（MainWindow 与 HomeView 共用） ======== -->
            <!-- 加载骨架：与设备卡同尺寸同圆角，先用占位块占住宫格，真设备到手整块换掉 -->
            <DataTemplate x:Key="SkeletonCardTemplate" x:DataType="x:String">
                <Border Classes="SkelCard">
                    <Panel ClipToBounds="True">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SkelIc" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0" Spacing="7">
                                <Border Classes="SkelBar" Width="104" />
                                <Border Classes="SkelBar" Width="64" Height="9" />
                            </StackPanel>
                            <Border Grid.Column="2" Classes="SkelSw" VerticalAlignment="Center" />
                        </Grid>
                        <Canvas IsHitTestVisible="False">
                            <!-- 高光带的扫动动画写在 App.axaml 的 Border.SkelShine.run 样式里：
                                 run 类跟骨架可见性同开关，收起时动画必须一起停，否则合成器满帧空转 -->
                            <Border Classes="SkelShine"
                                    Classes.run="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ShowSkeleton}" />
                        </Canvas>
                    </Panel>
                </Border>
            </DataTemplate>
            <!-- 场景骨架：与场景迷你卡同尺寸同圆角，首次拉取场景时先占住一行 -->
            <DataTemplate x:Key="SceneSkeletonTemplate" x:DataType="x:String">
                <Border Classes="SkelCard" MinHeight="72" Padding="14,11">
                    <Panel ClipToBounds="True">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SkelIc" Width="38" Height="38" CornerRadius="12" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center" Spacing="7">
                                <Border Classes="SkelBar" Width="96" HorizontalAlignment="Left" />
                                <Border Classes="SkelBar" Width="62" Height="9" HorizontalAlignment="Left" />
                            </StackPanel>
                            <Border Grid.Column="2" Classes="SkelSw" Width="30" Height="30"
                                    CornerRadius="15" VerticalAlignment="Center" />
                        </Grid>
                        <Canvas IsHitTestVisible="False">
                            <Border Classes="SkelShine"
                                    Classes.run="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ShowSceneSkeleton}" />
                        </Canvas>
                    </Panel>
                </Border>
            </DataTemplate>
            <!-- 统计卡骨架：与五张概览统计卡同尺寸同圆角，冷启动拉取期间先占住统计行。
                 外边距与真卡一致，配合 WrapPanel 的负边距容器保持右边缘对齐 -->
            <DataTemplate x:Key="StatSkeletonTemplate" x:DataType="x:String">
                <Border CornerRadius="16" Padding="16,13" MinWidth="96" Margin="0,0,10,10"
                        Background="{DynamicResource SkelCardBrush}"
                        BoxShadow="{DynamicResource CardShadow}">
                    <Panel ClipToBounds="True">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <!-- 首行是「图标 + 标签」：占位块跟着统计卡改成 13 见方，别留旧的小圆点尺寸 -->
                                <Border Width="13" Height="13" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{DynamicResource SkelBarBrush}" />
                                <Border Classes="SkelBar" Width="40" Height="11" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Classes="SkelBar" Width="50" Height="24" CornerRadius="7" />
                        </StackPanel>
                        <Canvas IsHitTestVisible="False">
                            <!-- 窄版高光：统计卡比设备卡小得多，416px 的扫程绝大部分在卡外，几乎看不见扫动 -->
                            <Border Classes="SkelShineSm"
                                    Classes.run="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ShowSkeleton}" />
                        </Canvas>
                    </Panel>
                </Border>
            </DataTemplate>
            <!-- 环境胶囊骨架：与 EnvPill 同圆角同内衬，读数到货前先占住胶囊行 -->
            <DataTemplate x:Key="EnvPillSkeletonTemplate" x:DataType="x:String">
                <Border CornerRadius="11" Padding="10,5" Margin="0,0,8,6"
                        Background="{DynamicResource SkelCardBrush}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Classes="SkelBar" Width="22" Height="8" CornerRadius="4" VerticalAlignment="Center" />
                        <Border Classes="SkelBar" Width="30" Height="11" CornerRadius="4" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </DataTemplate>
            <!-- 趋势卡骨架：与温度/湿度/用电三张真卡同圆角同内衬同高度，首拉期间先占住图表行，
                 读数到货后整块换成真卡；图表区比文字条淡一档，留出「这里会画曲线」的层次。
                 内衬与图表行高度要跟 Border.TrendCard / 真卡里的 72 保持一致，改一处要改三处 -->
            <DataTemplate x:Key="TrendSkeletonTemplate" x:DataType="x:String">
                <Border CornerRadius="16" Padding="16,12,16,10" Margin="8" ClipToBounds="False"
                        Background="{DynamicResource SkelCardBrush}"
                        BoxShadow="{DynamicResource CardShadow}">
                    <Panel ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Width="13" Height="13" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{DynamicResource SkelBarBrush}" />
                                <Border Grid.Column="1" Classes="SkelBar" Width="56" Height="11"
                                        Margin="6,0,0,0" HorizontalAlignment="Left" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,6,0,0" ColumnDefinitions="Auto,*,Auto">
                                <Border Classes="SkelBar" Width="72" Height="24" CornerRadius="7" VerticalAlignment="Bottom" />
                                <!-- 大数字右侧那两行小字（舒适度 / 全天高低）的占位 -->
                                <Border Grid.Column="2" Classes="SkelBar" Width="64" Height="8"
                                        CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                            <Border Grid.Row="2" MinHeight="72" Margin="0,8,0,0" CornerRadius="10" Opacity="0.45"
                                    Background="{DynamicResource SkelBarBrush}" />
                        </Grid>
                        <Canvas IsHitTestVisible="False">
                            <Border Classes="SkelShine"
                                    Classes.run="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ShowTrendSkeleton}" />
                        </Canvas>
                    </Panel>
                </Border>
            </DataTemplate>
            <!-- 设备卡右键菜单项（CardMenuItem）：Fluent 默认 MenuItem 的悬停高亮是直角、铺满整行，
                 与圆角外壳不搭。这里给一份精简主题：高亮画在圆角 8 的 ItemRoot 上，底色统一用品牌主色柔色档。
                 注意 MenuItem 的悬停伪类是 :selected（它没有 :pointerover），按压是 :pressed。
                 主题直接内联在本字典里、由菜单项用 Theme 静态引用 —— 不走样式匹配，弹出层里也稳。 -->
            <ControlTheme x:Key="CardMenuItem" TargetType="MenuItem">
                <!-- 静息底 = 悬停紫的零透明版本，悬停时只淡入同一层色（避免从黑透明插值闪灰） -->
                <Setter Property="Background" Value="{DynamicResource SelBgFromBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/>
                <Setter Property="Padding" Value="9,6"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="ItemRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <ContentControl Grid.Column="0" Name="PART_Icon"
                                                Width="14" Height="14" Margin="0,0,8,0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                IsVisible="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Content="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter Grid.Column="1" Name="PART_HeaderPresenter"
                                                  Content="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <!-- 选中底是实心紫，图标要跟文字一起翻白：描边直接绑 MenuItem.Foreground，
                     基础档是 MenuTextBrush、选中档是 SelTextBrush，两头都由下面两条已验证生效的规则供给，
                     绝不会出现描边为空、图标整只消失的情况 -->
                <!-- 悬停（MenuItem 用 :selected）与按下换底色：走淡变，右键菜单扫过时不闪 -->
                <Style Selector="^ /template/ Border#ItemRoot">
                    <Setter Property="Transitions">
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.16"/>
                        </Transitions>
                    </Setter>
                </Style>
                <!-- 文字与图标跟着底色一起翻白：颜色直接换，不做过渡 -->
                <Style Selector="^:selected">
                    <Setter Property="Foreground" Value="{DynamicResource SelTextBrush}"/>
                </Style>
                <Style Selector="^:selected /template/ Border#ItemRoot">
                    <Setter Property="Background" Value="{DynamicResource SelBgBrush}"/>
                </Style>
                <Style Selector="^:pressed /template/ Border#ItemRoot">
                    <Setter Property="Background" Value="{DynamicResource SelBgPressBrush}"/>
                </Style>
            </ControlTheme>
            <!-- 设备卡（§8.6）：图标 | 名称 + 房间·状态；「更多」浮在设备图标正中（悬停浮现，点击开菜单）、
                 右侧电源键固定居中。主窗口列表与桌面分区共用这一张卡：动作统一交给所在窗口 DataContext 的
                 IDeviceCardHost 实现（主窗口=抽屉，分区=控制弹窗），卡片本身不知道贴在哪；
                 菜单同理（右键 / 「更多」都开它），文案 / 图标 / 动作都由宿主给。 -->
            <!-- 设备菜单按需创建，右键、菜单键和更多按钮共享。 -->
            <DataTemplate x:Key="DeviceCardMenuTemplate" x:DataType="m:MijiaDevice">
                <!-- 外壳视觉（圆角 12 + 细描边 + 5px 内边距）直接写成本地 Template：
                     弹出层的样式应用时机不可控，本地值最稳，不依赖样式是否命中 -->
                <ContextMenu Padding="4" MinWidth="0" FontSize="11.5"
                             IsVisible="{Binding $parent[Window].((vm:IDeviceCardHost)DataContext).CardMenuCommand, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ContextMenu.Template>
                        <ControlTemplate>
                            <Border Name="MenuShell" CornerRadius="12"
                                    Background="{DynamicResource MenuBgBrush}"
                                    BorderBrush="{DynamicResource MenuLineBrush}"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ItemsPresenter Name="PART_ItemsPresenter"/>
                            </Border>
                        </ControlTemplate>
                    </ContextMenu.Template>
                    <!-- 第一项固定「设备详情」：与点卡片本体同一个动作（宿主 OpenCardCommand）；
                         第二项由宿主给文案/图标/命令（主窗口=添加到桌面组件，分区=从分区移除） -->
                    <MenuItem Theme="{StaticResource CardMenuItem}"
                              Header="设备详情"
                              Command="{Binding $parent[Window].((vm:IDeviceCardHost)DataContext).OpenCardCommand}"
                              CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Viewbox Width="12" Height="12" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Panel Width="24" Height="24">
                                    <Path StrokeThickness="1.92" StrokeLineCap="Round" StrokeJoin="Round"
                                          Stroke="{Binding $parent[MenuItem].Foreground}"
                                          Data="M21,12 A9,9 0 1,1 3,12 A9,9 0 1,1 21,12 M12,8 H12.01 M12,11.2 V16" />
                                </Panel>
                            </Viewbox>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Theme="{StaticResource CardMenuItem}"
                              Header="{Binding $parent[Window].((vm:IDeviceCardHost)DataContext).CardMenuText}"
                              Command="{Binding $parent[Window].((vm:IDeviceCardHost)DataContext).CardMenuCommand}"
                              CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <!-- 图标按 24 网格画好再交给 Viewbox 缩放：Path 单独用 Stretch 时按几何包围盒对齐，
                                 只有横线的「－」会算出零高度而错位，套一层正方网格才稳定 -->
                            <Viewbox Width="12" Height="12" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Panel Width="24" Height="24">
                                    <Path StrokeThickness="1.92" StrokeLineCap="Round" StrokeJoin="Round"
                                          Stroke="{Binding $parent[MenuItem].Foreground}"
                                          Data="{Binding $parent[Window].((vm:IDeviceCardHost)DataContext).CardMenuIcon}" />
                                </Panel>
                            </Viewbox>
                        </MenuItem.Icon>
                    </MenuItem>
                    <!-- 第三项只给主列表：隐藏 / 恢复这台设备。桌面分区宿主返回 null，整项收起。
                         文案按设备当前状态切换，隐藏后同一张卡片右键就是「取消隐藏」 -->
                    <MenuItem Theme="{StaticResource CardMenuItem}"
                              Header="{Binding IsHidden, Converter={x:Static conv:BoolTextConverter.Instance}, ConverterParameter='取消隐藏|隐藏此设备'}"
                              IsVisible="{Binding $parent[Window].((vm:IDeviceCardHost)DataContext).HideCardCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                              Command="{Binding $parent[Window].((vm:IDeviceCardHost)DataContext).HideCardCommand}"
                              CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Viewbox Width="12" Height="12" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Panel Width="24" Height="24">
                                    <Path StrokeThickness="1.92" StrokeLineCap="Round" StrokeJoin="Round"
                                          Stroke="{Binding $parent[MenuItem].Foreground}"
                                          Data="M2,12 C5,7 8.5,5 12,5 C15.5,5 19,7 22,12 C19,17 15.5,19 12,19 C8.5,19 5,17 2,12 Z M12,9 A3,3 0 1,1 11.99,9 M4,4 L20,20" />
                                </Panel>
                            </Viewbox>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataTemplate>
            <DataTemplate x:Key="DeviceCardTemplate" x:DataType="m:MijiaDevice">
                <ctl:DeviceCardButton Classes="DevCard" Classes.on="{Binding IsOn}"
                        Classes.sw="{Binding ShowCardSwitch}"
                        ctl:LazyContextMenu.MenuTemplate="{StaticResource DeviceCardMenuTemplate}"
                        Command="{Binding $parent[Window].((vm:IDeviceCardHost)DataContext).OpenCardCommand}"
                        CommandParameter="{Binding}">
                    <Panel>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Panel Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center">
                            <Panel IsVisible="{Binding !HasCustomIcon}">
                                <Border Classes="DevIc"
                                        IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}">
                                    <Path Classes="DevIcon" Classes.on="{Binding IsOn}" Width="24" Height="24"
                                          Stretch="Uniform" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                          Data="{Binding Converter={StaticResource DeviceIcon}}" />
                                </Border>
                                <Border Classes="DevPhoto" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <!-- 缩小 10 倍用 MediumQuality（双线性+mipmap 预滤波）：
                                         HighQuality 在 Skia 是固定 4×4 核三次采样，大比例缩小时欠采样，白描边会断成锯齿点 -->
                                    <Image Source="{Binding Icon}" Stretch="Uniform"
                                           RenderOptions.BitmapInterpolationMode="MediumQuality" />
                                </Border>
                            </Panel>
                            <!-- 用户自定义的设备图：铺满 48 圆角框，盖住真机图 / 矢量图标 -->
                            <ctl:RoundedImage Width="48" Height="48" CornerRadius="12"
                                              IsHitTestVisible="False"
                                              IsVisible="{Binding HasCustomIcon}"
                                              Source="{Binding CustomIcon.Image}" />
                            <!-- 「更多」浮在设备图标正中（卡片悬停时淡入）：容器透明、不铺方底，
                                 只把三个点居中；与图标同格叠放，不占布局槽，设备图标照常显示 -->
                            <ctl:DeviceMoreButton Classes="MoreBtn" ctl:MenuOpener.OpenOnClick="True"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ToolTip.Tip="更多">
                                <Border Classes="MoreBtnPill">
                                    <!-- 三个点显式双向居中：Button 内容对齐不保证 Center，不写会偏 -->
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="3.5" Height="3.5"
                                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <Ellipse Width="3.5" Height="3.5"
                                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <Ellipse Width="3.5" Height="3.5"
                                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Border>
                            </ctl:DeviceMoreButton>
                        </Panel>
                        <!-- 右内距留 0：中列和电源列之间本来就空着一截，把这点宽度让给读数和名称；
                             读数标签最多压到电源键前一点，不会真的盖住按钮 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="3"
                                    HorizontalAlignment="Stretch">
                            <!-- 名称行：名称吃剩余宽度并按需省略，离线 / 灯组角标紧跟名称末尾。
                                 TextBadgeRow 先量角标、再把剩下的宽度给名称：不能用 Grid（* + Auto），
                                 那会把角标推到行尾，名字短时中间空一大截；名字长时又不会省略。 -->
                            <ctl:TextBadgeRow VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <TextBlock Classes="DevName" Text="{Binding Name}" FontSize="13.5"
                                           FontWeight="Normal" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding Name}" />
                                <!-- 离线角标：仅离线设备显示，琥珀底 + 暖字，与抽屉 is-warn 同色系 -->
                                <Border CornerRadius="8" Padding="6,1.5" Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource AmberSoftBrush}" IsVisible="{Binding !IsOnline}">
                                    <TextBlock Text="离线" FontSize="9.5" FontWeight="Normal"
                                               Foreground="{DynamicResource AmberBrush}" />
                                </Border>
                                <!-- 灯组标签：组本身也在设备列表里，卡片上要能一眼和单灯区分 -->
                                <Border CornerRadius="8" Padding="6,1.5" Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource BlueSoftBrush}" IsVisible="{Binding IsGroup}">
                                    <TextBlock Text="{Binding GroupTag}" FontSize="9.5" FontWeight="Normal"
                                               Foreground="{DynamicResource BlueBrush}" />
                                </Border>
                            </ctl:TextBadgeRow>
                            <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Stretch">
                                <!-- 房间 + 读数：读数一项一枚小标签，排不下就整枚换到下一行，
                                     不会把「20µg/m³」从中间截断，也不会在行尾留下孤零零的「·」。
                                     读数多到三枚以上时先让出房间名（分组标题上已有房间），
                                     把整行宽度留给读数，避免标签叠出卡片。
                                     完整读数仍挂在整行上的悬停提示里 -->
                                <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding CardSubtitleTooltip}">
                                    <TextBlock Grid.Column="0" Classes="DevMeta" Text="{Binding RoomName}"
                                               FontSize="11" Margin="0,0,6,2" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding ShowCardRoom}" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding CardMetricTags}"
                                                  VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <!-- 读数标签收紧一点：左内距由 7 收到 5，
                                                     两枚并排才刚好塞进中间那九十来像素 -->
                                                <Border Classes="MiniTag" Margin="0,0,4,2">
                                                    <TextBlock Classes="DevMeta" Text="{Binding}" FontSize="10.5" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                        <!-- 右列：电源键固定垂直居中，不随悬停位移（「更多」已移到左侧图标上）；
                             多路设备的卡片不再显示「N 路」角标（设备名里已看出是双开/多键），这一列对它们留空。 -->
                        <Grid Grid.Column="2" MinWidth="32">
                            <ctl:DevicePowerButton Classes="Power" Classes.curtain="{Binding IsCurtain}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="0"
                                          IsVisible="{Binding ShowCardSwitch}"
                                          IsChecked="{Binding IsOn}" IsEnabled="{Binding !IsBusy}"
                                          Command="{Binding $parent[Window].((vm:IDeviceCardHost)DataContext).ToggleSwitchCommand}"
                                          CommandParameter="{Binding}" />
                        </Grid>
                    </Grid>
                    </Panel>
                </ctl:DeviceCardButton>
            </DataTemplate>
            <!-- 场景卡右键菜单：换自定义图标 / 回到默认画法；与房间行同一套弹窗。
                 必须定义在用到它的迷你卡/大卡之前：StaticResource 是文档顺序查找。 -->
            <DataTemplate x:Key="SceneIconMenuTemplate" x:DataType="m:SceneCardItem">
                <ContextMenu Padding="4" MinWidth="0" FontSize="11.5">
                    <ContextMenu.Template>
                        <ControlTemplate>
                            <Border Name="MenuShell" CornerRadius="12"
                                    Background="{DynamicResource MenuBgBrush}"
                                    BorderBrush="{DynamicResource MenuLineBrush}"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ItemsPresenter Name="PART_ItemsPresenter"/>
                            </Border>
                        </ControlTemplate>
                    </ContextMenu.Template>
                    <MenuItem Theme="{StaticResource CardMenuItem}"
                              Header="自定义图标…"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditSceneIconCommand}"
                              CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Viewbox Width="12" Height="12" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Panel Width="24" Height="24">
                                    <Path StrokeThickness="1.92" StrokeLineCap="Round" StrokeJoin="Round"
                                          Stroke="{Binding $parent[MenuItem].Foreground}"
                                          Data="M3,4.5 H21 V19.5 H3 Z M3,16 L8.5,10.5 L13,15 L16.5,11.5 L21,15.5 M15.5,7.8 A1.2,1.2 0 1 1 15.49,7.8" />
                                </Panel>
                            </Viewbox>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Theme="{StaticResource CardMenuItem}"
                              Header="恢复默认图标"
                              IsVisible="{Binding HasCustomIcon}"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ResetSceneIconCommand}"
                              CommandParameter="{Binding}">
                        <MenuItem.Icon>
                            <Viewbox Width="12" Height="12" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Panel Width="24" Height="24">
                                    <Path StrokeThickness="1.92" StrokeLineCap="Round" StrokeJoin="Round"
                                          Stroke="{Binding $parent[MenuItem].Foreground}"
                                          Data="M3.5,11.5 A8.5,8.5 0 1 1 6.2,17.8 M3.5,11.5 L1.8,7.9 M3.5,11.5 L7.1,13.3" />
                                </Panel>
                            </Viewbox>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataTemplate>

            <!-- 场景迷你卡（首页条）：横向「图标 / 名称+摘要 / 执行」三列，与场景大卡同构；
                 点卡片本身不执行，只有右侧播放按钮执行 -->
            <DataTemplate x:Key="SceneMiniTemplate" x:DataType="m:SceneCardItem">
                <Border CornerRadius="16" Margin="8" MinHeight="72"
                        Background="{DynamicResource CardBrush}"
                        ctl:LazyContextMenu.MenuTemplate="{StaticResource SceneIconMenuTemplate}"
                        ToolTip.Tip="点右侧播放钮执行，右键可换图标"
                        BoxShadow="{DynamicResource CardShadow}">
                    <Panel>
                        <Border CornerRadius="16" Background="{Binding GlowBrush}" IsHitTestVisible="False"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,11">
                            <!-- 左：场景色图标（用户换过自定义图时叠在默认线性图标上） -->
                            <Border Width="38" Height="38" CornerRadius="13" Background="{Binding IconBgBrush}"
                                    VerticalAlignment="Center">
                                <Panel>
                                    <!-- 线稿已按同一外包框（最长边 18、中心 12,12）归一化，
                                         因此 Uniform 缩放到 15 时每个图标都落在底块正中、大小一致 -->
                                    <Path Width="15" Height="15" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="{Binding IconFgBrush}"
                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                          Opacity="{Binding DefaultIconOpacity}"
                                          Data="{Binding Icon}" />
                                    <!-- 自定义图铺满整枚 38 圆角底，别在四周留出图标底色 -->
                                    <ctl:RoundedImage CornerRadius="13"
                                                      IsHitTestVisible="False"
                                                      IsVisible="{Binding HasCustomIcon}"
                                                      Source="{Binding CustomIcon.Image}" />
                                </Panel>
                            </Border>
                            <!-- 中：名称 + 摘要，与设备卡的「名称 / 副标题」同构 -->
                            <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Normal"
                                           MaxLines="1" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding Summary}" FontSize="10.5"
                                           MaxLines="1" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Text3Brush}" />
                            </StackPanel>
                            <!-- 右：运行中角标贴在播放钮左侧 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Border CornerRadius="20" Padding="7,2" VerticalAlignment="Center"
                                        Background="{DynamicResource GreenSoftBrush}" IsVisible="{Binding IsRunning}">
                                    <TextBlock Text="运行中" FontSize="10" FontWeight="Normal"
                                               Foreground="{DynamicResource GreenBrush}" />
                                </Border>
                                <Button Classes="PlayCircle" Width="30" Height="30" VerticalAlignment="Center"
                                        ToolTip.Tip="执行"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RunSceneCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Panel>
                </Border>
            </DataTemplate>
        <!-- 场景 / 自动化卡：直接复用设备卡的控件与壳（ctl:DeviceCardButton + .DevCard 样式），
             所以圆角、内距、投影、悬停上浮、按下缩放手感与首页设备卡完全一致；
             三列结构也照设备卡：左＝图标，中＝名称 + 一行摘要，右＝执行（场景）/ 启停（自动化）。
             整卡仍是按钮，点一下进编辑器（没有收藏 / 编辑小按钮）。 -->
        <DataTemplate x:Key="SceneBigTemplate" x:DataType="m:SceneCardItem">
            <ctl:DeviceCardButton Classes="DevCard"
                                  ToolTip.Tip="点击卡片编辑，右键可换图标"
                                  ctl:LazyContextMenu.MenuTemplate="{StaticResource SceneIconMenuTemplate}"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenSceneEditorCommand}"
                                  CommandParameter="{Binding}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- 左：场景色图标（设备卡是裸线性图标，这里保留柔色底块，一眼区分类别；
                         用户换过图就给自定义 SVG / PNG 让位） -->
                    <Border Width="46" Height="46" CornerRadius="16" Background="{Binding IconBgBrush}"
                            VerticalAlignment="Center">
                        <Panel>
                            <!-- 线稿已按同一外包框归一化，18 即原尺寸，四个场景入口用同一套 -->
                            <Path Width="18" Height="18" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{Binding IconFgBrush}"
                                  StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                  Opacity="{Binding DefaultIconOpacity}"
                                  Data="{Binding Icon}" />
                            <!-- 自定义图铺满 46 圆角底 -->
                            <ctl:RoundedImage CornerRadius="15"
                                              IsHitTestVisible="False"
                                              IsVisible="{Binding HasCustomIcon}"
                                              Source="{Binding CustomIcon.Image}" />
                        </Panel>
                    </Border>
                    <!-- 中：名称 + 摘要，与设备卡的「名称 / 副标题」同构；摘要小一号、与名称拉开 6px 呼吸 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Normal"
                                   MaxLines="1" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding Summary}" FontSize="10.5"
                                   MaxLines="1" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Text3Brush}" />
                    </StackPanel>
                    <!-- 右：与设备卡电源键同位；运行中角标贴在执行钮左侧 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border CornerRadius="8" Padding="6,1.5" VerticalAlignment="Center"
                                Background="{DynamicResource GreenSoftBrush}" IsVisible="{Binding IsRunning}">
                            <TextBlock Text="运行中" FontSize="9.5" FontWeight="Normal"
                                       Foreground="{DynamicResource GreenBrush}" />
                        </Border>
                        <!-- 手动场景：执行（与设备卡电源键同一套圆形按钮手感） -->
                        <Button Classes="PlayCircle" Width="32" Height="32"
                                IsVisible="{Binding !IsAutomation}"
                                ToolTip.Tip="执行"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RunSceneCommand}"
                                CommandParameter="{Binding}" />
                        <!-- 自动化启停：走 SetSceneStatus，只改 enable，不动动作定义 -->
                        <Button Classes="Switch" Classes.on="{Binding IsEnabled}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsAutomation}"
                                ToolTip.Tip="开启 / 关闭这条自动化"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleAutomationCommand}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </ctl:DeviceCardButton>
        </DataTemplate>

        <!-- 场景紧凑行：设备详情「智能场景」用；整行可点，走已有场景详情弹窗（OpenSceneEditorCommand） -->
        <DataTemplate x:Key="SceneDeviceRowTemplate" x:DataType="m:SceneCardItem">
            <Button Classes="SmartSceneRow" Margin="0,0,0,6"
                    ToolTip.Tip="打开场景详情，右键可换图标"
                    ctl:LazyContextMenu.MenuTemplate="{StaticResource SceneIconMenuTemplate}"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenSceneEditorCommand}"
                    CommandParameter="{Binding}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <Border Width="28" Height="28" CornerRadius="10" Background="{Binding IconBgBrush}"
                            VerticalAlignment="Center">
                        <Panel>
                            <Path Width="11" Height="11" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{Binding IconFgBrush}"
                                  StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                  Opacity="{Binding DefaultIconOpacity}"
                                  Data="{Binding Icon}" />
                            <!-- 自定义图铺满 28 圆角底 -->
                            <ctl:RoundedImage CornerRadius="10"
                                              IsHitTestVisible="False"
                                              IsVisible="{Binding HasCustomIcon}"
                                              Source="{Binding CustomIcon.Image}" />
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Normal"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding Summary}" FontSize="11.5" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                   Foreground="{DynamicResource Text3Brush}" />
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="10" Padding="7,2" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="触发：这台设备的状态变化会启动这条自动化 · 控制：这条场景会对这台设备下指令 · 带「灯组」：作用在包含本设备的灯组上"
                            Background="{DynamicResource GreenSoftBrush}" IsVisible="{Binding HasRole}">
                        <TextBlock Text="{Binding RoleText}" FontSize="10.5" FontWeight="Normal"
                                   Foreground="{DynamicResource GreenBrush}" />
                    </Border>
                    <!-- 仅本机：只下发这条场景里落到该设备的动作，不跑整条场景 -->
                    <Button Grid.Column="3" Classes="BtnGhost" Height="24" Padding="8,0"
                            FontSize="10.5" FontWeight="Normal" Margin="0,0,6,0"
                            VerticalAlignment="Center" Content="仅本机"
                            IsVisible="{Binding CanRunOnDevice}"
                            ToolTip.Tip="{Binding DeviceRunTip}"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunSceneOnDeviceCommand}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Column="4" Classes="PlayCircle" Width="28" Height="28"
                            VerticalAlignment="Center" ToolTip.Tip="执行整条场景"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunSceneCommand}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Button>
        </DataTemplate>
</ResourceDictionary>
