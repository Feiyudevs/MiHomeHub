<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ani="clr-namespace:Avalonia.Animation.Easings;assembly=Avalonia.Base"
    xmlns:conv="clr-namespace:MiHome.Converters"
    xmlns:ctl="clr-namespace:MiHome.Controls"
    xmlns:vm="clr-namespace:MiHome.ViewModels"
    xmlns:m="clr-namespace:MiHome.Models">
            <!-- ======== 全局 DataTemplate：设备卡/骨架卡/场景迷你卡（MainWindow 与 HomeView 共用） ======== -->
            <!-- 加载骨架：与设备卡同尺寸同圆角，先用占位块占住宫格，真设备到手整块换掉 -->
            <DataTemplate x:Key="SkeletonCardTemplate" x:DataType="x:String">
                <Border Classes="SkelCard">
                    <Panel ClipToBounds="True">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="SkelIc" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0" Spacing="7">
                                <Border Classes="SkelBar" Width="104" />
                                <Border Classes="SkelBar" Width="64" Height="9" />
                            </StackPanel>
                            <Border Grid.Column="2" Classes="SkelSw" VerticalAlignment="Center" />
                        </Grid>
                        <Canvas IsHitTestVisible="False">
                            <!-- 高光带的扫动动画写在 App.axaml 的 Border.SkelShine.run 样式里：
                                 run 类跟骨架可见性同开关，收起时动画必须一起停，否则合成器满帧空转 -->
                            <Border Classes="SkelShine"
                                    Classes.run="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ShowSkeleton}" />
                        </Canvas>
                    </Panel>
                </Border>
            </DataTemplate>
            <!-- 场景骨架：与场景迷你卡同尺寸同圆角，首次拉取场景时先占住一行 -->
            <DataTemplate x:Key="SceneSkeletonTemplate" x:DataType="x:String">
                <Border Classes="SkelCard" MinHeight="80">
                    <Panel ClipToBounds="True">
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="10">
                            <Border Classes="SkelIc" Width="30" Height="30" CornerRadius="10" HorizontalAlignment="Left" />
                            <Border Classes="SkelBar" Width="88" HorizontalAlignment="Left" />
                        </StackPanel>
                        <Canvas IsHitTestVisible="False">
                            <Border Classes="SkelShine"
                                    Classes.run="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ShowSceneSkeleton}" />
                        </Canvas>
                    </Panel>
                </Border>
            </DataTemplate>
            <!-- 统计卡骨架：与四张概览统计卡同尺寸同圆角，冷启动拉取期间先占住统计行。
                 外边距与真卡一致，配合 WrapPanel 的负边距容器保持右边缘对齐 -->
            <DataTemplate x:Key="StatSkeletonTemplate" x:DataType="x:String">
                <Border CornerRadius="16" Padding="16,13" MinWidth="96" Margin="0,0,10,10"
                        Background="{DynamicResource SkelCardBrush}"
                        BoxShadow="0 1 2 0 #050F172A, 0 5 16 0 #080F172A">
                    <Panel ClipToBounds="True">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <!-- 首行是「图标 + 标签」：占位块跟着统计卡改成 13 见方，别留旧的小圆点尺寸 -->
                                <Border Width="13" Height="13" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{DynamicResource SkelBarBrush}" />
                                <Border Classes="SkelBar" Width="40" Height="11" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Classes="SkelBar" Width="50" Height="24" CornerRadius="7" />
                        </StackPanel>
                        <Canvas IsHitTestVisible="False">
                            <!-- 窄版高光：统计卡比设备卡小得多，416px 的扫程绝大部分在卡外，几乎看不见扫动 -->
                            <Border Classes="SkelShineSm"
                                    Classes.run="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ShowSkeleton}" />
                        </Canvas>
                    </Panel>
                </Border>
            </DataTemplate>
            <!-- 环境胶囊骨架：与 EnvPill 同圆角同内衬，读数到货前先占住胶囊行 -->
            <DataTemplate x:Key="EnvPillSkeletonTemplate" x:DataType="x:String">
                <Border CornerRadius="11" Padding="10,5" Margin="0,0,8,6"
                        Background="{DynamicResource SkelCardBrush}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Classes="SkelBar" Width="22" Height="8" CornerRadius="4" VerticalAlignment="Center" />
                        <Border Classes="SkelBar" Width="30" Height="11" CornerRadius="4" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </DataTemplate>
            <!-- 设备卡右键菜单项（CardMenuItem）：Fluent 默认 MenuItem 的悬停高亮是直角、铺满整行，
                 与圆角外壳不搭。这里给一份精简主题：高亮画在圆角 8 的 ItemRoot 上，底色统一用品牌主色柔色档。
                 注意 MenuItem 的悬停伪类是 :selected（它没有 :pointerover），按压是 :pressed。
                 主题直接内联在本字典里、由菜单项用 Theme 静态引用 —— 不走样式匹配，弹出层里也稳。 -->
            <ControlTheme x:Key="CardMenuItem" TargetType="MenuItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/>
                <Setter Property="Padding" Value="9,6"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="ItemRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <ContentControl Grid.Column="0" Name="PART_Icon"
                                                Width="14" Height="14" Margin="0,0,8,0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                IsVisible="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Content="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter Grid.Column="1" Name="PART_HeaderPresenter"
                                                  Content="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <!-- 选中底是实心紫，图标要跟文字一起翻白：描边直接绑 MenuItem.Foreground，
                     基础档是 MenuTextBrush、选中档是 SelTextBrush，两头都由下面两条已验证生效的规则供给，
                     绝不会出现描边为空、图标整只消失的情况 -->
                <Style Selector="^:selected">
                    <Setter Property="Foreground" Value="{DynamicResource SelTextBrush}"/>
                </Style>
                <Style Selector="^:selected /template/ Border#ItemRoot">
                    <Setter Property="Background" Value="{DynamicResource SelBgBrush}"/>
                </Style>
                <Style Selector="^:pressed /template/ Border#ItemRoot">
                    <Setter Property="Background" Value="{DynamicResource SelBgPressBrush}"/>
                </Style>
            </ControlTheme>
            <!-- 设备卡（§8.6）：图标 | 名称 + 房间·状态；右上角「更多」（悬停浮现，点击开菜单）、
                 右下角电源键。主窗口列表与桌面分区共用这一张卡：动作统一交给所在窗口 DataContext 的
                 IDeviceCardHost 实现（主窗口=抽屉，分区=控制弹窗），卡片本身不知道贴在哪；
                 菜单同理（右键 / 「更多」都开它），文案 / 图标 / 动作都由宿主给。 -->
            <DataTemplate x:Key="DeviceCardTemplate" x:DataType="m:MijiaDevice">
                <Button Classes="DevCard" Classes.on="{Binding IsOn}"
                        Command="{Binding $parent[Window].((vm:IDeviceCardHost)DataContext).OpenCardCommand}"
                        CommandParameter="{Binding}">
                    <Button.ContextMenu>
                        <!-- 外壳视觉（圆角 12 + 细描边 + 5px 内边距）直接写成本地 Template：
                             弹出层的样式应用时机不可控，本地值最稳，不依赖样式是否命中 -->
                        <ContextMenu Padding="4" MinWidth="0" FontSize="11.5"
                                     IsVisible="{Binding $parent[Window].((vm:IDeviceCardHost)DataContext).CardMenuCommand, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ContextMenu.Template>
                                <ControlTemplate>
                                    <Border Name="MenuShell" CornerRadius="12"
                                            Background="{DynamicResource MenuBgBrush}"
                                            BorderBrush="{DynamicResource MenuLineBrush}"
                                            BorderThickness="1"
                                            Padding="{TemplateBinding Padding}">
                                        <ItemsPresenter Name="PART_ItemsPresenter"/>
                                    </Border>
                                </ControlTemplate>
                            </ContextMenu.Template>
                            <!-- 第一项固定「设备详情」：与点卡片本体同一个动作（宿主 OpenCardCommand）；
                                 第二项由宿主给文案/图标/命令（主窗口=添加到桌面组件，分区=从分区移除） -->
                            <MenuItem Theme="{StaticResource CardMenuItem}"
                                      Header="设备详情"
                                      Command="{Binding $parent[Window].((vm:IDeviceCardHost)DataContext).OpenCardCommand}"
                                      CommandParameter="{Binding}">
                                <MenuItem.Icon>
                                    <Viewbox Width="12" Height="12" Stretch="Uniform"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Panel Width="24" Height="24">
                                            <Path StrokeThickness="1.92" StrokeLineCap="Round" StrokeJoin="Round"
                                                  Stroke="{Binding $parent[MenuItem].Foreground}"
                                                  Data="M21,12 A9,9 0 1,1 3,12 A9,9 0 1,1 21,12 M12,8 H12.01 M12,11.2 V16" />
                                        </Panel>
                                    </Viewbox>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Theme="{StaticResource CardMenuItem}"
                                      Header="{Binding $parent[Window].((vm:IDeviceCardHost)DataContext).CardMenuText}"
                                      Command="{Binding $parent[Window].((vm:IDeviceCardHost)DataContext).CardMenuCommand}"
                                      CommandParameter="{Binding}">
                                <MenuItem.Icon>
                                    <!-- 图标按 24 网格画好再交给 Viewbox 缩放：Path 单独用 Stretch 时按几何包围盒对齐，
                                         只有横线的「－」会算出零高度而错位，套一层正方网格才稳定 -->
                                    <Viewbox Width="12" Height="12" Stretch="Uniform"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Panel Width="24" Height="24">
                                            <Path StrokeThickness="1.92" StrokeLineCap="Round" StrokeJoin="Round"
                                                  Stroke="{Binding $parent[MenuItem].Foreground}"
                                                  Data="{Binding $parent[Window].((vm:IDeviceCardHost)DataContext).CardMenuIcon}" />
                                        </Panel>
                                    </Viewbox>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Panel>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Panel Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center">
                            <Border Classes="DevIc"
                                    IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}">
                                <Path Classes="DevIcon" Classes.on="{Binding IsOn}" Width="24" Height="24"
                                      Stretch="Uniform" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                      Data="{Binding Converter={StaticResource DeviceIcon}}" />
                            </Border>
                            <Border Classes="DevPhoto" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <!-- 缩小 10 倍用 MediumQuality（双线性+mipmap 预滤波）：
                                     HighQuality 在 Skia 是固定 4×4 核三次采样，大比例缩小时欠采样，白描边会断成锯齿点 -->
                                <Image Source="{Binding Icon}" Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="MediumQuality" />
                            </Border>
                        </Panel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0" Spacing="3">
                            <!-- 三处文字的 Foreground 一律走样式（不在元素上写本地值）：
                                 本地值优先级高于样式，写了就压过 DesktopGroupView 里的提亮覆盖 -->
                            <TextBlock Classes="DevName" Text="{Binding Name}" FontSize="13.5"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="DevMeta" Text="{Binding CardSubtitle}" FontSize="11.5"
                                           TextTrimming="CharacterEllipsis" />
                                <!-- 离线角标：仅离线设备显示，琥珀底 + 暖字，与抽屉 is-warn 同色系 -->
                                <Border CornerRadius="8" Padding="6,1.5" VerticalAlignment="Center"
                                        Background="{DynamicResource AmberSoftBrush}" IsVisible="{Binding !IsOnline}">
                                    <TextBlock Text="离线" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{DynamicResource AmberBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <!-- 右列：默认电源键垂直居中；卡片悬停时「一分为二」——
                             电源键滑到右下（样式 translate 0→10px），「更多」在上方淡入下滑浮现（负 margin 贴右上角）；
                             多路设备的「N 路」角标与电源键互斥（同一时刻只显示一个），贴右下。 -->
                        <Grid Grid.Column="2" MinWidth="32">
                            <ToggleButton Classes="Power" Classes.curtain="{Binding IsCurtain}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="0"
                                          IsVisible="{Binding ShowCardSwitch}"
                                          IsChecked="{Binding IsOn}" IsEnabled="{Binding !IsBusy}"
                                          Command="{Binding $parent[Window].((vm:IDeviceCardHost)DataContext).ToggleSwitchCommand}"
                                          CommandParameter="{Binding}" />
                            <!-- 「更多」负 margin 悬浮到卡片右上角（卡片内距 15,13）：距角约 4px/9px，
                                 保留布局槽只靠透明度浮现，不影响电源键位置 -->
                            <Button Classes="MoreBtn" ctl:MenuOpener.OpenOnClick="True"
                                    HorizontalAlignment="Center" VerticalAlignment="Top"
                                    Margin="0,-9,0,0" ToolTip.Tip="更多">
                                <!-- 三个点显式双向居中：Button 内容对齐不保证 Center，不写会偏 -->
                                <StackPanel Orientation="Horizontal" Spacing="3"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="3" Height="3"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Ellipse Width="3" Height="3"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Ellipse Width="3" Height="3"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                            <!-- 多路开关不在卡片上铺满多个开关：显示路数，进抽屉逐路操作 -->
                            <Border Classes="DevBadge" CornerRadius="8" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,-2,-4"
                                    Background="{DynamicResource SurfaceBrush}"
                                    IsVisible="{Binding ShowChannelBadge}">
                                <TextBlock Classes="DevBadgeText" FontSize="10.5" FontWeight="SemiBold"
                                           Text="{Binding Channels.Count, StringFormat='{}{0} 路'}" />
                            </Border>
                        </Grid>
                    </Grid>
                    </Panel>
                </Button>
            </DataTemplate>
            <!-- 场景迷你卡（首页条）：点卡片不执行，仅右下角播放按钮执行 -->
            <DataTemplate x:Key="SceneMiniTemplate" x:DataType="m:SceneCardItem">
                <Border CornerRadius="16" Margin="8" MinHeight="80"
                        Background="{DynamicResource CardBrush}"
                        BoxShadow="0 1 2 0 #050F172A, 0 5 16 0 #080F172A">
                    <Panel>
                        <Border CornerRadius="16" Background="{Binding GlowBrush}" IsHitTestVisible="False"/>
                        <Border Padding="12">
                            <Panel>
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <Border Width="30" Height="30" CornerRadius="10" Background="{Binding IconBgBrush}"
                                            HorizontalAlignment="Left">
                                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding IconFgBrush}"
                                              StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                              Data="{Binding Icon}" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,0"
                                               Foreground="{DynamicResource Text2Brush}" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="20" Padding="7,3"
                                        Background="{DynamicResource GreenSoftBrush}" IsVisible="{Binding IsRunning}">
                                    <TextBlock Text="运行中" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{DynamicResource GreenBrush}" />
                                </Border>
                                <Button Classes="PlayCircle" Width="30" Height="30"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RunSceneCommand}"
                                        CommandParameter="{Binding}" />
                            </Panel>
                        </Border>
                    </Panel>
                </Border>
            </DataTemplate>
        <DataTemplate x:Key="SceneBigTemplate" x:DataType="m:SceneCardItem">
            <Border CornerRadius="16" Margin="8" MinHeight="112"
                    Background="{DynamicResource CardBrush}"
                    BoxShadow="0 1 2 0 #050F172A, 0 5 16 0 #080F172A">
                <Panel>
                    <Border CornerRadius="16" Background="{Binding GlowBrush}" IsHitTestVisible="False"/>
                    <Border Padding="14">
                        <Panel>
                            <StackPanel VerticalAlignment="Top">
                                <Border Width="40" Height="40" CornerRadius="12" Background="{Binding IconBgBrush}"
                                        HorizontalAlignment="Left">
                                    <Path Width="20" Height="20" Stretch="Uniform" Stroke="{Binding IconFgBrush}"
                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                          Data="{Binding Icon}" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="20" Padding="8,4"
                                    Background="{DynamicResource GreenSoftBrush}" IsVisible="{Binding IsRunning}">
                                <TextBlock Text="运行中 ✓" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource GreenBrush}" />
                            </Border>
                            <Button Classes="PlayCircle" Width="36" Height="36"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RunSceneCommand}"
                                    CommandParameter="{Binding}" />
                        </Panel>
                    </Border>
                </Panel>
            </Border>
        </DataTemplate>
</ResourceDictionary>