<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ani="clr-namespace:Avalonia.Animation.Easings;assembly=Avalonia.Base"
    xmlns:conv="clr-namespace:MiHome.Converters"
    xmlns:ctl="clr-namespace:MiHome.Controls"
    xmlns:vm="clr-namespace:MiHome.ViewModels"
    xmlns:m="clr-namespace:MiHome.Models">
        <conv:DeviceStatusConverter x:Key="DevStatus" />
        <conv:IntEqualsConverter x:Key="IntEq" />
        <!-- 音箱媒体控制图标：上一曲 / 下一曲 / 暂停，用实心几何避免小尺寸下线条糊成一团 -->
        <PathGeometry x:Key="GeoPrevTrack">M7,6 H8.2 V18 H7 Z M18,6 L9.6,12 L18,18 Z</PathGeometry>
        <PathGeometry x:Key="GeoNextTrack">M16.8,6 H18 V18 H16.8 Z M6,6 L14.4,12 L6,18 Z</PathGeometry>
        <PathGeometry x:Key="GeoPauseIc">M9,5.5 H12.2 V18.5 H9 Z M14.8,5.5 H18 V18.5 H14.8 Z</PathGeometry>
        <!-- 发送图标：纸飞机，走描边画法，浮层里的发送按钮用 -->
        <PathGeometry x:Key="GeoSend">M22,2 L11,13 M22,2 L15,22 L11,13 L2,9 Z</PathGeometry>
        <!-- 空调模式/风速动态按钮：按设备规格的 value-list 生成，选中态由设备当前值驱动 -->
        <DataTemplate x:Key="AcModeOptionTemplate" x:DataType="m:AcOptionItem">
            <Button Classes="SegBtn" Content="{Binding Label}" Classes.is-on="{Binding IsSelected}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SetAcModeCommand}"
                    CommandParameter="{Binding Value}" />
        </DataTemplate>
        <DataTemplate x:Key="AcFanOptionTemplate" x:DataType="m:AcOptionItem">
            <Button Classes="SegBtn" Content="{Binding Label}" Classes.is-on="{Binding IsSelected}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SetAcFanCommand}"
                    CommandParameter="{Binding Value}" />
        </DataTemplate>
        <!-- 多路开关：抽屉里每一路一行，虚拟子设备同样落在这里 -->
        <DataTemplate x:Key="ChannelRowTemplate" x:DataType="m:SwitchChannelState">
            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" />
                <ToggleButton Grid.Column="1" Classes="Switch" VerticalAlignment="Center"
                              IsChecked="{Binding IsOn, Mode=TwoWay}"
                              IsEnabled="{Binding !IsBusy}"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleChannelCommand}"
                              CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>
        <!-- 通用规格面板：枚举型属性用与空调一致的分段按钮 -->
        <DataTemplate x:Key="SpecChoiceTemplate" x:DataType="vm:SpecOptionVm">
            <Button Classes="SegBtn" Content="{Binding Label}" Classes.is-on="{Binding IsSelected}"
                    MinWidth="52" Margin="2,2,0,2"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SetSpecChoiceCommand}"
                    CommandParameter="{Binding}" />
        </DataTemplate>
        <DataTemplate x:Key="SpecPropTemplate" x:DataType="vm:SpecPropVm">
            <StackPanel Spacing="7" Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="12.5"
                               VerticalAlignment="Center" IsVisible="{Binding IsValue}"
                               Foreground="{DynamicResource Text3Brush}" />
                    <TextBlock Grid.Column="1" Text="{Binding SliderText}" FontSize="12.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="{Binding IsSlider}"
                               Foreground="{DynamicResource Accent2Brush}" />
                    <ToggleButton Grid.Column="1" Classes="Switch" VerticalAlignment="Center"
                                  IsVisible="{Binding IsToggle}"
                                  IsChecked="{Binding IsOn, Mode=TwoWay}"
                                  IsEnabled="{Binding !IsBusy}"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleSpecCommand}"
                                  CommandParameter="{Binding}" />
                    <!-- 选项过多：下拉与标题同一行，复用设置里的 OptionPicker -->
                    <ctl:OptionPicker Grid.Column="1" VerticalAlignment="Center"
                                      IsVisible="{Binding IsLargeChoice}"
                                      Options="{Binding Options}"
                                      SelectedValue="{Binding PickedValue, Mode=TwoWay}" />
                </Grid>
                <Slider Classes="DrSlider" IsVisible="{Binding IsSlider}"
                        Minimum="{Binding Min}" Maximum="{Binding Max}"
                        SmallChange="{Binding Step}" TickFrequency="{Binding Step}"
                        Value="{Binding Number, Mode=TwoWay}"
                        IsEnabled="{Binding Device.IsOnline}" />
                <!-- 轨道收成内容宽度，选项不满一行时右侧不再拖出一条空底色 -->
                <Border Classes="SegTrack" IsVisible="{Binding IsCompactChoice}" HorizontalAlignment="Left">
                    <ItemsControl ItemsSource="{Binding Options}" ItemTemplate="{StaticResource SpecChoiceTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </DataTemplate>
        <!-- 高级设置分区：服务标题下一条淡分割线，只在分区之间画，不再逐行铺线 -->
        <DataTemplate x:Key="SpecGroupTemplate" x:DataType="vm:SpecGroupVm">
            <Border Classes="DrCard">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding Title}" FontSize="12.5"
                               Foreground="{DynamicResource Text2Brush}" />
                    <Border Height="1" Background="{DynamicResource LineBrush}" Opacity="0.5" />
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SpecPropTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- 规格动作：无入参动作先点一次进入确认态，再点一次才下发 -->
        <DataTemplate x:Key="SpecActionTemplate" x:DataType="vm:SpecActionVm">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Title}" />
                <Button Grid.Column="1" Classes="BtnGhost" Classes.confirming="{Binding IsConfirming}"
                        Height="28" Padding="12,0" FontSize="12"
                        Content="{Binding ButtonText}"
                        IsEnabled="{Binding !IsBusy}"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RunSpecActionCommand}"
                        CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>
</ResourceDictionary>