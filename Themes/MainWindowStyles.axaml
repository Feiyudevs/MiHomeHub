<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ani="clr-namespace:Avalonia.Animation.Easings;assembly=Avalonia.Base"
    xmlns:conv="clr-namespace:MiHomeHub.Converters"
    xmlns:ctl="clr-namespace:MiHomeHub.Controls"
    xmlns:vm="clr-namespace:MiHomeHub.ViewModels"
    xmlns:m="clr-namespace:MiHomeHub.Models">
        <!-- 刷新图标跟随 BtnGhost 悬停加深，与旁侧文字按钮状态一致 -->
        <Style Selector="Button.BtnGhost:pointerover Path.RefreshIc">
            <Setter Property="Stroke" Value="{DynamicResource TextBrush}"/>
        </Style>
        <!-- 标题栏副标签：淡琥珀底 + 低饱和暖字，不抢主标题 -->
        <Style Selector="Border.TbTag">
            <Setter Property="Background" Value="{DynamicResource AmberSoftBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.TbTag > TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource AmberTextBrush}" />
        </Style>
        <!-- 标题栏账户：胶囊容器包住「家庭名 + 登录」，与右侧工具按钮同高 -->
        <Style Selector="Border.AccountGroup">
            <Setter Property="Height" Value="32" />
            <!-- 底色与「小爱同学 / 音乐」两个胶囊同一档（SearchBgBrush），三个入口在标题栏里看起来是一组 -->
            <Setter Property="Background" Value="{DynamicResource SearchBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 清掉 Flyout/Popup 默认底与投影，圆角画在 Presenter 上，避免叠出直角外框 -->
        <Style Selector="PopupRoot">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="FlyoutPresenter /template/ Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Button.AccountChip">
            <Setter Property="Cursor" Value="Hand" />
            <!-- 静息底用「悬停色 + 零透明」，悬停只淡入这一层色，不会先闪一层灰 -->
            <Setter Property="Background" Value="{DynamicResource PlayHoverFromBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- 撑满胶囊内高（32 − 2×1px 边框），悬停底色才不会上下悬空；左右留 14 让家庭名不贴胶囊边 -->
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bg" CornerRadius="15" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.AccountChip:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <!-- 家庭浮层展开中：胶囊保持悬停底色，和另两个胶囊的 .open 观感一致 -->
        <Style Selector="Button.AccountChip.open /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <!-- 胶囊里的「登录」：不铺底色，只用强调色文字 -->
        <Style Selector="Button.AccountLogin">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource PlayHoverFromBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bg" CornerRadius="15" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.AccountLogin:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <!-- 标题栏搜索：32px 圆形按钮，点击后同一元素就地长成输入框 -->
        <Style Selector="Border.SearchBox">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource SearchBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SearchLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.26" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.SearchBox.open">
            <Setter Property="Width" Value="252" />
            <Setter Property="Cursor" Value="Ibeam" />
        </Style>
        <Style Selector="Border.SearchBox Path">
            <Setter Property="Stroke" Value="{DynamicResource Text2Brush}" />
        </Style>
        <Style Selector="Border.SearchBox:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
        </Style>
        <!-- 胶囊内输入框：去掉 Fluent 自身底与描边，只留文字与光标 -->
        <Style Selector="TextBox.SearchInline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0,10,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.SearchInline /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- 搜索框右端的清空钮：18px 圆点，默认透明，悬停才浮出底 -->
        <Style Selector="Button.SearchClear">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Background" Value="{DynamicResource PlayHoverFromBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.SearchClear:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <!-- 下拉菜单项：圆角胶囊底 + 右侧绿勾，整行拉满浮层宽度（含空白处都可命中） -->
        <Style Selector="Button.HomeMenuItem">
            <Setter Property="Background" Value="{DynamicResource PlayHoverFromBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="9"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            Margin="{TemplateBinding Margin}">
                        <Grid ColumnDefinitions="*,Auto">
                            <ContentPresenter Name="Cp"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                            <Border Name="Check" Grid.Column="1" Width="18" Height="18"
                                    CornerRadius="9" VerticalAlignment="Center" Margin="10,0,0,0"
                                    Background="{DynamicResource GreenBrush}" IsVisible="False">
                                <!-- 勾的宽高按几何比例 16:11 给足（10 × 6.875），Uniform 缩放后没有纵向
                                     留白，才不会出现勾整体偏上、不在圆心的错觉 -->
                                <Path Width="10" Height="6.875" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      Data="M4 12 L9 17 L20 6" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.HomeMenuItem:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="Button.HomeMenuItem.is-on /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="Button.HomeMenuItem.is-on:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="Button.HomeMenuItem.is-on /template/ Border#Check">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Button.HomeMenuItem.is-on ContentPresenter#Cp TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <!-- 抽屉分段选择：胶囊轨道 + 每段独立胶囊，段与段之间留缝（横向 6、纵向 6），
             不再让悬停/选中的色块彼此贴边连成一片 -->
        <Style Selector="Border.SegTrack">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style Selector="Button.SegBtn">
            <!-- 24 + 上下外边距 3×2 = 30，单排轨道总高仍是 36（老高度不变）；
                 两排（风速 9 档那种）行与行之间也自动空出 6 -->
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <!-- 静息底是「悬停淡紫、透明位为 0」：悬停只把这层淡紫淡进来，
                 既看得清，又不会像选中态那样变成实心紫；也避免从黑透明插值闪灰 -->
            <Setter Property="Background" Value="{DynamicResource AccentSoft2FromBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- 关掉焦点框，避免点击瞬间闪一下 -->
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="Cp" Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}"
                                          TextBlock.FontWeight="{TemplateBinding FontWeight}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <!-- 只淡背景；文字换色不做过渡，移上去直接换 -->
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <!-- 悬停：未选中淡灰；按下保持选中色或轻微加深，避免 Fluent 默认 pressed 白闪 -->
        <Style Selector="Button.SegBtn:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentSoft2Brush}" />
        </Style>
        <Style Selector="Button.SegBtn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="Button.SegBtn:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}" />
        </Style>
        <Style Selector="Button.SegBtn.is-on">
            <Setter Property="Background" Value="{DynamicResource PrimaryBtnBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.SegBtn.is-on:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource PrimaryBtnBrush}" />
        </Style>
        <Style Selector="Button.SegBtn.is-on:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource PrimaryBtnBrush}" />
        </Style>
        <!-- 温度步进钮：Path 画 +/−，几何中心即按钮中心，不受字体基线影响 -->
        <Style Selector="Button.SegMini">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource AccentSoft2FromBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.SegMini:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentSoft2Brush}" />
        </Style>
        <Style Selector="Button.SegMini:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource Accent2Brush}" />
        </Style>
        <Style Selector="Button.SegMini:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentSoft2Brush}" />
        </Style>
        <!-- 详情顶部读数卡：既是读数，也是「是否显示在主页设备卡」的开关，
             所以要整卡可点 —— 做成 Button，卡面（底色/圆角/投影）画在模板里的 Border。
             选中不改底色（整排跳色太重），只在顶部拉一条强调线 + 点亮右上角小房子。 -->
        <Style Selector="Button.MetricTile">
            <Setter Property="Width" Value="104" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <!-- 一圈淡描边：深色底上把卡从背景里轻轻托起来，浅色底也不会凭空冒边 -->
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BoxShadow="{DynamicResource CardShadow}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <!-- 已在主页显示：顶部一条细强调线，左右各留 14 让开圆角 -->
                        <Border Name="Accent" Height="2" Margin="14,0" VerticalAlignment="Top"
                                CornerRadius="1" IsVisible="False"
                                Background="{DynamicResource AccentBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.MetricTile:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="Button.MetricTile:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}" />
        </Style>
        <Style Selector="Button.MetricTile.is-on /template/ Border#Accent">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Button.MetricTile.is-on Path">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Stroke" Value="{DynamicResource Accent2Brush}" />
        </Style>
        <Style Selector="Button.MetricTile:pointerover Path">
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Stroke" Value="{DynamicResource Accent2Brush}" />
        </Style>
        <!-- 抽屉控制卡：浅灰托盘上的白色浮卡，一个控制区域一张卡（与主内容区 DevCard 同一投影语言） -->
        <Style Selector="Border.DrCard">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16,15" />
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
        </Style>
        <!-- 卡中卡（高级设置里的规格分组）：外层 DrCard 用的 CardBrush 带 82% 透明度，
             内层若沿用同一个键，两层同色叠加会互相抵消，整片糊成一张卡。
             这里换成次级面色（比外层浅/深一档）分出层次；不描边、不叠投影，
             卡与卡之间靠外层 StackPanel 的 Spacing 留白，边界交给色阶。
             SubCardBrush 只提亮 3.5%（原来 6%），内层只作「这里是一组」的提示，不跟外层卡争层次。 -->
        <Style Selector="Border.DrSubCard">
            <Setter Property="Background" Value="{DynamicResource SubCardBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,11" />
        </Style>
        <!-- 详情卡片折叠标题行（智能场景 / 高级设置共用）：
             文字靠左、箭头靠右。BtnGhost 的模板把内容钉在 Center，直接复用会整行居中，所以单开一套 -->
        <Style Selector="Button.SectionHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- 根 Border 铺满按钮（Transparent 也参与命中测试），
                         否则只有文字那一小段能点，卡片空白处点不开 -->
                    <Border Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="4">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- 智能场景行：整行可点开已有场景详情弹窗；行内嵌着「仅本机 / 执行」两个小按钮，
             内层按钮先处理点击，不会把外层详情一起带起来（与场景页整卡可点同一套做法） -->
        <Style Selector="Button.SmartSceneRow">
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.SmartSceneRow:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}" />
        </Style>
        <Style Selector="Button.SmartSceneRow:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}" />
        </Style>
        <!-- 动作二次确认态：柔主色底 + 主色文字，跟普通幽灵按钮拉开 -->
        <Style Selector="Button.BtnGhost.confirming /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="Button.BtnGhost.confirming /template/ ContentPresenter#Cp">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.BtnGhost.confirming:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <!-- 点击遮罩关闭抽屉 -->
        <Style Selector="Border.Mask">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <!-- 滑杆样式（Slider.DrSlider）已上移到 Themes/ControlStyles.axaml：
             抽屉、外观窗、桌面分区的音量浮层都是不同 Window，共用一份才不会漂出两种滑杆。 -->
        <Style Selector="TextBlock.RbNum">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="TextBlock.RbLab">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <!-- 设置页信息行 -->
        <Style Selector="Border.SetIc">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <!-- 图标交给 Viewbox 缩放：Path 单用 Stretch 时按几何包围盒贴框左上角，
             锁定/音箱这类非正方形几何会整体偏左上，20px 的 Viewbox 化后天然居中 -->
        <Style Selector="Border.SetIc Viewbox">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.SetIc Path">
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <!-- 环境概览胶囊：默认浅底、可点开明细，悬停/按下逐档加深；耗材不足时转琥珀色 -->
        <Style Selector="Button.EnvPill">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="11"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.14" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.EnvPill:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}" />
        </Style>
        <Style Selector="Button.EnvPill:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}" />
        </Style>
        <!-- 三枚胶囊按指标分色：温度暖橙、湿度天蓝、耗材正常绿；悬停/按下各自加深一档。
             底色与文字都走 Pill* 专用画笔，浅色主题在那里单独收淡，不牵动通用软底 -->
        <Style Selector="Button.EnvPill.PillTemp">
            <Setter Property="Background" Value="{DynamicResource PillTempBgBrush}" />
        </Style>
        <Style Selector="Button.EnvPill.PillTemp:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource PillTempBgHoverBrush}" />
        </Style>
        <Style Selector="Button.EnvPill.PillTemp:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource PillTempBgHoverBrush}" />
        </Style>
        <Style Selector="Button.EnvPill.PillHum">
            <Setter Property="Background" Value="{DynamicResource PillHumBgBrush}" />
        </Style>
        <Style Selector="Button.EnvPill.PillHum:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource PillHumBgHoverBrush}" />
        </Style>
        <Style Selector="Button.EnvPill.PillHum:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource PillHumBgHoverBrush}" />
        </Style>
        <Style Selector="Button.EnvPill.PillCons">
            <Setter Property="Background" Value="{DynamicResource PillConsBgBrush}" />
        </Style>
        <Style Selector="Button.EnvPill.PillCons:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource PillConsBgHoverBrush}" />
        </Style>
        <Style Selector="Button.EnvPill.PillCons:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource PillConsBgHoverBrush}" />
        </Style>
        <Style Selector="Button.EnvPill.is-warn">
            <Setter Property="Background" Value="{DynamicResource PillWarnBgBrush}" />
        </Style>
        <Style Selector="Button.EnvPill.is-warn:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource PillWarnBgHoverBrush}" />
        </Style>
        <Style Selector="Button.EnvPill.is-warn:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource PillWarnBgHoverBrush}" />
        </Style>
        <!-- 统计卡：可点开对应设备弹窗。静息外观在所有统计卡上逐值一致
             （圆角 16 / 内距 16,13 / 最小宽 96 / 拟物渐变底 + 极淡描边），差别只在悬停反馈。
             不投影：投影在深色面板上几乎看不见，在浅色面板上反而沿轮廓勾出一圈暗边，
             立体感交给卡面渐变与那圈淡描边。
             MinWidth、内距都写在模板内的 Border 上：Button 自身的 MinWidth 会算上默认内距，宽度对不齐其余卡片。 -->
        <Style Selector="Button.StatCard">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="RenderTransform" Value="translate(0px,0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18">
                        <TransformOperationsTransition.Easing>
                            <ani:CubicEaseOut />
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Card" CornerRadius="16" Padding="16,13" MinWidth="96"
                            Background="{DynamicResource StatCardBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource StatCardLineBrush}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- 悬停：抬起 2px + 描边提亮一档 + 右上角箭头浮现；按下回落到 1px 并微缩，给出即时点击反馈 -->
        <Style Selector="Button.StatCard /template/ Border#Card">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.StatCard:pointerover /template/ Border#Card">
            <Setter Property="BorderBrush" Value="{DynamicResource StatCardLineHoverBrush}" />
        </Style>
        <Style Selector="Button.StatCard:pointerover">
            <Setter Property="RenderTransform" Value="translate(0px,-2px)" />
        </Style>
        <Style Selector="Button.StatCard:pressed">
            <Setter Property="RenderTransform" Value="translate(0px,-1px) scale(0.99)" />
        </Style>
        <Style Selector="Viewbox.StatGo">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <!-- 负 margin 把箭头悬浮到卡片内距区：不占内容布局槽，也就不会把卡片撑宽、破坏四张卡对齐 -->
            <Setter Property="Margin" Value="0,-6,-9,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.StatCard:pointerover Viewbox.StatGo">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- 卡片图标：几何按 24 网格画好交给 Viewbox 缩放（11/24 的缩比下描边要回补，1.9 落屏约 1.5px） -->
        <Style Selector="Viewbox.StatIc">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Path.StatIc">
            <Setter Property="StrokeThickness" Value="1.9" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="Path.StatGoIc">
            <Setter Property="StrokeThickness" Value="2.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <!-- 首页环境趋势卡：与统计卡同档圆角/卡色/投影，内距更宽给曲线让位；不可点，所以没有悬停反馈 -->
        <!-- 趋势卡：内衬上下各收 2，卡整体矮一档，和其他卡片排在一起不再显得发胀 -->
        <Style Selector="Border.TrendCard">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
            <Setter Property="Padding" Value="16,12,16,10" />
        </Style>
        <!-- 「较昨日」小胶囊：浅底、字不抢主读数 -->
        <Style Selector="Border.TrendChip">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 预览标记：琥珀底的小胶囊，提示当前是演示数据而不是真读数 -->
        <Style Selector="Border.TrendBadge">
            <Setter Property="Background" Value="{DynamicResource AmberSoftBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.TrendLab">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.TrendValue">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="-0.8" />
        </Style>
        <Style Selector="TextBlock.TrendUnit">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="Margin" Value="2,0,0,3" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <!-- 右侧那句舒适度：只做解释，往右贴到底，不跟大数字抢位 -->
        <Style Selector="TextBlock.TrendNote">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.TrendFoot">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
        </Style>
        <Style Selector="TextBlock.TrendFootVal">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        </Style>
        <!-- 曲线还没成形时顶替曲线的一行说明：淡字、贴左居中，不假装是一张图 -->
        <Style Selector="TextBlock.TrendStub">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="260" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 离线数量：颜色只走样式，元素上写本地 Foreground 会压过 is-warn 覆盖 -->
        <Style Selector="TextBlock.OfflineTag">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
        </Style>
        <Style Selector="TextBlock.OfflineTag.is-warn">
            <Setter Property="Foreground" Value="{DynamicResource AmberTextBrush}" />
        </Style>
        <Style Selector="TextBlock.EnvLab">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.EnvLab.LabTemp">
            <Setter Property="Foreground" Value="{DynamicResource PillTempInkBrush}" />
        </Style>
        <Style Selector="TextBlock.EnvLab.LabHum">
            <Setter Property="Foreground" Value="{DynamicResource PillHumInkBrush}" />
        </Style>
        <Style Selector="TextBlock.EnvVal">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource EnvValBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.EnvVal.ValTemp">
            <Setter Property="Foreground" Value="{DynamicResource PillTempInkBrush}" />
        </Style>
        <Style Selector="TextBlock.EnvVal.ValHum">
            <Setter Property="Foreground" Value="{DynamicResource PillHumInkBrush}" />
        </Style>
        <Style Selector="TextBlock.EnvVal.ValCons">
            <Setter Property="Foreground" Value="{DynamicResource PillConsInkBrush}" />
        </Style>
        <Style Selector="TextBlock.EnvVal.is-warn">
            <Setter Property="Foreground" Value="{DynamicResource AmberTextBrush}" />
        </Style>
        <Style Selector="TextBlock.ConsumeVal">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.ConsumeVal.is-low">
            <Setter Property="Foreground" Value="{DynamicResource AmberTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- 小爱语音 / 音乐：标题栏两个音箱入口，共用一套中性玻璃胶囊（底同搜索圆钮，描边走 Line → LineStrong → 主色三档）；
             主色只留给图标与「悬停 / 展开」态，不再整块铺紫，与家庭胶囊同高 32 -->
        <Style Selector="Button.XiaoAiCapsule, Button.MusicCapsule">
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource SearchBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- 接管模板内层：补 0.16s 变色过渡，同时吃掉 Fluent 自带的硬切灰底 -->
        <Style Selector="Button.XiaoAiCapsule /template/ ContentPresenter#PART_ContentPresenter, Button.MusicCapsule /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <!-- 正在播放：文字走主色 + 描边提亮一档，比「展开」的主色环轻一档（放在悬停/展开之前，让位给它们） -->
        <Style Selector="Button.MusicCapsule.playing">
            <Setter Property="Foreground" Value="{DynamicResource Accent2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        </Style>
        <!-- 悬停：文字并同图标走主色、描边再亮一档，底色只换成通用悬停灰，不加深紫色 -->
        <Style Selector="Button.XiaoAiCapsule:pointerover, Button.MusicCapsule:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Accent2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        </Style>
        <Style Selector="Button.XiaoAiCapsule:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.MusicCapsule:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="Button.XiaoAiCapsule:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.MusicCapsule:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <!-- 展开：只加一道主色细环表示「浮层归我」，底色仍是中性 -->
        <Style Selector="Button.XiaoAiCapsule.open, Button.MusicCapsule.open">
            <Setter Property="Foreground" Value="{DynamicResource Accent2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent2Brush}" />
        </Style>
        <!-- 发送中：纸飞机图标呼吸闪烁，只在 IsVoiceSending 时挂动画 -->
        <Style Selector="Path.SendIcon">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Path.SendIcon.run">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button.XiaoAiCapsule.open">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent2Brush}" />
        </Style>
        <Style Selector="Border.VoicePanel">
            <Setter Property="Background" Value="{DynamicResource CardSolidBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 12 28 0 #2A0F172A" />
        </Style>
        <!-- 家庭浮层与语音 / 音乐浮层同一壳：同宽、同圆角、同内距、同投影 -->
        <Style Selector="Border.HomePanel">
            <Setter Property="Background" Value="{DynamicResource CardSolidBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 12 28 0 #2A0F172A" />
        </Style>
        <Style Selector="TextBox.VoiceInput">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Card2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <!-- hover / 聚焦都不加深：统一保持细线描边与浅底，去掉默认的紫色粗焦点框 -->
        <Style Selector="TextBox.VoiceInput:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource Card2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.VoiceInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource Card2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.VoiceInput:focus:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource Card2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.VoiceFeed">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="TextBlock.VoiceHint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.VoiceHint.is-warn">
            <Setter Property="Foreground" Value="{DynamicResource AmberTextBrush}" />
        </Style>
        <!-- 音乐：胶囊规格与状态全部复用上面的共用样式；正在播放时名称就地换成三个控制钮 -->
        <!-- 胶囊内联控制钮：内层按钮自己吃掉按下事件，不会顺带开合浮层；
             忙态不绑 IsEnabled（命令里已挡），否则每次下发瞬间整排键会禁用又放开，看着像闪白 -->
        <Style Selector="Button.CapBtn">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Accent2Brush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="13" Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.CapBtn:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}" />
        </Style>
        <Style Selector="Button.CapBtn:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Surface4Brush}" />
        </Style>
        <Style Selector="Border.MusicPanel">
            <Setter Property="Background" Value="{DynamicResource CardSolidBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 12 28 0 #2A0F172A" />
        </Style>
        <!-- 浮层里的播放键：主键是这块唯一的强色块，两侧键让位给它 -->
        <Style Selector="Button.MusicPlay">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBtnBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="18" Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.MusicPlay:pointerover">
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.MusicPlay:pressed">
            <Setter Property="Opacity" Value="0.78" />
        </Style>
        <Style Selector="Button.MusicStep">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PlayHoverFromBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="11" Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.MusicStep:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="Button.MusicStep:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}" />
        </Style>
        <!-- 环境明细弹窗：温湿度大读数 + 耗材进度条 -->
        <Style Selector="Border.EnvTile">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <!-- 温湿度两块各走一套色调：温度暖（琥珀），湿度冷（蓝）。
             底色用同色系低浓度渐变，深浅随主题自适应（半透明叠在卡片底上） -->
        <Style Selector="Border.EnvTile.warm">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#3AFFC868" Offset="0" />
                    <GradientStop Color="#12FFC868" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.EnvTile.cool">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#3A4D8DFF" Offset="0" />
                    <GradientStop Color="#124D8DFF" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="TextBlock.EnvTileLab">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 标签跟着卡片色调走，不再是一片中性灰 -->
        <Style Selector="TextBlock.EnvTileLab.warm">
            <Setter Property="Foreground" Value="{DynamicResource AmberTextBrush}" />
        </Style>
        <Style Selector="TextBlock.EnvTileLab.cool">
            <Setter Property="Foreground" Value="{DynamicResource StatBlueBrush}" />
        </Style>
        <Style Selector="TextBlock.EnvTileVal">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="TextBlock.EnvTileVal.warm">
            <Setter Property="Foreground" Value="{DynamicResource AmberTextBrush}" />
        </Style>
        <Style Selector="TextBlock.EnvTileVal.cool">
            <Setter Property="Foreground" Value="{DynamicResource StatBlueBrush}" />
        </Style>
        <!-- 单位跟在数值后面，比数值小两档并压到底线，避免整串等大显得笨重 -->
        <Style Selector="TextBlock.EnvTileUnit">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- 房间小标签：浅底胶囊，只做定位提示，不抢设备名 -->
        <Style Selector="Border.RoomTag">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.RoomTagTx">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
        </Style>
        <!-- 耗材状态徽标：正常走绿，余量偏低转琥珀 -->
        <Style Selector="Border.EnvStatusTag">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="{DynamicResource GreenSoftBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.EnvStatusTag.is-warn">
            <Setter Property="Background" Value="{DynamicResource AmberSoftBrush}" />
        </Style>
        <Style Selector="TextBlock.EnvStatusTx">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
        </Style>
        <Style Selector="TextBlock.EnvStatusTx.is-warn">
            <Setter Property="Foreground" Value="{DynamicResource AmberTextBrush}" />
        </Style>
        <Style Selector="ProgressBar.EnvBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent2Brush}" />
        </Style>
        <Style Selector="ProgressBar.EnvBar.is-low">
            <Setter Property="Foreground" Value="{DynamicResource AmberBrush}" />
        </Style>
        <!-- 耗材余量行内排版：进度条缩成一小段，和「设备名 + 余量类型」挤在同一行，右侧只留百分比列。
             轨道与填充是两个圆角 Border（宽度按百分比由模型算出），不用 ProgressBar 模板，圆角才稳 -->
        <Style Selector="Border.EnvBarFill">
            <Setter Property="Background" Value="{DynamicResource Accent2Brush}" />
        </Style>
        <Style Selector="Border.EnvBarFill.is-low">
            <Setter Property="Background" Value="{DynamicResource AmberBrush}" />
        </Style>
        <!-- 耗材数值：常规字重、右对齐成列，余量偏低时只换色不加粗 -->
        <Style Selector="TextBlock.ConsumeValSoft">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.ConsumeValSoft.is-low">
            <Setter Property="Foreground" Value="{DynamicResource AmberTextBrush}" />
        </Style>
        <!-- 标题栏更新提示：与账户胶囊 / 搜索同高 32，柔主色底 + 细描边，只做「有新版」的轻提示，不抢内容 -->
        <Style Selector="Border.UpdateBanner">
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0,3,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.UpdateBannerText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 「查看详情」：只给强调色文字，悬停浮一层浅底，够得上但不如主按钮抢眼 -->
        <Style Selector="Button.UpdateBannerLink">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PlayHoverFromBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Accent2Brush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="13" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.UpdateBannerLink:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="Button.UpdateBannerLink:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Surface5Brush}" />
        </Style>
        <!-- X：24px 圆点，默认透明，悬停才浮底并提亮描边，窄条里不显笨重 -->
        <Style Selector="Button.UpdateBannerClose">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PlayHoverFromBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="12" Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.UpdateBannerClose:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="Button.UpdateBannerClose:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
        </Style>

        <!-- ======== 悬停过渡补遗 ========
             主窗口这些按钮的底 / 描边都画在自绘模板的具名 Border 上，全局兜底那条
             （Button 的 ContentPresenter）罩不到，这里逐类补一条 0.16s 的颜色淡变。 -->
        <Style Selector="Button.AccountChip /template/ Border#Bg,
                        Button.AccountLogin /template/ Border#Bg,
                        Button.SearchClear /template/ Border#Bd,
                        Button.HomeMenuItem /template/ Border#Bd,
                        Button.SegBtn /template/ Border#Bd,
                        Button.SegMini /template/ Border#Bd,
                        Button.MetricTile /template/ Border#Bd,
                        Button.SmartSceneRow /template/ Border#Bd,
                        Button.CapBtn /template/ Border#Bd,
                        Button.MusicStep /template/ Border#Bd,
                        Button.UpdateBannerLink /template/ Border#Bd,
                        Button.UpdateBannerClose /template/ Border#Bd">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <!-- 两个标题栏胶囊的悬停会换描边色，描边在控件自己身上，不能只靠模板内那条过渡 -->
        <Style Selector="Button.XiaoAiCapsule, Button.MusicCapsule">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
</Styles>