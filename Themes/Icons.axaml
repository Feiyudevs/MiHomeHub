<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ani="clr-namespace:Avalonia.Animation.Easings;assembly=Avalonia.Base"
    xmlns:conv="clr-namespace:MiHome.Converters"
    xmlns:ctl="clr-namespace:MiHome.Controls"
    xmlns:vm="clr-namespace:MiHome.ViewModels"
    xmlns:m="clr-namespace:MiHome.Models">
            <!-- ======== 图标几何（24 网格线性图标） ======== -->
            <PathGeometry x:Key="GeoHome">M3,10.5 L12,3 L21,10.5 M5.5,9.5 L5.5,20 L18.5,20 L18.5,9.5 M9.5,20 L9.5,14 L14.5,14 L14.5,20</PathGeometry>
            <PathGeometry x:Key="GeoRooms">M3,21 L3,8 L12,3 L21,8 L21,21 M9,21 L9,13 L15,13 L15,21</PathGeometry>
            <!-- 灯泡：与 DeviceIconConverter 里设备卡的 light 几何一致（整圆用两段半弧拼），两处同形才不会出现「卡片图标与统计卡图标不是一个灯」 -->
            <PathGeometry x:Key="GeoLight">M7.8,9.6 A4.2,4.2 0 0 1 16.2,9.6 A4.2,4.2 0 0 1 7.8,9.6 Z M9.9,15.2 H14.1 M10.8,17.6 H13.2</PathGeometry>
            <!-- 窗帘 / 空调：与 DeviceIconConverter 里设备卡同形，统计卡图标与卡片图标必须一个模子 -->
            <PathGeometry x:Key="GeoCurtain">M3.5,6 H20.5 M7,6 V17.5 M17,6 V17.5 M3.5,20 H20.5</PathGeometry>
            <PathGeometry x:Key="GeoAirCon">M4,5 H20 V11.5 H4 Z M7.5,15.5 H13.5 M10.5,19 H16.5</PathGeometry>
            <PathGeometry x:Key="GeoGrid">M6,3.5 H9 Q11.5,3.5 11.5,6 V9 Q11.5,11.5 9,11.5 H6 Q3.5,11.5 3.5,9 V6 Q3.5,3.5 6,3.5 Z M15,3.5 H18 Q20.5,3.5 20.5,6 V9 Q20.5,11.5 18,11.5 H15 Q12.5,11.5 12.5,9 V6 Q12.5,3.5 15,3.5 Z M6,12.5 H9 Q11.5,12.5 11.5,15 V18 Q11.5,20.5 9,20.5 H6 Q3.5,20.5 3.5,18 V15 Q3.5,12.5 6,12.5 Z M15,12.5 H18 Q20.5,12.5 20.5,15 V18 Q20.5,20.5 18,20.5 H15 Q12.5,20.5 12.5,18 V15 Q12.5,12.5 15,12.5 Z</PathGeometry>
            <PathGeometry x:Key="GeoScene">M9,5.5 L10.8,11.2 L16.5,13 L10.8,14.8 L9,20.5 L7.2,14.8 L1.5,13 L7.2,11.2 Z M18,2.3 L18.9,4.6 L21.2,5.5 L18.9,6.4 L18,8.7 L17.1,6.4 L14.8,5.5 L17.1,4.6 Z</PathGeometry>
            <PathGeometry x:Key="GeoCog">M19.4,15 a1.65,1.65 0 0 0 .33,1.82 l.06,.06 a2,2 0 0 1 0,2.83 2,2 0 0 1 -2.83,0 l-.06,-.06 a1.65,1.65 0 0 0 -1.82,-.33 1.65,1.65 0 0 0 -1,1.51 V21 a2,2 0 0 1 -2,2 2,2 0 0 1 -2,-2 v-.09 A1.65,1.65 0 0 0 9,19.4 a1.65,1.65 0 0 0 -1.82,.33 l-.06,.06 a2,2 0 0 1 -2.83,0 2,2 0 0 1 0,-2.83 l.06,-.06 a1.65,1.65 0 0 0 .33,-1.82 1.65,1.65 0 0 0 -1.51,-1 H3 a2,2 0 0 1 -2,-2 2,2 0 0 1 2,-2 h.09 A1.65,1.65 0 0 0 4.6,9 a1.65,1.65 0 0 0 -.33,-1.82 l-.06,-.06 a2,2 0 0 1 0,-2.83 2,2 0 0 1 2.83,0 l.06,.06 a1.65,1.65 0 0 0 1.82,.33 H9 a1.65,1.65 0 0 0 1,-1.51 V3 a2,2 0 0 1 2,-2 2,2 0 0 1 2,2 v.09 a1.65,1.65 0 0 0 1,1.51 1.65,1.65 0 0 0 1.82,-.33 l.06,-.06 a2,2 0 0 1 2.83,0 2,2 0 0 1 0,2.83 l-.06,.06 a1.65,1.65 0 0 0 -.33,1.82 V9 a1.65,1.65 0 0 0 1.51,1 H21 a2,2 0 0 1 2,2 2,2 0 0 1 -2,2 h-.09 a1.65,1.65 0 0 0 -1.51,1 Z M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9 Z</PathGeometry>
            <PathGeometry x:Key="GeoGear">M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9 Z M12,2.5 L12,4.5 M12,19.5 L12,21.5 M4.6,4.6 L6,6 M18,18 L19.4,19.4 M2.5,12 L4.5,12 M19.5,12 L21.5,12 M4.6,19.4 L6,18 M18,6 L19.4,4.6</PathGeometry>
            <PathGeometry x:Key="GeoSearch">M11,11 M11,11 m-7,0 a7,7 0 1 0 14,0 a7,7 0 1 0 -14,0 M16.5,16.5 L20,20</PathGeometry>
            <PathGeometry x:Key="GeoMoon">M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z</PathGeometry>
            <PathGeometry x:Key="GeoSun">M12 2v2 M12 20v2 M4.93 4.93l1.41 1.41 M17.66 17.66l1.41 1.41 M2 12h2 M20 12h2 M6.34 17.66l-1.41 1.41 M19.07 4.93l-1.41 1.41 M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z</PathGeometry>
            <PathGeometry x:Key="GeoMin">M4,12 L20,12</PathGeometry>
            <PathGeometry x:Key="GeoMax">M6,3 H18 Q21,3 21,6 V18 Q21,21 18,21 H6 Q3,21 3,18 V6 Q3,3 6,3 Z</PathGeometry>
            <PathGeometry x:Key="GeoClose">M3,3 L21,21 M21,3 L3,21</PathGeometry>
            <PathGeometry x:Key="GeoPower">M12,3 L12,11 M6.7,6.7 A7.5,7.5 0 1 0 17.3,6.7</PathGeometry>
            <PathGeometry x:Key="GeoTray">M4,4 H20 V15 H4 Z M12,7.5 L12,12 M9.5,9.5 L12,12 L14.5,9.5</PathGeometry>
            <PathGeometry x:Key="GeoBolt">M13,2 L4,14 L11,14 L10,22 L19,10 L12,10 Z</PathGeometry>
            <PathGeometry x:Key="GeoWifi">M5,12.5 A7,7 0 0 1 19,12.5 M8.5,15.5 A3.5,3.5 0 0 1 15.5,15.5 M12,18.5 m-1.2,0 a1.2,1.2 0 1 0 2.4,0 a1.2,1.2 0 1 0 -2.4,0</PathGeometry>
            <PathGeometry x:Key="GeoClock">M12,12 m-9,0 a9,9 0 1 0 18,0 a9,9 0 1 0 -18,0 M12,7 L12,12 L15,14</PathGeometry>
            <PathGeometry x:Key="GeoArrow">M9,5 L16,12 L9,19</PathGeometry>
            <!-- ======== 分区标题栏图标（24 网格线性，圆角居中，与主程序其它图标同族） ======== -->
            <PathGeometry x:Key="GeoChevron">M6,9 L12,15 L18,9</PathGeometry>
            <PathGeometry x:Key="GeoPlus">M12,5 V19 M5,12 H19</PathGeometry>
            <!-- 图钉：钉帽 + 外扩的钉身 + 向下的针，全直线 + 圆角连接（15px 下钉帽两竖间距 3.2px，够线宽不糊） -->
            <PathGeometry x:Key="GeoPin">M8.5,4 H15.5 V10.5 L18,13.5 H6 L8.5,10.5 Z M12,13.5 V20</PathGeometry>
            <PathGeometry x:Key="GeoPlay">M9.35,7 C8.75,7 8.35,7.4 8.35,8 L8.35,16 C8.35,16.6 8.95,17 9.55,16.7 L15.15,12.6 C15.65,12.3 15.65,11.7 15.15,11.4 L9.55,7.3 C9.45,7.1 9.45,7 9.35,7 Z</PathGeometry>
            <!-- 音箱：包围盒必须是正方形（3..21），Path Stretch=Uniform 贴框左上角不居中，非正方形会整体偏移 -->
            <PathGeometry x:Key="GeoSpeaker">M5,3 H19 Q21,3 21,5 V19 Q21,21 19,21 H5 Q3,21 3,19 V5 Q3,3 5,3 Z M12,7 A1.6,1.6 0 1 0 12,10.2 A1.6,1.6 0 1 0 12,7 Z M12,12.8 A3.3,3.3 0 1 0 12,19.4 A3.3,3.3 0 1 0 12,12.8 Z</PathGeometry>
            <!-- 音符：14px 标题栏胶囊用，两个符头 + 一条连梁，符头半径压到 2.3 以免糊成一团 -->
            <PathGeometry x:Key="GeoMusic">M9,17.8 V6.2 L21,4.2 V15.8 M6.7,18 m-2.3,0 a2.3,2.3 0 1 0 4.6,0 a2.3,2.3 0 1 0 -4.6,0 M18.7,16 m-2.3,0 a2.3,2.3 0 1 0 4.6,0 a2.3,2.3 0 1 0 -4.6,0</PathGeometry>
            <!-- 音量：16px 下只留喇叭 + 一条声波，第二条弧在细线宽下会糊成一团 -->
            <PathGeometry x:Key="GeoVolume">M4,9.5 V14.5 H7.5 L12,18 V6 L7.5,9.5 Z M15.2,9.2 A4,4 0 0 1 15.2,14.8</PathGeometry>
            <!-- 操作日志：圆角屏 + 底座 + 两行正文，与月亮/齿轮/窗口按钮同为圆润风格 -->
            <PathGeometry x:Key="GeoLog">M4,6 A2,2 0 0 1 6,4 H18 A2,2 0 0 1 20,6 V14 A2,2 0 0 1 18,16 H6 A2,2 0 0 1 4,14 Z M7,19 H17 M8,8 H16 M8,11 H14</PathGeometry>
            <PathGeometry x:Key="GeoRefresh">M21,12 A9,9 0 1 1 18,5.3 M21,3 L21,9 L15,9</PathGeometry>
            <PathGeometry x:Key="GeoLock">M5,10 L19,10 L19,21 L5,21 Z M8,10 L8,7 A4,4 0 0 1 16,7 L16,10</PathGeometry>
            <PathGeometry x:Key="GeoUser">M12,12 m-4,0 a4,4 0 1 0 8,0 a4,4 0 1 0 -8,0 M4,21 A8,8 0 0 1 20,21</PathGeometry>
            <PathGeometry x:Key="GeoSpinner">M12,3 A9,9 0 1 1 3,12</PathGeometry>
            <!-- ======== 房间专用图标（24 网格线性图标，侧边栏房间芯片用） ======== -->
            <PathGeometry x:Key="GeoLiving">M3,17 H19 V14 H3 Z M5,13 L10,13 L10,17 M10,13 L14,9 L19,13</PathGeometry>
            <PathGeometry x:Key="GeoBed">M4,17 H20 V11 H4 Z M7,11 V5 M17,11 V5 M8,17 H16</PathGeometry>
            <PathGeometry x:Key="GeoDining">M3,16 H21 V13 H3 Z M6,13 V8 M18,13 V8 M9,13 L15,7</PathGeometry>
            <PathGeometry x:Key="GeoKitchen">M5,6 H19 V16 H5 Z M8,6 V3 M16,6 V3 M10,16 L12,20 L14,16</PathGeometry>
            <PathGeometry x:Key="GeoStudy">M3,17 H21 V10 H3 Z M8,10 L18,5 M10,17 H16</PathGeometry>
            <PathGeometry x:Key="GeoToilet">M8,15 H16 V19 H8 Z M12,15 V9 M11,9 H13 M12,9 V4</PathGeometry>
            <PathGeometry x:Key="GeoBath">M6,17 H18 V14 H6 Z M14,14 V8 M12,8 A3,3 0 1 0 15,8 M14,8 V4</PathGeometry>
            <PathGeometry x:Key="GeoEntry">M6,5 V19 H18 V5 M12,5 V19</PathGeometry>
            <PathGeometry x:Key="GeoBalcony">M3,6 H21 V18 H3 Z M6,12 H18 M10,6 V18 M14,6 V18</PathGeometry>
            <!-- ======== 品牌标志（48 网格：圆肩 M + 橙点，卡底冷白、圆角 24%） ======== -->
            <StreamGeometry x:Key="GeoBrandMark">M13.5,32.5 V21.5 Q13.5,18.4 16.3,20.1 L22.2,26.4 Q24,27.9 25.8,26.4 L31.7,20.1 Q34.5,18.4 34.5,21.5 V32.5</StreamGeometry>
            <StreamGeometry x:Key="GeoBrandCard">M11.5,0 H36.5 A11.5,11.5 0 0 1 48,11.5 V36.5 A11.5,11.5 0 0 1 36.5,48 H11.5 A11.5,11.5 0 0 1 0,36.5 V11.5 A11.5,11.5 0 0 1 11.5,0 Z</StreamGeometry>
            <DrawingImage x:Key="LogoImage">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#F4F7FB" Geometry="{StaticResource GeoBrandCard}" />
                        <GeometryDrawing Geometry="{StaticResource GeoBrandMark}">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#28323F" Thickness="5.2" LineCap="Round" LineJoin="Round" />
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#FF6900">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="35.2,12.6" RadiusX="2.5" RadiusY="2.5" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
</ResourceDictionary>