<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAvalonia>true</UseAvalonia>
    <AssemblyName>MiHomeHub</AssemblyName>
    <RootNamespace>MiHomeHub</RootNamespace>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
    <Product>MiHomeHub</Product>
    <AssemblyTitle>MiHomeHub</AssemblyTitle>
    <Company>Feiyu</Company>
    <Description>MiHomeHub — 米家桌面控制台</Description>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <!-- 编译绑定：XAML 绑定错误编译期暴露，运行时零反射查找（Zonex 经验 P0）。
         View 需有 x:DataType；个别无法类型化的路径可显式 {ReflectionBinding}。 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- 本地变量字段文件：跟随 exe 放在同级目录，开源版本字段全空；发布后可手改，不必改代码。
         publish 目录会被 publish-sc 清空，所以必须同时设 CopyToPublishDirectory。 -->
    <Content Include="MiHomeHub.settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 本机覆盖（已 .gitignore）：只填私有后台等字段，不进仓库；存在才复制，且不进安装包 payload。 -->
    <Content Include="MiHomeHub.settings.local.json" Condition="Exists('MiHomeHub.settings.local.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Release/分发：自包含单文件 + 压缩。
       不开 PublishTrimmed：本应用 XAML 少量 ReflectionBinding + System.Text.Json 反射序列化，
       link 裁剪会破坏登录（auth.json）、二维码、面板关闭等运行时行为（见 TrimmerRoots.xml 注释）。
       若要重开裁剪：先清完 ReflectionBinding，JSON 改源生成，再补 root 并做完整回归。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Prefer32bit>true</Prefer32bit>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- 裁剪保护：见 TrimmerRoots.xml -->
  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <!-- .NET 10.0.9 的 COM 调试登记表会重复追加同一 CCW，随 UI Automation 调用持续增长。
       Release 分发关闭该调试辅助登记；保留 EventPipe/性能计数器，Debug 仍可正常调试。
       dotnet/runtime#129191、#133260；不涉及 PublishTrimmed。 -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeHostConfigurationOption Include="System.Diagnostics.Debugger.IsSupported" Value="false" />
  </ItemGroup>

  <!-- 显式排除构建输出目录：避免 SDK 默认 **/*.cs 通配把 obj/bin 下的
       AssemblyInfo 生成文件重复编入，导致 CS0579“特性重复”。 -->
  <ItemGroup>
    <Compile Remove="obj\**" />
    <Compile Remove="bin\**" />
    <!-- installer\MiHomeHub.Setup 是独立小工程（自带 Main），其源码与 obj/bin 不能混进主程序编译 -->
    <Compile Remove="installer\**\*.cs" />
    <Compile Remove="installer\**\obj\**" />
    <Compile Remove="installer\**\bin\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>

