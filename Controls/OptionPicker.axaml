<UserControl 
    xmlns="https://github.com/avaloniaui"
             
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             
    xmlns:m="clr-namespace:MiHome.Models"
    xmlns:controls="clr-namespace:MiHome.Controls"
             x:Class="MiHome.Controls.OptionPicker">
    <UserControl.Styles>
        <!-- ======== 触发器：圆角矩形 + 1px 细线，选中态只提亮底色，不描彩边 ======== -->
        <Style Selector="Button.PickBtn">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="11,0,9,0" />
            <Setter Property="Background" Value="{DynamicResource PickFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PickLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="7"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Panel>
                            <!-- 悬停走独立覆盖层的 Opacity，不用 BrushTransition：
                                 底是 #08FFFFFF、hover 是 HoverBrush，两者 RGB 不同，逐通道插值会先冲成浅灰（闪白）。
                                 覆盖层的色始终不变，只有透明度在动，所以不会过冲 -->
                            <Border Name="Hov" CornerRadius="8" Opacity="0"
                                    Background="{DynamicResource HoverBrush}">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.PickBtn:pointerover /template/ Border#Hov, Button.PickBtn.open /template/ Border#Hov">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- 挂 .wide 的实例占满宿主给的整条宽度，默认只按内容宽右对齐 -->
        <Style Selector="controls|OptionPicker.wide Button.PickBtn">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!-- 箭头展开时翻转 180°，让「开/合」有交代 -->
        <Style Selector="Button.PickBtn Path#Chev">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.PickBtn.open Path#Chev">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <!-- ======== 浮层：闭合态写在基础样式里，展开态由 .open 覆盖（局部值会压过样式，别写在这儿） ======== -->
        <Style Selector="Border.PickPanel">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="5" />
            <!-- 选项多时收成内部滚动，浮层本身不再无限拉长 -->
            <Setter Property="MaxHeight" Value="300" />
            <!-- Popup 是独立顶层窗口，投影只会画到自己的边界：留一圈透明边距给它展开 -->
            <Setter Property="Margin" Value="18,10,18,22" />
            <Setter Property="BoxShadow" Value="0 2 5 0 #26000000, 0 6 16 0 #40000000" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="50%, 0%" />
            <Setter Property="RenderTransform" Value="scale(0.94) translate(0px,-6px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.PickPanel.open">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1) translate(0px,0px)" />
        </Style>
        <!-- 浅色下投影要更淡一档，否则白卡上的黑边一圈很脏 -->
        <Style Selector="Border.PickPanel.light">
            <Setter Property="BoxShadow" Value="0 1 3 0 #100F172A, 0 5 16 0 #1A0F172A" />
        </Style>
        <Style Selector="Button.PickItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,1" />
            <!-- 淡入起点：与 SelBgHoverBrush 同色、透明位为 0。既保证整行（含空白处）可命中，
                 又能让 BrushTransition 从透明平滑淡到悬停柔色底 -->
            <Setter Property="Background" Value="{DynamicResource SelBgFromBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.14" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- 行内标签与房间胶囊的颜色写在控件上，不挂按钮：Control.Foreground 不会沿可视树继承进
             内容里的 TextBlock，挂按钮只会让名称退回黑色。下面的顺序固定为
             「基础档 → 悬停档 → 选中档」，同优先级取后者，后面的状态才能盖住前面的基础色。 -->
        <Style Selector="TextBlock.Lbl">
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 行尾的房间等补充信息：比主文字更弱一档，选中行也不提色，避免和名称抢焦点 -->
        <Style Selector="TextBlock.Meta">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 触发器上的同一份补充信息挪到名称左边：先认房间、再认设备 -->
        <Style Selector="TextBlock.Pre">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.PickItem:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SelBgHoverBrush}" />
        </Style>
        <!-- 悬停底也是实心紫（只是弱一档）：整行文字跟着翻白 -->
        <Style Selector="Button.PickItem:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SelTextBrush}" />
        </Style>
        <!-- 选中：品牌主色实心底 + 互补白字（名称和行尾房间胶囊一起翻白），不打勾 -->
        <Style Selector="Button.PickItem.is-on /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SelBgBrush}" />
        </Style>
        <Style Selector="Button.PickItem.is-on TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SelTextBrush}" />
        </Style>
        <!-- 悬停已选中的那一项：保持选中底，不能被更淡的悬停档盖过去 -->
        <Style Selector="Button.PickItem.is-on:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SelBgBrush}" />
        </Style>
        <Style Selector="Button.PickItem.is-on:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SelBgPressBrush}" />
        </Style>
        <Style Selector="Button.PickItem.is-on TextBlock.Lbl">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <Button Name="Trigger" Classes="PickBtn">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Name="Pre" Grid.Column="0" Classes="RoomTag" Margin="0,0,6,0" IsVisible="False">
                    <TextBlock Name="PreTxt" Classes="Pre" />
                </Border>
                <TextBlock Name="Cur" Grid.Column="1" Text="选择" FontSize="12.5" FontWeight="Medium"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <!-- Fill 而非 Uniform：几何包围盒 12:6 与视口 9:4.5 等比，形状必铺满视口、
                     中心即控件中心；Uniform 缩放后的内容不落在视口垂直中心，箭头会整体偏上 -->
                <Path Name="Chev" Grid.Column="2" Width="9" Height="4.5" Stretch="Fill"
                      Margin="10,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="50%, 50%"
                      Stroke="{DynamicResource Text3Brush}" StrokeThickness="1.2"
                      StrokeLineCap="Round" StrokeJoin="Round" Data="M6 9 L12 15 L18 9" />
            </Grid>
        </Button>
        <!-- 偏移抵掉浮层的透明边距：右缘对齐触发器右缘，卡片离触发器 6px -->
        <Popup Name="Pop" Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True"
               HorizontalOffset="18" VerticalOffset="-4" WindowManagerAddShadowHint="False">
            <Border Name="Panel" Classes="PickPanel">
                <ScrollViewer Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl Name="List">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:IPickOption">
                                <Button Classes="PickItem" Classes.is-on="{Binding IsSelected}" Tag="{Binding}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="Lbl" Text="{Binding Label}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Classes="RoomTag" Grid.Column="1" Margin="8,0,0,0"
                                                IsVisible="{Binding Meta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Classes="Meta" Text="{Binding Meta}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
