<UserControl 
    xmlns="https://github.com/avaloniaui"
             
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             
    xmlns:m="clr-namespace:MiHomeHub.Models"
    xmlns:controls="clr-namespace:MiHomeHub.Controls"
             x:Class="MiHomeHub.Controls.OptionPicker">
    <UserControl.Styles>
        <!-- ======== 触发器：圆角矩形 + 1px 细线，选中态只提亮底色，不描彩边 ======== -->
        <Style Selector="Button.PickBtn">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="11,0,9,0" />
            <Setter Property="Background" Value="{DynamicResource PickFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PickLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="7"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Panel>
                            <!-- 悬停走独立覆盖层的 Opacity，不用 BrushTransition：
                                 底是 #08FFFFFF、hover 是 HoverBrush，两者 RGB 不同，逐通道插值会先冲成浅灰（闪白）。
                                 覆盖层的色始终不变，只有透明度在动，所以不会过冲 -->
                            <Border Name="Hov" CornerRadius="8" Opacity="0"
                                    Background="{DynamicResource HoverBrush}">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.PickBtn:pointerover /template/ Border#Hov, Button.PickBtn.open /template/ Border#Hov">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- 挂 .wide 的实例占满宿主给的整条宽度，默认只按内容宽右对齐 -->
        <Style Selector="controls|OptionPicker.wide Button.PickBtn">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!-- ======== 小号档（Compact = True）：压成小胶囊，嵌在信息卡角上不抢主视觉 ========
             这里的类挂在内部元素上（触发器 / 浮层），不用「OptionPicker.compact」这种以自身打头的
             选择器——控件自己的 Styles 只覆盖子树，选择器根写自身类型是匹配不到的。 -->
        <Style Selector="Button.PickBtn.mini">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0,6,0" />
        </Style>
        <Style Selector="Button.PickBtn.mini TextBlock.Cur">
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style Selector="Button.PickBtn.mini Path#Chev">
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style Selector="Button.PickBtn.mini Border.RoomTag">
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <!-- ======== 胶囊形（Pill = True）：24 高配 12 圆角，左右各半个圆；文字弱一档，
             卡片角上的小控件不跟主读数抢眼 ======== -->
        <Style Selector="Button.PickBtn.pill /template/ Border#Bd">
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Button.PickBtn.pill /template/ Border#Hov">
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Button.PickBtn.pill TextBlock.Cur">
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
        </Style>
        <!-- 箭头与文字的间距写在基础样式里（不写在元素上），这样 .mini 才有机会压过它 -->
        <Style Selector="Button.PickBtn Path#Chev">
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <!-- 箭头展开时翻转 180°，让「开/合」有交代 -->
        <Style Selector="Button.PickBtn Path#Chev">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.PickBtn.open Path#Chev">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <!-- ======== 浮层：闭合态写在基础样式里，展开态由 .open 覆盖（局部值会压过样式，别写在这儿） ======== -->
        <Style Selector="Border.PickPanel">
            <Setter Property="Background" Value="{DynamicResource CardSolidBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <!-- 行内字号由浮层统一给、列表项继承：小号档只改这一处就能整体收一档（Border 不是 TextElement，得用附加属性） -->
            <Setter Property="TextBlock.FontSize" Value="12.5" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="5" />
            <!-- 选项多时收成内部滚动，浮层本身不再无限拉长 -->
            <Setter Property="MaxHeight" Value="300" />
            <!-- Popup 是独立顶层窗口，投影只会画到自己的边界：留一圈透明边距给它展开 -->
            <Setter Property="Margin" Value="18,10,18,22" />
            <Setter Property="BoxShadow" Value="0 2 5 0 #26000000, 0 6 16 0 #40000000" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="50%, 0%" />
            <Setter Property="RenderTransform" Value="scale(0.94) translate(0px,-6px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.PickPanel.open">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1) translate(0px,0px)" />
        </Style>
        <!-- 浅色下投影要更淡一档，否则白卡上的黑边一圈很脏 -->
        <Style Selector="Border.PickPanel.light">
            <Setter Property="BoxShadow" Value="0 1 3 0 #100F172A, 0 5 16 0 #1A0F172A" />
        </Style>
        <Style Selector="Button.PickItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,1" />
            <!-- 淡入起点：与 SelBgHoverBrush 同色、透明位为 0。既保证整行（含空白处）可命中，
                 又能让 BrushTransition 从透明平滑淡到悬停柔色底 -->
            <Setter Property="Background" Value="{DynamicResource SelBgFromBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.14" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- 行内标签与房间胶囊的颜色写在控件上，不挂按钮：Control.Foreground 不会沿可视树继承进
             内容里的 TextBlock，挂按钮只会让名称退回黑色。下面的顺序固定为
             「基础档 → 悬停档 → 选中档」，同优先级取后者，后面的状态才能盖住前面的基础色。 -->
        <Style Selector="TextBlock.Lbl">
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 名称后面的房间等补充信息：做成淡紫小胶囊。原来走 Text3 灰，压在深色卡上几乎读不出字；
             主文字本来就是亮白，副信息改用品牌淡紫，跟名称分得开又不抢焦点 -->
        <Style Selector="TextBlock.Meta">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource Accent2Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 胶囊底也带一点淡紫，不再用白到看不见的 Surface5 -->
        <Style Selector="Border.RoomTag">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <!-- 触发器主文字：默认强色；挂 .muted 的实例（如托盘里的音箱选择）弱一档 -->
        <Style Selector="TextBlock.Cur">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="controls|OptionPicker.muted TextBlock.Cur">
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        </Style>
        <Style Selector="Button.PickItem:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SelBgHoverBrush}" />
        </Style>
        <!-- 悬停底也是实心紫（只是弱一档）：整行文字跟着翻白 -->
        <Style Selector="Button.PickItem:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SelTextBrush}" />
        </Style>
        <!-- 选中：品牌主色实心底 + 互补白字（名称和行尾房间胶囊一起翻白），不打勾 -->
        <Style Selector="Button.PickItem.is-on /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SelBgBrush}" />
        </Style>
        <Style Selector="Button.PickItem.is-on TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SelTextBrush}" />
        </Style>
        <!-- 悬停已选中的那一项：保持选中底，不能被更淡的悬停档盖过去 -->
        <Style Selector="Button.PickItem.is-on:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SelBgBrush}" />
        </Style>
        <Style Selector="Button.PickItem.is-on:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SelBgPressBrush}" />
        </Style>
        <Style Selector="Button.PickItem.is-on TextBlock.Lbl">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <!-- ======== 小号档（Compact = True）：浮层比标准档再收一圈 ========
             卡片角上的小胶囊弹出一行 32 高、12.5 字的菜单太占地方，这里把行高、字号、
             内距、最大高度一起压下来；行数超过 6 条仍走内部滚动，浮层不会拉得比卡片还长 -->
        <Style Selector="Border.PickPanel.mini">
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MaxHeight" Value="188" />
        </Style>
        <Style Selector="Border.PickPanel.mini Button.PickItem">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="7,0" />
        </Style>
        <Style Selector="Border.PickPanel.mini TextBlock.Lbl">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Border.PickPanel.mini TextBlock.Meta">
            <Setter Property="FontSize" Value="9.5" />
        </Style>
        <!-- ======== 玻璃档（Glass = True）：桌面组件上的下拉 ========
             卡面是用户挑的彩色 / 渐变，深色不透明浮层像一块黑板、纯白实底又失去层次；
             这一档走「墨色玻璃 + 白字」：胶囊和浮层都是半透明压深色，卡面颜色透得出来，
             悬停 / 选中叠的是白色带透明度，文字与箭头一律近纯白 —— 压在任何颜色的卡面上都读得清。
             这一套是固定的玻璃色，不跟卡片深浅主题来回翻。 -->
        <Style Selector="Button.PickBtn.glass">
            <Setter Property="Background" Value="#4D0F172A" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
        </Style>
        <Style Selector="Button.PickBtn.glass /template/ Border#Hov">
            <Setter Property="Background" Value="#1FFFFFFF" />
        </Style>
        <Style Selector="Button.PickBtn.glass TextBlock.Cur">
            <Setter Property="Foreground" Value="#F2FFFFFF" />
        </Style>
        <Style Selector="Button.PickBtn.glass Path#Chev">
            <Setter Property="Stroke" Value="#C7D0DB" />
        </Style>
        <Style Selector="Button.PickBtn.glass:pointerover TextBlock.Cur, Button.PickBtn.glass.open TextBlock.Cur">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>
        <Style Selector="Button.PickBtn.glass:pointerover Path#Chev, Button.PickBtn.glass.open Path#Chev">
            <Setter Property="Stroke" Value="#FFFFFFFF" />
        </Style>

        <Style Selector="Border.PickPanel.glass">
            <Setter Property="Background" Value="#B80F1422" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="BoxShadow" Value="0 4 10 0 #33000000, 0 14 30 0 #4D000000" />
        </Style>
        <Style Selector="Border.PickPanel.glass TextBlock.Lbl">
            <Setter Property="Foreground" Value="#E6FFFFFF" />
        </Style>
        <Style Selector="Border.PickPanel.glass TextBlock.Meta">
            <Setter Property="Foreground" Value="#C7BCFF" />
        </Style>
        <Style Selector="Border.PickPanel.glass Button.PickItem:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="#1FFFFFFF" />
        </Style>
        <Style Selector="Border.PickPanel.glass Button.PickItem:pointerover TextBlock">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>
        <Style Selector="Border.PickPanel.glass Button.PickItem.is-on /template/ Border#Bd">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="Border.PickPanel.glass Button.PickItem.is-on TextBlock">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>
        <Style Selector="Border.PickPanel.glass Button.PickItem.is-on TextBlock.Lbl">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.PickPanel.glass Button.PickItem.is-on:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <Button Name="Trigger" Classes="PickBtn">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Name="Cur" Grid.Column="0" Classes="Cur" Text="选择" FontWeight="Normal"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <!-- 房间胶囊跟在名称后面（和浮层列表同一顺序）：名称吃掉剩余宽度、放不下就截断，
                     胶囊占 Auto 一列，永远留着自己的位置，不会被长名字挤掉 -->
                <Border Name="Room" Grid.Column="1" Classes="RoomTag" Margin="8,0,0,0" IsVisible="False">
                    <TextBlock Name="RoomTx" Classes="Meta" />
                </Border>
                <!-- Fill 而非 Uniform：几何包围盒 12:6 与视口 9:4.5 等比，形状必铺满视口、
                     中心即控件中心；Uniform 缩放后的内容不落在视口垂直中心，箭头会整体偏上 -->
                <Path Name="Chev" Grid.Column="2" Width="9" Height="4.5" Stretch="Fill"
                      VerticalAlignment="Center" RenderTransformOrigin="50%, 50%"
                      Stroke="{DynamicResource Text3Brush}" StrokeThickness="1.2"
                      StrokeLineCap="Round" StrokeJoin="Round" Data="M6 9 L12 15 L18 9" />
            </Grid>
        </Button>
        <!-- 偏移抵掉浮层的透明边距：右缘对齐触发器右缘，卡片离触发器 6px -->
        <Popup Name="Pop" Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True"
               HorizontalOffset="18" VerticalOffset="-4" WindowManagerAddShadowHint="False">
            <Border Name="Panel" Classes="PickPanel">
                <ScrollViewer Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- 右侧 14px 留白只在出现纵向滚动条时由代码补上（overlay 滚动条压在视口右缘，
                         给房间胶囊让位）；内容不够高、没有滚动条时不留这道空白。 -->
                    <ItemsControl Name="List">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:IPickOption">
                                <Button Classes="PickItem" Classes.is-on="{Binding IsSelected}" Tag="{Binding}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="Lbl" Text="{Binding Label}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Classes="RoomTag" Grid.Column="1" Margin="8,0,0,0"
                                                IsVisible="{Binding Meta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Classes="Meta" Text="{Binding Meta}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
