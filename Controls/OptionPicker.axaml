<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:MiHome.Models"
             x:Class="MiHome.Controls.OptionPicker">

    <UserControl.Styles>
        <!-- ======== 触发器：圆角矩形 + 1px 细线，选中态只提亮底色，不描彩边 ======== -->
        <Style Selector="Button.PickBtn">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="11,0,9,0" />
            <Setter Property="Background" Value="{DynamicResource PickFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PickLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="9"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Panel>
                            <!-- 悬停走独立覆盖层的 Opacity，不用 BrushTransition：
                                 底是 #08FFFFFF、hover 是 HoverBrush，两者 RGB 不同，逐通道插值会先冲成浅灰（闪白）。
                                 覆盖层的色始终不变，只有透明度在动，所以不会过冲 -->
                            <Border Name="Hov" CornerRadius="8" Opacity="0"
                                    Background="{DynamicResource HoverBrush}">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.PickBtn:pointerover /template/ Border#Hov, Button.PickBtn.open /template/ Border#Hov">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- 箭头展开时翻转 180°，让「开/合」有交代 -->
        <Style Selector="Button.PickBtn Path#Chev">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.PickBtn.open Path#Chev">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>

        <!-- ======== 浮层：闭合态写在基础样式里，展开态由 .open 覆盖（局部值会压过样式，别写在这儿） ======== -->
        <Style Selector="Border.PickPanel">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="5" />
            <!-- Popup 是独立顶层窗口，投影只会画到自己的边界：留一圈透明边距给它展开 -->
            <Setter Property="Margin" Value="18,10,18,22" />
            <Setter Property="BoxShadow" Value="0 2 5 0 #26000000, 0 6 16 0 #40000000" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="50%, 0%" />
            <Setter Property="RenderTransform" Value="scale(0.94) translate(0px,-6px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.PickPanel.open">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1) translate(0px,0px)" />
        </Style>
        <!-- 浅色下投影要更淡一档，否则白卡上的黑边一圈很脏 -->
        <Style Selector="Border.PickPanel.light">
            <Setter Property="BoxShadow" Value="0 1 3 0 #100F172A, 0 5 16 0 #1A0F172A" />
        </Style>

        <Style Selector="Button.PickItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="{DynamicResource HoverFromBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.14" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.PickItem:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <!-- 选中：柔色底 + 同色文字，不打勾 -->
        <Style Selector="Button.PickItem.is-on /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="Button.PickItem.is-on:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="Button.PickItem.is-on ContentPresenter TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <Button Name="Trigger" Classes="PickBtn">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Name="Cur" Grid.Column="0" Text="选择" FontSize="12.5" FontWeight="Medium"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Path Name="Chev" Grid.Column="1" Width="9" Height="9" Stretch="Uniform"
                      Margin="10,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="50%, 50%"
                      Stroke="{DynamicResource Text3Brush}" StrokeThickness="1.6"
                      StrokeLineCap="Round" StrokeJoin="Round" Data="M6 9 L12 15 L18 9" />
            </Grid>
        </Button>

        <!-- 偏移抵掉浮层的透明边距：右缘对齐触发器右缘，卡片离触发器 6px -->
        <Popup Name="Pop" Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True"
               HorizontalOffset="18" VerticalOffset="-4" WindowManagerAddShadowHint="False">
            <Border Name="Panel" Classes="PickPanel">
                <ItemsControl Name="List">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:OptionItem">
                            <Button Classes="PickItem" Classes.is-on="{Binding IsSelected}" Tag="{Binding}">
                                <TextBlock Text="{Binding Label}" FontSize="12.5"
                                           Foreground="{DynamicResource Text2Brush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>
    </Grid>
</UserControl>
